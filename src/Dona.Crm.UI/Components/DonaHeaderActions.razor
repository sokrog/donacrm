@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="dona-header-actions-desktop" role="group" aria-label="@Label">
    @foreach (var action in Actions)
    {
        @if (action.Href is not null && !action.Disabled)
        {
            <a class="dona-btn dona-btn--secondary" href="@action.Href">@action.Label</a>
        }
        else
        {
            <button type="button" class="dona-btn dona-btn--secondary" disabled="@action.Disabled" @onclick="action.Callback">@action.Label</button>
        }
    }
</div>
<details class="dona-context-menu" id="@menuId">
    <summary class="dona-icon-button dona-context-menu-trigger" role="button" aria-label="@Label" aria-expanded="false" aria-controls="@(menuId + "-panel")"><OrbitIcon Name="more" /></summary>
    <div class="dona-context-menu-panel" id="@(menuId + "-panel")" role="group" aria-label="@Label">
        @foreach (var action in Actions)
        {
            @if (action.Href is not null && !action.Disabled)
            {
                <a class="dona-btn" href="@action.Href" @onclick="() => ExecuteAsync(action)">@action.Label</a>
            }
            else
            {
                <button type="button" class="dona-btn" disabled="@action.Disabled" @onclick="() => ExecuteAsync(action)">@action.Label</button>
            }
        }
    </div>
</details>

@code {
    [Parameter] public string Label { get; set; } = "Действия";
    [Parameter] public IReadOnlyList<DonaHeaderAction> Actions { get; set; } = [];
    private readonly string menuId = $"header-actions-{Guid.NewGuid():N}";
    private async Task ExecuteAsync(DonaHeaderAction action)
    {
        await JS.InvokeVoidAsync("orbitModal.closeActionMenu", menuId);
        await action.Callback.InvokeAsync();
    }
}
