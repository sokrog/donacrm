@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject LocalImageMigrationService ImageMigration

<div class="shell @(isFocusedRoute ? "is-focused-route" : null)">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="DONA — главная">
            <img class="dona-logo" src="_content/Dona.Crm.UI/brand/dona-logo.png" alt="DONA" />
            <small>УПРАВЛЕНИЕ МАГАЗИНОМ</small>
        </a>
        <nav class="side-nav" aria-label="Навигация рабочего пространства">
            <a class="@SideClass("home")" href="/" aria-current="@Current("home")"><OrbitIcon Name="home" /><span>Главная</span></a>
            <a class="@SideClass("catalog")" href="/products" aria-current="@Current("catalog")"><OrbitIcon Name="catalog" /><span>Каталог</span></a>
            <a class="@SideClass("sales")" href="/sales" aria-current="@Current("sales")"><OrbitIcon Name="sales" /><span>Продажи</span></a>
            <a class="@SideClass("purchases")" href="/purchases" aria-current="@Current("purchases")"><OrbitIcon Name="truck" /><span>Закупки</span></a>
            <a class="@SideClass("inventory")" href="/inventory" aria-current="@Current("inventory")"><OrbitIcon Name="warehouse" /><span>Склад</span></a>
            <a class="@SideClass("partners")" href="/partners" aria-current="@Current("partners")"><OrbitIcon Name="partners" /><span>Партнёры</span></a>
            <a class="@SideClass("marketing")" href="/marketing" aria-current="@Current("marketing")"><OrbitIcon Name="marketing" /><span>Маркетинг</span></a>
            <a class="@SideClass("analytics")" href="/analytics" aria-current="@Current("analytics")"><OrbitIcon Name="analytics" /><span>Аналитика</span></a>
        </nav>
        <nav class="side-tools" aria-label="Настройки приложения">
            <a class="@SideClass("connections")" href="/connections" aria-current="@Current("connections")"><OrbitIcon Name="cloud" /><span>Подключения</span></a>
            <a class="@SideClass("settings")" href="/settings" aria-current="@Current("settings")"><OrbitIcon Name="settings" /><span>Настройки</span></a>
        </nav>
    </aside>

    <main class="main">
        <ErrorBoundary @ref="errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <section class="dona-state dona-state--error page-error" role="alert">
                    <h1>Что-то пошло не так на этой странице</h1>
                    <p>Обновите страницу или вернитесь на главную.</p>
                    <details>
                        <summary>Подробности</summary>
                        <p>@exception.Message</p>
                    </details>
                    <div class="page-error-actions">
                        <button type="button" class="dona-btn dona-btn--primary" @onclick="RecoverFromError">Попробовать снова</button>
                        <a class="dona-btn dona-btn--secondary" href="/">На главную</a>
                    </div>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    @if (!isFocusedRoute)
    {
        <nav class="tabs" aria-label="Основная навигация">
            <a class="@TabClass("home")" href="/" aria-current="@Current("home")">
                <OrbitIcon Name="home" />
                <span>Главная</span>
            </a>
            <a class="@TabClass("catalog")" href="/products" aria-current="@Current("catalog")">
                <OrbitIcon Name="catalog" />
                <span>Каталог</span>
            </a>
            <a class="@TabClass("sales")" href="/sales" aria-current="@Current("sales")">
                <OrbitIcon Name="sales" />
                <span>Продажи</span>
            </a>
            <a class="@TabClass("purchases")" href="/purchases" aria-current="@Current("purchases")">
                <OrbitIcon Name="truck" />
                <span>Закупки</span>
            </a>
            <a class="@TabClass("more")" href="/more" aria-current="@Current("more")">
                <OrbitIcon Name="more" />
                <span>Ещё</span>
            </a>
        </nav>
    }
</div>

@code {
    private bool isFocusedRoute;
    private string sidebarSection = "home";
    private string tabSection = "more";
    private ErrorBoundary? errorBoundary;

    protected override void OnInitialized()
    {
        // Однократный фоновый перенос старых base64-фотографий в локальное хранилище; ошибки глушатся внутри сервиса.
        _ = ImageMigration.EnsureMigratedAsync();
        UpdateRouteMode();
        Navigation.LocationChanged += LocationChanged;
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateRouteMode();
        InvokeAsync(() =>
        {
            errorBoundary?.Recover();
            StateHasChanged();
        });
    }

    private void RecoverFromError() => errorBoundary?.Recover();

    private string? Current(string key) => key == sidebarSection || key == tabSection ? "page" : null;

    private string SideClass(string key) => key == sidebarSection ? "active" : string.Empty;

    private string TabClass(string key) => key == tabSection ? "tab is-active" : "tab";

    private void UpdateRouteMode()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = "/" + relative.Split('?', '#')[0].Trim('/');
        isFocusedRoute = IsEditorRoute(path);
        sidebarSection = SidebarSectionFor(path);
        tabSection = TabSectionFor(path);
    }

    // Панель вкладок скрыта только на формах и редакторах, где нужен весь экран.
    private static bool IsEditorRoute(string path)
    {
        if (path == "/inventory/adjustment/new") return true;
        var last = path[(path.LastIndexOf('/') + 1)..];
        return last == "new" || Guid.TryParse(last, out _);
    }

    private static bool UnderRoute(string path, string root) => path == root || path.StartsWith(root + "/", StringComparison.Ordinal);

    private static string SidebarSectionFor(string path)
    {
        if (path == "/" || path == "/attention" || path == "/welcome") return "home";
        if (UnderRoute(path, "/products")) return "catalog";
        if (UnderRoute(path, "/sales") || UnderRoute(path, "/customers")) return "sales";
        if (UnderRoute(path, "/purchases")) return "purchases";
        if (UnderRoute(path, "/inventory")) return "inventory";
        if (UnderRoute(path, "/partners")) return "partners";
        if (UnderRoute(path, "/marketing") || UnderRoute(path, "/collections") || UnderRoute(path, "/outfits") || UnderRoute(path, "/content-plan")) return "marketing";
        if (UnderRoute(path, "/analytics")) return "analytics";
        if (UnderRoute(path, "/connections") || UnderRoute(path, "/sync")) return "connections";
        if (UnderRoute(path, "/settings")) return "settings";
        return string.Empty;
    }

    private static string TabSectionFor(string path)
    {
        if (path == "/" || path == "/attention" || path == "/welcome") return "home";
        if (UnderRoute(path, "/products")) return "catalog";
        if (UnderRoute(path, "/sales") || UnderRoute(path, "/customers")) return "sales";
        if (UnderRoute(path, "/purchases")) return "purchases";
        return "more";
    }

    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
