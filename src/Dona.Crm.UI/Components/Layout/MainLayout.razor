@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="orbit-shell @(isFocusedRoute ? "is-focused-route" : null)">
    <aside class="orbit-sidebar">
        <a class="orbit-brand" href="/" aria-label="Command Orbit — главная">
            <span aria-hidden="true">CO</span><strong>Command Orbit</strong>
        </a>
        <nav class="orbit-side-nav" aria-label="Навигация рабочего пространства">
            <NavLink href="/" Match="NavLinkMatch.All"><OrbitIcon Name="home" /><span>Главная</span></NavLink>
            <NavLink href="/products"><OrbitIcon Name="catalog" /><span>Каталог</span></NavLink>
            <NavLink href="/sales"><OrbitIcon Name="sales" /><span>Продажи</span></NavLink>
            <NavLink href="/purchases"><OrbitIcon Name="truck" /><span>Закупки</span></NavLink>
            <NavLink href="/inventory"><OrbitIcon Name="adjust" /><span>Склад</span></NavLink>
            <NavLink href="/partners"><OrbitIcon Name="purchases" /><span>Партнёры</span></NavLink>
            <NavLink href="/marketing"><OrbitIcon Name="marketing" /><span>Маркетинг</span></NavLink>
            <NavLink href="/analytics"><OrbitIcon Name="analytics" /><span>Аналитика</span></NavLink>
        </nav>
        <nav class="orbit-side-tools" aria-label="Настройки приложения">
            <NavLink href="/connections"><OrbitIcon Name="cloud" /><span>Подключения</span></NavLink>
            <NavLink href="/settings"><OrbitIcon Name="settings" /><span>Настройки</span></NavLink>
        </nav>
    </aside>

    <main class="orbit-main">
        @Body
    </main>

    @if (!isFocusedRoute)
    {
        <nav class="orbit-tabs" aria-label="Основная навигация">
            <NavLink class="orbit-tab" ActiveClass="is-active" href="/" Match="NavLinkMatch.All">
                <OrbitIcon Name="home" />
                <span>Главная</span>
            </NavLink>
            <NavLink class="orbit-tab" ActiveClass="is-active" href="/products">
                <OrbitIcon Name="catalog" />
                <span>Каталог</span>
            </NavLink>
            <NavLink class="orbit-tab" ActiveClass="is-active" href="/sales">
                <OrbitIcon Name="sales" />
                <span>Продажи</span>
            </NavLink>
            <NavLink class="orbit-tab" ActiveClass="is-active" href="/purchases">
                <OrbitIcon Name="truck" />
                <span>Закупки</span>
            </NavLink>
            <NavLink class="orbit-tab" ActiveClass="is-active" href="/more">
                <OrbitIcon Name="more" />
                <span>Ещё</span>
            </NavLink>
        </nav>
    }
</div>

@code {
    private static readonly HashSet<string> PrimaryRoutes =
    [
        "/",
        "/products",
        "/sales",
        "/purchases",
        "/more",
        "/welcome"
    ];

    private bool isFocusedRoute;

    protected override void OnInitialized()
    {
        UpdateRouteMode();
        Navigation.LocationChanged += LocationChanged;
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateRouteMode();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateRouteMode()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = "/" + relative.Split('?', '#')[0].Trim('/');
        isFocusedRoute = !PrimaryRoutes.Contains(path);
    }

    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
