@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@inject IProductImagePicker ImagePicker
@implements IAsyncDisposable

<div class="dona-section entity-images @(Featured && Images.Count > 0 ? "entity-images--featured" : null)" role="group" aria-labelledby="@headingId">
    <div class="dona-section-title">
        <h2 id="@headingId">Фотографии</h2>
        <button type="button" class="dona-btn dona-btn--ghost" disabled="@(busy || Images.Count >= MaxImages)" @onclick="PickAsync">
            @if (!busy) { <OrbitIcon Name="plus" Class="dona-inline-icon" /> }
            @(busy ? "Открываем…" : "Выбрать")
        </button>
    </div>
    <div class="entity-images__url">
        <label class="dona-field">Добавить по ссылке
            <InputText @bind-Value="imageUrl" inputmode="url" placeholder="https://…/photo.jpg" />
        </label>
        <button type="button" class="dona-btn dona-btn--ghost" disabled="@(busy || Images.Count >= MaxImages || string.IsNullOrWhiteSpace(imageUrl))" @onclick="AddUrlAsync">Добавить</button>
    </div>
    @if (Images.Count == 0)
    {
        <p class="entity-images__empty">Выберите фото из галереи или добавьте его по ссылке.</p>
    }
    else if (Featured)
    {
        var image = OrderedImages[ActiveIndex];
        <div class="entity-images__carousel" role="group" aria-roledescription="карусель" aria-label="Фотографии товара" @onkeydown="CarouselKeyDown">
            <button type="button" class="entity-image-preview-button" aria-label="Открыть фотографию на весь экран" @onclick="() => OpenPreview(image)">
                <ProductImageView @key="image.Id" Image="@image" FallbackUrl="@image.Url" Class="entity-image-preview" Alt="@($"Фото {EntityLabel.ToLowerInvariant()} {ActiveIndex + 1}")" />
            </button>
            <button type="button" class="entity-images__overlay-button entity-images__delete" aria-label="Удалить фотографию" title="Удалить фотографию" @onclick="() => removalCandidate = image"><OrbitIcon Name="trash" /></button>
            <div class="entity-images__photo-actions">
                <button type="button" class="entity-images__overlay-button entity-images__star" aria-label="Главная фотография" aria-pressed="@(image.IsMain ? "true" : "false")" title="@(image.IsMain ? "Главная фотография" : "Сделать главной")" @onclick="() => SetMainAsync(image)"><OrbitIcon Name="@(image.IsMain ? "star-filled" : "star")" /></button>
            </div>
            @if (Images.Count > 1)
            {
                <button type="button" class="entity-images__overlay-button entity-images__arrow entity-images__previous" aria-label="Предыдущая фотография" @onclick="() => MovePhoto(-1)"><OrbitIcon Name="back" /></button>
                <button type="button" class="entity-images__overlay-button entity-images__arrow entity-images__next" aria-label="Следующая фотография" @onclick="() => MovePhoto(1)"><OrbitIcon Name="forward" /></button>
            }
            <span class="entity-images__counter" role="status" aria-live="polite" aria-atomic="true">@(ActiveIndex + 1) / @Images.Count</span>
        </div>
    }
    else
    {
        <div class="entity-images__grid">
            @foreach (var image in OrderedImages)
            {
                <article class="entity-images__item" @key="image.Id">
                    <button type="button" class="entity-image-preview-button" aria-label="Открыть фотографию на весь экран" @onclick="() => OpenPreview(image)">
                        <ProductImageView Image="@image" FallbackUrl="@image.Url" Class="entity-image-preview" Alt="@($"Фото {EntityLabel.ToLowerInvariant()} {image.SortOrder + 1}")" />
                    </button>
                    <div>
                        <button type="button" class="@(image.IsMain ? "selected" : null)" @onclick="() => SetMainAsync(image)">@(image.IsMain ? "Главное" : "Сделать главным")</button>
                        <button type="button" class="delete" aria-label="Удалить фотографию" @onclick="() => removalCandidate = image">×</button>
                    </div>
                </article>
            }
        </div>
    }
    @if (removalCandidate is not null)
    {
        <DonaConfirmation OnCancel="() => removalCandidate = null">
            <div class="entity-images__confirmation">
                <h2>Удалить фотографию?</h2>
                <p>Фотография исчезнет из списка. Окончательное удаление произойдёт только после сохранения изменений в карточке.</p>
                <div class="dona-toolbar">
                    <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => removalCandidate = null">Отмена</button>
                    <button type="button" class="dona-btn dona-btn--danger" @onclick="ConfirmRemovalAsync">Удалить фотографию</button>
                </div>
            </div>
        </DonaConfirmation>
    }
    @if (preview is not null)
    {
        <EntityImageViewer Images="@OrderedImages" Image="@preview" EntityLabel="@EntityLabel" ImageChanged="PreviewChanged" OnClose="ClosePreview" />
    }
    @if (message is not null)
    {
        <p class="entity-images__message @(hasError ? "error" : null)" role="status">@message</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<ProductImage> Images { get; set; } = [];
    [Parameter] public Guid OwnerId { get; set; }
    [Parameter] public string EntityLabel { get; set; } = "записи";
    [Parameter] public int MaxImages { get; set; } = 12;
    [Parameter] public bool Featured { get; set; }
    [Parameter] public EventCallback ImagesChanged { get; set; }

    private readonly string headingId = $"images-{Guid.NewGuid():N}";
    private readonly List<ProductImage> pending = [];
    private readonly List<ProductImage> removed = [];
    private string? imageUrl;
    private string? message;
    private bool busy;
    private bool hasError;
    private ProductImage? preview;
    private ProductImage? removalCandidate;
    private Guid? activeImageId;
    private Guid? activeOwnerId;
    protected override void OnParametersSet()
    {
        if (activeOwnerId == OwnerId) return;
        activeOwnerId = OwnerId;
        removalCandidate = null;
        activeImageId = null;
    }
    private List<ProductImage> OrderedImages => Images.OrderByDescending(item => Featured && item.IsMain).ThenBy(item => item.SortOrder).ToList();
    private int ActiveIndex => Math.Max(0, OrderedImages.FindIndex(item => item.Id == activeImageId));
    private void MovePhoto(int direction)
    {
        if (!Featured || Images.Count < 2) return;
        activeImageId = OrderedImages[(ActiveIndex + direction + Images.Count) % Images.Count].Id;
    }
    private void CarouselKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft") MovePhoto(-1);
        else if (args.Key == "ArrowRight") MovePhoto(1);
    }

    public async Task CommitAsync()
    {
        Normalize();
        foreach (var image in removed)
            await ImagePicker.DeleteAsync(image);
        removed.Clear();
        pending.Clear();
    }

    public async Task DeleteAllAsync()
    {
        foreach (var image in Images.Concat(removed).DistinctBy(item => item.Id).ToList())
            await ImagePicker.DeleteAsync(image);
        Images.Clear();
        pending.Clear();
        removed.Clear();
    }

    private async Task PickAsync()
    {
        busy = true;
        hasError = false;
        message = null;
        try
        {
            var image = await ImagePicker.PickAsync(OwnerId);
            if (image is null)
                return;
            image.SortOrder = Images.Count;
            image.IsMain = Images.Count == 0;
            Images.Add(image);
            pending.Add(image);
            activeImageId = image.Id;
            Normalize();
            await ImagesChanged.InvokeAsync();
            message = "Фотография добавлена. Сохраните изменения.";
        }
        catch (Exception exception)
        {
            hasError = true;
            message = UserErrors.Describe(exception, "Не удалось добавить фотографию. Попробуйте другой файл.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AddUrlAsync()
    {
        hasError = false;
        message = null;
        if (!Uri.TryCreate(imageUrl?.Trim(), UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https"))
        {
            hasError = true;
            message = "Укажите полную ссылку на изображение с https://.";
            return;
        }

        var fileName = Path.GetFileName(uri.AbsolutePath);
        var image = new ProductImage
        {
            FileName = string.IsNullOrWhiteSpace(fileName) ? "external-image" : fileName,
            ContentType = "image/*",
            Storage = ProductImageStorage.External,
            StorageKey = uri.ToString(),
            Url = uri.ToString(),
            SortOrder = Images.Count,
            IsMain = Images.Count == 0
        };
        Images.Add(image);
        pending.Add(image);
        activeImageId = image.Id;
        imageUrl = null;
        Normalize();
        await ImagesChanged.InvokeAsync();
        message = "Ссылка добавлена. Сохраните изменения.";
    }

    private async Task SetMainAsync(ProductImage selected)
    {
        activeImageId = selected.Id;
        foreach (var image in Images)
            image.IsMain = image.Id == selected.Id;
        Normalize();
        await ImagesChanged.InvokeAsync();
    }

    private async Task ConfirmRemovalAsync()
    {
        var image = removalCandidate;
        removalCandidate = null;
        if (image is null || !Images.Contains(image)) return;
        await RemoveAsync(image);
        hasError = false;
        message = "Фотография будет окончательно удалена после сохранения изменений в карточке.";
    }

    private async Task RemoveAsync(ProductImage image)
    {
        var index = ActiveIndex;
        Images.Remove(image);
        activeImageId = OrderedImages.ElementAtOrDefault(Math.Min(index, Images.Count - 1))?.Id;
        removed.Add(image);
        Normalize();
        await ImagesChanged.InvokeAsync();
    }

    private void OpenPreview(ProductImage image) => preview = image;

    private void ClosePreview() => preview = null;

    private void PreviewChanged(ProductImage image)
    {
        preview = image;
        activeImageId = image.Id;
    }

    private void Normalize()
    {
        var ordered = Images.OrderBy(item => item.SortOrder).ThenBy(item => item.CreatedAt).ToList();
        Images.Clear();
        Images.AddRange(ordered);
        for (var index = 0; index < Images.Count; index++)
            Images[index].SortOrder = index;
        if (Images.Count > 0 && Images.All(item => !item.IsMain))
            Images[0].IsMain = true;
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var image in pending)
            await ImagePicker.DeleteAsync(image);
        pending.Clear();
    }
}
