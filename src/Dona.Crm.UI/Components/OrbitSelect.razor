@typeparam TValue
@inherits InputBase<TValue>
@implements IAsyncDisposable
@using System.Diagnostics.CodeAnalysis
@using Microsoft.JSInterop
@inject IJSRuntime JS

<button type="button"
        id="@triggerId"
        class="dona-select-trigger @(CssClass) @(SelectedOption is null ? "dona-select-trigger--empty" : null)"
        disabled="@Disabled"
        role="combobox"
        aria-label="@AriaLabel"
        aria-expanded="@(open ? "true" : "false")"
        aria-controls="@dialogId"
        aria-haspopup="listbox"
        @onclick="Open"
        @onkeydown="TriggerKeyDown">
    <span>@(SelectedOption?.Label ?? Placeholder)</span>
    <OrbitIcon Name="down" />
</button>

@if (open)
{
    <OrbitModalLock>
        <div class="dona-modal orbit-select-overlay" role="presentation" @onclick="Close" @onclick:preventDefault="true">
            <section id="@dialogId"
                     class="dona-modal__dialog orbit-select-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="@titleId"
                     tabindex="-1"
                     @onclick:stopPropagation="true"
                     @onkeydown="DialogKeyDown">
                <header class="dona-modal__header">
                    <div><small class="dona-modal__eyebrow">Выбор значения</small><h2 class="dona-modal__title" id="@titleId">@Title</h2></div>
                    <button type="button" class="dona-modal__close" aria-label="Закрыть список" @onclick="Close" @onclick:preventDefault="true"><OrbitIcon Name="close" /></button>
                </header>
                @if (Searchable || Options.Count > SearchThreshold)
                {
                    <input class="orbit-select-search"
                           type="search"
                           value="@query"
                           placeholder="Поиск"
                           aria-label="Поиск по вариантам"
                           autocomplete="off"
                           autofocus
                           @oninput="Search" />
                }
                <div class="dona-modal__body orbit-select-options" role="listbox" aria-label="@Title">
                    @foreach (var option in FilteredOptions)
                    {
                        var selected = IsSelected(option);
                        <button type="button"
                                role="option"
                                aria-selected="@(selected ? "true" : "false")"
                                class="@(selected ? "selected" : null)"
                                @onclick="() => SelectAsync(option)">
                            <span><strong>@option.Label</strong>@if (!string.IsNullOrWhiteSpace(option.Description)){<small>@option.Description</small>}</span>
                            <i aria-hidden="true"></i>
                        </button>
                    }
                    @if (FilteredOptions.Count == 0)
                    {
                        <p class="orbit-select-empty">Подходящих вариантов нет.</p>
                    }
                </div>
                @if (Footer is not null)
                {
                    <div class="dona-modal__footer orbit-select-footer">@Footer</div>
                }
            </section>
        </div>
    </OrbitModalLock>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<OrbitSelectOption<TValue>> Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = "Не выбрано";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Searchable { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int SearchThreshold { get; set; } = 8;
    [Parameter] public RenderFragment? Footer { get; set; }

    private readonly string triggerId = $"orbit-select-trigger-{Guid.NewGuid():N}";
    private bool focusPending;
    private bool returnFocus;
    private readonly string dialogId = $"orbit-select-{Guid.NewGuid():N}";
    private readonly string titleId = $"orbit-select-title-{Guid.NewGuid():N}";
    private bool open;
    private string query = string.Empty;
    private string Title => Label ?? AriaLabel ?? "Выберите значение";
    private OrbitSelectOption<TValue>? SelectedOption => Options.FirstOrDefault(IsSelected);
    private IReadOnlyList<OrbitSelectOption<TValue>> FilteredOptions =>
        string.IsNullOrWhiteSpace(query)
            ? Options
            : Options.Where(option =>
                option.Label.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                (option.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private bool IsSelected(OrbitSelectOption<TValue> option) =>
        EqualityComparer<TValue>.Default.Equals(option.Value, CurrentValue);

    private void Open()
    {
        if (Disabled)
            return;
        query = string.Empty;
        open = true;
        focusPending = true;
    }

    private void Close()
    {
        if (open)
            returnFocus = true;
        open = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (open && focusPending)
            {
                focusPending = false;
                await JS.InvokeVoidAsync("orbitModal.openSelect", triggerId, dialogId);
            }
            else if (!open && returnFocus)
            {
                returnFocus = false;
                await JS.InvokeVoidAsync("orbitModal.closeSelect", dialogId);
                await JS.InvokeVoidAsync("orbitModal.focusElement", triggerId);
            }
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }
    }
    public async ValueTask DisposeAsync()
    {
        ((IDisposable)this).Dispose();
        try { await JS.InvokeVoidAsync("orbitModal.closeSelect", dialogId); }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { }
    }
    public void CloseDialog() => Close();

    private async Task SelectAsync(OrbitSelectOption<TValue> option)
    {
        CurrentValue = option.Value;
        Close();
        await InvokeAsync(StateHasChanged);
    }

    private void Search(ChangeEventArgs args) => query = args.Value?.ToString() ?? string.Empty;

    private void TriggerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " " or "ArrowDown")
            Open();
    }

    private void DialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            Close();
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = null;
        return true;
    }
}
