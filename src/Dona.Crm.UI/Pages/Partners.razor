@page "/partners"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICommerceRepository Commerce
@inject ICatalogRepository Catalog
@inject IPurchaseHistoryRepository PurchaseHistory
@inject SupplierAnalyticsService SupplierAnalytics
@inject IntermediaryAnalyticsService IntermediaryAnalytics

<PageTitle>Партнёры — DONA CRM</PageTitle>
<div class="dona-page dona-page--wide">
    <header class="dona-page-header">
        <div class="dona-heading">
            <a class="dona-icon-button dona-back-button dona-back-button--section" href="/more" aria-label="Вернуться в меню"><OrbitIcon Name="back" /></a>
            <div>
                <p>Ещё</p>
                <h1 class="dona-title">Партнёры</h1>
            </div>
        </div>
        @if (!Editing)
        {
            <button class="dona-icon-button dona-add-button" type="button" aria-label="Добавить партнёра" @onclick="NewPartner"><OrbitIcon Name="plus" /></button>
        }
    </header>
    <div class="dona-tabs" role="group" aria-label="Тип партнёра">
        <button type="button"
                class="@(mode == PartnerMode.Supplier ? "active" : null)"
                aria-pressed="@(mode == PartnerMode.Supplier)"
                @onclick="() => SwitchMode(PartnerMode.Supplier)">Поставщики <span>@suppliers.Count</span></button>
        <button type="button"
                class="@(mode == PartnerMode.Intermediary ? "active" : null)"
                aria-pressed="@(mode == PartnerMode.Intermediary)"
                @onclick="() => SwitchMode(PartnerMode.Intermediary)">Посредники <span>@intermediaries.Count</span></button>
    </div>
    @if (errorMessage is not null && !Editing)
    {
        <p class="dona-message dona-message--error" role="alert">@errorMessage</p>
    }
    @if (loading)
    {
        <div class="dona-state">Загружаем партнёров…</div>
    }
    else if (editingSupplier is not null)
    {
        <EditForm Model="editingSupplier" OnValidSubmit="SaveSupplierAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <section class="dona-section">
                <div class="dona-section-title">
                    <div>
                        <p class="dona-eyebrow">Поставщик</p>
                        <h2>@(isNew ? "Новая карточка" : editingSupplier.Name)</h2>
                    </div>
                    <button type="button" aria-label="Закрыть редактор" @onclick="CloseEditor">×</button>
                </div>
                <label class="dona-field">
                    Название
                    <InputText @bind-Value="editingSupplier.Name" />
                    <ValidationMessage For="() => editingSupplier.Name" />
                </label>
                <div class="dona-field-row">
                    <label class="dona-field">Площадка<OrbitSelect TValue="string" @bind-Value="editingSupplier.Platform" Options="@PlatformOptions" Label="Торговая площадка" /></label>
                    <label class="dona-field">Минимальный заказ (справочно), шт.<InputNumber @bind-Value="editingSupplier.Moq" min="0" /></label>
                </div>
                <label class="dona-field">Ссылка магазина<InputText @bind-Value="editingSupplier.StoreUrl" inputmode="url" /></label>
                <div class="dona-field-row">
                    <label class="dona-field">Рейтинг 0–5<InputNumber @bind-Value="editingSupplier.Rating" min="0" max="5" step="0.1" /></label>
                    <label class="dona-field">WeChat<InputText @bind-Value="editingSupplier.WeChat" /></label>
                </div>
                <label class="dona-field">Контакт<InputText @bind-Value="editingSupplier.Contact" /></label>
                <label class="dona-field">Посредник по умолчанию<OrbitSelect TValue="Guid?" @bind-Value="editingSupplier.DefaultIntermediaryId" Options="@DefaultIntermediaryOptions" Label="Посредник по умолчанию" /></label>
                <label class="dona-field dona-toggle"><InputCheckbox @bind-Value="editingSupplier.IsArchived" /><span>В архиве — сохраняется в истории, не предлагается для новых закупок</span></label>
                <label class="dona-field">Заметки<InputTextArea @bind-Value="editingSupplier.Notes" /></label>
                @if (errorMessage is not null)
                {
                    <p class="dona-message dona-message--error" role="alert">@errorMessage</p>
                }
                <div class="dona-actions">
                    @if (confirmDelete)
                    {
                        <div class="dona-confirm dona-confirm--boxed">
                            <span>Удалить поставщика? История закупок сохранится.</span>
                            <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => confirmDelete = false">Нет</button>
                            <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="DeleteSupplierAsync">Да, удалить</button>
                        </div>
                    }
                    <button type="button" class="dona-btn dona-btn--secondary" @onclick="CloseEditor">Отмена</button>
                    @if (!isNew && !confirmDelete)
                    {
                        <button type="button" class="dona-btn dona-btn--danger" @onclick="() => confirmDelete = true">Удалить</button>
                    }
                    <button class="dona-btn dona-btn--primary" disabled="@saving">Сохранить</button>
                </div>
            </section>
        </EditForm>
    }
    else if (editingIntermediary is not null)
    {
        <EditForm Model="editingIntermediary" OnValidSubmit="SaveIntermediaryAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <section class="dona-section">
                <div class="dona-section-title">
                    <div>
                        <p class="dona-eyebrow">Посредник</p>
                        <h2>@(isNew ? "Новая карточка" : editingIntermediary.Name)</h2>
                    </div>
                    <button type="button" aria-label="Закрыть редактор" @onclick="CloseEditor">×</button>
                </div>
                <label class="dona-field">
                    Название
                    <InputText @bind-Value="editingIntermediary.Name" />
                    <ValidationMessage For="() => editingIntermediary.Name" />
                </label>
                <label class="dona-field">Компания<InputText @bind-Value="editingIntermediary.Company" /></label>
                <label class="dona-field dona-toggle"><InputCheckbox @bind-Value="editingIntermediary.IsArchived" /><span>В архиве — сохраняется в истории, не предлагается для новых закупок</span></label>
                <label class="dona-field">Адрес склада в Китае<InputTextArea @bind-Value="editingIntermediary.ChinaWarehouseAddress" /></label>
                <div class="dona-field-row">
                    <label class="dona-field">Контактное лицо<InputText @bind-Value="editingIntermediary.ContactName" /></label>
                    <label class="dona-field">Телефон<InputText @bind-Value="editingIntermediary.Phone" inputmode="tel" /></label>
                </div>
                <div class="dona-field-row">
                    <label class="dona-field">Telegram<InputText @bind-Value="editingIntermediary.Telegram" /></label>
                    <label class="dona-field">WeChat<InputText @bind-Value="editingIntermediary.WeChat" /></label>
                </div>
                <div class="dona-field-row">
                    <label class="dona-field">Тариф, $/кг<InputNumber @bind-Value="editingIntermediary.RatePerKgUsd" min="0" step="0.01" /></label>
                    <label class="dona-field">Комиссия от стоимости товаров, %<InputNumber @bind-Value="editingIntermediary.CommissionPercent" min="0" max="100" step="0.1" /></label>
                </div>
                <div class="dona-field-row">
                    <label class="dona-field">Минимально оплачиваемый вес, кг<InputNumber @bind-Value="editingIntermediary.MinimumWeightKg" min="0" step="0.1" /></label>
                    <label class="dona-field">Срок, дней<InputNumber @bind-Value="editingIntermediary.EstimatedDays" min="0" /></label>
                </div>
                <label class="dona-field">Рейтинг 0–5<InputNumber @bind-Value="editingIntermediary.Rating" min="0" max="5" step="0.1" /></label>
                <label class="dona-field dona-toggle">
                    <InputCheckbox @bind-Value="editingIntermediary.OfficialImport" />
                    <span><strong>Официальный импорт</strong><small>Посредник предоставляет документы</small></span>
                </label>
                <label class="dona-field">Заметки<InputTextArea @bind-Value="editingIntermediary.Notes" /></label>
                @if (errorMessage is not null)
                {
                    <p class="dona-message dona-message--error" role="alert">@errorMessage</p>
                }
                <div class="dona-actions">
                    @if (confirmDelete)
                    {
                        <div class="dona-confirm dona-confirm--boxed">
                            <span>Удалить посредника? История закупок сохранится.</span>
                            <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => confirmDelete = false">Нет</button>
                            <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="DeleteIntermediaryAsync">Да, удалить</button>
                        </div>
                    }
                    <button type="button" class="dona-btn dona-btn--secondary" @onclick="CloseEditor">Отмена</button>
                    @if (!isNew && !confirmDelete)
                    {
                        <button type="button" class="dona-btn dona-btn--danger" @onclick="() => confirmDelete = true">Удалить</button>
                    }
                    <button class="dona-btn dona-btn--primary" disabled="@saving">Сохранить</button>
                </div>
            </section>
        </EditForm>
    }
    else
    {
        <div class="dona-search partner-search"><label for="partner-search">Поиск</label><input id="partner-search" placeholder="Название, компания или контакт" @bind="query" @bind:event="oninput" /></div>
        @if (mode == PartnerMode.Supplier)
        {
            @if (!FilteredSuppliers.Any())
            {
                <div class="dona-state">
                    <strong>Поставщиков пока нет</strong>
                    <p>Добавьте магазин, чтобы выбирать его в закупках.</p>
                </div>
            }
            else
            {
                <ul class="partner-list">
                    @foreach (var value in FilteredSuppliers.OrderBy(item => item.Name))
                    {
                        var actual = SupplierActual(value.Id);
                        <li>
                            <button type="button" class="dona-list-row" @onclick="() => EditSupplier(value)">
                                <InitialBadge Text="@value.Name" />
                                <span>
                                    <strong>@value.Name @(value.IsArchived ? "— в архиве" : null)</strong>
                                    <small>@SupplierMeta(value)</small>
                                    <em>@Contact(value.Contact, value.WeChat)</em>
                                </span>
                                <span class="dona-list-row__value">@Score(actual?.ReliabilityScore)<small>надёжность</small></span>
                            </button>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            @if (!FilteredIntermediaries.Any())
            {
                <div class="dona-state">
                    <strong>Посредников пока нет</strong>
                    <p>Добавьте логистического партнёра для поставок из Китая.</p>
                </div>
            }
            else
            {
                <ul class="partner-list">
                    @foreach (var value in FilteredIntermediaries.OrderBy(item => item.Name))
                    {
                        var actual = IntermediaryActual(value.Id);
                        <li>
                            <button type="button" class="dona-list-row" @onclick="() => EditIntermediary(value)">
                                <InitialBadge Text="@value.Name" Variant="success" />
                                <span>
                                    <strong>@value.Name @(value.IsArchived ? "— в архиве" : null)</strong>
                                    <small>@IntermediaryMeta(value)</small>
                                    <em>@Contact(value.ContactName, value.Telegram, value.Phone)</em>
                                </span>
                                <span class="dona-list-row__value">@Score(actual?.ReliabilityScore)<small>надёжность</small></span>
                            </button>
                        </li>
                    }
                </ul>
            }
        }
    }
</div>
@code {
    private IReadOnlyList<Supplier> suppliers = [];
    private IReadOnlyList<Intermediary> intermediaries = [];
    private IReadOnlyList<Purchase> purchases = [];
    private IReadOnlyList<SupplierAnalytics> supplierMetrics = [];
    private IReadOnlyList<IntermediaryAnalytics> intermediaryMetrics = [];
    private Supplier? editingSupplier;
    private Intermediary? editingIntermediary;
    private UnsavedChangesGuard? unsavedGuard;
    private PartnerMode mode;
    private string query = string.Empty;
    private bool loading = true;
    private bool saving;
    private bool isNew;
    private bool confirmDelete;
    private string? errorMessage;
    private bool Editing => editingSupplier is not null || editingIntermediary is not null;
    private IReadOnlyList<OrbitSelectOption<Guid?>> DefaultIntermediaryOptions =>
        [new(null, "Не выбран"), .. intermediaries.Where(x => !x.IsArchived || x.Id == editingSupplier?.DefaultIntermediaryId)
            .Select(x => new OrbitSelectOption<Guid?>(x.Id, x.Name + (x.IsArchived ? " — в архиве" : "")))];

    private static readonly IReadOnlyList<OrbitSelectOption<string>> PlatformOptions =
        OrbitSelectOptions.OptionalStrings(["1688", "Taobao", "Alibaba", "Pinduoduo", "Другая"], "Не выбрана");

    private IEnumerable<Supplier> FilteredSuppliers => suppliers.Where(value =>
        string.IsNullOrWhiteSpace(query)
        || value.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
        || (value.Contact?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
        || (value.WeChat?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<Intermediary> FilteredIntermediaries => intermediaries.Where(value =>
        string.IsNullOrWhiteSpace(query)
        || value.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
        || (value.Company?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
        || (value.ContactName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
        || (value.Telegram?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            var supplierTask = Commerce.GetSuppliersAsync();
            var intermediaryTask = Commerce.GetIntermediariesAsync();
            var purchaseTask = Commerce.GetPurchasesAsync();
            var historyTask = PurchaseHistory.GetAsync();
            await Task.WhenAll(supplierTask, intermediaryTask, purchaseTask, historyTask);
            suppliers = await supplierTask;
            intermediaries = await intermediaryTask;
            purchases = await purchaseTask;
            supplierMetrics = SupplierAnalytics.Calculate(suppliers, purchases, await historyTask);
            intermediaryMetrics = IntermediaryAnalytics.Calculate(intermediaries, purchases);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось загрузить партнёров. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SwitchMode(PartnerMode value)
    {
        try
        {
            if (unsavedGuard is not null && !await unsavedGuard.ConfirmDiscardAsync())
            {
                return;
            }

            CloseEditorCore();
            mode = value;
            query = string.Empty;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось переключить раздел. Попробуйте ещё раз.");
        }
    }

    private void NewPartner()
    {
        isNew = true;
        confirmDelete = false;
        errorMessage = null;
        if (mode == PartnerMode.Supplier)
        {
            editingSupplier = new Supplier();
        }
        else
        {
            editingIntermediary = new Intermediary();
        }
    }

    private void EditSupplier(Supplier value)
    {
        editingSupplier = new Supplier
        {
            Id = value.Id,
            Name = value.Name,
            Platform = value.Platform,
            StoreUrl = value.StoreUrl,
            Rating = value.Rating,
            Moq = value.Moq,
            Contact = value.Contact,
            WeChat = value.WeChat,
            Intermediary = value.Intermediary,
            DefaultIntermediaryId = value.DefaultIntermediaryId,
            IsArchived = value.IsArchived,
            Notes = value.Notes,
            CreatedAt = value.CreatedAt
        };
        isNew = false;
        confirmDelete = false;
        errorMessage = null;
    }

    private void EditIntermediary(Intermediary value)
    {
        editingIntermediary = new Intermediary
        {
            Id = value.Id,
            Name = value.Name,
            Company = value.Company,
            IsArchived = value.IsArchived,
            ChinaWarehouseAddress = value.ChinaWarehouseAddress,
            ContactName = value.ContactName,
            Telegram = value.Telegram,
            WeChat = value.WeChat,
            Phone = value.Phone,
            RatePerKgUsd = value.RatePerKgUsd,
            CommissionPercent = value.CommissionPercent,
            MinimumWeightKg = value.MinimumWeightKg,
            EstimatedDays = value.EstimatedDays,
            Rating = value.Rating,
            OfficialImport = value.OfficialImport,
            Notes = value.Notes,
            CreatedAt = value.CreatedAt
        };
        isNew = false;
        confirmDelete = false;
        errorMessage = null;
    }

    private async Task CloseEditor()
    {
        try
        {
            if (unsavedGuard is not null && !await unsavedGuard.ConfirmDiscardAsync())
            {
                return;
            }

            CloseEditorCore();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось закрыть редактор. Попробуйте ещё раз.");
        }
    }

    private void CloseEditorCore()
    {
        editingSupplier = null;
        editingIntermediary = null;
        confirmDelete = false;
        errorMessage = null;
    }

    private async Task SaveSupplierAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        try
        {
            await Commerce.UpsertSupplierAsync(editingSupplier!);
            unsavedGuard?.MarkClean();
            CloseEditorCore();
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось сохранить поставщика. Попробуйте ещё раз.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveIntermediaryAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        try
        {
            await Commerce.UpsertIntermediaryAsync(editingIntermediary!);
            unsavedGuard?.MarkClean();
            CloseEditorCore();
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось сохранить посредника. Попробуйте ещё раз.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteSupplierAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        try
        {
            var count = (await Commerce.GetPurchasesAsync()).Count(value => value.SupplierId == editingSupplier!.Id);
            count += (await Catalog.GetProductsAsync()).Count(value => value.PreferredSupplierId == editingSupplier!.Id);
            if (count > 0)
            {
                confirmDelete = false;
                errorMessage = $"Поставщик используется в закупках или товарах ({count}). Переведите его в архив.";
                return;
            }

            await Commerce.DeleteSupplierAsync(editingSupplier!.Id);
            unsavedGuard?.MarkClean();
            CloseEditorCore();
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            confirmDelete = false;
            errorMessage = UserErrors.Describe(exception, "Не удалось удалить поставщика. Попробуйте ещё раз.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteIntermediaryAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        try
        {
            var count = (await Commerce.GetPurchasesAsync()).Count(value => value.IntermediaryId == editingIntermediary!.Id);
            count += (await Commerce.GetSuppliersAsync()).Count(value => value.DefaultIntermediaryId == editingIntermediary!.Id);
            if (count > 0)
            {
                confirmDelete = false;
                errorMessage = $"Посредник используется в закупках или поставщиках ({count}). Переведите его в архив.";
                return;
            }

            await Commerce.DeleteIntermediaryAsync(editingIntermediary!.Id);
            unsavedGuard?.MarkClean();
            CloseEditorCore();
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            confirmDelete = false;
            errorMessage = UserErrors.Describe(exception, "Не удалось удалить посредника. Попробуйте ещё раз.");
        }
        finally
        {
            saving = false;
        }
    }

    private SupplierAnalytics? SupplierActual(Guid id) => supplierMetrics.FirstOrDefault(value => value.SupplierId == id);

    private IntermediaryAnalytics? IntermediaryActual(Guid id) => intermediaryMetrics.FirstOrDefault(value => value.IntermediaryId == id);

    private static string Score(decimal? value) =>
        value is null ? "—" : value.Value.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));

    private static string SupplierMeta(Supplier value) =>
        $"{(string.IsNullOrWhiteSpace(value.Platform) ? "Площадка не указана" : value.Platform)} · Минимальный заказ {value.Moq?.ToString() ?? "—"}";

    private static string IntermediaryMeta(Intermediary value) =>
        $"{value.Company ?? "Без компании"} · {(value.RatePerKgUsd is null ? "тариф не указан" : $"${value.RatePerKgUsd:N2}/кг")}";

    private static string Contact(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "Контакт не указан";

    private enum PartnerMode
    {
        Supplier,
        Intermediary
    }
}
