@page "/purchases/new"
@page "/purchases/{Id:guid}"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICommerceRepository Commerce
@inject ICatalogRepository Catalog
@inject PurchaseReceivingService Receiving
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Новая закупка" : purchase.Number) — DONA CRM</PageTitle>
<div class="dona-page dona-page--form">
    <header class="dona-page-header dona-page-header--back dona-heading">
        <a class="dona-icon-button dona-back-button" href="/purchases" aria-label="Вернуться к закупкам"><OrbitIcon Name="back" /></a>
        <div>
            <p>@purchase.Status.Display()</p>
            <h1>@(IsNew ? "Новая закупка" : purchase.Number)</h1>
        </div>
    </header>
    @if (loading)
    {
        <div class="dona-state">Загружаем закупку…</div>
    }
    else if (error is not null)
    {
        <div class="dona-state dona-state--error" role="alert">@error</div>
    }
    else
    {
        @if (!IsNew)
        {
            <ol class="purchase-flow" aria-label="Этап закупки">
                @foreach (var value in Flow)
                {
                    <li class="@FlowClass(value)">@value.Display()</li>
                }
            </ol>
        }
        <EditForm class="dona-stack" Model="purchase" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <section class="dona-section">
                <h2>Поставка</h2>
                <div class="dona-field-row">
                    <label class="dona-field">Номер<InputText @bind-Value="purchase.Number" /></label>
                    <label class="dona-field">Статус<OrbitSelect TValue="PurchaseStatus?" @bind-Value="purchase.Status" Options="@PurchaseStatusOptions" Label="Статус закупки" /></label>
                </div>
                <label class="dona-field">Поставщик<OrbitSelect TValue="Guid?" @bind-Value="purchase.SupplierId" @bind-Value:after="SupplierChanged" Options="@SupplierOptions" Label="Поставщик" Searchable="true" /></label>
                <details open="@(purchase.IntermediaryId is not null)">
                    <summary>Посредник — если участвует</summary>
                    <label class="dona-field">Посредник<OrbitSelect TValue="Guid?" @bind-Value="purchase.IntermediaryId" @bind-Value:after="IntermediaryChanged" Options="@IntermediaryOptions" Label="Посредник" Searchable="true" /></label>
                </details>
                <a class="manage-partners" href="/partners">Управлять поставщиками и посредниками →</a>
                <div class="dona-field-row">
                    <label class="dona-field">Трек-код<InputText @bind-Value="purchase.TrackingCode" /></label>
                    <label class="dona-field">Ожидаемая дата<OrbitDatePicker @bind-Value="purchase.EstimatedDeliveryDate" ValueChangedAfter="_ => unsavedGuard?.MarkDirty()" /></label>
                </div>
                <label class="dona-field">Заметка<InputTextArea @bind-Value="purchase.Notes" /></label>
            </section>
            <section class="dona-section">
                <div class="dona-section-title">
                    <div>
                        <h2>Стоимость партии</h2>
                        <p>@purchase.TotalQuantity ед. · @(purchase.IsCostFinalized ? "Все расходы учтены" : "Предварительная себестоимость")</p>
                    </div>
                </div>
                <div class="dona-field-row">
                    <label class="dona-field">Валюта<OrbitSelect TValue="string" @bind-Value="purchase.CurrencyCode" @bind-Value:after="PurchaseCurrencyChanged" Options="@CurrencyOptions" Label="Валюта закупки" /></label>
                    @if (purchase.CurrencyCode != "UZS")
                    {
                        <label class="dona-field">Курс в UZS<InputNumber @bind-Value="purchase.CnyRateUzs" min="0" /></label>
                    }
                </div>
                @if (HasLegacyCosts)
                {
                    <details open>
                        <summary>Ранее указанные расходы — уже включены в итог</summary>
                        <div class="cost-grid">
                            <label class="dona-field">Комиссия, %<InputNumber @bind-Value="purchase.AgentCommissionPercent" min="0" /></label>
                            <label class="dona-field">Доставка по весу, UZS<InputNumber @bind-Value="purchase.InternationalShippingUzs" min="0" /></label>
                            <label class="dona-field">Другие расходы, UZS<InputNumber @bind-Value="purchase.OtherCostsUzs" min="0" /></label>
                        </div>
                    </details>
                }
                <div class="dona-section-title">
                    <h3>Дополнительные расходы</h3>
                    <button type="button" @onclick="AddExpense">Добавить расход</button>
                </div>
                @if (purchase.Expenses.Count == 0 && !HasLegacyCosts)
                {
                    <p>Если расходов нет, себестоимость равна закупочной цене.</p>
                }
                @foreach (var expense in purchase.Expenses)
                {
                    <article class="expense-line" @key="expense.Id">
                        <label class="dona-field">Название<InputText @bind-Value="expense.Name" placeholder="Например, доставка" /></label>
                        <div class="dona-field-row">
                            <label class="dona-field">Сумма<InputNumber @bind-Value="expense.Amount" min="0" /></label>
                            <label class="dona-field">Валюта<OrbitSelect TValue="string" @bind-Value="expense.CurrencyCode" @bind-Value:after="() => ExpenseCurrencyChanged(expense)" Options="@CurrencyOptions" Label="Валюта расхода" /></label>
                        </div>
                        @if (expense.CurrencyCode != "UZS")
                        {
                            <label class="dona-field">Курс этого расхода в UZS<InputNumber @bind-Value="expense.RateUzs" min="0" /></label>
                        }
                        <details>
                            <summary>Распределение: @AllocationLabel(expense.Allocation)</summary>
                            <label class="dona-field">Как распределить<OrbitSelect TValue="ExpenseAllocation" @bind-Value="expense.Allocation" Options="@AllocationOptions" Label="Распределение расхода" /></label>
                            @if (expense.Allocation == ExpenseAllocation.Item)
                            {
                                <label class="dona-field">На какую позицию<OrbitSelect TValue="Guid?" @bind-Value="expense.PurchaseItemId" Options="@ExpenseItemOptions" Label="Позиция для расхода" /></label>
                            }
                        </details>
                        <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => RemoveExpense(expense)">Убрать расход</button>
                    </article>
                }
                <div class="cost-summary">
                    @if (purchase.HasCompleteCostInputs)
                    {
                        <span>Товары<strong>@Money(purchase.GoodsCostUzs) UZS</strong></span>
                        <span>Дополнительные расходы<strong>@Money(purchase.AdditionalCostsUzs) UZS</strong></span>
                        <span class="total">Итого<strong>@Money(purchase.TotalCostUzs) UZS</strong></span>
                    }
                    else
                    {
                        <p role="status">Для расчета заполните цены, количество, курсы и настройки расходов.</p>
                    }
                </div>
                <label class="cost-confirm"><InputCheckbox @bind-Value="purchase.IsCostFinalized" /> Все расходы учтены</label>
                <p class="cost-hint">Доставку можно добавить позже и пересчитать себестоимость.</p>
                @if (purchase.Receipts.Count > 0)
                {
                    <p class="cost-hint">Изменения обновят историю приемок и стоимость товара, если эта закупка задает его текущую цену. Себестоимость уже оформленных продаж сохранится.</p>
                }
            </section>
            <section class="dona-section">
                <div class="dona-section-title">
                    <div>
                        <h2>Позиции</h2>
                        <p>Товары и варианты</p>
                    </div>
                    <button type="button" @onclick="AddItem"><OrbitIcon Name="plus" Class="dona-inline-icon" />Позиция</button>
                </div>
                @if (purchase.Items.Count == 0)
                {
                    <p class="dona-empty">Добавьте хотя бы одну позицию.</p>
                }
                @foreach (var item in purchase.Items)
                {
                    <article class="purchase-line" @key="item.Id">
                        <label class="dona-field">Товар<ProductAutocomplete Products="products" Value="item.ProductId" OnSelected="product => ProductChanged(item, product)" /></label>
                        <label class="dona-field">Вариант<OrbitSelect TValue="Guid?" @bind-Value="item.ProductVariantId" @bind-Value:after="() => VariantChanged(item)" Options="@VariantOptions(item)" Label="Вариант товара" /></label>
                        <div class="line-fields">
                            <label class="dona-field">Количество<InputNumber @bind-Value="item.Quantity" min="1" /></label>
                            <label class="dona-field">Цена, @CurrencyCodes.Symbol(purchase.CurrencyCode)<InputNumber @bind-Value="item.UnitPriceCny" min="0" /></label>
                            @if (purchase.NeedsWeight)
                            {
                                <label class="dona-field">Вес ед., кг<InputNumber @bind-Value="item.UnitWeightKg" min="0" step="0.01" /></label>
                            }
                        </div>
                        @if (purchase.HasCompleteCostInputs)
                        {
                            <details class="unit-cost">
                                <summary>Себестоимость: @Money(purchase.ItemUnitLandedCostUzs(item)) UZS / ед.</summary>
                                <p>Товары: @Money(purchase.ItemGoodsCostUzs(item)) UZS. Расходы: @Money(purchase.ItemLandedCostUzs(item) - purchase.ItemGoodsCostUzs(item)) UZS. Всего за позицию: @Money(purchase.ItemLandedCostUzs(item)) UZS.</p>
                            </details>
                        }
                        @if ((item.ReceivedQuantity ?? 0) > 0)
                        {
                            <div class="received-note">Получено @(item.ReceivedQuantity ?? 0) · брак @(item.DefectQuantity ?? 0) · на складе @item.StockedQuantity</div>
                        }
                        else if (removeCandidate == item.Id)
                        {
                            <div class="dona-confirm dona-confirm--boxed">
                                <span>Удалить позицию?</span>
                                <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => removeCandidate = null">Нет</button>
                                <button type="button" class="dona-btn dona-btn--danger" @onclick="() => RemoveItem(item)">Да, удалить</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="dona-btn dona-btn--danger" @onclick="() => removeCandidate = item.Id">Удалить позицию</button>
                        }
                    </article>
                }
            </section>
            @if (!IsNew && purchase.Status != PurchaseStatus.Cancelled && purchase.Items.Any(value => value.MissingQuantity > 0))
            {
                <section class="dona-section receipt-card">
                    <div class="dona-section-title">
                        <div>
                            <h2>Принять поставку</h2>
                            <p>Укажите фактически полученное</p>
                        </div>
                    </div>
                    <div class="dona-field-row">
                        <label class="dona-field">Дата<OrbitDatePicker @bind-Value="receiptDate" ValueChangedAfter="_ => unsavedGuard?.MarkDirty()" /></label>
                        <label class="dona-field">Комментарий<InputText @bind-Value="receiptNote" /></label>
                    </div>
                    @foreach (var item in purchase.Items.Where(value => value.MissingQuantity > 0))
                    {
                        var line = ReceiptInput(item.Id);
                        <article class="receipt-line">
                            <div>
                                <strong>@item.ProductName</strong>
                                <small>@VariantLabel(item) · осталось @item.MissingQuantity шт.</small>
                            </div>
                            <div class="dona-field-row">
                                <label class="dona-field">Получено<InputNumber @bind-Value="line.ReceivedQuantity" min="0" max="@item.MissingQuantity" /></label>
                                <label class="dona-field">Из них брак<InputNumber @bind-Value="line.DefectQuantity" min="0" /></label>
                            </div>
                        </article>
                    }
                    <button type="button" class="dona-btn dona-btn--ghost" disabled="@saving" @onclick="ReceiveAsync">Оформить приёмку</button>
                </section>
            }
            @if (purchase.Receipts.Count > 0)
            {
                <section class="dona-section">
                    <h2>История приёмок</h2>
                    <ul class="receipt-history">
                        @foreach (var value in purchase.Receipts.OrderByDescending(item => item.ReceivedAt))
                        {
                            <li>
                                <span>
                                    <strong>@value.ReceivedAt.ToLocalTime().ToString("dd.MM.yyyy · HH:mm")</strong>
                                    <small>@(value.Note ?? "Без комментария")</small>
                                </span>
                                <b>+@value.StockedQuantity<small>на склад</small></b>
                            </li>
                        }
                    </ul>
                </section>
            }
            <ValidationSummary />
            @if (purchase.CostRevisions.Count > 0)
            {
                <details class="dona-section">
                    <summary>История расчета</summary>
                    @foreach (var revision in purchase.CostRevisions.OrderByDescending(x => x.ChangedAt))
                    {
                        <p>@revision.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Money(revision.TotalCostUzs) UZS · @(revision.IsFinalized ? "Все расходы учтены" : "Предварительно")</p>
                    }
                </details>
            }
            @if (message is not null)
            {
                <p class="dona-message @(success ? "dona-message--success" : "dona-message--error")" role="status">@message</p>
            }
            <div class="dona-actions">
                <a class="dona-btn dona-btn--secondary" href="/purchases">Отмена</a>
                <button class="dona-btn dona-btn--primary" disabled="@saving">@(saving ? "Сохраняем…" : "Сохранить закупку")</button>
            </div>
        </EditForm>
    }
</div>
@code {
    [Parameter]
    public Guid? Id { get; set; }

    private Purchase purchase = new();
    private IReadOnlyList<Supplier> suppliers = [];
    private IReadOnlyList<Intermediary> intermediaries = [];
    private IReadOnlyList<Product> products = [];
    private readonly Dictionary<Guid, ReceiptFormLine> receiptLines = [];
    private Guid receiptId = Guid.NewGuid();
    private DateTime? receiptDate;
    private string? receiptNote;
    private Guid? removeCandidate;
    private UnsavedChangesGuard? unsavedGuard;
    private bool loading = true;
    private bool saving;
    private string? error;
    private string? message;
    private bool success;

    private static readonly PurchaseStatus[] Flow = [PurchaseStatus.Draft, PurchaseStatus.Ordered, PurchaseStatus.Shipped, PurchaseStatus.Received];

    private bool IsNew => Id is null;
    private bool HasLegacyCosts => purchase.AgentCommissionPercent > 0 || purchase.InternationalShippingUzs > 0 || purchase.OtherCostsUzs > 0;
    private static string AllocationLabel(ExpenseAllocation value) => value switch
    {
        ExpenseAllocation.Quantity => "по количеству",
        ExpenseAllocation.Weight => "по весу",
        ExpenseAllocation.Item => "на одну позицию",
        _ => "по стоимости товаров"
    };
    private static readonly IReadOnlyList<OrbitSelectOption<ExpenseAllocation>> AllocationOptions =
        OrbitSelectOptions.From(Enum.GetValues<ExpenseAllocation>(), AllocationLabel);
    private IReadOnlyList<OrbitSelectOption<Guid?>> ExpenseItemOptions =>
        [new(null, "Выберите позицию"), .. purchase.Items.Select(x => new OrbitSelectOption<Guid?>(x.Id, $"{x.ProductName} {VariantLabel(x)}"))];
    private void AddExpense()
    {
        purchase.Expenses.Add(new PurchaseExpense { CurrencyCode = purchase.CurrencyCode, RateUzs = purchase.CnyRateUzs });
        purchase.IsCostFinalized = false;
        unsavedGuard?.MarkDirty();
    }
    private void RemoveExpense(PurchaseExpense expense)
    {
        purchase.Expenses.Remove(expense);
        purchase.IsCostFinalized = false;
        unsavedGuard?.MarkDirty();
    }

    private static readonly IReadOnlyList<OrbitSelectOption<PurchaseStatus?>> PurchaseStatusOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<PurchaseStatus>(), "Не указан", value => value.Display());

    private static readonly IReadOnlyList<OrbitSelectOption<string>> CurrencyOptions =
        OrbitSelectOptions.From(CurrencyCodes.Supported, value => $"{value} · {CurrencyCodes.Symbol(value)}");

    private IReadOnlyList<OrbitSelectOption<Guid?>> SupplierOptions =>
        [new(null, "Не выбран"), .. suppliers.Select(value => new OrbitSelectOption<Guid?>(value.Id, value.Name))];

    private IReadOnlyList<OrbitSelectOption<Guid?>> IntermediaryOptions =>
        [new(null, "Не выбран"), .. intermediaries.Select(value => new OrbitSelectOption<Guid?>(value.Id, value.Name))];

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        try
        {
            var supplierTask = Commerce.GetSuppliersAsync();
            var intermediaryTask = Commerce.GetIntermediariesAsync();
            var productTask = Catalog.GetProductsAsync();
            var purchaseTask = Commerce.GetPurchasesAsync();
            await Task.WhenAll(supplierTask, intermediaryTask, productTask, purchaseTask);
            suppliers = await supplierTask;
            intermediaries = await intermediaryTask;
            products = (await productTask).Where(value => value.Status != ProductStatus.Archived).ToList();
            purchase = Id is null
                ? NewPurchase(await purchaseTask)
                : await Commerce.GetPurchaseAsync(Id.Value) ?? throw new InvalidOperationException("Закупка не найдена.");
            purchase.CurrencyCode = CurrencyCodes.Normalize(purchase.CurrencyCode, "CNY");
            ResetReceipt();
        }
        catch (Exception ex)
        {
            error = UserErrors.Describe(ex, "Не удалось загрузить закупку. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private static Purchase NewPurchase(IEnumerable<Purchase> existing)
    {
        var prefix = $"PO-{DateTime.Now:yyyyMMdd}";
        var used = existing.Select(value => value.Number).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var index = 1;
        while (used.Contains($"{prefix}-{index:000}"))
        {
            index++;
        }

        return new Purchase { Number = $"{prefix}-{index:000}", Status = PurchaseStatus.Draft, CurrencyCode = "CNY" };
    }

    private void AddItem()
    {
        purchase.Items.Add(new PurchaseItem { Quantity = 1 });
        unsavedGuard?.MarkDirty();
    }

    private void RemoveItem(PurchaseItem item)
    {
        purchase.Items.Remove(item);
        removeCandidate = null;
        unsavedGuard?.MarkDirty();
    }

    private IEnumerable<ProductVariant> Variants(PurchaseItem item) =>
        item.ProductId is null ? [] : products.FirstOrDefault(value => value.Id == item.ProductId)?.Variants ?? [];

    private void SupplierChanged()
    {
        purchase.SupplierName = purchase.SupplierId is null
            ? null
            : suppliers.FirstOrDefault(value => value.Id == purchase.SupplierId)?.Name;
    }

    private void IntermediaryChanged()
    {
        purchase.IntermediaryName = purchase.IntermediaryId is null
            ? null
            : intermediaries.FirstOrDefault(value => value.Id == purchase.IntermediaryId)?.Name;
    }

    private void ProductChanged(PurchaseItem item, Product? product)
    {
        item.ProductId = product?.Id;
        item.ProductName = product?.Name ?? string.Empty;
        item.UnitPriceCny = product?.PurchasePriceCny;
        item.ProductVariantId = null;
        item.Color = string.Empty;
        item.Size = string.Empty;
        if (product is not null && purchase.Items.All(value => value.Id == item.Id || value.ProductId is null))
        {
            purchase.CurrencyCode = CurrencyCodes.Normalize(product.PurchaseCurrencyCode, "CNY");
            purchase.CnyRateUzs = product.CnyRateUzs;
            CurrencyChanged();
        }

        unsavedGuard?.MarkDirty();
    }

    private IReadOnlyList<OrbitSelectOption<Guid?>> VariantOptions(PurchaseItem item) =>
        [new(null, "Не выбран"), .. Variants(item).Select(value => new OrbitSelectOption<Guid?>(value.Id, VariantName(value)))];

    private void VariantChanged(PurchaseItem item)
    {
        var value = Variants(item).FirstOrDefault(variant => variant.Id == item.ProductVariantId);
        item.Color = value?.Color ?? string.Empty;
        item.Size = value?.Size ?? string.Empty;
    }

    private void CurrencyChanged()
    {
        purchase.CurrencyCode = CurrencyCodes.Normalize(purchase.CurrencyCode, "CNY");
        if (purchase.CurrencyCode == "UZS")
        {
            purchase.CnyRateUzs = 1;
        }
    }

    private void PurchaseCurrencyChanged()
    {
        purchase.CnyRateUzs = purchase.CurrencyCode == "UZS" ? 1 : null;
        purchase.IsCostFinalized = false;
    }

    private void ExpenseCurrencyChanged(PurchaseExpense expense)
    {
        expense.RateUzs = expense.CurrencyCode == "UZS" ? 1
            : expense.CurrencyCode == purchase.CurrencyCode ? purchase.CnyRateUzs : null;
        purchase.IsCostFinalized = false;
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            ValidatePurchase();
            if ((await Commerce.GetPurchasesAsync()).Any(value =>
                    value.Id != purchase.Id && value.Number.Equals(purchase.Number, StringComparison.OrdinalIgnoreCase)))
            {
                throw new InvalidOperationException("Закупка с таким номером уже существует.");
            }

            await Receiving.SaveAsync(purchase);
            if (IsNew)
            {
                unsavedGuard?.MarkClean();
                Navigation.NavigateTo($"/purchases/{purchase.Id}");
            }
        }, "Закупка сохранена.");
    }

    private async Task ReceiveAsync()
    {
        await RunAsync(async () =>
        {
            ValidatePurchase();
            if (!purchase.HasCompleteCostInputs)
                throw new InvalidOperationException("Перед приемкой укажите закупочные цены, курсы и расходы.");
            await Receiving.SaveAsync(purchase);
            var input = receiptLines.Select(value =>
                new PurchaseReceiptInput(value.Key, value.Value.ReceivedQuantity ?? 0, value.Value.DefectQuantity ?? 0));
            DateTimeOffset? at = receiptDate is null
                ? null
                : new DateTimeOffset(receiptDate.Value.Date, TimeZoneInfo.Local.GetUtcOffset(receiptDate.Value.Date));
            var result = await Receiving.ReceiveAsync(purchase, input, receiptId, at, receiptNote);
            ResetReceipt();
            message = $"Принято: {result.AddedUnits} шт. на склад.";
        }, "Приёмка сохранена.");
    }

    private void ValidatePurchase()
    {
        purchase.Number = purchase.Number.Trim();
        purchase.Status ??= PurchaseStatus.Draft;
        if (string.IsNullOrWhiteSpace(purchase.Number))
        {
            throw new InvalidOperationException("Укажите номер закупки.");
        }

        if (purchase.Items.Count == 0)
        {
            throw new InvalidOperationException("Добавьте хотя бы одну позицию.");
        }

        if (purchase.Items.Any(value => string.IsNullOrWhiteSpace(value.ProductName) || (value.Quantity ?? 0) <= 0))
        {
            throw new InvalidOperationException("Для каждой позиции выберите товар и укажите количество.");
        }

        CurrencyChanged();
    }

    private void ResetReceipt()
    {
        receiptLines.Clear();
        receiptId = Guid.NewGuid();
        receiptDate = null;
        receiptNote = null;
    }

    private ReceiptFormLine ReceiptInput(Guid id)
    {
        if (!receiptLines.TryGetValue(id, out var value))
        {
            receiptLines[id] = value = new() { ReceivedQuantity = purchase.Items.First(x => x.Id == id).MissingQuantity };
        }

        return value;
    }

    private async Task RunAsync(Func<Task> action, string text)
    {
        if (saving)
        {
            return;
        }

        saving = true;
        message = null;
        try
        {
            await action();
            unsavedGuard?.MarkClean();
            message ??= text;
            success = true;
        }
        catch (Exception ex)
        {
            message = UserErrors.Describe(ex, "Не удалось выполнить действие с закупкой. Попробуйте ещё раз.");
            success = false;
        }
        finally
        {
            saving = false;
        }
    }

    private string FlowClass(PurchaseStatus value) =>
        purchase.Status == value ? "active" : purchase.Status is not null && value < purchase.Status ? "done" : string.Empty;

    private static string VariantName(ProductVariant value) =>
        string.Join(" · ", new[] { value.Color, value.Size }.Where(text => !string.IsNullOrWhiteSpace(text)));

    private static string VariantLabel(PurchaseItem value) =>
        string.Join(" · ", new[] { value.Color, value.Size }.Where(text => !string.IsNullOrWhiteSpace(text)));

    private static string Money(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));

    private sealed class ReceiptFormLine
    {
        public int? ReceivedQuantity { get; set; }

        public int? DefectQuantity { get; set; }
    }
}
