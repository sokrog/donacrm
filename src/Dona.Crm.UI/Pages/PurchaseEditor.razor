@page "/purchases/new"
@page "/purchases/{Id:guid}"
@page "/purchases/{Id:guid}/{Step}"
@using System.Globalization
@using System.Text.Json
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICommerceRepository Commerce
@inject ICatalogRepository Catalog
@inject PurchaseReceivingService Receiving
@inject NavigationManager Navigation
@inject IPricingRepository PricingHistory
@inject ProductPricingService Pricing

<PageTitle>@(IsNew ? "Новая закупка" : purchase.Number) — DONA CRM</PageTitle>
<div class="dona-page dona-page--form">
    <DonaPageHeader Class="dona-page-header dona-page-header--back dona-heading">
        <a class="dona-icon-button dona-back-button" href="/purchases" data-back-target="explicit" aria-label="Вернуться к закупкам"><OrbitIcon Name="back" /></a>
        <div>
            <p>@purchase.Status.Display()</p>
            <h1>@(IsNew ? "Новая закупка" : $"{StageTitle} · {purchase.Number}")</h1>
        </div>
    </DonaPageHeader>
    @if (loading)
    {
        <div class="dona-state">Загружаем закупку…</div>
    }
    else if (error is not null)
    {
        <div class="dona-state dona-state--error" role="alert">@error</div>
    }
    else
    {
        @if (!IsNew)
        {
            @if (Priced > 0) { <p class="dona-message dona-message--success" role="status">Обновлено цен: @Priced.</p> }
            @if (purchase.Status != PurchaseStatus.Cancelled)
            {
                @if (reviewPrices) { <p class="dona-message">Себестоимость оставшихся товаров изменилась после назначения цен. Проверьте продажные цены.</p> }
            }
            @if (purchase.Status == PurchaseStatus.Cancelled || purchase.ClosedAt is not null)
            {
                <p role="status">@(purchase.Status == PurchaseStatus.Cancelled ? "Закупка отменена" : purchase.Items.Any(x => x.MissingQuantity > 0) ? "Закупка закрыта с недостачей" : "Закупка закрыта")</p>
            }
        }
        <PurchaseNavigation Purchase="purchase" Current="@stage" IsNew="IsNew" PricesSet="pricesSet" />
        <EditForm @key="stage" id="purchaseeditor-form-1" class="dona-stack" Model="purchase" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" TrackModelChanges="true" DirtyChanged="value => hasChanges = value" AdditionalState="() => new { orderDate, receiptDate }" />
            <ListItemRemovalConfirmation @ref="removalConfirmation" />
            @if (stage == "order")
            {
            <section class="dona-section">
                <h2>Заказ</h2>
                <div class="dona-field-row">
                    <label class="dona-field">Номер<DonaLiveText @bind-Value="purchase.Number" /></label>
                    @if (purchase.Receipts.Count > 0 || purchase.ClosedAt is not null)
                    {
                        <div class="dona-field">Статус<strong>@purchase.Status.Display()</strong><small>Определяется документами приёмки и закрытия.</small></div>
                    }
                    else
                    {
                        <label class="dona-field">Статус<OrbitSelect TValue="PurchaseStatus?" @bind-Value="purchase.Status" Options="@PurchaseStatusOptions" Label="Статус закупки" /></label>
                    }
                </div>
                <label class="dona-field">Поставщик<OrbitSelect TValue="Guid?" @bind-Value="purchase.SupplierId" @bind-Value:after="SupplierChanged" Options="@SupplierOptions" Label="Поставщик" Searchable="true" /></label>
                <details open="@(purchase.IntermediaryId is not null)">
                    <summary>Посредник — если участвует</summary>
                    <label class="dona-field">Посредник<OrbitSelect TValue="Guid?" @bind-Value="purchase.IntermediaryId" @bind-Value:after="IntermediaryChanged" Options="@IntermediaryOptions" Label="Посредник" Searchable="true" /></label>
                </details>
                <a class="manage-partners" href="/partners">Управлять поставщиками и посредниками →</a>
                <div class="dona-field-row">
                    <label class="dona-field">Дата заказа<OrbitDatePicker @bind-Value="orderDate" ValueChangedAfter="_ => unsavedGuard?.MarkDirty()" /></label>
                    <label class="dona-field">Трек-код<DonaLiveText @bind-Value="purchase.TrackingCode" /></label>
                    <label class="dona-field">Ожидаемая дата<OrbitDatePicker @bind-Value="purchase.EstimatedDeliveryDate" ValueChangedAfter="_ => unsavedGuard?.MarkDirty()" /></label>
                </div>
                <div class="dona-field-row">
                    <label class="dona-field">Валюта<OrbitSelect TValue="string" @bind-Value="purchase.CurrencyCode" @bind-Value:after="PurchaseCurrencyChanged" Options="@CurrencyOptions" Label="Валюта закупки" /></label>
                    @if (purchase.CurrencyCode != "UZS")
                    {
                        <label class="dona-field">Курс в UZS<InputNumber @bind-Value="purchase.RateToUzs" min="0" /></label>
                    }
                </div>
                @if (currencyReviewRequired)
                {
                    <p class="dona-note">Валюта изменена. Цены не пересчитаны автоматически: проверьте каждую цену и новый курс. Валюты и курсы отдельных расходов сохранены.</p>
                    <label class="dona-field dona-toggle"><InputCheckbox @bind-Value="currencyPricesReviewed" /> Цены позиций проверены в новой валюте</label>
                }
                <label class="dona-field">Заметка<DonaLiveTextArea @bind-Value="purchase.Notes" /></label>
            </section>
            <section class="dona-section purchase-items">
                <div class="dona-section-title">
                    <div>
                        <h2>Позиции</h2>
                        <p>Товары и варианты</p>
                    </div>
                </div>
                @if (purchase.Items.Count == 0)
                {
                    <p class="dona-empty">Добавьте хотя бы одну позицию.</p>
                }
                @foreach (var item in purchase.Items)
                {
                    <article class="purchase-line" @key="item.Id" aria-labelledby="@($"purchase-item-{item.Id}")" @oninput="() => removalConfirmation?.MarkEdited(item)">
                        <header class="purchase-line-heading">
                            <h3 id="@($"purchase-item-{item.Id}")">Позиция @(purchase.Items.IndexOf(item) + 1)</h3>
                            @if ((item.ReceivedQuantity ?? 0) == 0)
                            {
                                <button type="button" class="dona-btn dona-btn--danger dona-btn--remove" aria-label="@($"Удалить позицию {purchase.Items.IndexOf(item) + 1}")" @onclick="() => RemoveItem(item)">×</button>
                            }
                        </header>
                        <label class="dona-field">Товар<ProductAutocomplete Products="products" Value="item.ProductId" OnSelected="product => ProductChanged(item, product)" /></label>
                        <label class="dona-field">Вариант<OrbitSelect TValue="Guid?" @bind-Value="item.ProductVariantId" @bind-Value:after="() => VariantChanged(item)" Options="@VariantOptions(item)" Label="Вариант товара" /></label>
                        <div class="line-fields @(purchase.NeedsWeight || SelectedIntermediary?.RatePerKgUsd is > 0 ? "line-fields--weighted" : null)">
                            <label class="dona-field">Количество<DonaLiveNumber @bind-Value="item.Quantity" min="1" /></label>
                            <label class="dona-field">Цена за единицу, @CurrencyCodes.Symbol(purchase.CurrencyCode)<DonaLiveNumber @bind-Value="item.UnitPrice" min="0" step="any" /></label>
                            <label class="dona-field">Сумма за все количество, @CurrencyCodes.Symbol(purchase.CurrencyCode)<DonaLiveNumber @bind-Value="item.TotalPrice" min="0" step="0.01" disabled="@(item.Quantity is not > 0)" /></label>
                            @if (purchase.NeedsWeight || SelectedIntermediary?.RatePerKgUsd is > 0)
                            {
                                <label class="dona-field">Общий вес, кг<DonaLiveNumber @bind-Value="item.TotalWeightKg" min="0" step="any" disabled="@(item.Quantity is not > 0)" /></label>
                            }
                        </div>
                        @if (item.Quantity is not > 0)
                        {
                            <p class="dona-note">Укажите количество, чтобы ввести общую сумму и вес.</p>
                        }
                        @if (purchase.HasCompleteCostInputs)
                        {
                            <details class="unit-cost">
                                <summary>Себестоимость: @Money(purchase.ItemUnitLandedCostUzs(item)) UZS / ед.</summary>
                                <p>Товары: @Money(purchase.ItemGoodsCostUzs(item)) UZS. Расходы: @Money(purchase.ItemLandedCostUzs(item) - purchase.ItemGoodsCostUzs(item)) UZS. Всего за позицию: @Money(purchase.ItemLandedCostUzs(item)) UZS.</p>
                            </details>
                        }
                        @if ((item.ReceivedQuantity ?? 0) > 0)
                        {
                            <div class="received-note">Получено @(item.ReceivedQuantity ?? 0) · брак @(item.DefectQuantity ?? 0) · оприходовано @item.StockedQuantity</div>
                        }
                    </article>
                }
                <button type="button" class="dona-btn dona-btn--ghost dona-btn--block" @onclick="AddItem"><OrbitIcon Name="plus" />Добавить позицию</button>
            </section>
            }
            @if (stage == "costs")
            {
            <section class="dona-section">
                <div class="dona-section-title">
                    <div>
                        <h2>Расходы и оценка партии</h2>
                        <p>@purchase.TotalQuantity ед. · @(purchase.IsCostFinalized ? "Все расходы учтены" : "Предварительная себестоимость")</p>
                    </div>
                </div>
                <div class="dona-section-title">
                    <h3>Дополнительные расходы</h3>
                </div>
                @if (purchase.Expenses.Count == 0)
                {
                    <p>Если расходов нет, себестоимость равна закупочной цене.</p>
                }
                @if (SelectedIntermediary is { } tariff)
                {
                    <p class="dona-note">Тариф: комиссия @(tariff.CommissionPercent ?? 0)% от товаров; доставка @(tariff.RatePerKgUsd ?? 0) USD/кг, минимально оплачиваемый вес @(tariff.MinimumWeightKg ?? 0) кг.</p>
                    @if (tariff.RatePerKgUsd is > 0)
                    {
                        <label class="dona-field">Курс USD в UZS для доставки<InputNumber @bind-Value="tariffUsdRate" min="0" placeholder="Для USD-закупки используется её курс" /></label>
                    }
                    <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="ApplyTariff">Рассчитать по тарифу</button>
                    @if (tariffMessage is not null) { <p class="dona-note" role="status">@tariffMessage</p> }
                    <p class="dona-note">Создаёт расходы для проверки и отдельного сохранения. Повторное нажатие сохраняет уже добавленные строки и ручные правки. Для нового расчёта удалите заменяемый расход. Формула под расходом — снимок исходного расчёта.</p>
                }
                @foreach (var expense in purchase.Expenses)
                {
                    <article class="expense-line" @key="expense.Id" @oninput="() => removalConfirmation?.MarkEdited(expense)">
                        <label class="dona-field">Название<DonaLiveText @bind-Value="expense.Name" placeholder="Например, доставка" /></label>
                        @if (expense.TariffCalculation is not null)
                        {
                            <p class="dona-note">Исходный расчёт: @expense.TariffCalculation Сумму и курс можно изменить вручную.</p>
                        }
                        <label class="dona-field">Вид расхода<OrbitSelect TValue="PurchaseExpenseKind" @bind-Value="expense.Kind" Options="@ExpenseKindOptions" Label="Вид расхода" /></label>
                        <div class="dona-field-row">
                            <label class="dona-field">Сумма<InputNumber @bind-Value="expense.Amount" min="0" /></label>
                            <label class="dona-field">Валюта<OrbitSelect TValue="string" @bind-Value="expense.CurrencyCode" @bind-Value:after="() => ExpenseCurrencyChanged(expense)" Options="@CurrencyOptions" Label="Валюта расхода" /></label>
                        </div>
                        @if (expense.CurrencyCode != "UZS")
                        {
                            <label class="dona-field">Курс этого расхода в UZS<InputNumber @bind-Value="expense.RateUzs" min="0" /></label>
                        }
                        <details>
                            <summary>Распределение: @AllocationLabel(expense.Allocation)</summary>
                            <label class="dona-field">Как распределить<OrbitSelect TValue="ExpenseAllocation" @bind-Value="expense.Allocation" Options="@AllocationOptions" Label="Распределение расхода" /></label>
                            @if (expense.Allocation == ExpenseAllocation.Item)
                            {
                                <label class="dona-field">На какую позицию<OrbitSelect TValue="Guid?" @bind-Value="expense.PurchaseItemId" Options="@ExpenseItemOptions" Label="Позиция для расхода" /></label>
                            }
                        </details>
                        <button type="button" class="dona-btn dona-btn--danger dona-btn--remove remove-list-item" aria-label="Удалить расход" @onclick="() => RemoveExpense(expense)">×</button>
                    </article>
                }
                <button type="button" class="dona-btn dona-btn--ghost dona-btn--block" @onclick="AddExpense"><OrbitIcon Name="plus" />Добавить расход</button>
                <div class="cost-summary">
                    @if (purchase.HasCompleteCostInputs)
                    {
                        <span>Товары<strong>@Money(purchase.GoodsCostUzs) UZS</strong></span>
                        <span>Дополнительные расходы<strong>@Money(purchase.AdditionalCostsUzs) UZS</strong></span>
                        <span class="total">Итого<strong>@Money(purchase.TotalCostUzs) UZS</strong></span>
                    }
                    else
                    {
                        <p role="status">Для расчета заполните цены, количество, курсы и настройки расходов.</p>
                    }
                </div>
                <label class="dona-field dona-toggle"><InputCheckbox @bind-Value="purchase.IsCostFinalized" /> Все расходы внесены</label>
                <p class="cost-hint">Включите, когда известны цены товаров, доставка, комиссия и остальные расходы. После сохранения себестоимость будет отмечена как окончательная. Это не оплата и не закрытие закупки. Поздние расходы можно внести позже; история расчётов сохранится.</p>
                @if (purchase.Receipts.Count > 0)
                {
                    <p class="cost-hint">Поздние расходы переоценивают остаток партии. Доначисления по уже списанному товару учитываются текущим периодом, исходные распределения FIFO сохраняются.</p>
                }
            </section>
            }
            @if (stage == "receiving" && CanReceive)
            {
                <section class="dona-section receipt-card">
                    <div class="dona-section-title">
                        <div>
                            <h2>Приёмки</h2>
                            <p>Укажите фактически полученное, включая брак. Если товар не пришёл, укажите 0 или нажмите «Не пришло».</p>
                        </div>
                    </div>
                    @if (HasUnsavedOrder)
                    {
                        <p class="dona-note">В заказе или расходах есть несохранённые изменения. Сохраните их на соответствующем этапе, затем оформите приёмку.</p>
                    }
                    <div class="dona-field-row">
                        <label class="dona-field">Дата<OrbitDatePicker @bind-Value="receiptDate" ValueChangedAfter="_ => unsavedGuard?.MarkDirty()" /></label>
                        <label class="dona-field">Комментарий<DonaLiveText @bind-Value="receiptNote" /></label>
                    </div>
                    @foreach (var item in purchase.Items.Where(value => value.MissingQuantity > 0))
                    {
                        var line = ReceiptInput(item.Id);
                        <article class="receipt-line">
                            <div>
                                <strong>@item.ProductName</strong>
                                <small>@VariantLabel(item) · осталось @item.MissingQuantity шт.</small>
                            </div>
                            <div class="dona-field-row">
                                <label class="dona-field">Получено<DonaLiveNumber @bind-Value="line.ReceivedQuantity" @bind-Value:after="() => receiptEdited = true" min="0" max="@item.MissingQuantity" /></label>
                                <label class="dona-field">Из них брак<DonaLiveNumber @bind-Value="line.DefectQuantity" @bind-Value:after="() => receiptEdited = true" min="0" /></label>
                            </div>
                            <p class="dona-note">Не пришло в этой поставке: @Math.Max(0, item.MissingQuantity - (line.ReceivedQuantity ?? 0)) шт.</p>
                            <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => MarkNotReceived(line)">Не пришло</button>
                        </article>
                    }
                    <p class="dona-note">Если ждёте оставшиеся товары — сохраните эту приёмку, следующую оформите позже. Если поставка завершена, сначала сохраните фактически полученные товары, затем перейдите к расхождениям. Если ничего не пришло, укажите 0 для всех позиций и сразу переходите к недостаче.</p>
                    <button type="button" class="dona-btn dona-btn--secondary" @onclick="GoToDiscrepancies">Завершить приёмку и разобрать недостачу</button>
                </section>
            }
            @if (stage == "closing" && !IsNew && purchase.Status != PurchaseStatus.Cancelled)
            {
                <section class="dona-section">
                    <h2>Закрытие закупки</h2>
                    @if (purchase.ClosedAt is { } closedAt)
                    {
                        <p>Закрыта @closedAt.ToLocalTime().ToString("dd.MM.yyyy")</p>
                        <a class="dona-btn dona-btn--secondary" href="/purchases/@purchase.Id/discrepancies">Решения по учёту потерь</a>
                        @foreach (var settlement in purchase.ShortageSettlements)
                        {
                            <p>@purchase.Items.Single(x => x.Id == settlement.PurchaseItemId).ProductName · недостача @settlement.Quantity шт. · при учёте: компенсация @Money(settlement.SupplierRefund), остаток стоимости @Money(settlement.Loss ?? 0). Текущая компенсация: @Money(purchase.CurrentRefund(settlement)).</p>
                            <a href="/purchases/@purchase.Id/compensation/@settlement.Id">Исправить компенсацию и посмотреть историю</a>
                            <p>Осталось недопоставлено: @purchase.UnresolvedShortage(settlement) ед. <a href="/purchases/@purchase.Id/late-receipt/@settlement.Id">Поздняя поставка и история</a></p>
                        }
                    }
                    else
                    {
                        <p>Перед закрытием завершите приёмку и учтите недостачу и брак на этапе расхождений. Затем проверьте цены продажи.</p>
                        <a class="dona-btn dona-btn--secondary" href="/purchases/@purchase.Id/discrepancies">Разобрать расхождения</a>
                        @if (purchase.ReceivingCompletedAt is not null && !PurchaseReceivingService.HasUnreviewedLosses(purchase)) { <p>Расхождения учтены. Закупка готова к закрытию.</p> }

                    }
                </section>
            }
            @if (stage == "receiving" && purchase.Receipts.Count > 0)
            {
                <section class="dona-section">
                    <h2>История приёмок</h2>
                    <ul class="receipt-history">
                        @foreach (var value in purchase.Receipts.OrderByDescending(item => item.ReceivedAt))
                        {
                            <li>
                                <span>
                                    <strong>@value.ReceivedAt.ToLocalTime().ToString("dd.MM.yyyy · HH:mm")</strong>
                                    <small>@(value.Note ?? "Без комментария")</small>
                                </span>
                                <b>+@value.StockedQuantity<small>на склад</small></b>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (stage == "receiving" && !CanReceive)
            { <p class="dona-state">@(purchase.ClosedAt is not null || purchase.ReceivingCompletedAt is not null ? "Приёмка завершена. Позднюю поставку можно оформить на этапе расхождений." : purchase.Status == PurchaseStatus.Cancelled ? "Закупка отменена." : "Все заказанные товары уже приняты.")</p> }
            @if (stage == "receiving" && !purchase.HasCompleteCostInputs)
            { <p class="dona-message">Перед приёмкой заполните цены и курсы на этапе «Заказ» и проверьте этап «Расходы».</p> }
            @if (stage == "closing" && purchase.Status == PurchaseStatus.Cancelled)
            { <p class="dona-state">Закупка отменена. Закрытие недоступно.</p> }
            @if (confirmClosing)
            {
                <DonaConfirmation OnCancel="() => confirmClosing = false">
                    <div class="dona-confirm">
                        <span>Закрыть закупку? Решения по расхождениям сохранены. Закупка будет отмечена как закрытая. Поздние расходы и поставки оформляются отдельными корректировками.</span>
                        <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="() => confirmClosing = false">Отмена</button>
                        <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="ConfirmClosingAsync">Закрыть закупку</button>
                    </div>
                </DonaConfirmation>
            }
            <ValidationSummary />
            @if (stage == "costs" && purchase.CostRevisions.Count > 0)
            {
                <details class="dona-section">
                    <summary>История расчета</summary>
                    @foreach (var revision in purchase.CostRevisions.OrderByDescending(x => x.ChangedAt))
                    {
                        <p>@revision.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Money(revision.TotalCostUzs) UZS · @(revision.IsFinalized ? "Все расходы учтены" : "Предварительно")</p>
                    }
                </details>
            }
            @if (message is not null)
            {
                <p class="dona-message @(success ? "dona-message--success" : "dona-message--error")" role="status">@message</p>
            }

            <DonaPageActions>
                <Primary>
                    @if (stage is "order" or "costs")
                    { <button form="purchaseeditor-form-1" type="submit" class="dona-btn dona-btn--primary @(IsNew || hasChanges ? null : "dona-save--unchanged")" disabled="@saving">@(saving ? "Сохраняем…" : stage == "costs" ? "Сохранить расходы" : "Сохранить заказ")</button> }
                    else if (stage == "receiving" && CanReceive)
                    { <button type="button" class="dona-btn dona-btn--primary" disabled="@(saving || !purchase.HasCompleteCostInputs)" @onclick="ReceiveAsync">Оформить приёмку</button> }
                    else if (stage == "closing" && purchase.ClosedAt is null && purchase.Status != PurchaseStatus.Cancelled)
                    { <button type="button" class="dona-btn dona-btn--primary" disabled="@(saving || purchase.ReceivingCompletedAt is null || PurchaseReceivingService.HasUnreviewedLosses(purchase))" @onclick="() => confirmClosing = true">Закрыть закупку</button> }
                </Primary>
                <Secondary>
                    @if (!IsNew)
                    {
                        <a class="dona-btn dona-btn--secondary" href="/purchases/@purchase.Id/reconciliation">Сверка партий и стоимости</a>
                    }
                </Secondary>
            </DonaPageActions>
        </EditForm>
    }
</div>
@code {
    private bool hasChanges;
    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery] public Guid? ProductId { get; set; }
    private Purchase purchase = new();
    [Parameter] public string? Step { get; set; }
    private string stage = "order";
    private bool pricesSet, confirmClosing;
    private string StageTitle => stage switch { "costs" => "Расходы", "receiving" => "Приёмка", "closing" => "Закрытие", _ => "Заказ" };
    private bool CanReceive => !IsNew && purchase.ClosedAt is null && purchase.ReceivingCompletedAt is null && purchase.Status != PurchaseStatus.Cancelled && purchase.Items.Any(x => x.MissingQuantity > 0);
    private async Task ConfirmClosingAsync() { await ClosePurchaseAsync(); if (success) confirmClosing = false; }
    private IReadOnlyList<Supplier> suppliers = [];
    private IReadOnlyList<Intermediary> intermediaries = [];
    private IReadOnlyList<Product> products = [];
    private IReadOnlyList<Purchase> priceHistory = [];
    private readonly Dictionary<Guid, ReceiptFormLine> receiptLines = [];
    private Guid receiptId = Guid.NewGuid();
    private bool receiptEdited;
    private DateTime? orderDate;
    private DateTime? receiptDate;
    private string? receiptNote;
    private UnsavedChangesGuard? unsavedGuard;
    private ListItemRemovalConfirmation? removalConfirmation;
    private bool loading = true;
    private bool saving;
    private string savedOrder = string.Empty;
    private bool HasUnsavedOrder => JsonSerializer.Serialize(purchase) != savedOrder;
    private void RequireSavedOrder()
    {
        if (HasUnsavedOrder) throw new InvalidOperationException("Сначала сохраните изменения заказа и расходов отдельным действием.");
    }
    private bool currencyReviewRequired;
    private bool currencyPricesReviewed;
    private string? error;
    private string? message;
    private bool success;
    [SupplyParameterFromQuery(Name = "priced")] public int? Priced { get; set; }
    private bool reviewPrices;
    private async Task ReviewPricesAsync()
    {
        reviewPrices = false;
        var lines = (await PricingHistory.GetPriceChangesAsync()).OrderByDescending(x => x.AppliedAt).SelectMany(x => x.Lines).GroupBy(x => x.Quote.ProductId).Select(x => x.First()).Where(x => x.Quote.PurchaseId == purchase.Id || x.Quote.Layers.Any(l => l.PurchaseId == purchase.Id));
        pricesSet = lines.Any();
        foreach (var line in lines) if (await Pricing.NeedsReviewAsync(line)) { reviewPrices = true; break; }
    }
    private decimal? tariffUsdRate;
    private string? tariffMessage;
    private Intermediary? SelectedIntermediary => intermediaries.FirstOrDefault(x => x.Id == purchase.IntermediaryId);
    private void ApplyTariff()
    {
        try
        {
            if (currencyReviewRequired && !currencyPricesReviewed)
                throw new InvalidOperationException("Сначала проверьте цены после смены валюты.");
            var count = PurchaseTariffCalculator.Apply(purchase, SelectedIntermediary
                ?? throw new InvalidOperationException("Выберите посредника."), tariffUsdRate);
            if (count > 0) unsavedGuard?.MarkDirty();
            tariffMessage = count > 0 ? $"Добавлено расходов: {count}. Проверьте и сохраните закупку." : "Новые расходы не добавлены: тарифы не заданы либо расходы уже существуют.";
        }
        catch (InvalidOperationException exception) { tariffMessage = exception.Message; }
    }


    private bool IsNew => Id is null;
    private static readonly IReadOnlyList<OrbitSelectOption<PurchaseExpenseKind>> ExpenseKindOptions =
        [new(PurchaseExpenseKind.Other, "Другой расход"), new(PurchaseExpenseKind.Commission, "Комиссия"), new(PurchaseExpenseKind.Shipping, "Доставка")];
    private static string AllocationLabel(ExpenseAllocation value) => value switch
    {
        ExpenseAllocation.Quantity => "по количеству",
        ExpenseAllocation.Weight => "по весу",
        ExpenseAllocation.Item => "на одну позицию",
        _ => "по стоимости товаров"
    };
    private static readonly IReadOnlyList<OrbitSelectOption<ExpenseAllocation>> AllocationOptions =
        OrbitSelectOptions.From(Enum.GetValues<ExpenseAllocation>(), AllocationLabel);
    private IReadOnlyList<OrbitSelectOption<Guid?>> ExpenseItemOptions =>
        [new(null, "Выберите позицию"), .. purchase.Items.Select(x => new OrbitSelectOption<Guid?>(x.Id, $"{x.ProductName} {VariantLabel(x)}"))];
    private void AddExpense()
    {
        purchase.Expenses.Add(new PurchaseExpense { CurrencyCode = purchase.CurrencyCode, RateUzs = purchase.RateToUzs });
        purchase.IsCostFinalized = false;
        unsavedGuard?.MarkDirty();
    }
    private async Task RemoveExpense(PurchaseExpense expense)
    {
        var filled = !string.IsNullOrWhiteSpace(expense.Name) || expense.Amount is not null
            || expense.Kind != PurchaseExpenseKind.Other || expense.Allocation != ExpenseAllocation.Value
            || expense.PurchaseItemId is not null || expense.TariffCalculation is not null;
        if (removalConfirmation is null || !await removalConfirmation.ConfirmAsync(expense, filled, "Удалить расход?")) return;
        purchase.Expenses.Remove(expense);
        purchase.IsCostFinalized = false;
        unsavedGuard?.MarkDirty();
    }

    private static readonly IReadOnlyList<OrbitSelectOption<PurchaseStatus?>> PurchaseStatusOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<PurchaseStatus>().Where(value => value is not (PurchaseStatus.Received or PurchaseStatus.PartiallyReceived)), "Не указан", value => value.Display());

    private static readonly IReadOnlyList<OrbitSelectOption<string>> CurrencyOptions =
        OrbitSelectOptions.From(CurrencyCodes.Supported, value => $"{value} · {CurrencyCodes.Symbol(value)}");

    private IReadOnlyList<OrbitSelectOption<Guid?>> SupplierOptions =>
        [new(null, "Не выбран"), .. suppliers.Where(x => !x.IsArchived || x.Id == purchase.SupplierId).Select(value => new OrbitSelectOption<Guid?>(value.Id, value.Name + (value.IsArchived ? " — в архиве" : "")))];

    private IReadOnlyList<OrbitSelectOption<Guid?>> IntermediaryOptions =>
        [new(null, "Не выбран"), .. intermediaries.Where(x => !x.IsArchived || x.Id == purchase.IntermediaryId).Select(value => new OrbitSelectOption<Guid?>(value.Id, value.Name + (value.IsArchived ? " — в архиве" : "")))];

    protected override async Task OnParametersSetAsync()
    {
        stage = Step switch { "costs" => "costs", "receiving" => "receiving", "closing" => "closing", _ => "order" };
        confirmClosing = false;
        message = null;
        success = false;
        currencyReviewRequired = currencyPricesReviewed = false;
        tariffMessage = null;
        tariffUsdRate = null;
        closingOperationId = Guid.NewGuid();
        shortageForms.Clear();
        loading = true;
        error = null;
        try
        {
            if (Step is not (null or "costs" or "receiving" or "closing")) throw new InvalidOperationException("Этап закупки не найден.");
            var supplierTask = Commerce.GetSuppliersAsync();
            var intermediaryTask = Commerce.GetIntermediariesAsync();
            var productTask = Catalog.GetProductsAsync();
            var purchaseTask = Commerce.GetPurchasesAsync();
            await Task.WhenAll(supplierTask, intermediaryTask, productTask, purchaseTask);
            priceHistory = await purchaseTask;
            suppliers = await supplierTask;
            intermediaries = await intermediaryTask;
            products = (await productTask).Where(value => value.Status != ProductStatus.Archived).ToList();
            purchase = Id is null
                ? NewPurchase(await purchaseTask)
                : await Commerce.GetPurchaseAsync(Id.Value) ?? throw new InvalidOperationException("Закупка не найдена.");
            if (Id is null && ProductId is { } productId && products.FirstOrDefault(x => x.Id == productId) is { } product)
            {
                purchase.Items.Clear();
                var item = new PurchaseItem();
                purchase.Items.Add(item);
                ProductChanged(item, product);
                if (product.Variants.Count == 1) { item.ProductVariantId = product.Variants[0].Id; VariantChanged(item); }
            }
            orderDate = purchase.OrderedAt.ToLocalTime().Date;
            purchase.CurrencyCode = CurrencyCodes.Normalize(purchase.CurrencyCode, "CNY");
            await ReviewPricesAsync();
            savedOrder = JsonSerializer.Serialize(purchase);
            ResetReceipt();
        }
        catch (Exception ex)
        {
            error = UserErrors.Describe(ex, "Не удалось загрузить закупку. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private static Purchase NewPurchase(IEnumerable<Purchase> existing)
    {
        var prefix = $"PO-{DateTime.Now:yyyyMMdd}";
        var used = existing.Select(value => value.Number).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var index = 1;
        while (used.Contains($"{prefix}-{index:000}"))
        {
            index++;
        }

        return new Purchase { Number = $"{prefix}-{index:000}", Status = PurchaseStatus.Draft, CurrencyCode = "CNY" };
    }

    private void AddItem()
    {
        purchase.Items.Add(new PurchaseItem { Quantity = 1 });
        unsavedGuard?.MarkDirty();
    }

    private async Task RemoveItem(PurchaseItem item)
    {
        if ((item.ReceivedQuantity ?? 0) > 0) return;
        var filled = item.ProductId is not null || item.ProductVariantId is not null || !string.IsNullOrWhiteSpace(item.ProductName)
            || !string.IsNullOrWhiteSpace(item.Color) || !string.IsNullOrWhiteSpace(item.Size)
            || item.Quantity is not (null or 1) || item.UnitPrice is not null || item.UnitWeightKg is not null;
        if (removalConfirmation is null || !await removalConfirmation.ConfirmAsync(item, filled)) return;
        purchase.Items.Remove(item);
        unsavedGuard?.MarkDirty();
    }

    private IEnumerable<ProductVariant> Variants(PurchaseItem item) =>
        item.ProductId is null ? [] : products.FirstOrDefault(value => value.Id == item.ProductId)?.Variants ?? [];

    private void SupplierChanged()
    {
        purchase.SupplierName = purchase.SupplierId is null
            ? null
            : suppliers.FirstOrDefault(value => value.Id == purchase.SupplierId)?.Name;
        if (purchase.IntermediaryId is null && suppliers.FirstOrDefault(x => x.Id == purchase.SupplierId)?.DefaultIntermediaryId is { } preferred
            && intermediaries.Any(x => x.Id == preferred && !x.IsArchived))
        {
            purchase.IntermediaryId = preferred;
            IntermediaryChanged();
        }
    }

    private void IntermediaryChanged()
    {
        purchase.IntermediaryName = purchase.IntermediaryId is null
            ? null
            : intermediaries.FirstOrDefault(value => value.Id == purchase.IntermediaryId)?.Name;
    }

    private void ProductChanged(PurchaseItem item, Product? product)
    {
        item.ProductId = product?.Id;
        item.ProductName = product?.Name ?? string.Empty;
        item.UnitPrice = product is null ? null : ProductPurchaseDefaults.LastPrice(product.Id, purchase, priceHistory);
        item.UnitWeightKg = product?.UnitWeightKg;
        item.ProductVariantId = null;
        item.Color = string.Empty;
        item.Size = string.Empty;
        if (purchase.SupplierId is null && product?.PreferredSupplierId is { } preferred
            && suppliers.Any(x => x.Id == preferred && !x.IsArchived))
        {
            purchase.SupplierId = preferred;
            SupplierChanged();
        }

        unsavedGuard?.MarkDirty();
    }

    private IReadOnlyList<OrbitSelectOption<Guid?>> VariantOptions(PurchaseItem item) =>
        [new(null, "Не выбран"), .. Variants(item).Select(value => new OrbitSelectOption<Guid?>(value.Id, VariantName(value)))];

    private void VariantChanged(PurchaseItem item)
    {
        var value = Variants(item).FirstOrDefault(variant => variant.Id == item.ProductVariantId);
        item.Color = value?.Color ?? string.Empty;
        item.Size = value?.Size ?? string.Empty;
    }

    private void CurrencyChanged()
    {
        purchase.CurrencyCode = CurrencyCodes.Normalize(purchase.CurrencyCode, "CNY");
        if (purchase.CurrencyCode == "UZS")
        {
            purchase.RateToUzs = 1;
        }
    }

    private void PurchaseCurrencyChanged()
    {
        currencyReviewRequired = purchase.Items.Any(x => x.UnitPrice is not null) || purchase.Expenses.Count > 0;
        currencyPricesReviewed = false;
        purchase.RateToUzs = purchase.CurrencyCode == "UZS" ? 1 : null;
        purchase.IsCostFinalized = false;
        unsavedGuard?.MarkDirty();
    }

    private void ExpenseCurrencyChanged(PurchaseExpense expense)
    {
        expense.RateUzs = expense.CurrencyCode == "UZS" ? 1
            : expense.CurrencyCode == purchase.CurrencyCode ? purchase.RateToUzs : null;
        purchase.IsCostFinalized = false;
    }

    private async Task SaveAsync()
    {
        if (stage is not ("order" or "costs")) return;
        await RunAsync(async () =>
        {
            ValidatePurchase();
            if ((await Commerce.GetPurchasesAsync()).Any(value =>
                    value.Id != purchase.Id && value.Number.Equals(purchase.Number, StringComparison.OrdinalIgnoreCase)))
            {
                throw new InvalidOperationException("Закупка с таким номером уже существует.");
            }

            await Receiving.SaveAsync(purchase);
            if (IsNew)
            {
                unsavedGuard?.MarkClean();
                Navigation.NavigateTo($"/purchases/{purchase.Id}");
            }
        }, "Закупка сохранена.");
    }

    private readonly Dictionary<Guid, ShortageForm> shortageForms = [];
    private Guid closingOperationId = Guid.NewGuid();
    private sealed class ShortageForm { public decimal Refund { get; set; } }
    private ShortageForm ShortageInput(Guid id)
    {
        if (!shortageForms.TryGetValue(id, out var value)) shortageForms[id] = value = new();
        return value;
    }
    private Task ClosePurchaseAsync() => RunAsync(async () =>
    {
        ValidatePurchase();
        RequireSavedOrder();
        await Receiving.CloseAsync(purchase, purchase.ReceivingCompletedAt is not null ? [] : purchase.Items.Where(x => x.MissingQuantity > 0)
            .Select(x => new PurchaseShortageInput(x.Id, ShortageInput(x.Id).Refund)).ToList(), closingOperationId);
    }, "Закупка закрыта, недостача учтена.");

    private async Task ReceiveAsync()
    {
        await RunAsync(async () =>
        {
            ValidatePurchase();
            if (!purchase.HasCompleteCostInputs)
                throw new InvalidOperationException("Перед приемкой укажите закупочные цены, курсы и расходы.");
            RequireSavedOrder();
            var input = receiptLines.Select(value =>
                new PurchaseReceiptInput(value.Key, value.Value.ReceivedQuantity ?? 0, value.Value.DefectQuantity ?? 0));
            DateTimeOffset? at = receiptDate is null
                ? null
                : new DateTimeOffset(receiptDate.Value.Date, TimeZoneInfo.Local.GetUtcOffset(receiptDate.Value.Date));
            var result = await Receiving.ReceiveAsync(purchase, input, receiptId, at, receiptNote);
            ResetReceipt();
            var receipt = purchase.Receipts.Single(value => value.Id == result.ReceiptId);
            message = $"Получено: {receipt.ReceivedQuantity} шт., брак: {receipt.DefectQuantity} шт. На склад: {result.AddedUnits} шт.";
        }, "Приёмка сохранена.");
    }

    private void ValidatePurchase()
    {
        if (currencyReviewRequired && !currencyPricesReviewed)
            throw new InvalidOperationException("Проверьте цены позиций и подтвердите их после смены валюты закупки.");
        if (orderDate is null) throw new InvalidOperationException("Укажите дату фактического заказа.");
        if (orderDate.Value.Date != purchase.OrderedAt.ToLocalTime().Date)
            purchase.OrderedAt = new DateTimeOffset(orderDate.Value.Date, TimeZoneInfo.Local.GetUtcOffset(orderDate.Value.Date));
        purchase.Number = purchase.Number.Trim();
        purchase.Status ??= PurchaseStatus.Draft;
        if (string.IsNullOrWhiteSpace(purchase.Number))
        {
            throw new InvalidOperationException("Укажите номер закупки.");
        }

        if (purchase.Items.Count == 0)
        {
            throw new InvalidOperationException("Добавьте хотя бы одну позицию.");
        }

        if (purchase.Items.Any(value => string.IsNullOrWhiteSpace(value.ProductName) || (value.Quantity ?? 0) <= 0))
        {
            throw new InvalidOperationException("Для каждой позиции выберите товар и укажите количество.");
        }

        CurrencyChanged();
    }

    private void GoToDiscrepancies()
    {
        if (receiptEdited && receiptLines.Values.Any(x => (x.ReceivedQuantity ?? 0) > 0 || (x.DefectQuantity ?? 0) > 0))
        { success = false; message = "Сначала сохраните фактически полученные товары кнопкой «Оформить приёмку». Если новых поступлений нет, укажите 0."; return; }
        unsavedGuard?.MarkClean();
        Navigation.NavigateTo($"/purchases/{purchase.Id}/discrepancies");
    }

    private void MarkNotReceived(ReceiptFormLine line)
    {
        receiptEdited = true; line.ReceivedQuantity = 0; line.DefectQuantity = 0; unsavedGuard?.MarkDirty();
    }

    private void ResetReceipt()
    {
        receiptEdited = false;
        receiptLines.Clear();
        receiptId = Guid.NewGuid();
        receiptDate = null;
        receiptNote = null;
    }

    private ReceiptFormLine ReceiptInput(Guid id)
    {
        if (!receiptLines.TryGetValue(id, out var value))
        {
            receiptLines[id] = value = new() { ReceivedQuantity = purchase.Items.First(x => x.Id == id).MissingQuantity };
        }

        return value;
    }

    private async Task RunAsync(Func<Task> action, string text)
    {
        if (saving)
        {
            return;
        }

        saving = true;
        message = null;
        try
        {
            await action();
            await ReviewPricesAsync();
            savedOrder = JsonSerializer.Serialize(purchase);
            unsavedGuard?.MarkClean();
            message ??= text;
            success = true;
        }
        catch (Exception ex)
        {
            message = UserErrors.Describe(ex, "Не удалось выполнить действие с закупкой. Попробуйте ещё раз.");
            success = false;
        }
        finally
        {
            saving = false;
        }
    }


    private static string VariantName(ProductVariant value) =>
        string.Join(" · ", new[] { value.Color, value.Size }.Where(text => !string.IsNullOrWhiteSpace(text)));

    private static string VariantLabel(PurchaseItem value) =>
        string.Join(" · ", new[] { value.Color, value.Size }.Where(text => !string.IsNullOrWhiteSpace(text)));

    private static string Money(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));

    private sealed class ReceiptFormLine
    {
        public int? ReceivedQuantity { get; set; }

        public int? DefectQuantity { get; set; }
    }
}
