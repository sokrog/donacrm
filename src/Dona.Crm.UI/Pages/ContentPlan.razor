@page "/content-plan"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject IMarketingRepository Marketing
@inject IBusinessSettingsRepository Settings

<PageTitle>Контент-план — DONA CRM</PageTitle>
<div class="dona-page dona-page--wide">
    <header class="dona-page-header">
        <div class="dona-heading">
            <a class="dona-icon-button dona-back-button" href="/marketing" aria-label="Вернуться в маркетинг"><OrbitIcon Name="back" /></a>
            <div>
                <p>Маркетинг</p>
                <h1 class="dona-title">Контент-план</h1>
            </div>
        </div>
        <a class="dona-icon-button dona-add-button" href="/content-plan/new" aria-label="Создать публикацию"><OrbitIcon Name="plus" /></a>
    </header>
    @if (loading)
    {
        <div class="dona-state">Загружаем публикации…</div>
    }
    else if (errorMessage is not null)
    {
        <div class="dona-state dona-state--error" role="alert"><strong>Не удалось загрузить публикации</strong><p>@errorMessage</p></div>
    }
    else
    {
        <section class="dona-kpis dona-kpis--4 content-metrics">
            <article class="dona-kpi"><span>Запланировано</span><strong>@posts.Count(value => value.Status == ContentStatus.Planned)</strong></article>
            <article class="dona-kpi"><span>Готово</span><strong>@posts.Count(value => value.Status == ContentStatus.Ready)</strong></article>
            <article class="dona-kpi"><span>Идей</span><strong>@posts.Count(value => value.Status is ContentStatus.Idea or null)</strong></article>
            <article class="dona-kpi"><span>Опубликовано</span><strong>@posts.Count(value => value.Status == ContentStatus.Published)</strong></article>
        </section>
        @if (OverdueCount > 0)
        {
            <div class="content-alert overdue" role="status">Просрочено публикаций: @OverdueCount.</div>
        }
        else if (UpcomingCount > 0)
        {
            <div class="content-alert" role="status">В ближайшие @settings.ContentPlanningHorizonDays дней: @UpcomingCount публикаций.</div>
        }
        <div class="content-tools">
            <input class="dona-input" aria-label="Поиск публикаций" placeholder="Тема, коллекция или образ" @bind="query" @bind:event="oninput" />
            <div>
                <OrbitSelect TValue="string" @bind-Value="status" Options="@ContentStatusFilterOptions" Label="Статус публикации" />
                <OrbitSelect TValue="string" @bind-Value="type" Options="@ContentTypeFilterOptions" Label="Формат публикации" />
            </div>
        </div>
        @if (!Filtered.Any())
        {
            <div class="dona-state"><strong>Публикации не найдены</strong><p>Измените фильтры или создайте новую идею.</p></div>
        }
        else
        {
            <ul class="content-list">
                @foreach (var post in Filtered)
                {
                    <li>
                        <a class="dona-list-row" href="/content-plan/@post.Id">
                            <span class="dona-icon-tile content-date @DateClass(post)"><strong>@(post.ScheduledAt?.ToString("dd") ?? "—")</strong><small>@(post.ScheduledAt?.ToString("MMM") ?? "без даты")</small></span>
                            <span><strong>@post.Title</strong><small>@(post.Type?.Display() ?? "Формат не указан") · @post.Status.Display()</small><em>@Association(post)</em></span>
                            <b aria-hidden="true">›</b>
                        </a>
                    </li>
                }
            </ul>
        }
    }
</div>
@code {
    private IReadOnlyList<ContentPost> posts = [];
    private BusinessSettings settings = new();
    private bool loading = true;
    private string? errorMessage;
    private string query = string.Empty;
    private string status = string.Empty;
    private string type = string.Empty;

    private static readonly IReadOnlyList<OrbitSelectOption<string>> ContentStatusFilterOptions =
    [
        new(string.Empty, "Все статусы"),
        .. Enum.GetValues<ContentStatus>().Select(value => new OrbitSelectOption<string>(value.ToString(), value.Display()))
    ];

    private static readonly IReadOnlyList<OrbitSelectOption<string>> ContentTypeFilterOptions =
    [
        new(string.Empty, "Все форматы"),
        .. Enum.GetValues<ContentType>().Select(value => new OrbitSelectOption<string>(value.ToString(), value.Display()))
    ];

    private IEnumerable<ContentPost> Pending => posts.Where(value => value.Status is not ContentStatus.Published and not ContentStatus.Cancelled);

    private int OverdueCount => Pending.Count(value => value.ScheduledAt?.Date < DateTime.Today);

    private int UpcomingCount => Pending.Count(value =>
        value.ScheduledAt?.Date >= DateTime.Today
        && value.ScheduledAt?.Date <= DateTime.Today.AddDays(settings.ContentPlanningHorizonDays));

    private IEnumerable<ContentPost> Filtered => posts
        .Where(value =>
            (string.IsNullOrWhiteSpace(query)
                || value.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
                || (value.CollectionName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
                || (value.OutfitName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
            && (string.IsNullOrWhiteSpace(status) || value.Status.ToString() == status)
            && (string.IsNullOrWhiteSpace(type) || value.Type.ToString() == type))
        .OrderBy(value => SortGroup(value))
        .ThenBy(value => value.ScheduledAt ?? DateTime.MaxValue)
        .ThenByDescending(value => value.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var content = Marketing.GetContentPostsAsync();
            var storedSettings = Settings.GetAsync();
            await Task.WhenAll(content, storedSettings);
            posts = await content;
            settings = await storedSettings;
        }
        catch (Exception exception)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось загрузить контент-план. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private static int SortGroup(ContentPost value) =>
        value.Status is ContentStatus.Published or ContentStatus.Cancelled ? 2 : value.ScheduledAt?.Date < DateTime.Today ? 0 : 1;

    private static string DateClass(ContentPost value) =>
        value.Status is not ContentStatus.Published and not ContentStatus.Cancelled && value.ScheduledAt?.Date < DateTime.Today
            ? "overdue"
            : value.Status == ContentStatus.Published ? "published" : string.Empty;

    private static string Association(ContentPost value) =>
        string.Join(" · ", new[] { value.CollectionName, value.OutfitName }.Where(text => !string.IsNullOrWhiteSpace(text))) is { Length: > 0 } text
            ? text
            : "Без привязки";
}
