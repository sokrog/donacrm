@page "/content-plan"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject IMarketingRepository Marketing
@inject IBusinessSettingsRepository Settings

<PageTitle>Контент-план — DONA CRM</PageTitle>
<div class="content-page">
    <header><div><a href="/marketing">Маркетинг</a><h1>Контент-план</h1></div><a class="orbit-icon-button orbit-add-button" href="/content-plan/new" aria-label="Создать публикацию"><OrbitIcon Name="plus" /></a></header>
    @if(loading){<div class="content-state">Загружаем публикации…</div>}
    else
    {
        <section class="content-metrics orbit-metrics orbit-metrics--4"><article><span>Запланировано</span><strong>@posts.Count(value=>value.Status==ContentStatus.Planned)</strong></article><article><span>Готово</span><strong>@posts.Count(value=>value.Status==ContentStatus.Ready)</strong></article><article><span>Идей</span><strong>@posts.Count(value=>value.Status is ContentStatus.Idea or null)</strong></article><article><span>Опубликовано</span><strong>@posts.Count(value=>value.Status==ContentStatus.Published)</strong></article></section>
        @if(OverdueCount>0){<div class="content-alert overdue" role="status">Просрочено публикаций: @OverdueCount.</div>}else if(UpcomingCount>0){<div class="content-alert" role="status">В ближайшие @settings.ContentPlanningHorizonDays дней: @UpcomingCount публикаций.</div>}
        <div class="content-tools"><input aria-label="Поиск публикаций" placeholder="Тема, коллекция или образ" @bind="query" @bind:event="oninput" /><div><select aria-label="Статус" @bind="status"><option value="">Все статусы</option>@foreach(var value in Enum.GetValues<ContentStatus>()){<option value="@value">@value.Display()</option>}</select><select aria-label="Формат" @bind="type"><option value="">Все форматы</option>@foreach(var value in Enum.GetValues<ContentType>()){<option value="@value">@value.Display()</option>}</select></div></div>
        @if(!Filtered.Any()){<div class="content-state"><strong>Публикации не найдены</strong><p>Измените фильтры или создайте новую идею.</p></div>}else{<ul class="content-list">@foreach(var post in Filtered){<li><a href="/content-plan/@post.Id"><span class="content-date @DateClass(post)"><strong>@(post.ScheduledAt?.ToString("dd")??"—")</strong><small>@(post.ScheduledAt?.ToString("MMM")??"без даты")</small></span><span><strong>@post.Title</strong><small>@(post.Type?.Display()??"Формат не указан") · @post.Status.Display()</small><em>@Association(post)</em></span><b aria-hidden="true">›</b></a></li>}</ul>}
    }
</div>
@code{
    private IReadOnlyList<ContentPost> posts=[];private BusinessSettings settings=new();private bool loading=true;private string query=string.Empty;private string status=string.Empty;private string type=string.Empty;private IEnumerable<ContentPost> Pending=>posts.Where(value=>value.Status is not ContentStatus.Published and not ContentStatus.Cancelled);private int OverdueCount=>Pending.Count(value=>value.ScheduledAt?.Date<DateTime.Today);private int UpcomingCount=>Pending.Count(value=>value.ScheduledAt?.Date>=DateTime.Today&&value.ScheduledAt?.Date<=DateTime.Today.AddDays(settings.ContentPlanningHorizonDays));
    private IEnumerable<ContentPost> Filtered=>posts.Where(value=>(string.IsNullOrWhiteSpace(query)||value.Title.Contains(query,StringComparison.OrdinalIgnoreCase)||(value.CollectionName?.Contains(query,StringComparison.OrdinalIgnoreCase)??false)||(value.OutfitName?.Contains(query,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(status)||value.Status.ToString()==status)&&(string.IsNullOrWhiteSpace(type)||value.Type.ToString()==type)).OrderBy(value=>SortGroup(value)).ThenBy(value=>value.ScheduledAt??DateTime.MaxValue).ThenByDescending(value=>value.CreatedAt);
    protected override async Task OnInitializedAsync(){var content=Marketing.GetContentPostsAsync();var storedSettings=Settings.GetAsync();await Task.WhenAll(content,storedSettings);posts=await content;settings=await storedSettings;loading=false;}
    private static int SortGroup(ContentPost value)=>value.Status is ContentStatus.Published or ContentStatus.Cancelled?2:value.ScheduledAt?.Date<DateTime.Today?0:1;private static string DateClass(ContentPost value)=>value.Status is not ContentStatus.Published and not ContentStatus.Cancelled&&value.ScheduledAt?.Date<DateTime.Today?"overdue":value.Status==ContentStatus.Published?"published":string.Empty;private static string Association(ContentPost value)=>string.Join(" · ",new[]{value.CollectionName,value.OutfitName}.Where(text=>!string.IsNullOrWhiteSpace(text))) is {Length:>0} text?text:"Без привязки";
}
