@page "/analytics"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ISalesRepository Sales
@inject ICatalogRepository Catalog
@inject ICommerceRepository Commerce
@inject IMarketingRepository Marketing
@inject IStockMovementRepository Movements
@inject IBusinessSettingsRepository SettingsRepository
@inject AnalyticsService AnalyticsService
@inject InventoryAnalyticsService InventoryService
@inject ProfitAnalyticsService ProfitService

<PageTitle>Аналитика — DONA CRM</PageTitle>
<div class="dona-page dona-page--wide analytics-page">
    <header class="dona-page-header">
        <div class="dona-heading">
            <a class="dona-icon-button dona-back-button dona-back-button--section" href="/more" aria-label="Вернуться в меню"><OrbitIcon Name="back" /></a>
            <div>
                <p>Ещё</p>
                <h1 class="dona-title">Аналитика</h1>
            </div>
        </div>
    </header>
    @if (loading)
    {
        <div class="dona-state">Собираем показатели…</div>
    }
    else if (loadFailed)
    {
        <div class="dona-state dona-state--error" role="alert">@errorMessage</div>
    }
    else
    {
        @if (inventory.UnvaluedQuantity > 0 || report.HasUnknownCost)
        {
            <p class="dona-message" role="status">Часть себестоимости неизвестна. Суммы включают только известные расходы; прибыль предварительная. На складе без оценки: @inventory.UnvaluedQuantity ед.</p>
        }
        @if (errorMessage is not null)
        {
            <div class="dona-state dona-state--error" role="alert">@errorMessage</div>
        }
        <div class="dona-tabs" role="group" aria-label="Период аналитики">
            <button class="@(period == 7 ? "active" : null)" @onclick="() => SetPeriod(7)">7 дней</button>
            <button class="@(period == 30 ? "active" : null)" @onclick="() => SetPeriod(30)">30 дней</button>
            <button class="@(period == 90 ? "active" : null)" @onclick="() => SetPeriod(90)">90 дней</button>
            <button class="@(period == 0 ? "active" : null)" @onclick="AllTime">Всё время</button>
        </div>
        <details class="custom-period">
            <summary>Свой период</summary>
            <div class="dona-field-row">
                <label class="dona-field">С даты<OrbitDatePicker @bind-Value="from" ValueChangedAfter="_ => Rebuild()" /></label>
                <label class="dona-field">По дату<OrbitDatePicker @bind-Value="to" ValueChangedAfter="_ => Rebuild()" /></label>
            </div>
        </details>
        @if (report.Expenses.Count > 0)
        {
            <details class="dona-section">
                <summary>Потери и доначисления периода · @Money(report.PeriodExpensesUzs)</summary>
                @foreach (var expense in report.Expenses)
                {
                    <p>@expense.At.ToLocalTime().ToString("dd.MM.yyyy") · @expense.Source · @expense.Reason · @(expense.Amount is null ? "Стоимость неизвестна" : Money(expense.Amount.Value))</p>
                }
            </details>
        }
        <section class="dona-kpis dona-kpis--4 sales-overview">
            <article class="dona-kpi"><span>Выручка</span><strong>@Money(report.RevenueUzs)</strong><small>@CurrencyLabel</small></article>
            <article class="dona-kpi"><span>Прибыль</span><strong class="@(report.ProfitUzs < 0 ? "negative" : null)">@Money(report.ProfitUzs)</strong><small>маржа @report.MarginPercent.ToString("N1")%</small></article>
            <article class="dona-kpi"><span>Заказы</span><strong>@report.Orders</strong><small>@report.Units единиц</small></article>
            <article class="dona-kpi"><span>Средний чек</span><strong>@Money(report.AverageCheckUzs)</strong><small>@CurrencyLabel</small></article>
        </section>
        <section class="dona-section">
            <div class="dona-section-title">
                <div>
                    <h2>Динамика продаж</h2>
                    <p>@PeriodLabel</p>
                </div>
            </div>
            @if (report.Daily.Count == 0)
            {
                <p class="dona-empty">Нет завершённых продаж за период.</p>
            }
            else
            {
                <div class="daily-chart">
                    @foreach (var point in report.Daily.TakeLast(14))
                    {
                        <article><span>@point.Date.ToString("dd.MM")</span><div><i style="width:@BarWidth(point.RevenueUzs)%"></i></div><strong>@ShortMoney(point.RevenueUzs)</strong></article>
                    }
                </div>
            }
        </section>
        <section class="dona-section">
            <div class="dona-section-title">
                <div>
                    <h2>Запасы</h2>
                    <p>Текущий снимок склада</p>
                </div>
                <a href="/inventory">Открыть склад</a>
            </div>
            <div class="dona-kpis">
                <article class="dona-kpi"><span>Себестоимость</span><strong>@Money(inventory.InventoryCostUzs)</strong></article>
                <article class="dona-kpi"><span>Потенциал прибыли</span><strong>@Money(inventory.PotentialProfitUzs)</strong></article>
                <article class="dona-kpi @(inventory.LowStockVariants > 0 ? "warning" : null)"><span>Заканчивается</span><strong>@inventory.LowStockVariants</strong></article>
                <article class="dona-kpi @(inventory.StaleInventoryCostUzs > 0 ? "warning" : null)"><span>Залежалось</span><strong>@Money(inventory.StaleInventoryCostUzs)</strong></article>
            </div>
            @if (InventorySignals.Any())
            {
                <ul class="signal-list">
                    @foreach (var row in InventorySignals.Take(5))
                    {
                        <li>
                            <span><strong>@row.ProductName</strong><small>@Variant(row)</small></span>
                            <b>@(row.IsStale ? row.OldestLayerAgeDays is { } age ? $"Старейшая партия: {age} дн." : $"{row.InactiveDays} дн. без движения" : $"Осталось {row.AvailableQuantity}")</b>
                        </li>
                    }
                </ul>
            }
        </section>
        <section class="dona-section">
            <div class="dona-section-title">
                <div>
                    <h2>Рейтинг</h2>
                    <p>Лучшие результаты выбранного среза</p>
                </div>
            </div>
            <label class="dona-field">Срез<OrbitSelect TValue="string" @bind-Value="ranking" Options="@RankingOptions" Label="Срез рейтинга" /></label>
            @if (ranking == "content")
            {
                @if (profit.Content.Count == 0)
                {
                    <p class="dona-empty">Нет опубликованного контента с продажами.</p>
                }
                else
                {
                    <ul class="ranking-list">
                        @foreach (var row in profit.Content.Take(10))
                        {
                            <li>
                                <span><strong>@row.Name</strong><small>@row.Format · @row.Orders заказов · @row.Quantity шт.</small></span>
                                <b>@Money(row.ProfitUzs)<small>прибыль</small></b>
                            </li>
                        }
                    </ul>
                }
            }
            else
            {
                @if (CurrentRows.Count == 0)
                {
                    <p class="dona-empty">Недостаточно данных для рейтинга.</p>
                }
                else
                {
                    <ul class="ranking-list">
                        @foreach (var row in CurrentRows.Take(10))
                        {
                            <li>
                                <span><strong>@row.Name</strong><small>@row.Orders заказов · @row.Quantity шт.</small></span>
                                <b class="@(row.ProfitUzs < 0 ? "negative" : null)">@Money(row.ProfitUzs)<small>прибыль</small></b>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }
</div>
@code {
    private IReadOnlyList<Sale> sales = [];
    private IReadOnlyList<Product> products = [];
    private IReadOnlyList<Purchase> purchases = [];
    private MarketingData marketing = new();
    private IReadOnlyList<StockMovement> movements = [];
    private BusinessSettings settings = new();
    private AnalyticsReport report = new();
    private ProfitAnalyticsReport profit = new();
    private InventoryAnalyticsReport inventory = new();
    private DateTime? from;
    private DateTime? to = DateTime.Today;
    private int period = 30;
    private string ranking = "products";
    private bool loading = true;
    private bool loadFailed;
    private string? errorMessage;

    private static readonly IReadOnlyList<OrbitSelectOption<string>> RankingOptions =
    [
        new("products", "Товары"),
        new("categories", "Категории"),
        new("customers", "Клиенты"),
        new("suppliers", "Поставщики"),
        new("intermediaries", "Посредники"),
        new("collections", "Коллекции"),
        new("outfits", "Образы"),
        new("content", "Контент")
    ];

    private IReadOnlyList<AnalyticsRow> CurrentRows => ranking switch
    {
        "categories" => report.Categories,
        "customers" => report.Customers,
        "suppliers" => profit.Suppliers,
        "intermediaries" => profit.Intermediaries,
        "collections" => profit.Collections,
        "outfits" => profit.Outfits,
        _ => report.Products
    };

    private IEnumerable<InventoryAnalyticsRow> InventorySignals => inventory.Rows
        .Where(value => value.IsStale || value.IsLowStock)
        .OrderByDescending(value => value.IsStale)
        .ThenBy(value => value.AvailableQuantity);

    private decimal MaxDaily => report.Daily.Count == 0 ? 0 : report.Daily.Max(value => value.RevenueUzs);

    private string CurrencyLabel => $"{settings.MainCurrencyCode} · {CurrencyCodes.Symbol(settings.MainCurrencyCode)}";

    private string PeriodLabel => from is null ? "За всё время" : $"{from:dd.MM.yyyy} — {to:dd.MM.yyyy}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var salesTask = Sales.GetSalesAsync();
            var productsTask = Catalog.GetProductsAsync();
            var purchasesTask = Commerce.GetPurchasesAsync();
            var marketingTask = Marketing.GetDataAsync();
            var movementTask = Movements.GetAsync();
            var settingsTask = SettingsRepository.GetAsync();
            await Task.WhenAll(salesTask, productsTask, purchasesTask, marketingTask, movementTask, settingsTask);
            sales = await salesTask;
            products = await productsTask;
            purchases = await purchasesTask;
            marketing = await marketingTask;
            movements = await movementTask;
            settings = await settingsTask;
            SetPeriod(Math.Max(1, settings.DefaultAnalyticsPeriodDays));
        }
        catch (Exception exception)
        {
            loadFailed = true;
            errorMessage = UserErrors.Describe(exception, "Не удалось загрузить аналитику. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private void SetPeriod(int days)
    {
        period = days;
        to = DateTime.Today;
        from = to.Value.AddDays(-(days - 1));
        Rebuild();
    }

    private void AllTime()
    {
        period = 0;
        from = null;
        to = null;
        Rebuild();
    }

    private void Rebuild()
    {
        try
        {
            report = AnalyticsService.Build(sales, products, from, to, purchases, movements);
            profit = ProfitService.Build(sales, products, purchases, marketing, from, to, movements);
            inventory = InventoryService.Build(products, sales, movements, settings);
            errorMessage = null;
        }
        catch (Exception exception)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось пересчитать аналитику. Попробуйте ещё раз.");
        }
    }

    private decimal BarWidth(decimal value) => MaxDaily == 0 ? 0 : Math.Max(3, Math.Round(value / MaxDaily * 100, 1));

    private static string Variant(InventoryAnalyticsRow value) =>
        string.Join(" · ", new[] { value.Color, value.Size, value.Sku }.Where(text => !string.IsNullOrWhiteSpace(text)));

    private static string ShortMoney(decimal value) =>
        value >= 1_000_000 ? $"{value / 1_000_000:N1}M" : value >= 1_000 ? $"{value / 1_000:N0}K" : value.ToString("N0");

    private static string Money(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));
}
