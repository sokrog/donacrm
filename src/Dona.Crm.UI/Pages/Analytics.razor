@page "/analytics"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ISalesRepository Sales
@inject ICatalogRepository Catalog
@inject ICommerceRepository Commerce
@inject IMarketingRepository Marketing
@inject IStockMovementRepository Movements
@inject IBusinessSettingsRepository SettingsRepository
@inject AnalyticsService AnalyticsService
@inject InventoryAnalyticsService InventoryService
@inject ProfitAnalyticsService ProfitService

<PageTitle>Аналитика — DONA CRM</PageTitle>
<div class="analytics-page">
    <header><div><a href="/more">Ещё</a><h1>Аналитика</h1></div></header>
    @if(loading){<div class="analytics-state">Собираем показатели…</div>}
    else
    {
        <div class="period-tabs" role="group" aria-label="Период аналитики"><button class="@(period==7?"active":null)" @onclick="()=>SetPeriod(7)">7 дней</button><button class="@(period==30?"active":null)" @onclick="()=>SetPeriod(30)">30 дней</button><button class="@(period==90?"active":null)" @onclick="()=>SetPeriod(90)">90 дней</button><button class="@(period==0?"active":null)" @onclick="AllTime">Всё время</button></div>
        <details class="custom-period"><summary>Свой период</summary><div class="field-row"><label>С даты<OrbitDatePicker @bind-Value="from" ValueChangedAfter="_=>Rebuild()" /></label><label>По дату<OrbitDatePicker @bind-Value="to" ValueChangedAfter="_=>Rebuild()" /></label></div></details>
        <section class="sales-overview"><article><span>Выручка</span><strong>@Money(report.RevenueUzs)</strong><small>@CurrencyLabel</small></article><article><span>Прибыль</span><strong class="@(report.ProfitUzs<0?"negative":null)">@Money(report.ProfitUzs)</strong><small>маржа @report.MarginPercent.ToString("N1")%</small></article><article><span>Заказы</span><strong>@report.Orders</strong><small>@report.Units единиц</small></article><article><span>Средний чек</span><strong>@Money(report.AverageCheckUzs)</strong><small>@CurrencyLabel</small></article></section>
        <section><div class="section-heading"><div><h2>Динамика продаж</h2><p>@PeriodLabel</p></div></div>@if(report.Daily.Count==0){<p class="empty-chart">Нет завершённых продаж за период.</p>}else{<div class="daily-chart">@foreach(var point in report.Daily.TakeLast(14)){<article><span>@point.Date.ToString("dd.MM")</span><div><i style="width:@BarWidth(point.RevenueUzs)%"></i></div><strong>@ShortMoney(point.RevenueUzs)</strong></article>}</div>}</section>
        <section><div class="section-heading"><div><h2>Запасы</h2><p>Текущий снимок склада</p></div><a href="/inventory">Открыть склад</a></div><div class="inventory-grid"><article><span>Себестоимость</span><strong>@Money(inventory.InventoryCostUzs)</strong></article><article><span>Потенциал прибыли</span><strong>@Money(inventory.PotentialProfitUzs)</strong></article><article class="@(inventory.LowStockVariants>0?"warning":null)"><span>Заканчивается</span><strong>@inventory.LowStockVariants</strong></article><article class="@(inventory.StaleInventoryCostUzs>0?"warning":null)"><span>Залежалось</span><strong>@Money(inventory.StaleInventoryCostUzs)</strong></article></div>@if(InventorySignals.Any()){<ul class="signal-list">@foreach(var row in InventorySignals.Take(5)){<li><span><strong>@row.ProductName</strong><small>@Variant(row)</small></span><b>@(row.IsStale?$"{row.InactiveDays} дн. без движения":$"Осталось {row.AvailableQuantity}")</b></li>}</ul>}</section>
        <section><div class="section-heading"><div><h2>Рейтинг</h2><p>Лучшие результаты выбранного среза</p></div></div><label class="ranking-select">Срез<select @bind="ranking"><option value="products">Товары</option><option value="categories">Категории</option><option value="customers">Клиенты</option><option value="suppliers">Поставщики</option><option value="intermediaries">Посредники</option><option value="collections">Коллекции</option><option value="outfits">Образы</option><option value="content">Контент</option></select></label>@if(ranking=="content"){@if(profit.Content.Count==0){<p class="empty-chart">Нет опубликованного контента с продажами.</p>}else{<ul class="ranking-list">@foreach(var row in profit.Content.Take(10)){<li><span><strong>@row.Name</strong><small>@row.Format · @row.Orders заказов · @row.Quantity шт.</small></span><b>@Money(row.ProfitUzs)<small>прибыль</small></b></li>}</ul>}}else{@if(CurrentRows.Count==0){<p class="empty-chart">Недостаточно данных для рейтинга.</p>}else{<ul class="ranking-list">@foreach(var row in CurrentRows.Take(10)){<li><span><strong>@row.Name</strong><small>@row.Orders заказов · @row.Quantity шт.</small></span><b class="@(row.ProfitUzs<0?"negative":null)">@Money(row.ProfitUzs)<small>прибыль</small></b></li>}</ul>}}</section>
    }
</div>
@code{
    private IReadOnlyList<Sale> sales=[];private IReadOnlyList<Product> products=[];private IReadOnlyList<Purchase> purchases=[];private MarketingData marketing=new();private IReadOnlyList<StockMovement> movements=[];private BusinessSettings settings=new();private AnalyticsReport report=new();private ProfitAnalyticsReport profit=new();private InventoryAnalyticsReport inventory=new();private DateTime? from;private DateTime? to=DateTime.Today;private int period=30;private string ranking="products";private bool loading=true;
    private IReadOnlyList<AnalyticsRow> CurrentRows=>ranking switch{"categories"=>report.Categories,"customers"=>report.Customers,"suppliers"=>profit.Suppliers,"intermediaries"=>profit.Intermediaries,"collections"=>profit.Collections,"outfits"=>profit.Outfits,_=>report.Products};private IEnumerable<InventoryAnalyticsRow> InventorySignals=>inventory.Rows.Where(value=>value.IsStale||value.IsLowStock).OrderByDescending(value=>value.IsStale).ThenBy(value=>value.AvailableQuantity);private decimal MaxDaily=>report.Daily.Count==0?0:report.Daily.Max(value=>value.RevenueUzs);private string CurrencyLabel=>$"{settings.MainCurrencyCode} · {CurrencyCodes.Symbol(settings.MainCurrencyCode)}";private string PeriodLabel=>from is null?"За всё время":$"{from:dd.MM.yyyy} — {to:dd.MM.yyyy}";
    protected override async Task OnInitializedAsync(){var salesTask=Sales.GetSalesAsync();var productsTask=Catalog.GetProductsAsync();var purchasesTask=Commerce.GetPurchasesAsync();var marketingTask=Marketing.GetDataAsync();var movementTask=Movements.GetAsync();var settingsTask=SettingsRepository.GetAsync();await Task.WhenAll(salesTask,productsTask,purchasesTask,marketingTask,movementTask,settingsTask);sales=await salesTask;products=await productsTask;purchases=await purchasesTask;marketing=await marketingTask;movements=await movementTask;settings=await settingsTask;SetPeriod(Math.Max(1,settings.DefaultAnalyticsPeriodDays));loading=false;}
    private void SetPeriod(int days){period=days;to=DateTime.Today;from=to.Value.AddDays(-(days-1));Rebuild();}private void AllTime(){period=0;from=null;to=null;Rebuild();}private void Rebuild(){report=AnalyticsService.Build(sales,products,from,to);profit=ProfitService.Build(sales,products,purchases,marketing,from,to);inventory=InventoryService.Build(products,sales,movements,settings);}
    private decimal BarWidth(decimal value)=>MaxDaily==0?0:Math.Max(3,Math.Round(value/MaxDaily*100,1));private static string Variant(InventoryAnalyticsRow value)=>string.Join(" · ",new[]{value.Color,value.Size,value.Sku}.Where(text=>!string.IsNullOrWhiteSpace(text)));private static string ShortMoney(decimal value)=>value>=1_000_000?$"{value/1_000_000:N1}M":value>=1_000?$"{value/1_000:N0}K":value.ToString("N0");private static string Money(decimal value)=>value.ToString("N0",CultureInfo.GetCultureInfo("ru-RU"));
}
