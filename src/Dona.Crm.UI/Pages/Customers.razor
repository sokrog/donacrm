@page "/customers"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject ISalesRepository SalesRepository

<PageTitle>Клиенты — DONA CRM</PageTitle>
<div class="customers-page">
    <header>
        <div class="orbit-secondary-heading">
            <a class="orbit-icon-button orbit-back-button" href="/sales" aria-label="Вернуться к продажам"><OrbitIcon Name="back" /></a>
            <div>
                <p>Продажи</p>
                <h1>Клиенты</h1>
            </div>
        </div>
        <button class="orbit-icon-button orbit-add-button" type="button" aria-label="Добавить клиента" @onclick="NewCustomer"><OrbitIcon Name="plus" /></button>
    </header>
    @if (errorMessage is not null && editing is null)
    {
        <p class="delete-error" role="alert">@errorMessage</p>
    }
    @if (editing is not null)
    {
        <EditForm Model="editing" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <section>
                <h2>@(isNew ? "Новый клиент" : "Редактирование")</h2>
                <label>
                    Имя
                    <InputText @bind-Value="editing.Name" />
                    <ValidationMessage For="() => editing.Name" />
                </label>
                <label>Телефон<InputText @bind-Value="editing.Phone" inputmode="tel" /></label>
                <div class="field-row">
                    <label>Instagram<InputText @bind-Value="editing.Instagram" /></label>
                    <label>Telegram<InputText @bind-Value="editing.Telegram" /></label>
                </div>
                <label>Адрес<InputText @bind-Value="editing.Address" /></label>
                <label>Заметка<InputTextArea @bind-Value="editing.Notes" /></label>
                @if (errorMessage is not null)
                {
                    <p class="delete-error" role="alert">@errorMessage</p>
                }
                @if (confirmDelete)
                {
                    <div class="delete-confirm">
                        <span>Удалить клиента? Продажи останутся в истории.</span>
                        <button type="button" class="secondary" @onclick="() => confirmDelete = false">Нет</button>
                        <button type="button" class="danger" disabled="@saving" @onclick="DeleteAsync">Да, удалить</button>
                    </div>
                }
                <div class="form-actions">
                    <button type="button" class="secondary" @onclick="CloseEditor">Отмена</button>
                    @if (!isNew && !confirmDelete)
                    {
                        <button type="button" class="danger" @onclick="() => confirmDelete = true">Удалить</button>
                    }
                    <button disabled="@saving">Сохранить</button>
                </div>
            </section>
        </EditForm>
    }
    @if (loading)
    {
        <div class="customer-state">Загружаем клиентов…</div>
    }
    else if (customers.Count == 0)
    {
        <div class="customer-state">
            <strong>Клиентов пока нет</strong>
            <p>Добавьте контакт или создавайте продажи без клиента.</p>
        </div>
    }
    else
    {
        <ul class="customer-list">
            @foreach (var customer in customers.OrderBy(value => value.Name))
            {
                <li>
                    <button type="button" @onclick="() => EditCustomer(customer)">
                        <InitialBadge Text="@customer.Name" Variant="round" />
                        <span>
                            <strong>@customer.Name</strong>
                            <small>@Contact(customer)</small>
                        </span>
                        <b>@sales.Count(value => value.CustomerId == customer.Id)<small>заказов</small></b>
                    </button>
                </li>
            }
        </ul>
    }
</div>
@code {
    private IReadOnlyList<Customer> customers = [];
    private IReadOnlyList<Sale> sales = [];
    private Customer? editing;
    private UnsavedChangesGuard? unsavedGuard;
    private bool isNew;
    private bool loading = true;
    private bool saving;
    private bool confirmDelete;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            customers = await SalesRepository.GetCustomersAsync();
            sales = await SalesRepository.GetSalesAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = $"Не удалось загрузить клиентов: {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void NewCustomer()
    {
        editing = new Customer();
        isNew = true;
        confirmDelete = false;
        errorMessage = null;
    }

    private void EditCustomer(Customer value)
    {
        editing = new Customer
        {
            Id = value.Id,
            Name = value.Name,
            Phone = value.Phone,
            Instagram = value.Instagram,
            Telegram = value.Telegram,
            Address = value.Address,
            Notes = value.Notes,
            CreatedAt = value.CreatedAt
        };
        isNew = false;
        confirmDelete = false;
        errorMessage = null;
    }

    private async Task CloseEditor()
    {
        try
        {
            if (unsavedGuard is not null && !await unsavedGuard.ConfirmDiscardAsync())
            {
                return;
            }

            CloseEditorCore();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = $"Не удалось закрыть редактор: {exception.Message}";
        }
    }

    private void CloseEditorCore()
    {
        editing = null;
        confirmDelete = false;
        errorMessage = null;
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        try
        {
            await SalesRepository.UpsertCustomerAsync(editing!);
            unsavedGuard?.MarkClean();
            CloseEditorCore();
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = $"Не удалось сохранить клиента: {exception.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        errorMessage = null;
        try
        {
            var orders = (await SalesRepository.GetSalesAsync()).Count(value => value.CustomerId == editing!.Id);
            if (orders > 0)
            {
                confirmDelete = false;
                errorMessage = $"Нельзя удалить клиента: у него {orders} заказ(ов). Продажи ссылаются на карточку клиента.";
                return;
            }

            await SalesRepository.DeleteCustomerAsync(editing!.Id);
            unsavedGuard?.MarkClean();
            CloseEditorCore();
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            confirmDelete = false;
            errorMessage = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private static string Contact(Customer value) => value.Phone ?? value.Telegram ?? value.Instagram ?? "Контакты не указаны";
}
