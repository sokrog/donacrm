@page "/customers"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject ISalesRepository SalesRepository

<PageTitle>Клиенты — DONA CRM</PageTitle>
<div class="dona-page dona-page--wide">
    <header class="dona-page-header">
        <div>
            <p class="dona-eyebrow">Заказы</p>
            <h1 class="dona-title">Клиенты</h1>
        </div>
        <a class="dona-icon-button dona-add-button" href="/customers/new" aria-label="Добавить клиента"><OrbitIcon Name="plus" /></a>
    </header>
    <SalesNavigation Customers="true" />
    @if (errorMessage is not null)
    {
        <p class="dona-message dona-message--error" role="alert">@errorMessage</p>
    }
    @if (loading)
    {
        <div class="dona-state">Загружаем клиентов…</div>
    }
    else if (customers.Count == 0)
    {
        <div class="dona-state">
            <strong>Клиентов пока нет</strong>
            <p>Добавьте контакт или создавайте продажи без клиента.</p>
        </div>
    }
    else
    {
        <ul class="customer-list">
            @foreach (var customer in customers.OrderBy(value => value.Name))
            {
                <li>
                    <a class="dona-list-row" href="@($"/customers/{customer.Id}")">
                        <InitialBadge Text="@customer.Name" Variant="round" />
                        <span>
                            <strong>@customer.Name</strong>
                            <small>@Contact(customer)</small>
                        </span>
                        <span class="dona-list-row__value">@sales.Count(value => value.CustomerId == customer.Id)<small>заказов</small></span>
                    </a>
                </li>
            }
        </ul>
    }
</div>
@code {
    private IReadOnlyList<Customer> customers = [];
    private IReadOnlyList<Sale> sales = [];
    private bool loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            customers = await SalesRepository.GetCustomersAsync();
            sales = await SalesRepository.GetSalesAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось загрузить клиентов. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private static string Contact(Customer value) => value.Phone ?? value.Telegram ?? value.Instagram ?? "Контакты не указаны";
}
