@page "/"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject HomeDashboardService Dashboard
@inject IGoogleSyncService Sync
@inject IGoogleConnectionService Google
@inject ICatalogRepository Catalog
@inject IBusinessSettingsRepository SettingsRepository
@inject NavigationManager Navigation

<PageTitle>Главная — DONA CRM</PageTitle>

<div class="dona-page dona-page--wide home" aria-busy="@isLoading">
    <div class="home-brand"><img src="_content/Dona.Crm.UI/brand/dona-logo.png" alt="DONA" /></div>
    <DonaPageHeader Class="dona-page-header home-header">
        <div>
            <p class="dona-eyebrow">@DateLabel</p>
            <h1 class="dona-title">@Greeting</h1>
        </div>
        <a class="dona-icon-button dona-icon-button--round" href="/attention" aria-label="Открыть раздел «Внимание»">
            <OrbitIcon Name="bell" />
            @if (!isLoading && attentionTotal > 0) { <span class="attention-badge" aria-label="@attentionTotal сигналов">@attentionTotal</span> }
        </a>
    </DonaPageHeader>

    <div class="connection-row">
        <p class="connection @ConnectionTone" role="status"><span aria-hidden="true"></span>@ConnectionLabel</p>
        <a class="dona-icon-button dona-icon-button--round sync-shortcut" href="@SyncHref" aria-label="Открыть синхронизацию Google" title="Синхронизация Google">
            <OrbitIcon Name="cloud" />
        </a>
    </div>

    @if (errorMessage is not null)
    {
        <section class="dona-state dona-state--error" role="alert">
            <strong>Не удалось прочитать локальные данные</strong>
            <p>@errorMessage</p>
            <button type="button" class="dona-btn dona-btn--primary" @onclick="LoadAsync">Повторить</button>
        </section>
    }
    else if (isLoading)
    {
        <div class="dashboard-loading" aria-label="Загрузка главной страницы">
            <div class="loading-block hero-placeholder"></div>
            <div class="loading-row"><span></span><span></span><span></span></div>
        </div>
    }
    else
    {
        <div class="dashboard-overview">
            <article class="hero" aria-labelledby="today-revenue">
                <p class="hero-label" id="today-revenue">Выручка сегодня</p>
                <p class="revenue">@Money(todayRevenue) <span>UZS</span></p>
                <div class="hero-meta">
                    <div><span>Прибыль</span><strong>@Money(todayProfit) UZS</strong></div>
                    <div class="sales-meta"><span>Продажи</span><strong>@todaySalesCount @SaleWord(todaySalesCount)</strong></div>
                </div>
            </article>

            <div class="dona-kpis dona-kpis--3 signal-strip" aria-label="Ключевые показатели">
                <article class="dona-kpi"><span>Доступный остаток</span><strong>@availableQuantity ед.</strong></article>
                <article class="dona-kpi"><span>Входящие закупки</span><strong>@incomingQuantity ед.</strong></article>
                <article class="dona-kpi debt"><span>Долг клиентов</span><strong>@Money(customerDebt) UZS</strong></article>
            </div>
        </div>

        <div class="dashboard-columns">
            <section aria-labelledby="attention-heading">
                <div class="section-heading">
                    <h2 id="attention-heading">Требует внимания</h2>
                    @if (attentionTotal > attentionItems.Count) { <a class="section-link" href="/attention">Все · @attentionTotal</a> }
                    else if (attentionTotal > 0) { <span>@attentionTotal @SignalWord(attentionTotal)</span> }
                </div>
                @if (attentionItems.Count == 0)
                {
                    <p class="dona-state">Сейчас всё спокойно — срочных сигналов нет.</p>
                }
                else
                {
                    <ul class="attention-list">
                        @foreach (var item in attentionItems)
                        {
                            <li><a class="dona-list-row" href="@item.Href"><span class="dona-icon-tile @item.Tone"><OrbitIcon Name="@item.Icon" /></span><span>@item.Text</span><b aria-hidden="true">›</b></a></li>
                        }
                    </ul>
                }
            </section>

            <div class="dashboard-secondary">
                <section aria-labelledby="actions-heading">
                    <div class="section-heading"><h2 id="actions-heading">Быстрые действия</h2></div>
                    <div class="actions-grid">
                        <a class="action" href="/products/new"><span class="dona-icon-tile"><OrbitIcon Name="catalog" /></span><span>Добавить товар</span></a>
                        <a class="action" href="/sales/new"><span class="dona-icon-tile"><OrbitIcon Name="sales" /></span><span>Создать продажу</span></a>
                        <a class="action" href="/purchases/new"><span class="dona-icon-tile"><OrbitIcon Name="truck" /></span><span>Создать закупку</span></a>
                        <a class="action" href="/inventory/adjustment/new"><span class="dona-icon-tile"><OrbitIcon Name="adjust" /></span><span>Изменить остаток</span></a>
                    </div>
                </section>

                <section aria-labelledby="activity-heading">
                    <div class="section-heading"><h2 id="activity-heading">Последняя активность</h2></div>
                    @if (activityItems.Count == 0)
                    {
                        <p class="dona-state">Операций пока нет. Начните с продажи или корректировки остатка.</p>
                    }
                    else
                    {
                        <ol class="activity-list">
                            @foreach (var item in activityItems)
                            {
                                <li><a class="activity-item" href="@item.Href"><span class="activity-mark"><OrbitIcon Name="@item.Icon" /></span><div><strong>@item.Title</strong><p>@item.Caption</p></div></a></li>
                            }
                        </ol>
                    }
                </section>
            </div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private bool isLoading = true;
    private string? errorMessage;
    private decimal todayRevenue;
    private decimal todayProfit;
    private decimal customerDebt;
    private int todaySalesCount;
    private int availableQuantity;
    private int incomingQuantity;
    private List<AttentionItem> attentionItems = [];
    private int attentionTotal;
    private List<ActivityItem> activityItems = [];
    private GoogleSyncStatus syncStatus = new(GoogleSyncState.LocalOnly);
    private bool googleConnected;
    private string? accountName;

    private string DateLabel => DateTime.Now.ToString("dddd, d MMMM", RussianCulture);
    private string Greeting
    {
        get
        {
            var greeting = DateTime.Now.Hour switch { < 6 => "Доброй ночи", < 12 => "Доброе утро", < 18 => "Добрый день", _ => "Добрый вечер" };
            return string.IsNullOrWhiteSpace(accountName) ? greeting : $"{greeting}, {accountName}";
        }
    }
    private string ConnectionLabel => errorMessage is not null
        ? "Локальное хранилище недоступно"
        : isLoading
            ? "Читаем локальные данные"
            : syncStatus.State switch
            {
                GoogleSyncState.LocalOnly when !googleConnected => "Работа только локально",
                GoogleSyncState.LocalOnly => "Google подключён · данные на устройстве",
                GoogleSyncState.Pending => "Есть изменения для синхронизации",
                GoogleSyncState.Synced when syncStatus.LastSuccessfulAt is not null =>
                    $"Синхронизировано · {syncStatus.LastSuccessfulAt.Value.ToLocalTime():dd.MM HH:mm}",
                GoogleSyncState.Synced => "Синхронизировано",
                GoogleSyncState.Conflict => "Требуется разрешить конфликт",
                GoogleSyncState.Error => "Ошибка синхронизации",
                _ => "Локальные данные загружены"
            };
    private string ConnectionTone => errorMessage is not null || syncStatus.State == GoogleSyncState.Error
        ? "error"
        : syncStatus.State == GoogleSyncState.Conflict
            ? "conflict"
            : syncStatus.State == GoogleSyncState.Pending
                ? "pending"
                : string.Empty;
    private string SyncHref => googleConnected && syncStatus.State is GoogleSyncState.Pending or GoogleSyncState.Conflict or GoogleSyncState.Error ? "/sync" : "/connections";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var dashboardTask = Dashboard.LoadAsync(DateTimeOffset.Now);
            var productsTask = Catalog.GetProductsAsync();
            var settingsTask = SettingsRepository.GetAsync();
            await Task.WhenAll(dashboardTask, productsTask, settingsTask);
            var products = await productsTask;
            var settings = await settingsTask;
            if (products.Count == 0 && !settings.OnboardingCompleted)
            {
                Navigation.NavigateTo("/welcome", replace: true);
                return;
            }
            if (products.Count > 0 && !settings.OnboardingCompleted)
            {
                settings.OnboardingCompleted = true;
                await SettingsRepository.SaveAsync(settings);
            }

            BuildDashboard(await dashboardTask);
            var googleState = await Google.GetStateAsync();
            googleConnected = googleState.IsConnected;
            accountName = googleState.AccountName ?? googleState.AccountEmail;
            try
            {
                syncStatus = await Sync.GetStatusAsync();
            }
            catch (Exception exception)
            {
                syncStatus = new(GoogleSyncState.Error, Error: UserErrors.Describe(exception, "Не удалось проверить синхронизацию. Попробуйте ещё раз."));
            }
        }
        catch (Exception exception)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось загрузить главную страницу. Попробуйте ещё раз.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BuildDashboard(
        HomeDashboardSnapshot snapshot)
    {
        todayRevenue = snapshot.TodayRevenueUzs;
        todayProfit = snapshot.TodayProfitUzs;
        todaySalesCount = snapshot.TodaySalesCount;
        customerDebt = snapshot.CustomerDebtUzs;
        availableQuantity = snapshot.AvailableQuantity;
        incomingQuantity = snapshot.IncomingQuantity;
        var allAttention = BuildAttention(snapshot).ToList();
        attentionTotal = allAttention.Count;
        attentionItems = allAttention.Take(4).ToList();
        activityItems = BuildActivity(snapshot).OrderByDescending(item => item.CreatedAt).Take(4).ToList();
    }

    private static IEnumerable<AttentionItem> BuildAttention(HomeDashboardSnapshot snapshot)
    {
        foreach (var product in snapshot.LowStockProducts)
            yield return new("catalog", string.Empty, $"{product.Name} — осталось {product.Quantity} ед.", $"/products/{product.Id}");

        foreach (var sale in snapshot.SalesWithDebt)
            yield return new("clock", "warning", $"{sale.Number} · {sale.CustomerName ?? "клиент"} — долг {Money(sale.BalanceDueUzs)} UZS", $"/sales/{sale.Id}");

        foreach (var purchase in snapshot.DuePurchases)
            yield return new("truck", "success", $"{purchase.Number} — ожидается, {purchase.Items.Sum(item => item.MissingQuantity)} ед.", $"/purchases/{purchase.Id}");

        foreach (var product in snapshot.ProductsWithoutImages)
            yield return new("image", "rose", $"{product.Name} — нет фотографии", $"/products/{product.Id}");
    }

    private static IEnumerable<ActivityItem> BuildActivity(HomeDashboardSnapshot snapshot)
    {
        foreach (var sale in snapshot.RecentSales)
            yield return new("check", $"{sale.Number} · {sale.CustomerName ?? "клиент"} — {Money(sale.NetTotalUzs)} UZS", $"{sale.Status.Display()} · {RelativeTime(sale.CreatedAt)}", sale.CreatedAt, $"/sales/{sale.Id}");

        foreach (var movement in snapshot.RecentMovements)
            yield return new("warehouse", $"{movement.ProductName} · {SignedQuantity(movement.QuantityDelta)} ед.", $"{movement.Type.Display()} · {RelativeTime(movement.CreatedAt)}", movement.CreatedAt, $"/products/{movement.ProductId}");
    }

    private static string Money(decimal value) => value.ToString("N0", RussianCulture);
    private static string SignedQuantity(int value) => value > 0 ? $"+{value}" : value.ToString(RussianCulture);
    private static string SaleWord(int count) => count == 1 ? "продажа" : count is >= 2 and <= 4 ? "продажи" : "продаж";
    private static string SignalWord(int count) => count == 1 ? "сигнал" : count is >= 2 and <= 4 ? "сигнала" : "сигналов";
    private static string RelativeTime(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.Now - value.ToLocalTime();
        if (elapsed.TotalMinutes < 1) return "только что";
        if (elapsed.TotalHours < 1) return $"{Math.Max(1, (int)elapsed.TotalMinutes)} мин назад";
        if (elapsed.TotalDays < 1) return $"{Math.Max(1, (int)elapsed.TotalHours)} ч назад";
        return value.LocalDateTime.ToString("d MMM, HH:mm", RussianCulture);
    }

    private sealed record AttentionItem(string Icon, string Tone, string Text, string Href);
    private sealed record ActivityItem(string Icon, string Title, string Caption, DateTimeOffset CreatedAt, string Href);
}
