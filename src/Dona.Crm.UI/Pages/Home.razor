@page "/"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@inject HomeDashboardService Dashboard
@inject IGoogleSyncService Sync
@inject IGoogleConnectionService Google

<PageTitle>Главная — DONA CRM</PageTitle>

<div class="orbit-home" aria-busy="@isLoading">
    <header class="home-header">
        <div>
            <p class="eyebrow">@DateLabel</p>
            <h1>@Greeting</h1>
        </div>
        <button class="icon-button" type="button" aria-label="Открыть уведомления">
            <OrbitIcon Name="bell" />
        </button>
    </header>

    <div class="connection-row">
        <p class="connection @ConnectionTone" role="status"><span aria-hidden="true"></span>@ConnectionLabel</p>
        <a class="sync-shortcut" href="/connections" aria-label="Открыть подключения Google" title="Подключения Google">
            <OrbitIcon Name="cloud" />
        </a>
    </div>

    @if (errorMessage is not null)
    {
        <section class="state-card" role="alert">
            <strong>Не удалось прочитать локальные данные</strong>
            <p>@errorMessage</p>
            <button type="button" @onclick="LoadAsync">Повторить</button>
        </section>
    }
    else if (isLoading)
    {
        <div class="dashboard-loading" aria-label="Загрузка главной страницы">
            <div class="loading-block hero-placeholder"></div>
            <div class="loading-row"><span></span><span></span><span></span></div>
        </div>
    }
    else
    {
        <div class="dashboard-overview">
            <article class="hero" aria-labelledby="today-revenue">
                <p class="hero-label" id="today-revenue">Выручка сегодня</p>
                <p class="revenue">@Money(todayRevenue) <span>UZS</span></p>
                <div class="hero-meta">
                    <div><span>Прибыль</span><strong>@Money(todayProfit) UZS</strong></div>
                    <div class="sales-meta"><span>Продажи</span><strong>@todaySalesCount @SaleWord(todaySalesCount)</strong></div>
                </div>
            </article>

            <div class="signal-strip" aria-label="Ключевые показатели">
                <article class="signal"><span>Доступный остаток</span><strong>@availableQuantity ед.</strong></article>
                <article class="signal"><span>Входящие закупки</span><strong>@incomingQuantity ед.</strong></article>
                <article class="signal debt"><span>Долг клиентов</span><strong>@Money(customerDebt) UZS</strong></article>
            </div>
        </div>

        <div class="dashboard-columns">
            <section aria-labelledby="attention-heading">
                <div class="section-heading">
                    <h2 id="attention-heading">Требует внимания</h2>
                    @if (attentionItems.Count > 0) { <span>@attentionItems.Count @SignalWord(attentionItems.Count)</span> }
                </div>
                @if (attentionItems.Count == 0)
                {
                    <p class="empty-state">Сейчас всё спокойно — срочных сигналов нет.</p>
                }
                else
                {
                    <ul class="attention-list">
                        @foreach (var item in attentionItems)
                        {
                            <li><a class="attention-item" href="@item.Href"><span class="attention-icon @item.Tone"><OrbitIcon Name="@item.Icon" /></span><span>@item.Text</span><span class="chevron" aria-hidden="true">›</span></a></li>
                        }
                    </ul>
                }
            </section>

            <div class="dashboard-secondary">
                <section aria-labelledby="actions-heading">
                    <div class="section-heading"><h2 id="actions-heading">Быстрые действия</h2></div>
                    <div class="actions-grid">
                        <a class="action" href="/products/new"><span class="action-icon"><OrbitIcon Name="catalog" /></span><span>Добавить товар</span></a>
                        <a class="action" href="/sales/new"><span class="action-icon"><OrbitIcon Name="sales" /></span><span>Создать продажу</span></a>
                        <a class="action" href="/purchases/new"><span class="action-icon"><OrbitIcon Name="truck" /></span><span>Создать закупку</span></a>
                        <a class="action" href="/inventory/adjustment/new"><span class="action-icon"><OrbitIcon Name="adjust" /></span><span>Изменить остаток</span></a>
                    </div>
                </section>

                <section aria-labelledby="activity-heading">
                    <div class="section-heading"><h2 id="activity-heading">Последняя активность</h2><span>Последние операции</span></div>
                    @if (activityItems.Count == 0)
                    {
                        <p class="empty-state">Операций пока нет. Начните с продажи или корректировки остатка.</p>
                    }
                    else
                    {
                        <ol class="activity-list">
                            @foreach (var item in activityItems)
                            {
                                <li><span class="activity-mark"><OrbitIcon Name="@item.Icon" /></span><div><strong>@item.Title</strong><p>@item.Caption</p></div></li>
                            }
                        </ol>
                    }
                </section>
            </div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private bool isLoading = true;
    private string? errorMessage;
    private decimal todayRevenue;
    private decimal todayProfit;
    private decimal customerDebt;
    private int todaySalesCount;
    private int availableQuantity;
    private int incomingQuantity;
    private List<AttentionItem> attentionItems = [];
    private List<ActivityItem> activityItems = [];
    private GoogleSyncStatus syncStatus = new(GoogleSyncState.LocalOnly);
    private bool googleConnected;
    private string? accountName;

    private string DateLabel => DateTime.Now.ToString("dddd, d MMMM", RussianCulture);
    private string Greeting
    {
        get
        {
            var greeting = DateTime.Now.Hour switch { < 6 => "Доброй ночи", < 12 => "Доброе утро", < 18 => "Добрый день", _ => "Добрый вечер" };
            return string.IsNullOrWhiteSpace(accountName) ? greeting : $"{greeting}, {accountName}";
        }
    }
    private string ConnectionLabel => errorMessage is not null
        ? "Локальное хранилище недоступно"
        : isLoading
            ? "Читаем локальные данные"
            : syncStatus.State switch
            {
                GoogleSyncState.LocalOnly when !googleConnected => "Работа только локально",
                GoogleSyncState.LocalOnly => "Google подключён · данные на устройстве",
                GoogleSyncState.Pending => "Есть изменения для синхронизации",
                GoogleSyncState.Synced when syncStatus.LastSuccessfulAt is not null =>
                    $"Синхронизировано · {syncStatus.LastSuccessfulAt.Value.ToLocalTime():dd.MM HH:mm}",
                GoogleSyncState.Synced => "Синхронизировано",
                GoogleSyncState.Conflict => "Требуется разрешить конфликт",
                GoogleSyncState.Error => "Ошибка синхронизации",
                _ => "Локальные данные загружены"
            };
    private string ConnectionTone => errorMessage is not null || syncStatus.State == GoogleSyncState.Error
        ? "error"
        : syncStatus.State == GoogleSyncState.Conflict
            ? "conflict"
            : syncStatus.State == GoogleSyncState.Pending
                ? "pending"
                : string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            BuildDashboard(await Dashboard.LoadAsync(DateTimeOffset.Now));
            var googleState = await Google.GetStateAsync();
            googleConnected = googleState.IsConnected;
            accountName = googleState.AccountName;
            try
            {
                syncStatus = await Sync.GetStatusAsync();
            }
            catch (Exception exception)
            {
                syncStatus = new(GoogleSyncState.Error, Error: exception.Message);
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BuildDashboard(
        HomeDashboardSnapshot snapshot)
    {
        todayRevenue = snapshot.TodayRevenueUzs;
        todayProfit = snapshot.TodayProfitUzs;
        todaySalesCount = snapshot.TodaySalesCount;
        customerDebt = snapshot.CustomerDebtUzs;
        availableQuantity = snapshot.AvailableQuantity;
        incomingQuantity = snapshot.IncomingQuantity;
        attentionItems = BuildAttention(snapshot).Take(4).ToList();
        activityItems = BuildActivity(snapshot).OrderByDescending(item => item.CreatedAt).Take(4).ToList();
    }

    private static IEnumerable<AttentionItem> BuildAttention(HomeDashboardSnapshot snapshot)
    {
        foreach (var product in snapshot.LowStockProducts)
            yield return new("catalog", string.Empty, $"{product.Name} — осталось {product.Quantity} ед.", "/products");

        foreach (var sale in snapshot.SalesWithDebt)
            yield return new("clock", "amber", $"{sale.Number} · {sale.CustomerName ?? "клиент"} — долг {Money(sale.BalanceDueUzs)} UZS", "/sales");

        foreach (var purchase in snapshot.DuePurchases)
            yield return new("truck", "cyan", $"{purchase.Number} — ожидается, {purchase.Items.Sum(item => item.MissingQuantity)} ед.", "/purchases");

        foreach (var product in snapshot.ProductsWithoutImages)
            yield return new("image", "magenta", $"{product.Name} — нет фотографии", "/products");
    }

    private static IEnumerable<ActivityItem> BuildActivity(HomeDashboardSnapshot snapshot)
    {
        foreach (var sale in snapshot.RecentSales)
            yield return new("check", $"{sale.Number} · {sale.CustomerName ?? "клиент"} — {Money(sale.NetTotalUzs)} UZS", $"{sale.Status.Display()} · {RelativeTime(sale.CreatedAt)}", sale.CreatedAt);

        foreach (var movement in snapshot.RecentMovements)
            yield return new("catalog", $"{movement.ProductName} · {SignedQuantity(movement.QuantityDelta)} ед.", $"{movement.Type.Display()} · {RelativeTime(movement.CreatedAt)}", movement.CreatedAt);
    }

    private static string Money(decimal value) => value.ToString("N0", RussianCulture);
    private static string SignedQuantity(int value) => value > 0 ? $"+{value}" : value.ToString(RussianCulture);
    private static string SaleWord(int count) => count == 1 ? "продажа" : count is >= 2 and <= 4 ? "продажи" : "продаж";
    private static string SignalWord(int count) => count == 1 ? "сигнал" : count is >= 2 and <= 4 ? "сигнала" : "сигналов";
    private static string RelativeTime(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.Now - value.ToLocalTime();
        if (elapsed.TotalMinutes < 1) return "только что";
        if (elapsed.TotalHours < 1) return $"{Math.Max(1, (int)elapsed.TotalMinutes)} мин назад";
        if (elapsed.TotalDays < 1) return $"{Math.Max(1, (int)elapsed.TotalHours)} ч назад";
        return value.LocalDateTime.ToString("d MMM, HH:mm", RussianCulture);
    }

    private sealed record AttentionItem(string Icon, string Tone, string Text, string Href);
    private sealed record ActivityItem(string Icon, string Title, string Caption, DateTimeOffset CreatedAt);
}
