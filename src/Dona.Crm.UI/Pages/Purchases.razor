@using Microsoft.JSInterop
@page "/purchases"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject ICommerceRepository Commerce
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS


<PageTitle>Закупки — DONA CRM</PageTitle>
<div class="dona-page dona-page--wide">
    <DonaPageHeader Class="dona-page-header">
        <div>
            <p class="dona-eyebrow">Поставка</p>
            <h1 class="dona-title">Закупки</h1>
        </div>
        <a class="dona-icon-button dona-add-button" href="/purchases/new" aria-label="Создать закупку"><OrbitIcon Name="plus" /></a>
    </DonaPageHeader>
    @if (loading)
    {
        <div class="dona-state">Загружаем закупки…</div>
    }
    else if (errorMessage is not null)
    {
        <div class="dona-state dona-state--error" role="alert"><strong>Не удалось загрузить закупки</strong><p>@errorMessage</p></div>
    }
    else
    {
        <section class="dona-kpis dona-kpis--3 purchase-metrics">
            <article class="dona-kpi"><span>В пути</span><strong>@Active.Count()</strong><small>закупок</small></article>
            <article class="dona-kpi"><span>Ожидается</span><strong>@IncomingUnits</strong><small>единиц</small></article>
            <article class="dona-kpi @(OverdueCount > 0 ? "warning" : null)"><span>Просрочено</span><strong>@OverdueCount</strong><small>закупок</small></article>
        </section>
        @if (OverdueCount > 0)
        {
            <div class="dona-alert dona-alert--warning" role="status">Проверьте трек-коды: @OverdueCount поставок позже ожидаемой даты.</div>
        }
        <div class="purchase-tools">
            <input class="dona-input" aria-label="Поиск закупок" placeholder="Номер, партнёр или трек-код" @bind="query" @bind:event="oninput" />
            <OrbitSelect TValue="string" @bind-Value="status" Options="@PurchaseStatusFilterOptions" Label="Статус закупки" />
        </div>
        @if (!Filtered.Any())
        {
            <div class="dona-state"><strong>Закупки не найдены</strong><p>Измените фильтр или создайте первую закупку.</p></div>
        }
        else
        {
            <div class="purchase-list">
                @foreach (var item in Filtered.OrderByDescending(value => value.OrderedAt))
                {
                    <article class="dona-card purchase-card" @onclick="() => OpenPurchase(item)">
                        <div class="purchase-card-title">
                            <a class="purchase-card-link" @onclick:stopPropagation="true" href="/purchases/@item.Id">@item.Number</a>
                            <span class="dona-badge">@(item.ClosedAt is not null ? "Закрыта" : item.Status.Display())</span>
                        </div>
                        <div class="purchase-card-body">
                            <dl class="purchase-partners">
                                <div><dt>Поставщик</dt><dd class="@(string.IsNullOrWhiteSpace(item.SupplierName) ? "purchase-missing" : null)">@(string.IsNullOrWhiteSpace(item.SupplierName) ? "Не указан" : item.SupplierName)</dd></div>
                                @if (!string.IsNullOrWhiteSpace(item.IntermediaryName)) { <div><dt>Посредник</dt><dd>@item.IntermediaryName</dd></div> }
                                <div><dt>Товары</dt><dd>@item.Items.Count поз. · @item.TotalQuantity шт.</dd></div>
                            </dl>
                            <dl class="purchase-amounts">
                                <div class="purchase-total"><dt>Итого с расходами</dt>
                                    @if (item.HasCompleteCostInputs) {
                                        <dd>@Money(item.TotalCostUzs) UZS</dd>
                                        <small>@(item.IsCostFinalized ? "Все расходы внесены" : "Предварительная сумма")</small>
                                    } else { <dd class="purchase-total-pending">Пока недоступно</dd> }
                                </div>
                                <div class="purchase-money-row"><dt>Товары</dt><dd>@Goods(item)</dd></div>
                                <div class="purchase-money-row"><dt>Комиссия и доставка</dt><dd>@IntermediaryCosts(item)</dd></div>
                            </dl>
                        </div>
                        @if (!item.HasCompleteCostInputs) {
                            <a class="purchase-issue" @onclick:stopPropagation="true" href="/purchases/@item.Id/costs">@CostIssue(item) <span>К расчёту →</span></a>
                        }
                        @if (InvalidDates(item)) {
                            <a class="purchase-issue" @onclick:stopPropagation="true" href="/purchases/@item.Id">Проверьте даты: доставка указана раньше заказа.</a>
                        } else if (IsOverdue(item)) { <p class="purchase-issue">Доставка просрочена — проверьте срок у посредника или поставщика.</p> }
                        <div class="purchase-card-foot">
                            <span><span class="purchase-date-label">@(item.Status == PurchaseStatus.Draft ? "Дата заказа в черновике" : "Заказ")</span> @item.OrderedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            @if (item.EstimatedDeliveryDate is { } expected) { <span><span class="purchase-date-label">Ожидается</span> @expected.ToString("dd.MM.yyyy")</span> }
                            @if (item.ClosedAt is { } closed) { <span><span class="purchase-date-label">Закрыта</span> @closed.ToLocalTime().ToString("dd.MM.yyyy")</span> }
                            else if (item.Receipts.Count > 0) { <span><span class="purchase-date-label">Приёмка</span> @item.Receipts.Max(x => x.ReceivedAt).ToLocalTime().ToString("dd.MM.yyyy")</span> }
                            @if (!string.IsNullOrWhiteSpace(item.TrackingCode)) {
                                <button type="button" class="purchase-track" @onclick:stopPropagation="true" title="Скопировать трек-код" aria-label="@($"Скопировать трек-код {item.TrackingCode}")" @onclick="() => CopyTracking(item)">Трек: @item.TrackingCode <OrbitIcon Name="copy" /></button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>
@code {
    private IReadOnlyList<Purchase> purchases = [];

    private bool loading = true;
    private string? errorMessage;
    private string query = string.Empty;
    private string status = string.Empty;

    private static readonly IReadOnlyList<OrbitSelectOption<string>> PurchaseStatusFilterOptions =
    [
        new(string.Empty, "Все статусы"),
        .. Enum.GetValues<PurchaseStatus>().Select(value => new OrbitSelectOption<string>(value.ToString(), value.Display()))
    ];

    private IEnumerable<Purchase> Active => purchases.Where(PurchaseAvailability.IsAwaitingDelivery);

    private int IncomingUnits => Active.Sum(value => value.Items.Sum(item => item.MissingQuantity));

    private int OverdueCount => Active.Count(IsOverdue);

    private IEnumerable<Purchase> Filtered => purchases.Where(value =>
        (string.IsNullOrWhiteSpace(query)
            || value.Number.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (value.SupplierName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || (value.IntermediaryName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || (value.TrackingCode?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
        && (string.IsNullOrWhiteSpace(status) || value.Status.ToString() == status));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            purchases = await Commerce.GetPurchasesAsync();
        }
        catch (Exception exception)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось загрузить закупки. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenPurchase(Purchase value) => Navigation.NavigateTo($"/purchases/{value.Id}");

    private static string Goods(Purchase value) => value.Items.Count > 0 && value.Items.All(x => x.UnitPrice is >= 0 && x.Quantity is > 0)
        ? $"{Money(value.GoodsCost)} {value.CurrencyCode}" : "Цены ещё не заполнены";
    private static string IntermediaryCosts(Purchase value)
    {
        var expenses = value.Expenses.Where(x => x.Kind is PurchaseExpenseKind.Commission or PurchaseExpenseKind.Shipping).ToList();
        if (expenses.Count > 0 && expenses.All(x => x.Amount is not null && (x.CurrencyCode == "UZS" || x.RateUzs is > 0))) return $"{Money(expenses.Sum(x => x.AmountUzs))} UZS";
        return expenses.Count == 0 ? "Не внесены" : expenses.Any(x => x.Amount is null) ? "Суммы ещё не заполнены" : string.Join(" + ", expenses.GroupBy(x => x.CurrencyCode).Select(g => $"{Money(g.Sum(x => x.Amount ?? 0))} {g.Key}"));
    }
    private static bool InvalidDates(Purchase value) => value.EstimatedDeliveryDate?.Date < value.OrderedAt.ToLocalTime().Date;
    private static bool IsOverdue(Purchase value) => !InvalidDates(value) && value.ClosedAt is null && value.ReceivingCompletedAt is null
        && value.Status is PurchaseStatus.Ordered or PurchaseStatus.ChinaWarehouse or PurchaseStatus.Shipped or PurchaseStatus.PartiallyReceived
        && value.EstimatedDeliveryDate?.Date < DateTime.Today;
    private static string CostIssue(Purchase value) => value.ValidateCostInputs()
        .Concat(value.Validate(new System.ComponentModel.DataAnnotations.ValidationContext(value)))
        .Select(result => result.ErrorMessage).FirstOrDefault(text => !string.IsNullOrWhiteSpace(text))
        ?? "Проверьте заполнение расходов и их распределение.";
    private async Task CopyTracking(Purchase value)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", value.TrackingCode); }
        catch (Microsoft.JSInterop.JSException) { }
    }

    private static string Money(decimal value) => value.ToString("N2", CultureInfo.GetCultureInfo("ru-RU"));
}
