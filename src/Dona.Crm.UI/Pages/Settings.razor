@page "/settings"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject IBusinessSettingsRepository SettingsRepository
@inject ICatalogRepository Catalog
@inject ProductStatusService ProductStatuses
@inject BackupRestoreService BackupRestore
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject PortableBackupService PortableBackup
@inject IImageTransferStore ImageTransfers
@implements IDisposable

<PageTitle>Настройки — DONA CRM</PageTitle>
<div class="dona-page dona-page--form">
    <DonaPageHeader Class="dona-page-header">
        <div class="dona-heading"><a class="dona-icon-button dona-back-button dona-back-button--section" href="/more"
                                                aria-label="Вернуться в меню">
            <OrbitIcon Name="back" />
        </a>
        <div>
            <p>Ещё</p>
            <h1 class="dona-title">Настройки</h1>
        </div>
    </div>
</DonaPageHeader>
@if (loading)
{
    <div class="dona-state">Загружаем настройки…</div>
}
else
{
    <EditForm id="settings-form-1" class="dona-stack" Model="settings" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <UnsavedChangesGuard @ref="unsavedGuard" />
        <section class="dona-section">
            <div class="dona-section-title section-heading"><span>01</span>
                <div>
                    <h2>Склад</h2>
                    <p>Статусы и доступный остаток</p>
                </div>
            </div>
        <div class="dona-field-row"><label class="dona-field">Порог «Заканчивается»
            <InputNumber @bind-Value="settings.LowStockThreshold" min="0" />
        </label></div><p class="dona-note">При нулевом доступном остатке — «Нет в наличии».</p><label class="dona-field dona-toggle">
    <InputCheckbox @bind-Value="settings.CountReservedAsUnavailable" /><span><strong>Вычитать
    резерв</strong><small>Зарезервированные единицы недоступны для новой продажи</small></span>
</label><button type="button" class="dona-btn dona-btn--ghost" disabled="@saving"
                @onclick="RecalculateAsync">Пересчитать статусы сейчас</button>
</section>
<section class="dona-section">
    <div class="dona-section-title section-heading"><span>02</span>
        <div>
            <h2>Планирование</h2>
            <p>Периоды, предупреждения и номера</p>
        </div>
    </div><label class="dona-field dona-toggle">
    <InputCheckbox @bind-Value="settings.PreventSalesBelowCost" /><span><strong>Запрещать продажу ниже
    себестоимости</strong><small>По умолчанию включено; отключите только для осознанной
    распродажи</small></span>
</label>
<div class="dona-field-row"><label class="dona-field">Горизонт контент-плана, дней
    <InputNumber @bind-Value="settings.ContentPlanningHorizonDays" min="1" />
</label><label class="dona-field">Период аналитики, дней
<InputNumber @bind-Value="settings.DefaultAnalyticsPeriodDays" min="1" />
</label></div>
<div class="dona-field-row"><label class="dona-field">Залежавшийся товар, дней
    <InputNumber @bind-Value="settings.StaleInventoryDays" min="1" />
</label><label class="dona-field">Префикс продажи
<InputText @bind-Value="settings.SaleNumberPrefix" />
</label></div><p class="dona-note">Валюта учёта — UZS (сум). Иностранные валюты закупок и расходов пересчитываются по курсу документа.</p>
</section>
<section class="dona-section">
    <div class="dona-section-title section-heading"><span>03</span>
        <div>
            <h2>Google</h2>
            <p>Личное хранилище и фотографии</p>
        </div>
    </div>
    <p class="dona-note dona-note--sm">Войдите в аккаунт, чтобы сохранять личные копии базы и новые фотографии в закрытом
        хранилище Google.</p><a class="dona-btn dona-btn--ghost" href="/connections">Открыть подключения →</a>
    </section>
    @if (BackupFiles is not null)
    {
        <section class="dona-section">
            <div class="dona-section-title section-heading"><span>04</span>
                <div>
                    <h2 id="backups">Резервная копия</h2>
                    <p>Восстановление локальных данных из ZIP</p>
                </div>
            </div>
            <p class="dona-note">Полная ZIP-копия включает фотографии товаров, коллекций и образов, в том числе из Google Drive. Для облачных фото подключите исходный аккаунт. До 10 МБ на фото и 200 МБ фотографий в архиве.</p>
            <button type="button" class="dona-btn dona-btn--primary" disabled="@saving" @onclick="ExportFullBackupAsync">Скачать полную копию с фотографиями</button>
            <p class="dona-note dona-note--sm">После восстановления фото доступны на этом устройстве. Для других устройств загрузите их в новый аккаунт, затем отправьте базу на странице синхронизации.</p>
            <button type="button" class="dona-btn dona-btn--ghost" disabled="@saving" @onclick="PrepareImageTransferAsync">Перенести фотографии в Google Drive…</button>
            @if (transferAccount is not null)
            {
                <div class="dona-confirm">
                    <p>Загрузить локальные фотографии в <strong>@transferAccount</strong>? Локальные файлы сохранятся. Уже облачные фотографии не переносятся — сначала восстановите полную ZIP-копию.</p>
                    <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="() => transferAccount = null">Отмена</button>
                    <button type="button" class="dona-btn dona-btn--primary" disabled="@saving" @onclick="TransferImagesAsync">Загрузить фотографии</button>
                </div>
            }
            @if (imageOperation is not null)
            {
                <p role="status" aria-live="polite">@imageOperation · @imageProgress.Completed из @imageProgress.Total</p>
                <button type="button" class="dona-btn dona-btn--secondary" @onclick="CancelImageOperation">Остановить</button>
            }
            <p class="dona-note dona-note--sm">Перед заменой DONA CRM создаст автоматическую ZIP-копию текущих данных. Хранятся
                последние семь копий.</p><button type="button" class="dona-btn dona-btn--ghost" disabled="@saving"
                                                 @onclick="SelectBackupAsync">Выбрать ZIP-копию</button><button type="button" class="dona-btn dona-btn--ghost"
                                                                               disabled="@saving" @onclick="ExportDataJsonAsync">Скачать данные JSON</button>@if (backupPreview is not
                null) {
                    <div class="backup-preview"><strong>Проверка пройдена</strong><small>Товары: @backupPreview.Products
                        · Закупки: @backupPreview.Purchases · Продажи: @backupPreview.Sales · Фото:
                        @backupPreview.LocalImages</small></div>@if (!confirmRestore) {
                        <button type="button" class="dona-btn dona-btn--danger" disabled="@saving"
                                @onclick="() => confirmRestore = true">Восстановить
                            данные…</button>
                        } else
                        {

                            <div class="dona-confirm"><span>Текущие локальные данные будут заменены.
                                Продолжить?</span><button type="button" class="dona-btn dona-btn--secondary" @onclick="() => confirmRestore = false">Нет</button><button
                                type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="RestoreBackupAsync">Да,
                                восстановить</button></div>
                            }
                        }
                    </section>
                }
                @if (PersonalCloud is not null)
                {
                    <section class="dona-section">
                        <div class="dona-section-title section-heading"><span>05</span>
                            <div>
                                <h2 id="cloud-backups">Копии в Google Drive</h2>
                                <p>Версии в скрытой папке аккаунта</p>
                            </div>
                        </div>
                        <p class="dona-note dona-note--sm">Ручные копии хранятся, пока вы сами их не удалите. Автоматически сохраняются последние
                            семь копий перед восстановлением.</p>
                            <div class="personal-cloud-actions">
                                <button type="button" class="dona-btn dona-btn--ghost" disabled="@saving" @onclick="CreatePersonalBackupAsync">Создать личную копию</button>
                                <button type="button" class="dona-btn dona-btn--ghost" disabled="@saving" @onclick="LoadPersonalBackupsAsync">Обновить список</button>
                            </div>
                            @if (personalBackups.Count > 0)
                            {
                                <div class="personal-backups">
                                    @foreach (var backup in personalBackups)
                                    {
                                        <div class="personal-backup">
                                            <span>
                                                <strong>@backup.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
                                                <small>@(backup.Kind == PersonalBackupKind.Automatic ? "Автоматическая перед восстановлением" : "Ручная копия") · @(Math.Ceiling(backup.SizeBytes / 1024d)) КБ</small>
                                            </span>
                                            <div class="personal-backup-actions">
                                                <button type="button" class="dona-btn dona-btn--ghost" disabled="@saving" @onclick="() => RestorePersonalBackupAsync(backup.Id)">Восстановить</button>
                                                <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="() => ExportPersonalBackupAsync(backup.Id)">Скачать ZIP</button>
                                                @if (deleteBackupId == backup.Id)
                                                {
                                                    <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="() => DeletePersonalBackupAsync(backup.Id)">Удалить навсегда</button>
                                                    <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="CancelDeletePersonalBackup">Отмена</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="() => deleteBackupId = backup.Id">Удалить</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="dona-note dona-note--sm">Личных копий пока нет.</p>
                            }
                            </section>
                        }
                        <section class="dona-section danger-zone">
                            <div class="dona-section-title section-heading"><span>06</span>
                                <div>
                                    <h2>Очистка данных</h2>
                                    <p>Удаление данных только с этого устройства</p>
                                </div>
                            </div>
                            <p class="dona-note dona-note--sm">Товары, документы, остатки и настройки будут удалены. Личные ZIP-копии в Google Drive
                                останутся, но Google будет отключён на этом устройстве.</p>@if(!confirmClear){
                                <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="() => confirmClear = true">Очистить
                                    локальные
                                    данные…</button>
                                }else
                                {

                                    <div class="dona-confirm dona-confirm--boxed"><p><strong>Это действие нельзя
                                        отменить.</strong></p><label class="dona-field"><span>Введите <b>УДАЛИТЬ</b> для подтверждения</span>
                                        <InputText @bind-Value="clearConfirmation" autocomplete="off" />
                                    </label>
                                    <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving"
                                                     @onclick="CancelClear">Отмена</button><button type="button" class="dona-btn dona-btn--danger"
                                                                                  disabled="@(saving || clearConfirmation != "УДАЛИТЬ")" @onclick="ClearLocalDataAsync">Удалить
                                        данные</button>
                                    </div>
                                }
                            </section>
                            @if (message is not null)
                            {
                                <p class="dona-message @(success ? "dona-message--success" : "dona-message--error")" role="status" style="white-space: pre-line">@message</p>
                            }

            <DonaPageActions>
                <Primary>
                    <button form="settings-form-1" type="submit" class="dona-btn dona-btn--primary" disabled="@saving">@(saving ? "Сохраняем…" :
                    "Сохранить настройки")</button>
                </Primary>
                <Secondary>
                    <a class="dona-btn dona-btn--secondary" href="/more">Отмена</a>
                </Secondary>
            </DonaPageActions>
                            </EditForm>
                        }
                    </div>
@code {
    private string? transferAccount, imageOperation;
    private ImageTransferProgress imageProgress = new(0, 0);
    private CancellationTokenSource? imageCancellation;
    private IProgress<ImageTransferProgress> ImageProgress => new Progress<ImageTransferProgress>(value =>
    {
        if (imageOperation is null) return;
        imageProgress = value;
        _ = InvokeAsync(StateHasChanged);
    });

    private async Task ExportFullBackupAsync() => await RunAsync(async () =>
    {
        BeginImageOperation("Собираем фотографии");
        try
        {
            var backup = await PortableBackup.ExportAsync(ImageProgress, imageCancellation!.Token);
            await BackupFiles!.ExportAsync(backup, imageCancellation.Token);
        }
        finally { EndImageOperation(); }
    }, "Полная ZIP-копия подготовлена. Она содержит все фотографии и не требует исходного аккаунта.");

    private async Task PrepareImageTransferAsync() => await RunAsync(async () =>
    {
        var state = Google is null ? null : await Google.GetStateAsync();
        if (state is not { IsConnected: true } || string.IsNullOrWhiteSpace(state.AccountEmail))
            throw new InvalidOperationException("Сначала подключите целевой Google-аккаунт в разделе «Подключения».");
        transferAccount = state.AccountEmail;
    }, "Проверьте аккаунт для загрузки фотографий.");

    private async Task TransferImagesAsync() => await RunAsync(async () =>
    {
        var state = Google is null ? null : await Google.GetStateAsync();
        if (transferAccount is null || state is not { IsConnected: true } || state.AccountEmail != transferAccount)
            throw new InvalidOperationException("Google-аккаунт изменился. Выберите перенос фотографий заново.");
        BeginImageOperation("Загружаем фотографии");
        try
        {
            await DiscardQueuedUploadsAsync();
            var count = await PortableBackup.UploadLocalImagesAsync(ImageTransfers, ImageProgress, imageCancellation!.Token);
            message = count == 0 ? "Локальных фотографий для переноса нет." : $"Перенесено фотографий: {count}. Теперь сравните и отправьте базу на странице «Синхронизация».";
        }
        finally { transferAccount = null; EndImageOperation(); }
    }, "Фотографии перенесены.");

    private void BeginImageOperation(string title)
    {
        imageCancellation = new();
        imageProgress = new(0, 0);
        imageOperation = title;
    }
    private void EndImageOperation()
    {
        imageOperation = null;
        imageCancellation?.Dispose();
        imageCancellation = null;
    }
    private void CancelImageOperation() => imageCancellation?.Cancel();
    public void Dispose() => imageCancellation?.Cancel();
    private BusinessSettings settings = new(); private UnsavedChangesGuard? unsavedGuard; private bool
   loading = true, saving, success, confirmRestore, confirmClear; private string? message; private string
   clearConfirmation = string.Empty; private byte[]? backupContent; private BackupPreview? backupPreview; private
   List<PersonalBackupInfo> personalBackups = []; private string? deleteBackupId; private IBackupArchiveFileService?
   BackupFiles => Services.GetService(typeof(IBackupArchiveFileService)) as IBackupArchiveFileService; private
   IBackupSnapshotStore? BackupStore => Services.GetService(typeof(IBackupSnapshotStore)) as IBackupSnapshotStore; private
   IGoogleConnectionService? Google => Services.GetService(typeof(IGoogleConnectionService)) as
   IGoogleConnectionService; private ILocalSyncResetService?
   LocalSyncReset => Services.GetService(typeof(ILocalSyncResetService)) as ILocalSyncResetService; private
   IPersonalCloudBackupService? PersonalCloud => Services.GetService(typeof(IPersonalCloudBackupService)) as
   IPersonalCloudBackupService;
    protected override async Task OnInitializedAsync() { settings = await SettingsRepository.GetAsync(); loading = false; }
    private
   async Task SaveAsync() => await RunAsync(async () => { Normalize(); await SettingsRepository.SaveAsync(settings); },
"Настройки сохранены."); private async Task RecalculateAsync() => await RunAsync(async () =>
   {
       Normalize(); await
   SettingsRepository.SaveAsync(settings); foreach (var product in await Catalog.GetProductsAsync())
       {
           var
   status = ProductStatuses.Calculate(product, settings); if (status != product.Status)
           {
               product.Status = status; await
   Catalog.UpsertProductAsync(product);
           }
       }
   }, "Статусы пересчитаны."); private void
   Normalize()
    {
        settings.LowStockThreshold = Math.Max(0, settings.LowStockThreshold); settings.ContentPlanningHorizonDays =
Math.Max(1, settings.ContentPlanningHorizonDays); settings.DefaultAnalyticsPeriodDays = Math.Max(1,
settings.DefaultAnalyticsPeriodDays); settings.StaleInventoryDays = Math.Max(1, settings.StaleInventoryDays);
        settings.SaleNumberPrefix = SaleNumberGenerator.NormalizePrefix(settings.SaleNumberPrefix);
    }
    private
   async Task SelectBackupAsync() => await RunAsync(async () =>
   {
       backupContent = await BackupFiles!.PickAsync(); if (backupContent
   is null) { message = "Выбор ZIP-копии отменён."; return; }
       backupPreview = await
   BackupRestore.PreviewAsync(backupContent); confirmRestore = false;
   }, "Архив проверен."); private async Task
   RestoreBackupAsync() => await RunAsync(async () =>
   {
       if (backupContent is null) throw new InvalidOperationException("Сначала выберите ZIP-копию."); var result = await
BackupRestore.RestoreAsync(backupContent); await DiscardQueuedUploadsAsync(); await
   BackupFiles!.SaveAutomaticBackupAsync(result.AutomaticBackup); backupContent = null; backupPreview = null;
       confirmRestore = false;
       settings = await SettingsRepository.GetAsync();
   }, "Данные восстановлены."); private async Task LoadPersonalBackupsAsync() => await RunAsync(async () =>
   {
       personalBackups = (await
   PersonalCloud!.ListAsync()).ToList();
   }, "Список личных копий обновлён."); private async Task
   CreatePersonalBackupAsync() => await RunAsync(async () =>
   {
       await PersonalCloud!.CreateAsync(); personalBackups = (await
   PersonalCloud.ListAsync()).ToList();
   }, "Личная копия сохранена."); private async Task RestorePersonalBackupAsync(string
   id) => await RunAsync(async () =>
   {
       var result = await PersonalCloud!.RestoreAsync(id); await DiscardQueuedUploadsAsync(); await
   BackupFiles!.SaveAutomaticBackupAsync(result.AutomaticBackup); await
   PersonalCloud.SaveAutomaticAsync(result.AutomaticBackup); personalBackups = (await
   PersonalCloud.ListAsync()).ToList();
   }, "Личная копия восстановлена.");
    // Очередь могла содержать выгрузку данных до восстановления: сбрасываем её, чтобы она не ушла в Google
    // без проверки. После сброса автоматическая выгрузка ждёт нового сравнения на странице синхронизации.
    private async Task DiscardQueuedUploadsAsync()
    {
        if (LocalSyncReset is not null) await LocalSyncReset.ResetLocalStateAsync();
    }
    private async Task DeletePersonalBackupAsync(string
   id) => await RunAsync(async () =>
   {
       await PersonalCloud!.DeleteAsync(id); deleteBackupId = null; personalBackups = (await
   PersonalCloud.ListAsync()).ToList();
   }, "Личная копия удалена."); private void
   CancelDeletePersonalBackup() => deleteBackupId = null; private async Task RunAsync(Func<Task> a, string
   t)
    {
        if (saving) return; saving = true; message = null; try
        {
            await
   a(); unsavedGuard?.MarkClean(); message ??= t; success = true;
        }
        catch (OperationCanceledException)
        { message = "Операция остановлена. Локальные фотографии сохранены; завершённые загрузки в Google не отменены."; success = false; }
        catch (Exception
   ex)
        { message = UserErrors.Describe(ex, "Не удалось выполнить действие. Попробуйте ещё раз."); success = false; }
        finally { saving = false; }
    }
    private async Task ExportPersonalBackupAsync(string id) => await RunAsync(async () =>
    {
        var archive = await
    PersonalCloud!.DownloadAsync(id); await BackupFiles!.ExportAsync(archive);
    }, "ZIP-копия подготовлена.");
    private async Task ExportDataJsonAsync() => await RunAsync(async () =>
    {
        var snapshot = await
    BackupStore!.ReadSnapshotAsync(); await
    BackupFiles!.ExportAsync(BackupArchiveCodec.CreateJsonExport(BackupSnapshotMapper.FromSyncSnapshot(snapshot)));
    }, "JSON-файл подготовлен.");
    private void CancelClear() { confirmClear = false; clearConfirmation = string.Empty; }
    private async Task
    ClearLocalDataAsync()
    {
        if (clearConfirmation != "УДАЛИТЬ") return; await RunAsync(async () =>
        {
            if (Google is not null) await
    Google.DisconnectAsync(); if (LocalSyncReset is not null) await LocalSyncReset.ResetLocalStateAsync(); await
    BackupStore!.ReplaceSnapshotAsync(new
    DonaSyncSnapshot()); CancelClear(); Navigation.NavigateTo("/welcome", replace: true);
        }, "Локальные данные удалены.");
    }
}
