@page "/settings"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject IBusinessSettingsRepository SettingsRepository
@inject ICatalogRepository Catalog
@inject ProductStatusService ProductStatuses
@inject BackupRestoreService BackupRestore
@inject IServiceProvider Services

<PageTitle>Настройки — DONA CRM</PageTitle>
<div class="settings-page">
 <header><div class="orbit-secondary-heading"><a class="orbit-icon-button orbit-back-button" href="/more" aria-label="Вернуться в меню"><OrbitIcon Name="back" /></a><div><p>Ещё</p><h1>Настройки</h1></div></div></header>
 @if(loading){<div class="settings-state">Загружаем настройки…</div>}
 else {
 <EditForm Model="settings" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><UnsavedChangesGuard @ref="unsavedGuard" />
  <section><div class="section-heading"><span>01</span><div><h2>Склад</h2><p>Статусы и доступный остаток</p></div></div><label class="toggle-row"><InputCheckbox @bind-Value="settings.AutoUpdateStockStatus" /><span><strong>Автоматические статусы товара</strong><small>Обновлять статус по фактическому остатку</small></span></label><div class="field-row"><label>Порог «Заканчивается»<InputNumber @bind-Value="settings.LowStockThreshold" min="0" /></label><label>При нулевом остатке<OrbitSelect TValue="ProductStatus" @bind-Value="settings.ZeroStockStatus" Options="@ZeroStockStatusOptions" Label="Статус при нулевом остатке" /></label></div><label class="toggle-row"><InputCheckbox @bind-Value="settings.CountReservedAsUnavailable" /><span><strong>Вычитать резерв</strong><small>Зарезервированные единицы недоступны для новой продажи</small></span></label><button type="button" class="secondary-action" disabled="@saving" @onclick="RecalculateAsync">Пересчитать статусы сейчас</button></section>
  <section><div class="section-heading"><span>02</span><div><h2>Планирование</h2><p>Периоды, предупреждения и номера</p></div></div><label class="toggle-row"><InputCheckbox @bind-Value="settings.PreventSalesBelowCost" /><span><strong>Запрещать продажу ниже себестоимости</strong><small>По умолчанию включено; отключите только для осознанной распродажи</small></span></label><div class="field-row"><label>Горизонт контент-плана, дней<InputNumber @bind-Value="settings.ContentPlanningHorizonDays" min="1" /></label><label>Период аналитики, дней<InputNumber @bind-Value="settings.DefaultAnalyticsPeriodDays" min="1" /></label></div><div class="field-row"><label>Залежавшийся товар, дней<InputNumber @bind-Value="settings.StaleInventoryDays" min="1" /></label><label>Префикс продажи<InputText @bind-Value="settings.SaleNumberPrefix" /></label></div><label>Главная валюта<OrbitSelect TValue="string" @bind-Value="settings.MainCurrencyCode" Options="@CurrencyOptions" Label="Главная валюта" /></label></section>
  <section><div class="section-heading"><span>03</span><div><h2>Google</h2><p>Личное хранилище и фотографии</p></div></div><p class="field-note">Войдите в аккаунт, чтобы сохранять личные копии базы и новые фотографии в закрытом хранилище Google.</p><a class="connections-action" href="/connections">Открыть подключения →</a></section>
  @if (BackupFiles is not null) { <section><div class="section-heading"><span>04</span><div><h2>Резервная копия</h2><p>Восстановление локальных данных из ZIP</p></div></div><p class="field-note">Перед заменой DONA CRM создаст автоматическую ZIP-копию текущих данных. Хранятся последние семь копий.</p><button type="button" class="secondary-action" disabled="@saving" @onclick="SelectBackupAsync">Выбрать ZIP-копию</button>@if (backupPreview is not null) { <div class="backup-preview"><strong>Проверка пройдена</strong><small>Товары: @backupPreview.Products · Закупки: @backupPreview.Purchases · Продажи: @backupPreview.Sales · Фото: @backupPreview.LocalImages</small></div>@if (!confirmRestore) { <button type="button" class="danger-action" disabled="@saving" @onclick="() => confirmRestore = true">Восстановить данные…</button> } else { <div class="archive-confirm"><span>Текущие локальные данные будут заменены. Продолжить?</span><button type="button" @onclick="() => confirmRestore = false">Нет</button><button type="button" class="danger-action" disabled="@saving" @onclick="RestoreBackupAsync">Да, восстановить</button></div> } }</section> }
  @if (PersonalCloud is not null) { <section><div class="section-heading"><span>05</span><div><h2>Личное облако Google</h2><p>Версии в скрытой папке аккаунта</p></div></div><p class="field-note">Ручные копии хранятся, пока вы сами их не удалите. Автоматически сохраняются последние семь копий перед восстановлением.</p><div class="personal-cloud-actions"><button type="button" class="secondary-action" disabled="@saving" @onclick="CreatePersonalBackupAsync">Создать личную копию</button><button type="button" class="secondary-action" disabled="@saving" @onclick="LoadPersonalBackupsAsync">Обновить список</button></div>@if(personalBackups.Count>0){<div class="personal-backups">@foreach(var backup in personalBackups){<div class="personal-backup"><span><strong>@backup.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong><small>@(backup.Kind == PersonalBackupKind.Automatic ? "Автоматическая перед восстановлением" : "Ручная копия") · @(Math.Ceiling(backup.SizeBytes/1024d)) КБ</small></span><div class="personal-backup-actions"><button type="button" class="danger-action" disabled="@saving" @onclick="() => RestorePersonalBackupAsync(backup.Id)">Восстановить</button>@if (deleteBackupId == backup.Id) { <button type="button" class="danger-action" disabled="@saving" @onclick="() => DeletePersonalBackupAsync(backup.Id)">Удалить навсегда</button><button type="button" disabled="@saving" @onclick="CancelDeletePersonalBackup">Отмена</button> } else { <button type="button" class="text-danger-action" disabled="@saving" @onclick="() => deleteBackupId = backup.Id">Удалить</button> }</div></div>}</div>} else { <p class="field-note">Личных копий пока нет.</p> }</section> }
  @if(message is not null){<p class="settings-message @(success?"success":null)" role="status">@message</p>}
  <div class="settings-actions"><a href="/more">Отмена</a><button disabled="@saving">@(saving?"Сохраняем…":"Сохранить настройки")</button></div>
 </EditForm> }
</div>
@code{
 private BusinessSettings settings=new();private UnsavedChangesGuard? unsavedGuard;private bool loading=true,saving,success,confirmRestore;private string? message;private byte[]? backupContent;private BackupPreview? backupPreview;private List<PersonalBackupInfo> personalBackups=[];private string? deleteBackupId;private IBackupArchiveFileService? BackupFiles=>Services.GetService(typeof(IBackupArchiveFileService)) as IBackupArchiveFileService;private IPersonalCloudBackupService? PersonalCloud=>Services.GetService(typeof(IPersonalCloudBackupService)) as IPersonalCloudBackupService;
 private static readonly IReadOnlyList<OrbitSelectOption<ProductStatus>> ZeroStockStatusOptions=[new(ProductStatus.OutOfStock,"Нет в наличии"),new(ProductStatus.OnOrder,"Под заказ")];private static readonly IReadOnlyList<OrbitSelectOption<string>> CurrencyOptions=OrbitSelectOptions.From(CurrencyCodes.Supported,value=>$"{value} · {CurrencyCodes.Symbol(value)}");
 protected override async Task OnInitializedAsync(){settings=await SettingsRepository.GetAsync();loading=false;}private async Task SaveAsync()=>await RunAsync(async()=>{Normalize();await SettingsRepository.SaveAsync(settings);},"Настройки сохранены.");private async Task RecalculateAsync()=>await RunAsync(async()=>{Normalize();await SettingsRepository.SaveAsync(settings);foreach(var product in await Catalog.GetProductsAsync()){var status=ProductStatuses.Calculate(product,settings);if(status!=product.Status){product.Status=status;await Catalog.UpsertProductAsync(product);}}},"Статусы пересчитаны.");private void Normalize(){settings.LowStockThreshold=Math.Max(0,settings.LowStockThreshold);settings.ContentPlanningHorizonDays=Math.Max(1,settings.ContentPlanningHorizonDays);settings.DefaultAnalyticsPeriodDays=Math.Max(1,settings.DefaultAnalyticsPeriodDays);settings.StaleInventoryDays=Math.Max(1,settings.StaleInventoryDays);settings.SaleNumberPrefix=SaleNumberGenerator.NormalizePrefix(settings.SaleNumberPrefix);settings.MainCurrencyCode=CurrencyCodes.Normalize(settings.MainCurrencyCode);}private async Task SelectBackupAsync()=>await RunAsync(async()=>{backupContent=await BackupFiles!.PickAsync();if(backupContent is null){message="Выбор ZIP-копии отменён.";return;}backupPreview=await BackupRestore.PreviewAsync(backupContent);confirmRestore=false;},"Архив проверен.");private async Task RestoreBackupAsync()=>await RunAsync(async()=>{if(backupContent is null)throw new InvalidOperationException("Сначала выберите ZIP-копию.");var result=await BackupRestore.RestoreAsync(backupContent);await BackupFiles!.SaveAutomaticBackupAsync(result.AutomaticBackup);backupContent=null;backupPreview=null;confirmRestore=false;},"Данные восстановлены.");private async Task LoadPersonalBackupsAsync()=>await RunAsync(async()=>{personalBackups=(await PersonalCloud!.ListAsync()).ToList();},"Список личных копий обновлён.");private async Task CreatePersonalBackupAsync()=>await RunAsync(async()=>{await PersonalCloud!.CreateAsync();personalBackups=(await PersonalCloud.ListAsync()).ToList();},"Личная копия сохранена.");private async Task RestorePersonalBackupAsync(string id)=>await RunAsync(async()=>{var result=await PersonalCloud!.RestoreAsync(id);await BackupFiles!.SaveAutomaticBackupAsync(result.AutomaticBackup);await PersonalCloud.SaveAutomaticAsync(result.AutomaticBackup);personalBackups=(await PersonalCloud.ListAsync()).ToList();},"Личная копия восстановлена.");private async Task DeletePersonalBackupAsync(string id)=>await RunAsync(async()=>{await PersonalCloud!.DeleteAsync(id);deleteBackupId=null;personalBackups=(await PersonalCloud.ListAsync()).ToList();},"Личная копия удалена.");private void CancelDeletePersonalBackup()=>deleteBackupId=null;private async Task RunAsync(Func<Task> a,string t){if(saving)return;saving=true;message=null;try{await a();unsavedGuard?.MarkClean();message??=t;success=true;}catch(Exception ex){message=ex.Message;success=false;}finally{saving=false;}}
}
