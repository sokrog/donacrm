@page "/settings"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject IBusinessSettingsRepository SettingsRepository
@inject ICatalogRepository Catalog
@inject ProductStatusService ProductStatuses

<PageTitle>Настройки — DONA CRM</PageTitle>
<div class="settings-page">
    <header><div><a href="/more">Ещё</a><h1>Настройки</h1></div></header>
    @if(loading){<div class="settings-state">Загружаем настройки…</div>}
    else
    {
        <EditForm Model="settings" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
            <section><div class="section-heading"><span>01</span><div><h2>Склад</h2><p>Статусы и доступный остаток</p></div></div><label class="toggle-row"><InputCheckbox @bind-Value="settings.AutoUpdateStockStatus" /><span><strong>Автоматические статусы товара</strong><small>Обновлять статус по фактическому остатку</small></span></label><div class="field-row"><label>Порог «Заканчивается»<InputNumber @bind-Value="settings.LowStockThreshold" min="0" /></label><label>При нулевом остатке<select @bind="settings.ZeroStockStatus"><option value="@ProductStatus.OutOfStock">Нет в наличии</option><option value="@ProductStatus.OnOrder">Под заказ</option></select></label></div><label class="toggle-row"><InputCheckbox @bind-Value="settings.CountReservedAsUnavailable" /><span><strong>Вычитать резерв</strong><small>Зарезервированные единицы недоступны для новой продажи</small></span></label><button type="button" class="secondary-action" disabled="@saving" @onclick="RecalculateAsync">Пересчитать статусы сейчас</button></section>
            <section><div class="section-heading"><span>02</span><div><h2>Планирование</h2><p>Периоды, предупреждения и номера</p></div></div><div class="field-row"><label>Горизонт контент-плана, дней<InputNumber @bind-Value="settings.ContentPlanningHorizonDays" min="1" /></label><label>Период аналитики, дней<InputNumber @bind-Value="settings.DefaultAnalyticsPeriodDays" min="1" /></label></div><div class="field-row"><label>Залежавшийся товар, дней<InputNumber @bind-Value="settings.StaleInventoryDays" min="1" /></label><label>Префикс продажи<InputText @bind-Value="settings.SaleNumberPrefix" /></label></div><label>Главная валюта<select @bind="settings.MainCurrencyCode">@foreach(var value in CurrencyCodes.Supported){<option value="@value">@value · @CurrencyCodes.Symbol(value)</option>}</select></label><p class="field-note">Смена валюты не конвертирует уже сохранённые суммы.</p></section>
            <section><div class="section-heading"><span>03</span><div><h2>Google</h2><p>Единое подключение Sheets и Drive</p></div></div><p class="field-note">Аккаунт, таблица, папка Drive и синхронизация настраиваются централизованно в разделе подключений.</p><a class="connections-action" href="/connections">Открыть подключения →</a></section>
            @if(message is not null){<p class="settings-message @(success?"success":null)" role="status">@message</p>}
            <div class="settings-actions"><a href="/more">Отмена</a><button disabled="@saving">@(saving?"Сохраняем…":"Сохранить настройки")</button></div>
        </EditForm>
    }
</div>
@code{
    private BusinessSettings settings=new();private bool loading=true;private bool saving;private string? message;private bool success;
    protected override async Task OnInitializedAsync(){settings=await SettingsRepository.GetAsync();loading=false;}
    private async Task SaveAsync(){await RunAsync(async()=>{Normalize();await SettingsRepository.SaveAsync(settings);},"Настройки сохранены.");}
    private async Task RecalculateAsync(){await RunAsync(async()=>{Normalize();await SettingsRepository.SaveAsync(settings);var products=await Catalog.GetProductsAsync();var changed=0;foreach(var product in products){var status=ProductStatuses.Calculate(product,settings);if(status==product.Status)continue;product.Status=status;await Catalog.UpsertProductAsync(product);changed++;}message=$"Пересчёт завершён: изменено статусов — {changed}.";},"Статусы пересчитаны.");}
    private void Normalize(){settings.LowStockThreshold=Math.Max(0,settings.LowStockThreshold);settings.ContentPlanningHorizonDays=Math.Max(1,settings.ContentPlanningHorizonDays);settings.DefaultAnalyticsPeriodDays=Math.Max(1,settings.DefaultAnalyticsPeriodDays);settings.StaleInventoryDays=Math.Max(1,settings.StaleInventoryDays);settings.SaleNumberPrefix=SaleNumberGenerator.NormalizePrefix(settings.SaleNumberPrefix);settings.MainCurrencyCode=CurrencyCodes.Normalize(settings.MainCurrencyCode);}
    private async Task RunAsync(Func<Task> action,string text){if(saving)return;saving=true;message=null;try{await action();message??=text;success=true;}catch(Exception ex){message=ex.Message;success=false;}finally{saving=false;}}
}
