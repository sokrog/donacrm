@page "/products/new"
@page "/products/{Id:guid}"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICatalogRepository Catalog
@inject ICommerceRepository Commerce
@inject ISalesRepository SalesRepository
@inject ProductEditingService ProductEditing
@inject NavigationManager Navigation
@inject IPricingRepository PricingHistory
@inject ProductPricingService Pricing

<PageTitle>@(IsNew ? "Новый товар" : "Товар") — DONA CRM</PageTitle>

<div class="dona-page dona-page--form" aria-busy="@isLoading">
    <DonaPageHeader Class="dona-page-header dona-page-header--back dona-heading product-editor-header">
        <a class="dona-icon-button dona-back-button" href="/products" aria-label="Вернуться в каталог"><OrbitIcon Name="back" /></a>
        <div class="product-editor-title">
            <p>Каталог</p>
            <h1>@(IsNew ? "Новый товар" : "Редактирование")</h1>
        </div>

    </DonaPageHeader>

    @if (isLoading) { <div class="dona-state" role="status">Загружаем товар…</div> }
    else if (errorMessage is not null) { <div class="dona-state dona-state--error" role="alert"><strong>Не удалось открыть товар</strong><p>@errorMessage</p><a href="/products">В каталог</a></div> }
    else
    {
        <EditForm id="producteditor-form-1" class="dona-stack" Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <ListItemRemovalConfirmation @ref="removalConfirmation" />
            <div class="product-editor-workspace @(model.Images.Count > 0 ? "product-editor-workspace--with-images" : null)">
                <div class="product-editor-media">
                    <EntityImageEditor @ref="imageEditor" Images="@model.Images" OwnerId="@model.Id" EntityLabel="товара" ImagesChanged="UpdatePrimaryImage" Featured="true" />
                </div>
                <div class="product-editor-primary">
                    <section class="dona-section" aria-labelledby="main-fields"><h2 id="main-fields">Основное</h2>
                        @if (!IsNew && model.Quantity == 0) { <p class="dona-note">Остатка пока нет.</p> }
                        <label class="dona-field">Название *<InputText @bind-Value="model.Name" autocomplete="off" /><ValidationMessage For="() => model.Name" /></label>
                        <div class="dona-field-row">
                            <label class="dona-field">SKU *<InputText @bind-Value="model.Sku" autocomplete="off" /><ValidationMessage For="() => model.Sku" /></label>
                            <label class="dona-field">
                                Категория<OrbitSelect @ref="categoryPicker" TValue="string" @bind-Value="model.Category" Options="@CategoryOptions" Label="Категория">
                                    <Footer>
                                        <div class="category-picker-add">
                                            <InputText @bind-Value="newCategoryName" placeholder="Новая категория" autocomplete="off" />
                                            <button type="button" class="dona-btn dona-btn--ghost" disabled="@isSaving" @onclick="AddCategoryAsync"><OrbitIcon Name="plus" />Добавить</button>
                                        </div>
                                    </Footer>
                                </OrbitSelect>
                            </label>
                        </div>
                        <div class="dona-field-row">
                            <label class="dona-field">Пол<OrbitSelect TValue="string" @bind-Value="model.Gender" Options="@GenderOptions" Label="Пол" /></label>
                            <label class="dona-field">Сезон<OrbitSelect TValue="string" @bind-Value="model.Season" Options="@SeasonOptions" Label="Сезон" /></label>
                        </div>
                        <div class="dona-field">Цена продажи<strong>@(model.SellingPriceUzs is null ? "Не установлена" : PricingLayers.Money(model.SellingPriceUzs))</strong></div>
                        @if (IsNew) { <p class="dona-note">Сохраните товар, чтобы установить цену отдельной операцией.</p> }
                        else
                        {
                            <div class="dona-toolbar"><a class="dona-btn dona-btn--secondary" href="/products/@model.Id/pricing">Установить цену</a></div>
                            @if (lastPriceAt is { } date) { <p class="dona-note">Последнее изменение: @date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p> }
                            @if (reviewPrice) { <p class="dona-message">Основание последней установки цены изменилось. Проверьте себестоимость и пересмотрите цену.</p> }
                        }
                        @if (Priced > 0) { <p class="dona-message dona-message--success" role="status">Продажная цена обновлена.</p> }
                        <label class="dona-field">Описание<InputTextArea @bind-Value="model.Notes" rows="5" placeholder="Материал, посадка, особенности модели" /></label>
                    </section>
            <section class="dona-section product-variants" aria-labelledby="variants">
                <div class="dona-section-title">
                    <div><h2 id="variants">Варианты *</h2>@if (!IsNew) { <p class="dona-note">Доступно всего @model.Variants.Sum(x => x.AvailableQuantity)</p> }</div>
                    <button type="button" class="dona-btn dona-btn--ghost" @onclick="AddVariant"><OrbitIcon Name="plus" Class="dona-inline-icon" />Добавить</button>
                </div>
                @if (model.Variants.Count == 0) { <p class="dona-empty">Добавьте хотя бы один вариант.</p> }
                @if (model.Variants.GroupBy(x => (NormalizeVariantText(x.Color), NormalizeVariantText(x.Size))).Any(x => x.Count() > 1))
                {
                    <p class="dona-message" role="status">Варианты с одинаковыми цветом и размером нельзя сохранить.</p>
                }
                @foreach (var variant in model.Variants)
                {
                    <div class="variant-row" @key="variant.Id" @oninput="() => removalConfirmation?.MarkEdited(variant)">
                        <label class="dona-field">Цвет<InputText @bind-Value="variant.Color" /></label>
                        <label class="dona-field">Размер<InputText @bind-Value="variant.Size" /></label>
                        <div class="variant-stock">
                            @if (!IsNew) { <strong>Доступно @variant.AvailableQuantity</strong> }
                            @if (Expected(variant) > 0) { <span>Ожидается @Expected(variant)</span> }
                        </div>
                        <button type="button" class="dona-btn dona-btn--danger dona-btn--remove remove" aria-label="Удалить вариант"
                                disabled="@(model.Variants.Count == 1 || RemovalBlocker(variant) is not null)"
                                @onclick="() => RemoveVariant(variant)"><OrbitIcon Name="close" /></button>
                        @if (RemovalBlocker(variant) is { } reason) { <p class="variant-blocker dona-note">@reason</p> }
                    </div>
                }
            </section>

                </div>

                <div class="product-editor-secondary">
                    <details class="dona-section"><summary><OrbitIcon Name="down" />Закупка</summary>
                        <label class="dona-field">Предпочтительный поставщик<OrbitSelect TValue="Guid?" @bind-Value="model.PreferredSupplierId" Options="@PreferredSupplierOptions" Label="Предпочтительный поставщик" Searchable="true" /></label>
                        <label class="dona-field">Ссылка на товар у поставщика<InputText @bind-Value="model.SourceUrl" inputmode="url" placeholder="https://detail.1688.com/…" /></label>
                        @if (Uri.TryCreate(model.SourceUrl, UriKind.Absolute, out var storeUri) && storeUri.Scheme is "http" or "https")
                        {
                            <a class="store-link" href="@storeUri" target="_blank" rel="noopener noreferrer">Открыть страницу товара в магазине ↗</a>
                        }
                        <label class="dona-field">Вес единицы, кг<InputNumber @bind-Value="model.UnitWeightKg" min="0" /></label>
                    </details>
                </div>
            </div>

            <ValidationSummary />
            @if (saveError is not null) { <p class="dona-message dona-message--error" role="alert">@saveError</p> }
@if (confirmArchive)
                {
                    <DonaConfirmation OnCancel="() => confirmArchive = false"><div class="dona-confirm dona-confirm--boxed" role="group" aria-label="Подтверждение архивирования">
                        <span>@(model.Status == ProductStatus.Archived ? "Вернуть товар из архива?" : "Убрать товар из активного каталога?")</span>
                        <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => confirmArchive = false">Нет</button>
                        <button type="button" class="dona-btn dona-btn--danger" @onclick="ArchiveAsync">Подтвердить</button>
                    </div></DonaConfirmation>
                }

            <DonaPageActions>
                <Primary>
                    <button form="producteditor-form-1" type="submit" class="dona-btn dona-btn--primary" disabled="@isSaving">@(isSaving ? "Сохраняем…" : "Сохранить товар")</button>
                </Primary>
                <Secondary>
                    <a class="dona-btn dona-btn--secondary" href="/products">Отмена</a>
                    @if (!IsNew) {
                    <a class="dona-btn dona-btn--secondary" href="/products/@model.Id/price-history">История цен</a>
                    <a class="dona-btn dona-btn--secondary" href="/purchases/new?productId=@model.Id">Создать закупку</a>
                    <a class="dona-btn dona-btn--secondary" href="/inventory/adjustment/new?productId=@model.Id">Внести остаток</a>
                }
            </Secondary>
            <Danger>
                @if (!IsNew) { <button type="button" class="dona-btn dona-btn--danger" disabled="@isSaving" @onclick="() => confirmArchive = true">@(model.Status == ProductStatus.Archived ? "Вернуть из архива" : "В архив")</button> }
            </Danger>
            </DonaPageActions>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Product model = new();
    private bool isLoading = true;
    private bool isSaving;
    [SupplyParameterFromQuery(Name = "priced")] public int? Priced { get; set; }
    private DateTimeOffset? lastPriceAt;
    private bool reviewPrice;
    private bool confirmArchive;
    private string newCategoryName = string.Empty;
    private string? errorMessage;
    private string? saveError;
    private IReadOnlyList<string> categories = [];
    private IReadOnlyList<Supplier> suppliers = [];
    private IReadOnlyList<Purchase> purchases = [];
    private static string NormalizeVariantText(string value) => Product.NormalizeVariantText(value);
    private IReadOnlyList<OrbitSelectOption<Guid?>> PreferredSupplierOptions =>
        [new(null, "Не выбран"), .. suppliers.Where(x => !x.IsArchived || x.Id == model.PreferredSupplierId).Select(x => new OrbitSelectOption<Guid?>(x.Id, x.Name + (x.IsArchived ? " — в архиве" : "")))];
    private Product? original;
    private Dictionary<Guid, string> removalBlockers = [];
    private static readonly string[] genders = ["Женский", "Мужской", "Унисекс"];
    private static readonly string[] seasons = ["Весна", "Лето", "Осень", "Зима", "Всесезон"];
    private IReadOnlyList<OrbitSelectOption<string>> CategoryOptions => OrbitSelectOptions.OptionalStrings(categories, "Не выбрана");
    private static readonly IReadOnlyList<OrbitSelectOption<string>> GenderOptions = OrbitSelectOptions.OptionalStrings(genders, "Не указан");
    private static readonly IReadOnlyList<OrbitSelectOption<string>> SeasonOptions = OrbitSelectOptions.OptionalStrings(seasons, "Не указан");
    private EntityImageEditor? imageEditor;
    private OrbitSelect<string>? categoryPicker;
    private UnsavedChangesGuard? unsavedGuard;
    private ListItemRemovalConfirmation? removalConfirmation;
    private bool IsNew => Id is null;
    private int Expected(ProductVariant variant) => purchases.Where(x => x.ClosedAt is null && x.Status is PurchaseStatus.Ordered or PurchaseStatus.ChinaWarehouse or PurchaseStatus.Shipped or PurchaseStatus.PartiallyReceived)
        .SelectMany(x => x.Items).Where(x => x.ProductId == model.Id && x.ProductVariantId == variant.Id).Sum(x => x.MissingQuantity);
    private async Task<string> SuggestSkuAsync()
    {
        var used = (await Catalog.GetProductsAsync()).Select(x => x.Sku).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var number = 1;
        while (used.Contains($"P-{number:0000}")) number++;
        return $"P-{number:0000}";
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; errorMessage = null; confirmArchive = false; saveError = null; newCategoryName = string.Empty;
        try
        {
            suppliers = await Commerce.GetSuppliersAsync();
            categories = (await Commerce.GetCategoriesAsync()).Where(value => value.IsActive).OrderBy(value => value.SortOrder).Select(value => value.Name).ToList();
            removalBlockers = []; original = null;
            if (Id is not null)
            {
                model = await Catalog.GetProductAsync(Id.Value) ?? throw new InvalidOperationException("Товар не найден.");
                // Отдельный экземпляр: по нему сервис поймёт, какие поля изменил пользователь.
                original = await Catalog.GetProductAsync(Id.Value);
                var last = (await PricingHistory.GetPriceChangesAsync()).Where(x => x.Lines.Any(l => l.Quote.ProductId == Id)).OrderByDescending(x => x.AppliedAt).FirstOrDefault();
                lastPriceAt = last?.AppliedAt;
                reviewPrice = last is not null && await Pricing.NeedsReviewAsync(last.Lines.Single(x => x.Quote.ProductId == Id));
                var sales = await SalesRepository.GetSalesAsync();
                purchases = await Commerce.GetPurchasesAsync();
                foreach (var variant in model.Variants)
                    if (ProductEditingService.VariantRemovalBlocker(variant, sales, purchases) is { } blocker) removalBlockers[variant.Id] = blocker;
            }
            else { model = new Product { Status = ProductStatus.OutOfStock, Sku = await SuggestSkuAsync() }; model.Variants.Add(new ProductVariant()); }
        }
        catch (Exception exception) { errorMessage = UserErrors.Describe(exception, "Не удалось загрузить товар. Попробуйте ещё раз."); }
        finally { isLoading = false; }
    }

    private void AddVariant() { model.Variants.Add(new ProductVariant()); unsavedGuard?.MarkDirty(); }
    private async Task AddCategoryAsync()
    {
        var name = newCategoryName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { saveError = "Введите название категории."; return; }
        if (categories.Any(value => string.Equals(value, name, StringComparison.OrdinalIgnoreCase)))
        {
            model.Category = categories.First(value => string.Equals(value, name, StringComparison.OrdinalIgnoreCase));
            newCategoryName = string.Empty;
            categoryPicker?.CloseDialog();
            return;
        }
        isSaving = true; saveError = null;
        try
        {

            categories = categories.Append(name).OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase).ToList();
            model.Category = name;
            newCategoryName = string.Empty;
            categoryPicker?.CloseDialog();
            unsavedGuard?.MarkDirty();
        }
        catch (Exception exception) { saveError = UserErrors.Describe(exception, "Не удалось добавить категорию. Попробуйте ещё раз."); }
        finally { isSaving = false; }
    }
    private string? RemovalBlocker(ProductVariant variant) => removalBlockers.GetValueOrDefault(variant.Id);
    private async Task RemoveVariant(ProductVariant variant)
    {
        if (model.Variants.Count == 1 || RemovalBlocker(variant) is not null) return;
        var filled = !string.IsNullOrWhiteSpace(variant.Color) || !string.IsNullOrWhiteSpace(variant.Size)
            || variant.Quantity is not (null or 0) || variant.Layers.Count > 0;
        if (removalConfirmation is null || !await removalConfirmation.ConfirmAsync(variant, filled, "Удалить вариант?")) return;
        model.Variants.Remove(variant);
        unsavedGuard?.MarkDirty();
    }
    private void UpdatePrimaryImage()
    {
        model.ImageUrl = model.Images.OrderByDescending(item => item.IsMain).ThenBy(item => item.SortOrder).FirstOrDefault()?.Url;
        unsavedGuard?.MarkDirty();
    }

    private async Task SaveAsync()
    {
        isSaving = true; saveError = null;
        try
        {
            UpdatePrimaryImage();
            var created = IsNew;
            await ProductEditing.SaveAsync(model, original);
            if (!string.IsNullOrWhiteSpace(model.Category) && !(await Commerce.GetCategoriesAsync()).Any(x => string.Equals(x.Name, model.Category, StringComparison.OrdinalIgnoreCase)))
                await Commerce.UpsertCategoryAsync(new Category { Name = model.Category, IsActive = true, SortOrder = categories.Count });
            if (imageEditor is not null) await imageEditor.CommitAsync();
            unsavedGuard?.MarkClean();
            Navigation.NavigateTo(created ? $"/products/{model.Id}" : "/products");
        }
        catch (Exception exception) { saveError = UserErrors.Describe(exception, "Не удалось сохранить товар. Попробуйте ещё раз."); }
        finally { isSaving = false; }
    }

    private async Task ArchiveAsync()
    {
        isSaving = true; saveError = null;
        try { UpdatePrimaryImage(); if (model.Status == ProductStatus.Archived) { model.Status = ProductStatus.OutOfStock; await ProductEditing.SaveAsync(model, original); } else await ProductEditing.ArchiveAsync(model, original); if (imageEditor is not null) await imageEditor.CommitAsync(); unsavedGuard?.MarkClean(); Navigation.NavigateTo("/products"); }
        catch (Exception exception) { saveError = UserErrors.Describe(exception, "Не удалось архивировать товар. Попробуйте ещё раз."); }
        finally { isSaving = false; }
    }
}
