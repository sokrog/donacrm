@page "/products/new"
@page "/products/{Id:guid}"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICatalogRepository Catalog
@inject ICommerceRepository Commerce
@inject ISalesRepository SalesRepository
@inject ProductEditingService ProductEditing
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Новый товар" : "Товар") — DONA CRM</PageTitle>

<div class="dona-page dona-page--form" aria-busy="@isLoading">
    <header class="dona-page-header dona-page-header--back dona-heading">
        <a class="dona-icon-button dona-back-button" href="/products" aria-label="Вернуться в каталог"><OrbitIcon Name="back" /></a>
        <div>
            <p>Каталог</p>
            <h1>@(IsNew ? "Новый товар" : "Редактирование")</h1>
        </div>
    </header>

    @if (isLoading) { <div class="dona-state" role="status">Загружаем товар…</div> }
    else if (errorMessage is not null) { <div class="dona-state dona-state--error" role="alert"><strong>Не удалось открыть товар</strong><p>@errorMessage</p><a class="state-link" href="/products">В каталог</a></div> }
    else
    {
        <EditForm class="dona-stack" Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <div class="product-editor-workspace">
                <div class="product-editor-primary">
                    <section class="dona-section" aria-labelledby="main-fields"><h2 id="main-fields">Основное</h2>
                        <label class="dona-field">Название<InputText @bind-Value="model.Name" autocomplete="off" /><ValidationMessage For="() => model.Name" /></label>
                        <div class="dona-field-row">
                            <label class="dona-field">SKU<InputText @bind-Value="model.Sku" autocomplete="off" /><ValidationMessage For="() => model.Sku" /></label>
                            <label class="dona-field">
                                Категория<OrbitSelect @ref="categoryPicker" TValue="string" @bind-Value="model.Category" Options="@CategoryOptions" Label="Категория">
                                    <Footer>
                                        <div class="category-picker-add">
                                            <InputText @bind-Value="newCategoryName" placeholder="Новая категория" autocomplete="off" />
                                            <button type="button" class="dona-btn dona-btn--primary" disabled="@isSaving" @onclick="AddCategoryAsync"><OrbitIcon Name="plus" />Добавить</button>
                                        </div>
                                    </Footer>
                                </OrbitSelect>
                            </label>
                        </div>
                        <div class="dona-field-row">
                            <label class="dona-field">Пол<OrbitSelect TValue="string" @bind-Value="model.Gender" Options="@GenderOptions" Label="Пол" /></label>
                            <label class="dona-field">Сезон<OrbitSelect TValue="string" @bind-Value="model.Season" Options="@SeasonOptions" Label="Сезон" /></label>
                        </div>
                        <label class="dona-field">Описание и заметки<InputTextArea @bind-Value="model.Notes" rows="5" placeholder="Материал, посадка, особенности модели" /></label>
                    </section>
                </div>

                <div class="product-editor-secondary">
                    <EntityImageEditor @ref="imageEditor" Images="@model.Images" OwnerId="@model.Id" EntityLabel="товара" ImagesChanged="UpdatePrimaryImage" />
                    <section class="dona-section" aria-labelledby="commerce-fields"><h2 id="commerce-fields">Закупка и продажа</h2>
                        <label class="dona-field">Магазин или поставщик<InputText @bind-Value="model.SupplierName" placeholder="Название магазина" /></label>
                        <label class="dona-field">Ссылка на магазин<InputText @bind-Value="model.SourceUrl" inputmode="url" placeholder="https://detail.1688.com/…" /></label>
                        @if (Uri.TryCreate(model.SourceUrl, UriKind.Absolute, out var storeUri) && storeUri.Scheme is "http" or "https")
                        {
                            <a class="store-link" href="@storeUri" target="_blank" rel="noopener noreferrer">Открыть страницу товара в магазине ↗</a>
                        }
                        <div class="dona-field-row"><label class="dona-field">Закупка, CNY<InputNumber @bind-Value="model.PurchasePriceCny" /></label><label class="dona-field">Курс CNY<InputNumber @bind-Value="model.CnyRateUzs" /></label></div>
                        <div class="dona-field-row"><label class="dona-field">Доставка, UZS<InputNumber @bind-Value="model.DeliveryCostUzs" /></label><label class="dona-field">Продажа, UZS<InputNumber @bind-Value="model.SellingPriceUzs" /></label></div>
                    </section>
                </div>
            </div>

            <section class="dona-section product-variants" aria-labelledby="variants">
                <div class="dona-section-title">
                    <h2 id="variants">Варианты и остатки</h2>
                    <button type="button" @onclick="AddVariant"><OrbitIcon Name="plus" Class="dona-inline-icon" />Добавить</button>
                </div>
                @if (model.Variants.Count == 0) { <p class="empty-variants">Добавьте цвет, размер и количество.</p> }
                @foreach (var variant in model.Variants)
                {
                    <div class="variant-row" @key="variant.Id">
                        <label class="dona-field">Цвет<InputText @bind-Value="variant.Color" /></label>
                        <label class="dona-field">Размер<InputText @bind-Value="variant.Size" /></label>
                        @if (existingVariantIds.Contains(variant.Id))
                        {
                            <div class="variant-stock">
                                <span>В наличии @(variant.Quantity ?? 0) · резерв @variant.ReservedQuantity</span>
                                <a href="/inventory/adjustment/new?productId=@model.Id&variantId=@variant.Id">Корректировка остатка</a>
                            </div>
                        }
                        else
                        {
                            <label class="dona-field">Начальный остаток<InputNumber @bind-Value="variant.Quantity" min="0" /></label>
                        }
                        <button type="button" class="dona-btn dona-btn--danger dona-btn--icon remove" aria-label="Удалить вариант"
                                disabled="@(RemovalBlocker(variant) is not null)" title="@RemovalBlocker(variant)"
                                @onclick="() => RemoveVariant(variant)">×</button>
                    </div>
                }
            </section>

            <ValidationSummary />
            @if (saveError is not null) { <p class="dona-message dona-message--error" role="alert">@saveError</p> }
            @if (!IsNew)
            {
                @if (confirmArchive)
                {
                    <div class="dona-confirm confirm-box" role="group" aria-label="Подтверждение архивирования">
                        <span>Убрать товар из активного каталога?</span>
                        <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => confirmArchive = false">Нет</button>
                        <button type="button" class="dona-btn dona-btn--danger" @onclick="ArchiveAsync">Да, в архив</button>
                    </div>
                }
                else
                {
                    <button type="button" class="archive-toggle" @onclick="() => confirmArchive = true">Переместить товар в архив</button>
                }
            }
            <div class="dona-actions"><a class="dona-btn dona-btn--secondary" href="/products">Отмена</a><button type="submit" class="dona-btn dona-btn--primary" disabled="@isSaving">@(isSaving ? "Сохраняем…" : "Сохранить товар")</button></div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Product model = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool confirmArchive;
    private string newCategoryName = string.Empty;
    private string? errorMessage;
    private string? saveError;
    private IReadOnlyList<string> categories = [];
    private HashSet<Guid> existingVariantIds = [];
    private Product? original;
    private Dictionary<Guid, string> removalBlockers = [];
    private static readonly string[] genders = ["Женский", "Мужской", "Унисекс"];
    private static readonly string[] seasons = ["Весна", "Лето", "Осень", "Зима", "Всесезон"];
    private IReadOnlyList<OrbitSelectOption<string>> CategoryOptions => OrbitSelectOptions.OptionalStrings(categories, "Не выбрана");
    private static readonly IReadOnlyList<OrbitSelectOption<string>> GenderOptions = OrbitSelectOptions.OptionalStrings(genders, "Не указан");
    private static readonly IReadOnlyList<OrbitSelectOption<string>> SeasonOptions = OrbitSelectOptions.OptionalStrings(seasons, "Не указан");
    private EntityImageEditor? imageEditor;
    private OrbitSelect<string>? categoryPicker;
    private UnsavedChangesGuard? unsavedGuard;
    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; errorMessage = null;
        try
        {
            categories = (await Commerce.GetCategoriesAsync()).Where(value => value.IsActive).OrderBy(value => value.SortOrder).Select(value => value.Name).ToList();
            existingVariantIds = []; removalBlockers = []; original = null;
            if (Id is not null)
            {
                model = await Catalog.GetProductAsync(Id.Value) ?? throw new InvalidOperationException("Товар не найден.");
                // Отдельный экземпляр: по нему сервис поймёт, какие поля изменил пользователь.
                original = await Catalog.GetProductAsync(Id.Value);
                var sales = await SalesRepository.GetSalesAsync();
                var purchases = await Commerce.GetPurchasesAsync();
                existingVariantIds = model.Variants.Select(value => value.Id).ToHashSet();
                foreach (var variant in model.Variants)
                    if (ProductEditingService.VariantRemovalBlocker(variant, sales, purchases) is { } blocker) removalBlockers[variant.Id] = blocker;
            }
            else { model = new Product { Status = ProductStatus.OnOrder }; model.Variants.Add(new ProductVariant()); }
        }
        catch (Exception exception) { errorMessage = UserErrors.Describe(exception, "Не удалось загрузить товар. Попробуйте ещё раз."); }
        finally { isLoading = false; }
    }

    private void AddVariant() { model.Variants.Add(new ProductVariant()); unsavedGuard?.MarkDirty(); }
    private async Task AddCategoryAsync()
    {
        var name = newCategoryName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { saveError = "Введите название категории."; return; }
        if (categories.Any(value => string.Equals(value, name, StringComparison.OrdinalIgnoreCase)))
        {
            model.Category = categories.First(value => string.Equals(value, name, StringComparison.OrdinalIgnoreCase));
            newCategoryName = string.Empty;
            categoryPicker?.CloseDialog();
            return;
        }
        isSaving = true; saveError = null;
        try
        {
            await Commerce.UpsertCategoryAsync(new Category { Name = name, SortOrder = categories.Count, IsActive = true });
            categories = categories.Append(name).OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase).ToList();
            model.Category = name;
            newCategoryName = string.Empty;
            categoryPicker?.CloseDialog();
            unsavedGuard?.MarkDirty();
        }
        catch (Exception exception) { saveError = UserErrors.Describe(exception, "Не удалось добавить категорию. Попробуйте ещё раз."); }
        finally { isSaving = false; }
    }
    private string? RemovalBlocker(ProductVariant variant) => removalBlockers.GetValueOrDefault(variant.Id);
    private void RemoveVariant(ProductVariant variant) { if (RemovalBlocker(variant) is not null) return; model.Variants.Remove(variant); unsavedGuard?.MarkDirty(); }
    private void UpdatePrimaryImage()
    {
        model.ImageUrl = model.Images.OrderByDescending(item => item.IsMain).ThenBy(item => item.SortOrder).FirstOrDefault()?.Url;
        unsavedGuard?.MarkDirty();
    }

    private async Task SaveAsync()
    {
        isSaving = true; saveError = null;
        try
        {
            UpdatePrimaryImage();
            await ProductEditing.SaveAsync(model, original);
            if (imageEditor is not null) await imageEditor.CommitAsync();
            unsavedGuard?.MarkClean();
            Navigation.NavigateTo("/products");
        }
        catch (Exception exception) { saveError = UserErrors.Describe(exception, "Не удалось сохранить товар. Попробуйте ещё раз."); }
        finally { isSaving = false; }
    }

    private async Task ArchiveAsync()
    {
        isSaving = true; saveError = null;
        try { UpdatePrimaryImage(); await ProductEditing.ArchiveAsync(model, original); if (imageEditor is not null) await imageEditor.CommitAsync(); unsavedGuard?.MarkClean(); Navigation.NavigateTo("/products"); }
        catch (Exception exception) { saveError = UserErrors.Describe(exception, "Не удалось архивировать товар. Попробуйте ещё раз."); }
        finally { isSaving = false; }
    }
}
