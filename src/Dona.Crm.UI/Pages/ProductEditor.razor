@page "/products/new"
@page "/products/{Id:guid}"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICatalogRepository Catalog
@inject ICommerceRepository Commerce
@inject IBusinessSettingsRepository Settings
@inject ProductStatusService StatusService
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Новый товар" : "Товар") — DONA CRM</PageTitle>

<div class="editor-page" aria-busy="@isLoading">
    <header><a class="orbit-icon-button orbit-back-button" href="/products" aria-label="Вернуться в каталог"><OrbitIcon Name="back" /></a><div><p>Каталог</p><h1>@(IsNew ? "Новый товар" : "Редактирование")</h1></div></header>

    @if (isLoading) { <div class="editor-state" role="status">Загружаем товар…</div> }
    else if (errorMessage is not null) { <div class="editor-state" role="alert"><strong>Не удалось открыть товар</strong><p>@errorMessage</p><a href="/products">В каталог</a></div> }
    else
    {
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <div class="product-editor-workspace">
                <div class="product-editor-primary">
                    <section aria-labelledby="main-fields"><h2 id="main-fields">Основное</h2>
                        <label>Название<InputText @bind-Value="model.Name" autocomplete="off" /><ValidationMessage For="() => model.Name" /></label>
                        <div class="field-row"><label>SKU<InputText @bind-Value="model.Sku" autocomplete="off" /><ValidationMessage For="() => model.Sku" /></label><label>Категория<div class="category-select"><OrbitSelect TValue="string" @bind-Value="model.Category" Options="@CategoryOptions" Label="Категория" /><button type="button" aria-label="Добавить категорию" title="Добавить категорию" @onclick="() => addingCategory = !addingCategory"><OrbitIcon Name="plus" /></button></div>@if(addingCategory){<div class="quick-category"><InputText @bind-Value="newCategoryName" placeholder="Название категории" autocomplete="off" /><button type="button" disabled="@isSaving" @onclick="AddCategoryAsync">Добавить</button></div>}</label></div>
                        <div class="field-row"><label>Пол<OrbitSelect TValue="string" @bind-Value="model.Gender" Options="@GenderOptions" Label="Пол" /></label><label>Сезон<OrbitSelect TValue="string" @bind-Value="model.Season" Options="@SeasonOptions" Label="Сезон" /></label></div>
                        <label>Описание и заметки<InputTextArea @bind-Value="model.Notes" rows="5" placeholder="Материал, посадка, особенности модели" /></label>
                    </section>
                </div>

                <div class="product-editor-secondary">
                    <EntityImageEditor @ref="imageEditor" Images="@model.Images" OwnerId="@model.Id" EntityLabel="товара" ImagesChanged="UpdatePrimaryImage" />
                    <section aria-labelledby="commerce-fields"><h2 id="commerce-fields">Закупка и продажа</h2>
                        <label>Магазин или поставщик<InputText @bind-Value="model.SupplierName" placeholder="Название магазина" /></label>
                        <label>Ссылка на магазин<InputText @bind-Value="model.SourceUrl" inputmode="url" placeholder="https://detail.1688.com/…" /></label>
                        @if (Uri.TryCreate(model.SourceUrl, UriKind.Absolute, out var storeUri) && storeUri.Scheme is "http" or "https")
                        {
                            <a class="store-link" href="@storeUri" target="_blank" rel="noopener noreferrer">Открыть страницу товара в магазине ↗</a>
                        }
                        <div class="field-row"><label>Закупка, CNY<InputNumber @bind-Value="model.PurchasePriceCny" /></label><label>Курс CNY<InputNumber @bind-Value="model.CnyRateUzs" /></label></div>
                        <div class="field-row"><label>Доставка, UZS<InputNumber @bind-Value="model.DeliveryCostUzs" /></label><label>Продажа, UZS<InputNumber @bind-Value="model.SellingPriceUzs" /></label></div>
                    </section>
                </div>
            </div>

            <section class="product-variants" aria-labelledby="variants"><div class="section-title"><h2 id="variants">Варианты и остатки</h2><button type="button" @onclick="AddVariant"><OrbitIcon Name="plus" Class="orbit-inline-icon" />Добавить</button></div>
                @if (model.Variants.Count == 0) { <p class="empty-variants">Добавьте цвет, размер и количество.</p> }
                @foreach (var variant in model.Variants)
                {
                    <div class="variant-row" @key="variant.Id">
                        <label>Цвет<InputText @bind-Value="variant.Color" /></label><label>Размер<InputText @bind-Value="variant.Size" /></label><label>Кол-во<InputNumber @bind-Value="variant.Quantity" /></label>
                        <button type="button" class="remove" aria-label="Удалить вариант" @onclick="() => RemoveVariant(variant)">×</button>
                    </div>
                }
            </section>

            <ValidationSummary />
            @if (saveError is not null) { <p class="save-error" role="alert">@saveError</p> }
            @if (!IsNew)
            {
                @if (confirmArchive)
                {
                    <div class="archive-confirm" role="group" aria-label="Подтверждение архивирования"><span>Убрать товар из активного каталога?</span><button type="button" @onclick="() => confirmArchive = false">Нет</button><button type="button" class="danger-action" @onclick="ArchiveAsync">Да, в архив</button></div>
                }
                else
                {
                    <button type="button" class="archive-toggle" @onclick="() => confirmArchive = true">Переместить товар в архив</button>
                }
            }
            <div class="form-actions"><a href="/products">Отмена</a><button type="submit" disabled="@isSaving">@(isSaving ? "Сохраняем…" : "Сохранить товар")</button></div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Product model = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool confirmArchive;
    private bool addingCategory;
    private string newCategoryName = string.Empty;
    private string? errorMessage;
    private string? saveError;
    private IReadOnlyList<string> categories = [];
    private static readonly string[] genders = ["Женский", "Мужской", "Унисекс"];
    private static readonly string[] seasons = ["Весна", "Лето", "Осень", "Зима", "Всесезон"];
    private IReadOnlyList<OrbitSelectOption<string>> CategoryOptions => OrbitSelectOptions.OptionalStrings(categories, "Не выбрана");
    private static readonly IReadOnlyList<OrbitSelectOption<string>> GenderOptions = OrbitSelectOptions.OptionalStrings(genders, "Не указан");
    private static readonly IReadOnlyList<OrbitSelectOption<string>> SeasonOptions = OrbitSelectOptions.OptionalStrings(seasons, "Не указан");
    private EntityImageEditor? imageEditor;
    private UnsavedChangesGuard? unsavedGuard;
    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; errorMessage = null;
        try
        {
            categories = (await Commerce.GetCategoriesAsync()).Where(value => value.IsActive).OrderBy(value => value.SortOrder).Select(value => value.Name).ToList();
            if (Id is not null) model = await Catalog.GetProductAsync(Id.Value) ?? throw new InvalidOperationException("Товар не найден.");
            else { model = new Product { Status = ProductStatus.OnOrder }; model.Variants.Add(new ProductVariant()); }
        }
        catch (Exception exception) { errorMessage = exception.Message; }
        finally { isLoading = false; }
    }

    private void AddVariant() { model.Variants.Add(new ProductVariant()); unsavedGuard?.MarkDirty(); }
    private async Task AddCategoryAsync()
    {
        var name = newCategoryName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { saveError = "Введите название категории."; return; }
        if (categories.Any(value => string.Equals(value, name, StringComparison.OrdinalIgnoreCase))) { model.Category = categories.First(value => string.Equals(value, name, StringComparison.OrdinalIgnoreCase)); addingCategory = false; newCategoryName = string.Empty; return; }
        isSaving = true; saveError = null;
        try
        {
            await Commerce.UpsertCategoryAsync(new Category { Name = name, SortOrder = categories.Count, IsActive = true });
            categories = categories.Append(name).OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase).ToList();
            model.Category = name;
            newCategoryName = string.Empty;
            addingCategory = false;
            unsavedGuard?.MarkDirty();
        }
        catch (Exception exception) { saveError = exception.Message; }
        finally { isSaving = false; }
    }
    private void RemoveVariant(ProductVariant variant) { model.Variants.Remove(variant); unsavedGuard?.MarkDirty(); }
    private void UpdatePrimaryImage()
    {
        model.ImageUrl = model.Images.OrderByDescending(item => item.IsMain).ThenBy(item => item.SortOrder).FirstOrDefault()?.Url;
        unsavedGuard?.MarkDirty();
    }

    private async Task SaveAsync()
    {
        isSaving = true; saveError = null;
        try
        {
            model.Sku = model.Sku.Trim();
            var duplicate = (await Catalog.GetProductsAsync()).FirstOrDefault(product =>
                product.Id != model.Id && string.Equals(product.Sku.Trim(), model.Sku, StringComparison.OrdinalIgnoreCase));
            if (duplicate is not null)
                throw new InvalidOperationException($"SKU «{model.Sku}» уже используется товаром «{duplicate.Name}».");
            model.Status = StatusService.Calculate(model, await Settings.GetAsync());
            UpdatePrimaryImage();
            await Catalog.UpsertProductAsync(model);
            if (imageEditor is not null) await imageEditor.CommitAsync();
            unsavedGuard?.MarkClean();
            Navigation.NavigateTo("/products");
        }
        catch (Exception exception) { saveError = exception.Message; }
        finally { isSaving = false; }
    }

    private async Task ArchiveAsync()
    {
        isSaving = true; saveError = null;
        try { model.Status = ProductStatus.Archived; UpdatePrimaryImage(); await Catalog.UpsertProductAsync(model); if (imageEditor is not null) await imageEditor.CommitAsync(); unsavedGuard?.MarkClean(); Navigation.NavigateTo("/products"); }
        catch (Exception exception) { saveError = exception.Message; }
        finally { isSaving = false; }
    }
}
