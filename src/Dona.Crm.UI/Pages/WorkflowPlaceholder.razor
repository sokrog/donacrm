@page "/purchases/new"
@inject NavigationManager Navigation

<PageTitle>@Title — DONA CRM</PageTitle>

<div class="placeholder-page">
    <p class="placeholder-kicker">Быстрое действие</p>
    <h1>@Title</h1>
    <p>Маршрут уже зарезервирован. Форма будет перенесена без изменения бизнес-правил существующего Web-приложения.</p>
    <a class="placeholder-link" href="/">Вернуться на главную</a>
</div>

@code {
    private string Title => new Uri(Navigation.Uri).AbsolutePath switch
    {
        "/products/new" => "Добавить товар",
        "/sales/new" => "Создать продажу",
        "/purchases/new" => "Создать закупку",
        _ => "Изменить остаток"
    };
}
