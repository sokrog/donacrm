@page "/marketing"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject IMarketingRepository Marketing
@inject IBusinessSettingsRepository Settings

<PageTitle>Маркетинг — DONA CRM</PageTitle>
<div class="marketing-hub">
    <header><div><a href="/more">Ещё</a><h1>Маркетинг</h1></div></header><p class="hub-intro">Подготовка ассортимента и публикаций в одном месте.</p>
    @if(loading){<div class="hub-state">Загружаем маркетинг…</div>}
    else
    {
        @if(Overdue>0){<div class="hub-alert">Просрочено публикаций: @Overdue. Перенесите дату или обновите статус.</div>}
        <nav class="hub-list" aria-label="Разделы маркетинга">
            <a href="/content-plan"><span class="hub-icon content"><OrbitIcon Name="marketing" /></span><span><strong>Контент-план</strong><small>@UpcomingText</small></span><b>@data.ContentPosts.Count<small>публикаций</small></b></a>
            <a href="/collections"><span class="hub-icon"><OrbitIcon Name="catalog" /></span><span><strong>Коллекции</strong><small>Сезоны, запуски и подборки</small></span><b>@data.Collections.Count<small>коллекций</small></b></a>
            <a href="/outfits"><span class="hub-icon outfit"><OrbitIcon Name="image" /></span><span><strong>Образы</strong><small>Готовые сочетания товаров</small></span><b>@data.Outfits.Count<small>образов</small></b></a>
        </nav>
    }
</div>
@code{
    private MarketingData data=new();private BusinessSettings settings=new();private bool loading=true;private IEnumerable<ContentPost> Pending=>data.ContentPosts.Where(value=>value.Status is not ContentStatus.Published and not ContentStatus.Cancelled);private int Overdue=>Pending.Count(value=>value.ScheduledAt?.Date<DateTime.Today);private int Upcoming=>Pending.Count(value=>value.ScheduledAt?.Date>=DateTime.Today&&value.ScheduledAt?.Date<=DateTime.Today.AddDays(settings.ContentPlanningHorizonDays));private string UpcomingText=>Upcoming>0?$"{Upcoming} публикаций в ближайшие {settings.ContentPlanningHorizonDays} дней":"Ближайших публикаций нет";
    protected override async Task OnInitializedAsync(){var marketing=Marketing.GetDataAsync();var storedSettings=Settings.GetAsync();await Task.WhenAll(marketing,storedSettings);data=await marketing;settings=await storedSettings;loading=false;}
}
