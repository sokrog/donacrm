@page "/content-plan/new"
@page "/content-plan/{Id:guid}"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject IMarketingRepository Marketing
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Новая публикация" : post.Title) — DONA CRM</PageTitle>
<div class="dona-page dona-page--form">
    <header class="dona-page-header dona-page-header--back dona-heading">
        <a class="dona-icon-button dona-back-button" href="/content-plan" aria-label="Вернуться к контент-плану"><OrbitIcon Name="back" /></a>
        <div>
            <p>@post.Status.Display()</p>
            <h1>@(IsNew ? "Новая публикация" : post.Title)</h1>
        </div>
    </header>
    @if (loading)
    {
        <div class="dona-state">Загружаем публикацию…</div>
    }
    else if (error is not null)
    {
        <div class="dona-state dona-state--error" role="alert">@error</div>
    }
    else
    {
        <EditForm class="dona-stack" Model="post" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <section class="dona-section">
                <h2>Публикация</h2>
                <label class="dona-field">Тема<InputText @bind-Value="post.Title" placeholder="О чём публикация" /><ValidationMessage For="() => post.Title" /></label>
                <div class="dona-field-row">
                    <label class="dona-field">Формат<OrbitSelect TValue="ContentType?" @bind-Value="post.Type" Options="@ContentTypeOptions" Label="Формат публикации" /></label>
                    <label class="dona-field">Статус<OrbitSelect TValue="ContentStatus?" @bind-Value="post.Status" Options="@ContentStatusOptions" Label="Статус публикации" /></label>
                </div>
                <label class="dona-field">Дата публикации<OrbitDatePicker @bind-Value="post.ScheduledAt" ValueChangedAfter="_ => unsavedGuard?.MarkDirty()" /></label>
            </section>
            <section class="dona-section">
                <div class="dona-section-title">
                    <div>
                        <h2>Связанные товары</h2>
                        <p>Через коллекцию или готовый образ</p>
                    </div>
                </div>
                <label class="dona-field">Коллекция<OrbitSelect TValue="Guid?" @bind-Value="post.CollectionId" @bind-Value:after="CollectionChanged" Options="@CollectionOptions" Label="Коллекция" Searchable="true" /></label>
                <label class="dona-field">Готовый образ<OrbitSelect TValue="Guid?" @bind-Value="post.OutfitId" @bind-Value:after="OutfitChanged" Options="@OutfitOptions" Label="Готовый образ" Searchable="true" /></label>
                @if (post.CollectionId is null && post.OutfitId is null)
                {
                    <p class="dona-note dona-note--sm">Публикация сохранится без привязки к ассортименту.</p>
                }
                else
                {
                    <p class="dona-note dona-note--sm linked">Привязка позволит учитывать результат публикации в аналитике.</p>
                }
            </section>
            <section class="dona-section">
                <div class="dona-section-title">
                    <div>
                        <h2>Материал</h2>
                        <p>Текст можно доработать позже</p>
                    </div>
                    <span>@(post.Caption?.Length ?? 0) знаков</span>
                </div>
                <label class="dona-field">Текст публикации<InputTextArea @bind-Value="post.Caption" placeholder="Текст, призыв к действию, хэштеги…" /></label>
                @if (post.Status == ContentStatus.Published)
                {
                    <label class="dona-field">Ссылка на публикацию<InputText @bind-Value="post.PublicationUrl" inputmode="url" placeholder="https://…" /></label>
                }
                <details>
                    <summary>Дополнительные заметки</summary>
                    <label class="dona-field">Заметки<InputTextArea @bind-Value="post.Notes" /></label>
                </details>
            </section>
            @if (confirmDelete)
            {
                <div class="dona-confirm dona-confirm--boxed">
                    <span>Удалить публикацию? Это действие нельзя отменить.</span>
                    <button type="button" class="dona-btn dona-btn--secondary" @onclick="() => confirmDelete = false">Нет</button>
                    <button type="button" class="dona-btn dona-btn--danger" @onclick="DeleteAsync">Да, удалить</button>
                </div>
            }
            @if (message is not null)
            {
                <p class="dona-message dona-message--error" role="alert">@message</p>
            }
            <div class="dona-actions">
                <a class="dona-btn dona-btn--secondary" href="/content-plan">Отмена</a>
                @if (!IsNew && !confirmDelete)
                {
                    <button type="button" class="dona-btn dona-btn--danger" @onclick="() => confirmDelete = true">Удалить</button>
                }
                <button class="dona-btn dona-btn--primary" disabled="@saving">@(saving ? "Сохраняем…" : "Сохранить")</button>
            </div>
        </EditForm>
    }
</div>
@code {
    [Parameter]
    public Guid? Id { get; set; }

    private ContentPost post = new();
    private IReadOnlyList<ProductCollection> collections = [];
    private IReadOnlyList<Outfit> outfits = [];
    private UnsavedChangesGuard? unsavedGuard;
    private bool loading = true;
    private bool saving;
    private bool confirmDelete;
    private string? error;
    private string? message;

    private bool IsNew => Id is null;

    private static readonly IReadOnlyList<OrbitSelectOption<ContentType?>> ContentTypeOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<ContentType>(), "Не выбран", value => value.Display());

    private static readonly IReadOnlyList<OrbitSelectOption<ContentStatus?>> ContentStatusOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<ContentStatus>(), "Не указан", value => value.Display());

    private IReadOnlyList<OrbitSelectOption<Guid?>> CollectionOptions =>
    [
        new(null, "Не выбрана"),
        .. collections.Select(value => new OrbitSelectOption<Guid?>(value.Id, $"{value.Name} · {value.Products.Count} тов."))
    ];

    private IReadOnlyList<OrbitSelectOption<Guid?>> OutfitOptions =>
    [
        new(null, "Не выбран"),
        .. outfits.Select(value => new OrbitSelectOption<Guid?>(value.Id, $"{value.Name} · {value.Products.Count} тов."))
    ];

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        confirmDelete = false;
        try
        {
            var data = await Marketing.GetDataAsync();
            collections = data.Collections;
            outfits = data.Outfits;
            post = Id is null
                ? new ContentPost { Status = ContentStatus.Idea }
                : Clone(data.ContentPosts.FirstOrDefault(value => value.Id == Id) ?? throw new InvalidOperationException("Публикация не найдена."));
        }
        catch (Exception ex)
        {
            error = UserErrors.Describe(ex, "Не удалось загрузить публикацию. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private void CollectionChanged()
    {
        post.CollectionName = post.CollectionId is null ? null : collections.FirstOrDefault(value => value.Id == post.CollectionId)?.Name;
    }

    private void OutfitChanged()
    {
        post.OutfitName = post.OutfitId is null ? null : outfits.FirstOrDefault(value => value.Id == post.OutfitId)?.Name;
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        message = null;
        try
        {
            post.Title = post.Title.Trim();
            post.Caption = Clean(post.Caption);
            post.PublicationUrl = Clean(post.PublicationUrl);
            post.Notes = Clean(post.Notes);
            await Marketing.UpsertContentPostAsync(post);
            unsavedGuard?.MarkClean();
            Navigation.NavigateTo("/content-plan");
        }
        catch (Exception ex)
        {
            message = UserErrors.Describe(ex, "Не удалось сохранить публикацию. Попробуйте ещё раз.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        message = null;
        try
        {
            await Marketing.DeleteContentPostAsync(post.Id);
            unsavedGuard?.MarkClean();
            Navigation.NavigateTo("/content-plan");
        }
        catch (Exception ex)
        {
            message = UserErrors.Describe(ex, "Не удалось удалить публикацию. Попробуйте ещё раз.");
            confirmDelete = false;
        }
        finally
        {
            saving = false;
        }
    }

    private static ContentPost Clone(ContentPost value) => new()
    {
        Id = value.Id,
        Title = value.Title,
        Type = value.Type,
        Status = value.Status,
        ScheduledAt = value.ScheduledAt,
        CollectionId = value.CollectionId,
        CollectionName = value.CollectionName,
        OutfitId = value.OutfitId,
        OutfitName = value.OutfitName,
        Caption = value.Caption,
        PublicationUrl = value.PublicationUrl,
        Notes = value.Notes,
        CreatedAt = value.CreatedAt
    };

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
