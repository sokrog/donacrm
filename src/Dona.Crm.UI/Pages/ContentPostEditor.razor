@page "/content-plan/new"
@page "/content-plan/{Id:guid}"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject IMarketingRepository Marketing
@inject NavigationManager Navigation

<PageTitle>@(IsNew?"Новая публикация":post.Title) — DONA CRM</PageTitle>
<div class="content-editor">
    <header><a href="/content-plan" aria-label="Вернуться к контент-плану">‹</a><div><p>@post.Status.Display()</p><h1>@(IsNew?"Новая публикация":post.Title)</h1></div></header>
    @if(loading){<div class="editor-state">Загружаем публикацию…</div>}
    else if(error is not null){<div class="editor-state" role="alert">@error</div>}
    else
    {
        <EditForm Model="post" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
            <section><h2>Публикация</h2><label>Тема<InputText @bind-Value="post.Title" placeholder="О чём публикация" /><ValidationMessage For="()=>post.Title" /></label><div class="field-row"><label>Формат<select @bind="post.Type"><option value="">Не выбран</option>@foreach(var value in Enum.GetValues<ContentType>()){<option value="@value">@value.Display()</option>}</select></label><label>Статус<select @bind="post.Status"><option value="">Не указан</option>@foreach(var value in Enum.GetValues<ContentStatus>()){<option value="@value">@value.Display()</option>}</select></label></div><label>Дата публикации<InputDate @bind-Value="post.ScheduledAt" /></label></section>
            <section><div class="section-heading"><div><h2>Связанные товары</h2><p>Через коллекцию или готовый образ</p></div></div><label>Коллекция<select value="@post.CollectionId" @onchange="CollectionChanged"><option value="">Не выбрана</option>@foreach(var value in collections){<option value="@value.Id">@value.Name · @value.Products.Count тов.</option>}</select></label><label>Готовый образ<select value="@post.OutfitId" @onchange="OutfitChanged"><option value="">Не выбран</option>@foreach(var value in outfits){<option value="@value.Id">@value.Name · @value.Products.Count тов.</option>}</select></label>@if(post.CollectionId is null&&post.OutfitId is null){<p class="association-note">Публикация сохранится без привязки к ассортименту.</p>}else{<p class="association-note linked">Привязка позволит учитывать результат публикации в аналитике.</p>}</section>
            <section><div class="section-heading"><div><h2>Материал</h2><p>Текст можно доработать позже</p></div><span>@(post.Caption?.Length??0) знаков</span></div><label>Текст публикации<InputTextArea @bind-Value="post.Caption" placeholder="Текст, призыв к действию, хэштеги…" /></label>@if(post.Status==ContentStatus.Published){<label>Ссылка на публикацию<InputText @bind-Value="post.PublicationUrl" inputmode="url" placeholder="https://…" /></label>}<details><summary>Дополнительные заметки</summary><label>Заметки<InputTextArea @bind-Value="post.Notes" /></label></details></section>
            @if(confirmDelete){<div class="delete-confirm"><span>Удалить публикацию? Это действие нельзя отменить.</span><button type="button" class="secondary" @onclick="()=>confirmDelete=false">Нет</button><button type="button" class="danger" @onclick="DeleteAsync">Да, удалить</button></div>}
            @if(message is not null){<p class="editor-message" role="alert">@message</p>}
            <div class="actions"><a href="/content-plan">Отмена</a>@if(!IsNew&&!confirmDelete){<button type="button" class="danger" @onclick="()=>confirmDelete=true">Удалить</button>}<button disabled="@saving">@(saving?"Сохраняем…":"Сохранить")</button></div>
        </EditForm>
    }
</div>
@code{
    [Parameter]public Guid? Id{get;set;}private ContentPost post=new();private IReadOnlyList<ProductCollection> collections=[];private IReadOnlyList<Outfit> outfits=[];private bool loading=true;private bool saving;private bool confirmDelete;private string? error;private string? message;private bool IsNew=>Id is null;
    protected override async Task OnParametersSetAsync(){loading=true;error=null;confirmDelete=false;try{var data=await Marketing.GetDataAsync();collections=data.Collections;outfits=data.Outfits;post=Id is null?new ContentPost{Status=ContentStatus.Idea}:Clone(data.ContentPosts.FirstOrDefault(value=>value.Id==Id)??throw new InvalidOperationException("Публикация не найдена."));}catch(Exception ex){error=ex.Message;}finally{loading=false;}}
    private void CollectionChanged(ChangeEventArgs args){post.CollectionId=Guid.TryParse(args.Value?.ToString(),out var id)?id:null;post.CollectionName=post.CollectionId is null?null:collections.FirstOrDefault(value=>value.Id==post.CollectionId)?.Name;}private void OutfitChanged(ChangeEventArgs args){post.OutfitId=Guid.TryParse(args.Value?.ToString(),out var id)?id:null;post.OutfitName=post.OutfitId is null?null:outfits.FirstOrDefault(value=>value.Id==post.OutfitId)?.Name;}
    private async Task SaveAsync(){if(saving)return;saving=true;message=null;try{post.Title=post.Title.Trim();post.Caption=Clean(post.Caption);post.PublicationUrl=Clean(post.PublicationUrl);post.Notes=Clean(post.Notes);await Marketing.UpsertContentPostAsync(post);Navigation.NavigateTo("/content-plan");}catch(Exception ex){message=ex.Message;}finally{saving=false;}}private async Task DeleteAsync(){await Marketing.DeleteContentPostAsync(post.Id);Navigation.NavigateTo("/content-plan");}
    private static ContentPost Clone(ContentPost value)=>new(){Id=value.Id,Title=value.Title,Type=value.Type,Status=value.Status,ScheduledAt=value.ScheduledAt,CollectionId=value.CollectionId,CollectionName=value.CollectionName,OutfitId=value.OutfitId,OutfitName=value.OutfitName,Caption=value.Caption,PublicationUrl=value.PublicationUrl,Notes=value.Notes,CreatedAt=value.CreatedAt};private static string? Clean(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
}
