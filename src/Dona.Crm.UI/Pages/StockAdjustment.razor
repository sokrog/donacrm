@page "/inventory/adjustment/new"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICatalogRepository Catalog
@inject StockAdjustmentService Service
@inject NavigationManager Navigation

<PageTitle>Корректировка склада — DONA CRM</PageTitle>
<div class="adjust-page">
    <header><a class="orbit-icon-button orbit-back-button" href="/inventory" aria-label="Вернуться к движениям склада"><OrbitIcon Name="back" /></a><div><p>Склад</p><h1>Корректировка</h1></div></header>
    @if (isLoading) { <div class="adjust-state">Загружаем остатки…</div> }
    else if (products.Count == 0) { <div class="adjust-state"><strong>Нет товаров с вариантами</strong><p>Сначала добавьте товар и хотя бы один вариант.</p><a href="/products/new">Добавить товар</a></div> }
    else
    {
        <EditForm Model="model" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
            <section><h2>Фактический остаток</h2>
                <label>Товар<select @bind="model.ProductId" @bind:after="ProductChanged"><option value="">Выберите товар</option>@foreach(var product in products){<option value="@product.Id">@product.Name · @product.Sku</option>}</select></label>
                <label>Вариант<select @bind="model.ProductVariantId" @bind:after="VariantChanged" disabled="@(SelectedProduct is null)"><option value="">Выберите вариант</option>@foreach(var variant in SelectedProduct?.Variants ?? []){<option value="@variant.Id">@VariantName(variant) · остаток @(variant.Quantity ?? 0)</option>}</select></label>
                <div class="quantity-grid"><div><span>Сейчас</span><strong>@(SelectedVariant?.Quantity ?? 0) ед.</strong><small>резерв @(SelectedVariant?.ReservedQuantity ?? 0)</small></div><label>Новый остаток<InputNumber @bind-Value="model.NewQuantity" min="0" /></label></div>
                @if (SelectedVariant is not null && model.NewQuantity is not null) { <div class="preview"><span>Изменение</span><strong class="@(Delta > 0 ? "plus" : Delta < 0 ? "minus" : null)">@DeltaText ед.</strong></div> }
            </section>
            <section><h2>Причина</h2><label>Тип корректировки<InputSelect class="adjust-select" @bind-Value="model.Reason"><option value="">Выберите причину</option>@foreach(var reason in Enum.GetValues<StockAdjustmentReason>()){<option value="@reason">@reason.Display()</option>}</InputSelect></label><label>Комментарий<InputTextArea @bind-Value="model.Note" placeholder="Что произошло и почему меняется остаток" /></label></section>
            <ValidationSummary />@if(error is not null){<p class="adjust-error" role="alert">@error</p>}
            <div class="actions"><a href="/inventory">Отмена</a><button disabled="@saving">@(saving ? "Сохраняем…" : "Сохранить")</button></div>
        </EditForm>
    }
</div>
@code {
    private StockAdjustmentRequest model = new(); private IReadOnlyList<Product> products=[]; private bool isLoading=true; private bool saving; private string? error;
    private Product? SelectedProduct => model.ProductId is null ? null : products.FirstOrDefault(item=>item.Id==model.ProductId);
    private ProductVariant? SelectedVariant => model.ProductVariantId is null ? null : SelectedProduct?.Variants.FirstOrDefault(item=>item.Id==model.ProductVariantId);
    private int Delta => (model.NewQuantity ?? 0) - (SelectedVariant?.Quantity ?? 0); private string DeltaText => Delta>0?$"+{Delta}":Delta.ToString();
    protected override async Task OnInitializedAsync(){products=(await Catalog.GetProductsAsync()).Where(item=>item.Status!=ProductStatus.Archived&&item.Variants.Count>0).ToList();isLoading=false;}
    private void ProductChanged(){model.ProductVariantId=null;model.NewQuantity=null;}
    private void VariantChanged()=>model.NewQuantity=SelectedVariant?.Quantity;
    private async Task SaveAsync(){saving=true;error=null;try{await Service.AdjustAsync(model);Navigation.NavigateTo("/inventory");}catch(Exception exception){error=exception.Message;}finally{saving=false;}}
    private static string VariantName(ProductVariant variant)=>string.Join(" · ",new[]{variant.Color,variant.Size}.Where(value=>!string.IsNullOrWhiteSpace(value))) is {Length:>0} value?value:"Без названия";
}
