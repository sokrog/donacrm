@page "/inventory/adjustment/new"
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICatalogRepository Catalog
@inject StockAdjustmentService Service
@inject NavigationManager Navigation

<PageTitle>Корректировка склада — DONA CRM</PageTitle>
<div class="dona-page dona-page--form">
    <DonaPageHeader Class="dona-page-header dona-page-header--back dona-heading">
        <a class="dona-icon-button dona-back-button" href="/inventory" aria-label="Вернуться к движениям склада"><OrbitIcon Name="back" /></a>
        <div>
            <p>Склад</p>
            <h1>@(IsPersonal ? "Личное изъятие" : "Корректировка")</h1>
        </div>
    </DonaPageHeader>
    @if (isLoading)
    {
        <div class="dona-state">Загружаем остатки…</div>
    }
    else if (products.Count == 0)
    {
        <div class="dona-state">
            <strong>Нет товаров с вариантами</strong>
            <p>Сначала добавьте товар и хотя бы один вариант.</p>
            <a href="/products/new">Добавить товар</a>
        </div>
    }
    else
    {
        <EditForm id="stockadjustment-form-1" class="dona-stack" Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <section class="dona-section">
                <h2>Фактический остаток</h2>
                <label class="dona-field">Товар<OrbitSelect TValue="Guid?" @bind-Value="model.ProductId" @bind-Value:after="ProductChanged" Options="@ProductOptions" Label="Товар" Searchable="true" /></label>
                <label class="dona-field">Вариант<OrbitSelect TValue="Guid?" @bind-Value="model.ProductVariantId" @bind-Value:after="VariantChanged" Options="@VariantOptions" Label="Вариант" Disabled="@(SelectedProduct is null)" /></label>
                <div class="quantity-grid">
                    <div>
                        <span>Сейчас</span>
                        <strong>@(SelectedVariant?.Quantity ?? 0) ед.</strong>
                        <small>резерв @(SelectedVariant?.ReservedQuantity ?? 0)</small>
                    </div>
                    @if (IsPersonal)
                    {
                        <label class="dona-field">Количество для себя<DonaLiveNumber @bind-Value="model.WithdrawQuantity" @bind-Value:after="UpdateWithdrawal" min="1" max="@AvailableQuantity" /></label>
                    }
                    else
                    { <label class="dona-field">Новый остаток<InputNumber @bind-Value="model.NewQuantity" min="0" /></label> }
                </div>
                @if (SelectedVariant is not null && model.NewQuantity is not null)
                {
                    <div class="preview">
                        <span>@(IsPersonal ? $"Будет списано: {model.WithdrawQuantity ?? 0} шт. · Останется на складе" : "Изменение")</span>
                        <strong class="@(Delta > 0 ? "plus" : Delta < 0 ? "minus" : null)">@(IsPersonal ? model.NewQuantity?.ToString() : DeltaText) ед.</strong>
                    </div>
                }
                @if (Delta > 0)
                {
                    <label class="dona-field">Себестоимость единицы<InputNumber @bind-Value="model.UnitCost" min="0" /></label>
                    <small>Для начального остатка укажите себестоимость. Ноль означает бесплатный товар.</small>
                }
                @if (Delta < 0)
                {
                    <p>@LossPreview()</p>
                }
            </section>
            <section class="dona-section">
                <h2>Причина</h2>
                <label class="dona-field">Тип корректировки<OrbitSelect TValue="StockAdjustmentReason?" @bind-Value="model.Reason" @bind-Value:after="ReasonChanged" Options="@ReasonOptions" Label="Причина корректировки" /></label>
                @if (Delta < 0)
                {
                    <label class="dona-field">Как учесть стоимость<OrbitSelect TValue="LossTreatment" @bind-Value="model.LossTreatment" Options="LossOptions" Label="Как учесть стоимость" /></label>
                    <p class="dona-note">Отдельный расход уменьшает прибыль. Распределение увеличивает себестоимость оставшихся единиц этого варианта; выручка не меняется.</p>
                }
                <label class="dona-field">Комментарий<InputTextArea @bind-Value="model.Note" placeholder="Что произошло и почему меняется остаток" /></label>
            </section>
            <ValidationSummary />
            @if(error is not null)
            {
                <p class="dona-message dona-message--error" role="alert">@error</p>
            }

            <DonaPageActions>
                <Primary>
                    <button form="stockadjustment-form-1" type="submit" class="dona-btn dona-btn--primary" disabled="@saving">@(saving ? "Сохраняем…" : IsPersonal ? $"Списать {model.WithdrawQuantity ?? 0} шт. для себя" : "Сохранить")</button>
                </Primary>
            </DonaPageActions>
        </EditForm>
    }
</div>
@code {
    [SupplyParameterFromQuery] public Guid? ProductId { get; set; }
    [SupplyParameterFromQuery] public bool PersonalUse { get; set; }
    [SupplyParameterFromQuery] public Guid? VariantId { get; set; }
    private StockAdjustmentRequest model = new();
    private IReadOnlyList<Product> products=[];
    private UnsavedChangesGuard? unsavedGuard;
    private bool isLoading=true;
    private bool saving;
    private string? error;
    private Product? SelectedProduct => model.ProductId is null ? null : products.FirstOrDefault(item=>item.Id==model.ProductId);
    private ProductVariant? SelectedVariant => model.ProductVariantId is null ? null : SelectedProduct?.Variants.FirstOrDefault(item=>item.Id==model.ProductVariantId);
    private IReadOnlyList<OrbitSelectOption<Guid?>> ProductOptions=>[new(null,"Выберите товар"),..products.Select(value=>new OrbitSelectOption<Guid?>(value.Id,$"{value.Name} · {value.Sku}"))];
    private IReadOnlyList<OrbitSelectOption<Guid?>> VariantOptions=>
    [
        new(null,"Выберите вариант"),
        ..(SelectedProduct?.Variants??[]).Select(value=>new OrbitSelectOption<Guid?>(value.Id,$"{VariantName(value)} · остаток {value.Quantity??0}"))
    ];
    private static readonly IReadOnlyList<OrbitSelectOption<StockAdjustmentReason?>> ReasonOptions=OrbitSelectOptions.Optional(Enum.GetValues<StockAdjustmentReason>(),"Выберите причину",value=>value.Display());
    private static readonly IReadOnlyList<OrbitSelectOption<LossTreatment>> LossOptions = [new(LossTreatment.PeriodExpense, "Отдельный расход"), new(LossTreatment.RemainingStock, "В себестоимость остатка")];
    private bool IsPersonal => model.Reason == StockAdjustmentReason.PersonalUse;
    private int AvailableQuantity => Math.Max(0, (SelectedVariant?.Quantity ?? 0) - (SelectedVariant?.ReservedQuantity ?? 0));
    private void UpdateWithdrawal() => model.NewQuantity = SelectedVariant is null || model.WithdrawQuantity is null ? null : (SelectedVariant.Quantity ?? 0) - model.WithdrawQuantity;
    private void ReasonChanged() { model.WithdrawQuantity = IsPersonal ? 1 : null; if (IsPersonal) UpdateWithdrawal(); }
    private int Delta => (model.NewQuantity ?? 0) - (SelectedVariant?.Quantity ?? 0);
    private string LossPreview()
    {
        if (SelectedVariant is null) return string.Empty;
        try
        {
            var cost = FifoCostCalculator.Cost(FifoCostCalculator.Preview(SelectedVariant, -Delta));
            return cost.TotalValue is { } total ? $"Будет списано по себестоимости: {total:N2} UZS" : $"Известная стоимость списания: {cost.KnownValue:N2}; без оценки: {cost.UnvaluedQuantity} ед.";
        }
        catch (InventoryException ex) { return ex.Message; }
    }
    private string DeltaText => Delta>0?$"+{Delta}":Delta.ToString();
    protected override async Task OnInitializedAsync(){
        products=(await Catalog.GetProductsAsync()).Where(item=>item.Status!=ProductStatus.Archived&&item.Variants.Count>0).ToList();
        if(ProductId is not null&&products.FirstOrDefault(item=>item.Id==ProductId) is{}preset){
            model.ProductId=preset.Id;
            model.Reason=PersonalUse ? StockAdjustmentReason.PersonalUse : StockAdjustmentReason.OpeningBalance;
            model.Note=PersonalUse ? "Личное изъятие" : "Начальный остаток";
            if (VariantId is null && preset.Variants.Count == 1) VariantId = preset.Variants[0].Id;
            if(VariantId is not null&&preset.Variants.Any(item=>item.Id==VariantId)){
                model.ProductVariantId=VariantId;
                VariantChanged();
            }
        }
        isLoading=false;
    }
    private void ProductChanged(){
        model.ProductVariantId=null;
        model.NewQuantity=null;
    }
    private void VariantChanged() { model.NewQuantity = SelectedVariant?.Quantity; model.WithdrawQuantity = IsPersonal ? 1 : null; if (IsPersonal) UpdateWithdrawal(); }
    private async Task SaveAsync(){
        saving=true;
        error=null;
        try{
            if (IsPersonal && model.WithdrawQuantity is null or <= 0) throw new InvalidOperationException("Укажите количество для себя.");
            await Service.AdjustAsync(model);
            unsavedGuard?.MarkClean();
            Navigation.NavigateTo("/inventory");
        }catch(Exception exception){
            error=UserErrors.Describe(exception, "Не удалось провести корректировку. Попробуйте ещё раз.");
        }finally{
            saving=false;
        }
    }
    private static string VariantName(ProductVariant variant)=>string.Join(" · ",new[]{variant.Color,variant.Size}.Where(value=>!string.IsNullOrWhiteSpace(value))) is {Length:>0} value?value:"Без названия";
}
