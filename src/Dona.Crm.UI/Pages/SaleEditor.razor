@page "/sales/new"
@page "/sales/{Id:guid}"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ISalesRepository SalesRepository
@inject ICatalogRepository Catalog
@inject IBusinessSettingsRepository Settings
@inject SalesInventoryService Inventory
@inject SalesPaymentService Payments
@inject SalesReturnService ReturnService
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Новая продажа" : sale.Number) — DONA CRM</PageTitle>
<div class="dona-page dona-page--form">
    <header class="dona-page-header dona-page-header--back dona-heading">
        <a class="dona-icon-button dona-back-button" href="/sales" aria-label="Вернуться к продажам"><OrbitIcon Name="back" /></a>
        <div>
            <p>@sale.Status.Display()</p>
            <h1>@(IsNew ? "Новая продажа" : sale.Number)</h1>
        </div>
    </header>
    @if (loading)
    {
        <div class="dona-state">Загружаем заказ…</div>
    }
    else if (error is not null)
    {
        <div class="dona-state dona-state--error" role="alert">@error</div>
    }
    else
    {
        @if (!IsNew && sale.Status is not (SaleStatus.Cancelled or SaleStatus.Returned))
        {
            <section class="sale-workflow" aria-label="Этапы продажи">
                <p class="workflow-heading">Этапы продажи</p>
                <ol class="workflow">
                    @for (var index = 0; index < Flow.Length; index++)
                    {
                        var status = Flow[index];
                        var state = FlowClass(status);
                        <li class="@state" aria-current="@(state == "active" ? "step" : null)">
                            <span class="workflow-marker" aria-hidden="true">@(state == "done" ? "✓" : (index + 1).ToString())</span>
                            <span class="workflow-label">
                                <strong>@status.Display()</strong>
                                @if (state == "active") { <small>Текущий этап</small> }
                                else if (state == "done") { <small>Пройден</small> }
                            </span>
                        </li>
                    }
                </ol>
            </section>
        }
        <EditForm class="dona-stack" Model="sale" OnValidSubmit="SaveDraftAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <ListItemRemovalConfirmation @ref="removalConfirmation" />
            <fieldset disabled="@IsReadOnly">
                <section class="dona-section">
                    <div class="dona-section-title">
                        <div>
                            <h2>Товары</h2>
                            <p>@sale.TotalQuantity ед. · @Money(sale.TotalUzs) UZS</p>
                        </div>
                        <button type="button" @onclick="AddItem"><OrbitIcon Name="plus" Class="dona-inline-icon" />Позиция</button>
                    </div>
                    @if (sale.Items.Count == 0)
                    {
                        <p class="dona-empty">Добавьте хотя бы один товар.</p>
                    }
                    @foreach (var item in sale.Items)
                    {
                        <article class="sale-line" @key="item.Id" @oninput="() => removalConfirmation?.MarkEdited(item)">
                            <label class="dona-field">Товар<ProductAutocomplete Products="products" Value="item.ProductId" OnSelected="product => ProductChanged(item, product)" /></label>
                            <label class="dona-field">Вариант<OrbitSelect TValue="Guid?" @bind-Value="item.ProductVariantId" @bind-Value:after="() => VariantChanged(item)" Options="@VariantOptions(item)" Label="Вариант товара" /></label>
                            <div class="dona-field-row">
                                <label class="dona-field">Количество<InputNumber @bind-Value="item.Quantity" min="1" /></label>
                                <label class="dona-field">Цена, UZS<InputNumber @bind-Value="item.UnitPriceUzs" min="0" /></label>
                            </div>
                            <button type="button" class="dona-btn dona-btn--danger dona-btn--remove remove-line" aria-label="Удалить позицию" @onclick="() => RemoveItem(item)">×</button>
                        </article>
                    }
                </section>
            </fieldset>
            <details class="dona-section">
                <summary>Себестоимость по партиям</summary>
                @if (sale.Items.Any(x => x.Consumptions.Count > 0))
                {
                    @foreach (var item in sale.Items)
                    {
                        <strong>@item.ProductName</strong>
                        @foreach (var part in item.Consumptions)
                        {
                            var layer = products.SelectMany(x => x.Variants).SelectMany(x => x.Layers).FirstOrDefault(x => x.Id == part.LayerId);
                            <p>@part.Quantity ед. · @(layer?.SourceNumber ?? "Партия") · @(part.TotalCost is null ? "Стоимость неизвестна" : $"Стоимость {part.TotalCost:N2}")</p>
                        }
                    }
                    <p>С учётом возвратов: @(sale.HasUnknownCost ? "оценка неполная" : $"{sale.CostUzs:N2}")</p>
                }
                else
                {
                    <p>Предварительный расчёт по текущим партиям. При отправке заказа стоимость проверяется повторно.</p>
                    <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="PreviewCostAsync">Рассчитать себестоимость</button>
                    @if (previewCostText is not null) { <p>@previewCostText</p> }
                }
            </details>
            <section class="dona-section total-card">
                <span>Товары<strong>@Money(sale.SubtotalUzs)</strong></span>
                <span>Скидка<strong>− @Money(sale.AppliedDiscountUzs)</strong></span>
                <span>Доставка<strong>@Money(sale.DeliveryChargeUzs ?? 0)</strong></span>
                <span class="total">К оплате<strong>@Money(sale.TotalUzs) UZS</strong></span>
                @if (IsDraft)
                {
                    <label class="dona-field quick-method">Оплата при продаже<OrbitSelect TValue="PaymentMethod?" @bind-Value="quickMethod" Options="@QuickPaymentOptions" Label="Способ оплаты" /></label>
                }
                @if (!IsNew)
                {
                    <span>Оплачено<strong>@Money(sale.PaidUzs)</strong></span>
                    <span>Долг<strong class="debt">@Money(sale.BalanceDueUzs)</strong></span>
                    @if (sale.RefundedUzs > 0 || sale.RefundDueUzs > 0)
                    {
                        <span>Оформлено возвратов<strong>@Money(sale.RefundedUzs)</strong></span>
                        <span>Вернуть клиенту<strong class="refund">@Money(sale.RefundDueUzs)</strong></span>
                    }
                }
            </section>
            <fieldset disabled="@IsReadOnly">
                <section class="dona-section">
                    <h2>Клиент и доставка</h2>
                    <label class="dona-field">Клиент<OrbitSelect TValue="Guid?" @bind-Value="sale.CustomerId" @bind-Value:after="CustomerChanged" Options="@CustomerOptions" Label="Клиент" Searchable="true" /></label>
                    <div class="dona-field-row">
                        <label class="dona-field">Доставка<OrbitSelect TValue="DeliveryMethod?" @bind-Value="sale.DeliveryMethod" Options="@DeliveryOptions" Label="Способ доставки" /></label>
                        <label class="dona-field">Способ скидки<OrbitSelect TValue="SaleDiscountMode" @bind-Value="sale.DiscountMode" Options="@DiscountOptions" Label="Способ скидки" /></label>
                        @if (sale.DiscountMode == SaleDiscountMode.Percent)
                        {
                            <label class="dona-field">Скидка, %<InputNumber @bind-Value="sale.DiscountPercent" min="0" max="100" /></label>
                        }
                        else
                        {
                            <label class="dona-field">Скидка, UZS<InputNumber @bind-Value="sale.DiscountUzs" min="0" max="@sale.SubtotalUzs" /></label>
                        }
                        <label class="dona-field">Плата клиента за доставку, UZS<InputNumber @bind-Value="sale.DeliveryChargeUzs" min="0" /></label>
                    </div>
                    <label class="dona-field">Заметка<InputTextArea @bind-Value="sale.Notes" /></label>
                    <label class="dona-field">
                        Номер продажи
                        <InputText @bind-Value="sale.Number" />
                        <ValidationMessage For="() => sale.Number" />
                    </label>
                </section>
            </fieldset>
            @if (!IsNew && sale.Status is not null and not SaleStatus.Draft && sale.BalanceDueUzs > 0)
            {
                <section class="dona-section">
                    <div class="dona-section-title">
                        <div>
                            <h2>Принять оплату</h2>
                            <p>Осталось @Money(sale.BalanceDueUzs) UZS</p>
                        </div>
                    </div>
                    <div class="dona-field-row">
                        <label class="dona-field">Способ<OrbitSelect TValue="PaymentMethod?" @bind-Value="payment.Method" Options="@PaymentMethodOptions" Label="Способ оплаты" /></label>
                        <label class="dona-field">Сумма, UZS<InputNumber @bind-Value="payment.AmountUzs" min="1" /></label>
                    </div>
                    <button type="button" class="dona-btn dona-btn--ghost" @onclick="AddPaymentAsync">Записать оплату</button>
                </section>
            }
            @if (sale.Payments.Count > 0)
            {
                <section class="dona-section">
                    <h2>Платежи</h2>
                    <ul class="payment-list">
                        @foreach (var item in sale.Payments.OrderByDescending(value => value.CreatedAt))
                        {
                            <li>
                                <span>@(item.Type is { } type ? type.Display() : "Операция") · @item.Method?.Display()<small>@item.CreatedAt.ToLocalTime().ToString("dd.MM · HH:mm")</small></span>
                                <strong class="@(item.Type == PaymentOperationType.Refund ? "refund" : null)">@(item.Type == PaymentOperationType.Refund ? "− " : null)@Money(item.AmountUzs ?? 0) UZS</strong>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if ((sale.Status is SaleStatus.Shipped or SaleStatus.Completed) && sale.Items.Any(item => item.QuantityToReturn > 0))
            {
                <section class="dona-section return-card">
                    <div class="dona-section-title">
                        <div>
                            <h2>Оформить возврат</h2>
                            <p>Только проданные позиции</p>
                        </div>
                    </div>
                    <label class="dona-field">Причина<InputText @bind-Value="returnDocument.Reason" placeholder="Например, не подошёл размер" /></label>
                    @foreach (var item in sale.Items.Where(value => value.QuantityToReturn > 0))
                    {
                        var line = ReturnLine(item);
                        <article class="return-line">
                            <div>
                                <strong>@item.ProductName</strong>
                                <small>@VariantLabel(item) · доступно @item.QuantityToReturn шт.</small>
                            </div>
                            <div class="dona-field-row">
                                <label class="dona-field">Количество<InputNumber @bind-Value="line.Quantity" min="1" max="@item.QuantityToReturn" /></label>
                                <label class="dona-field">Результат<OrbitSelect TValue="ReturnDisposition?" @bind-Value="line.Disposition" Options="@ReturnDispositionOptions" Label="Результат возврата" /></label>
                            </div>
                        </article>
                    }
                    <label class="dona-field">Вернуть за доставку, UZS<InputNumber @bind-Value="returnDocument.DeliveryRefundUzs" min="0" max="@SaleReturnCalculator.DeliveryAvailable(sale)" /></label>
                    <p>За товары с учётом скидки: @Money(SaleReturnCalculator.GoodsRefund(sale, returnDocument)) UZS. Всего: @Money(SaleReturnCalculator.GoodsRefund(sale, returnDocument) + returnDocument.DeliveryRefundUzs) UZS.</p>
                    <button type="button" class="dona-btn dona-btn--ghost" @onclick="CreateReturnAsync">Оформить возврат</button>
                </section>
            }
            @if (sale.Returns.Count > 0)
            {
                <section class="dona-section">
                    <h2>Возвраты</h2>
                    <ul class="return-list">
                        @foreach (var item in sale.Returns.OrderByDescending(value => value.CreatedAt))
                        {
                            <li>
                                <span>
                                    <strong>@item.Reason</strong>
                                    <small>@item.AcceptedQuantity шт. принято · @item.CreatedAt.ToLocalTime().ToString("dd.MM · HH:mm")</small>
                                </span>
                                <b>@Money(item.RefundAmountUzs ?? 0) UZS</b>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (sale.RefundDueUzs > 0)
            {
                <section class="dona-section">
                    <div class="dona-section-title">
                        <div>
                            <h2>Вернуть деньги</h2>
                            <p>По документам осталось @Money(sale.RefundDueUzs) UZS</p>
                        </div>
                    </div>
                    <div class="dona-field-row">
                        <label class="dona-field">Способ<OrbitSelect TValue="PaymentMethod?" @bind-Value="refundPayment.Method" Options="@PaymentMethodOptions" Label="Способ возврата" /></label>
                        <label class="dona-field">Сумма, UZS<InputNumber @bind-Value="refundPayment.AmountUzs" min="1" /></label>
                    </div>
                    <button type="button" class="dona-btn dona-btn--danger" @onclick="AddRefundAsync">Записать возврат денег</button>
                </section>
            }
            <ValidationSummary />
            @if (message is not null)
            {
                <p class="dona-message @(success ? "dona-message--success" : "dona-message--error")" role="status">@message</p>
            }
            <div class="dona-actions">
                @if (confirm is not null)
                {
                    <div class="dona-confirm" role="alertdialog">
                        <span>@(confirm == ConfirmKind.Delete ? "Удалить продажу? Она и её оплаты будут исключены из списков и отчётов. Резерв будет снят, списанный товар возвращён на склад за вычетом уже принятых возвратов." : confirm == ConfirmKind.Cancel ? "Отменить заказ? Резерв будет снят, полученная оплата останется к возврату." : confirm == ConfirmKind.Ship ? "Отправить заказ? Товар спишется со склада по FIFO." : "Подтвердить завершение заказа? Товар уже списан при отправке.")</span>
                        @if (confirm == ConfirmKind.Cancel && sale.DeliveryChargeUzs is > 0)
                        {
                            <label class="dona-field">Вернуть за доставку, UZS<InputNumber @bind-Value="cancelDeliveryRefund" min="0" max="@sale.DeliveryChargeUzs" /></label>
                            <small>Если сумма не указана, возвращается вся плата за доставку.</small>
                        }
                        <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="() => confirm = null">Нет</button>
                        <button type="button"
                                class="dona-btn @(confirm is ConfirmKind.Cancel or ConfirmKind.Delete ? "dona-btn--danger" : "dona-btn--primary")"
                                disabled="@saving"
                                @onclick="ConfirmAsync">@(confirm == ConfirmKind.Delete ? "Да, удалить" : confirm == ConfirmKind.Cancel ? "Да, отменить" : confirm == ConfirmKind.Ship ? "Да, отправить" : "Да, завершить")</button>
                    </div>
                }
                else if (IsDraft)
                {
                    <button type="button" class="dona-btn dona-btn--primary" disabled="@saving" @onclick="QuickSaleAsync">Продать · @Money(sale.TotalUzs) UZS</button>
                    <button type="submit" class="dona-btn dona-btn--secondary" disabled="@saving">Черновик</button>
                    <button type="button" class="dona-btn dona-btn--secondary" disabled="@saving" @onclick="ReserveAsync">Зарезервировать</button>
                }
                else if (sale.Status is SaleStatus.Reserved)
                {
                    <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="() => confirm = ConfirmKind.Cancel">Отменить заказ</button>
                    <button type="button" class="dona-btn dona-btn--primary" disabled="@saving" @onclick="() => confirm = ConfirmKind.Ship">Отправить заказ</button>
                }
                else if (sale.Status == SaleStatus.Shipped)
                {
                    <button type="button" class="dona-btn dona-btn--primary" disabled="@saving" @onclick="() => confirm = ConfirmKind.Complete">Завершить продажу</button>
                }
                @if (!IsNew && confirm is null)
                {
                    <button type="button" class="dona-btn dona-btn--danger" disabled="@saving" @onclick="() => confirm = ConfirmKind.Delete">@(IsDraft ? "Удалить черновик" : "Удалить продажу")</button>
                }
            </div>
        </EditForm>
    }
</div>
@code {
    [Parameter]
    public Guid? Id { get; set; }

    private Sale sale = new();
    private IReadOnlyList<Product> products = [];
    private IReadOnlyList<Customer> customers = [];
    private SalePayment payment = new() { Type = PaymentOperationType.Payment, Status = PaymentStatus.Completed, Method = PaymentMethod.Cash };
    private SalePayment refundPayment = new() { Type = PaymentOperationType.Refund, Status = PaymentStatus.Completed, Method = PaymentMethod.Cash };
    private SaleReturn returnDocument = new();
    private UnsavedChangesGuard? unsavedGuard;
    private ListItemRemovalConfirmation? removalConfirmation;
    private bool loading = true;
    private bool saving;
    private string? error;
    private string? message;
    private bool success;

    private static readonly SaleStatus[] Flow = [SaleStatus.Draft, SaleStatus.Reserved, SaleStatus.Shipped, SaleStatus.Completed];

    private enum ConfirmKind { Cancel, Ship, Complete, Delete }

    private ConfirmKind? confirm;
    private PaymentMethod? quickMethod = PaymentMethod.Cash;
    private decimal? cancelDeliveryRefund;
    private static readonly IReadOnlyList<OrbitSelectOption<SaleDiscountMode>> DiscountOptions =
        [new(SaleDiscountMode.Amount, "Сумма в UZS"), new(SaleDiscountMode.Percent, "Процент")];

    private bool IsNew => Id is null;

    private bool IsDraft => IsNew || sale.Status is null or SaleStatus.Draft;

    private static readonly IReadOnlyList<OrbitSelectOption<PaymentMethod?>> QuickPaymentOptions =
        Enum.GetValues<PaymentMethod>().Select(value => new OrbitSelectOption<PaymentMethod?>(value, value.Display())).ToList();

    private bool IsReadOnly =>
        sale.Status is SaleStatus.Completed or SaleStatus.Cancelled or SaleStatus.Returned or SaleStatus.Shipped;

    private IReadOnlyList<OrbitSelectOption<Guid?>> CustomerOptions =>
        [new(null, "Без клиента"), .. customers.Select(value => new OrbitSelectOption<Guid?>(value.Id, value.Name))];

    private static readonly IReadOnlyList<OrbitSelectOption<DeliveryMethod?>> DeliveryOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<DeliveryMethod>(), "Не выбрана", value => value.Display());

    private static readonly IReadOnlyList<OrbitSelectOption<PaymentMethod?>> PaymentMethodOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<PaymentMethod>(), "Не указан", value => value.Display());

    private static readonly IReadOnlyList<OrbitSelectOption<ReturnDisposition?>> ReturnDispositionOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<ReturnDisposition>(), "Не указан", value => value.Display());

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        try
        {
            customers = await SalesRepository.GetCustomersAsync();
            products = (await Catalog.GetProductsAsync()).Where(value => value.Status != ProductStatus.Archived).ToList();
            if (Id is null)
            {
                var existing = await SalesRepository.GetAllSalesAsync();
                var settings = await Settings.GetAsync();
                sale = new Sale
                {
                    Number = SaleNumberGenerator.Generate(existing, settings.SaleNumberPrefix, DateTimeOffset.Now),
                    Status = SaleStatus.Draft
                };
                sale.Items.Add(new SaleItem { Quantity = 1 });
            }
            else
            {
                sale = await SalesRepository.GetSaleAsync(Id.Value) ?? throw new InvalidOperationException("Продажа не найдена.");
                if (sale.DeletedAt is not null) throw new InvalidOperationException("Продажа удалена.");
            }

            ResetPayment();
            ResetReturn();
            ResetRefund();
        }
        catch (Exception ex)
        {
            error = UserErrors.Describe(ex, "Не удалось загрузить продажу. Попробуйте ещё раз.");
        }
        finally
        {
            loading = false;
        }
    }

    private void AddItem()
    {
        sale.Items.Add(new SaleItem { Quantity = 1 });
        unsavedGuard?.MarkDirty();
    }

    private string? previewCostText;
    private async Task PreviewCostAsync()
    {
        try
        {
            var costs = (await Inventory.PreviewAsync(sale)).Values;
            var value = costs.Sum(x => x.KnownValue);
            var unknown = costs.Sum(x => x.UnvaluedQuantity);
            previewCostText = $"Расчёт {DateTime.Now:HH:mm:ss}: {value:N2}" + (unknown > 0 ? $"; без оценки {unknown} ед." : string.Empty);
        }
        catch (Exception ex) { previewCostText = UserErrors.Describe(ex, "Не удалось рассчитать себестоимость."); }
    }

    private async Task RemoveItem(SaleItem item)
    {
        var filled = item.ProductId is not null || item.ProductVariantId is not null || !string.IsNullOrWhiteSpace(item.ProductName)
            || !string.IsNullOrWhiteSpace(item.Color) || !string.IsNullOrWhiteSpace(item.Size)
            || item.Quantity is not (null or 1) || item.UnitPriceUzs is not null;
        if (removalConfirmation is null || !await removalConfirmation.ConfirmAsync(item, filled)) return;
        sale.Items.Remove(item);
        unsavedGuard?.MarkDirty();
    }

    private IEnumerable<ProductVariant> Variants(SaleItem item) =>
        item.ProductId is null ? [] : products.FirstOrDefault(value => value.Id == item.ProductId)?.Variants ?? [];

    private void CustomerChanged()
    {
        sale.CustomerName = sale.CustomerId is null
            ? null
            : customers.FirstOrDefault(value => value.Id == sale.CustomerId)?.Name;
    }

    private void ProductChanged(SaleItem item, Product? product)
    {
        item.ProductId = product?.Id;
        item.ProductName = product?.Name ?? string.Empty;
        item.UnitPriceUzs = product?.SellingPriceUzs;
        item.UnitCostUzs = null;
        item.ProductVariantId = null;
        item.Color = string.Empty;
        item.Size = string.Empty;
        unsavedGuard?.MarkDirty();
    }

    private IReadOnlyList<OrbitSelectOption<Guid?>> VariantOptions(SaleItem item) =>
    [
        new(null, "Выберите вариант"),
        .. Variants(item).Select(value => new OrbitSelectOption<Guid?>(value.Id, $"{VariantName(value)} · доступно {value.AvailableQuantity}"))
    ];

    private void VariantChanged(SaleItem item)
    {
        var variant = Variants(item).FirstOrDefault(value => value.Id == item.ProductVariantId);
        item.Color = variant?.Color ?? string.Empty;
        item.Size = variant?.Size ?? string.Empty;
    }

    private async Task SaveDraftAsync()
    {
        await RunAsync(async () =>
        {
            sale.Status ??= SaleStatus.Draft;
            await EnsureUniqueAsync();
            await SalesRepository.UpsertSaleAsync(sale);
            if (IsNew)
            {
                unsavedGuard?.MarkClean();
                Navigation.NavigateTo($"/sales/{sale.Id}");
            }
        }, "Черновик сохранён.");
    }

    private async Task ReserveAsync()
    {
        await RunAsync(async () =>
        {
            await EnsureUniqueAsync();
            await EnsurePriceAllowedAsync();
            await Inventory.ReserveAsync(sale);
            if (IsNew)
            {
                unsavedGuard?.MarkClean();
                Navigation.NavigateTo($"/sales/{sale.Id}");
            }
        }, "Товар зарезервирован.");
    }

    private async Task QuickSaleAsync()
    {
        await RunAsync(async () =>
        {
            if (quickMethod is null)
            {
                throw new InvalidOperationException("Выберите способ оплаты.");
            }

            await EnsureUniqueAsync();
            await EnsurePriceAllowedAsync();
            await Inventory.ReserveAsync(sale);
            // From here the reserved sale is already saved; each step below is atomic and leaves it consistent on failure.
            var wasNew = IsNew;
            try
            {
                if (sale.BalanceDueUzs > 0)
                {
                    await Payments.AddAsync(sale, new SalePayment
                    {
                        Type = PaymentOperationType.Payment,
                        Status = PaymentStatus.Completed,
                        Method = quickMethod,
                        AmountUzs = sale.BalanceDueUzs
                    });
                }

                await Inventory.MarkShippedAsync(sale);
                await Inventory.CompleteAsync(sale);
                ResetReturn();
                ResetRefund();
            }
            catch (Exception ex)
            {
                var done = sale.Payments.Count > 0 ? "Заказ зарезервирован и оплачен" : "Заказ зарезервирован";
                if (wasNew)
                {
                    unsavedGuard?.MarkClean();
                    Navigation.NavigateTo($"/sales/{sale.Id}");
                }

                throw new InvalidOperationException($"{done}, но продажа не завершена: {UserErrors.Describe(ex, "не удалось завершить продажу")} Завершите её вручную.");
            }

            if (wasNew)
            {
                unsavedGuard?.MarkClean();
                Navigation.NavigateTo($"/sales/{sale.Id}");
            }
        }, "Продажа завершена: оплата принята, остаток списан.");
    }

    private Task ConfirmAsync() => confirm == ConfirmKind.Delete ? DeleteAsync() : confirm == ConfirmKind.Cancel ? CancelAsync() : confirm == ConfirmKind.Ship ? ShipAsync() : CompleteAsync();

    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Inventory.DeleteAsync(sale.Id);
        unsavedGuard?.MarkClean();
        Navigation.NavigateTo("/sales");
    }, "Продажа удалена.");

    private Task ShipAsync() => RunAsync(async () =>
    {
        await Inventory.MarkShippedAsync(sale);
        ResetReturn();
        ResetRefund();
    }, "Заказ отправлен, товар списан со склада.");

    private Task CancelAsync() => RunAsync(async () =>
    {
        await Inventory.CancelAsync(sale, cancelDeliveryRefund);
        ResetRefund();
    }, "Заказ отменён, резерв снят. Полученная оплата учтена в сумме к возврату.");

    private Task CompleteAsync() => RunAsync(async () =>
    {
        await Inventory.CompleteAsync(sale);
        ResetReturn();
        ResetRefund();
    }, "Исполнение заказа завершено.");

    private async Task AddPaymentAsync()
    {
        await RunAsync(async () =>
        {
            await Payments.AddAsync(sale, payment);
            ResetPayment();
        }, "Оплата записана.");
    }

    private async Task CreateReturnAsync()
    {
        await RunAsync(async () =>
        {
            await ReturnService.CreateAsync(sale, returnDocument);
            ResetReturn();
            ResetRefund();
        }, "Возврат оформлен, остатки обновлены.");
    }

    private async Task AddRefundAsync()
    {
        await RunAsync(async () =>
        {
            await Payments.AddAsync(sale, refundPayment);
            ResetRefund();
        }, "Возврат денег записан.");
    }

    private void ResetPayment() =>
        payment = new SalePayment
        {
            Type = PaymentOperationType.Payment,
            Status = PaymentStatus.Completed,
            Method = sale.PaymentMethod ?? PaymentMethod.Cash,
            AmountUzs = sale.BalanceDueUzs > 0 ? sale.BalanceDueUzs : null
        };

    private void ResetRefund() =>
        refundPayment = new SalePayment
        {
            Type = PaymentOperationType.Refund,
            Status = PaymentStatus.Completed,
            Method = sale.PaymentMethod ?? PaymentMethod.Cash,
            AmountUzs = sale.RefundDueUzs > 0 ? Math.Min(sale.RefundDueUzs, sale.PaidUzs) : null
        };

    private void ResetReturn() =>
        returnDocument = new SaleReturn
        {
            Items = sale.Items
                .Where(item => item.QuantityToReturn > 0)
                .Select(item => new SaleReturnItem { SaleItemId = item.Id, Disposition = ReturnDisposition.Restock })
                .ToList()
        };

    private SaleReturnItem ReturnLine(SaleItem item) => returnDocument.Items.First(value => value.SaleItemId == item.Id);

    private async Task EnsureUniqueAsync()
    {
        if ((await SalesRepository.GetAllSalesAsync()).Any(value =>
                value.Id != sale.Id && value.Number.Equals(sale.Number, StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException("Продажа с таким номером уже существует.");
        }
    }

    private async Task EnsurePriceAllowedAsync()
    {
        if (!(await Settings.GetAsync()).PreventSalesBelowCost)
        {
            return;
        }

        var costs = await Inventory.PreviewAsync(sale);
        if (costs.Values.Any(x => !x.IsComplete)) throw new InvalidOperationException("Себестоимость неизвестна. Проверка продажи ниже себестоимости невозможна.");
        var discountFactor = sale.SubtotalUzs <= 0 ? 0 : Math.Max(0, sale.SubtotalUzs - sale.AppliedDiscountUzs) / sale.SubtotalUzs;
        var below = sale.Items.FirstOrDefault(item => (item.UnitPriceUzs ?? 0) * (item.Quantity ?? 0) * discountFactor < costs[item.Id].TotalValue);
        if (below is not null)
        {
            throw new InvalidOperationException(
                $"Цена «{below.ProductName}» ниже себестоимости. Отключите запрет в настройках, если это осознанная распродажа.");
        }
    }

    private async Task RunAsync(Func<Task> action, string text)
    {
        if (saving)
        {
            return;
        }

        saving = true;
        message = null;
        confirm = null;
        try
        {
            await action();
            unsavedGuard?.MarkClean();
            message = text;
            success = true;
        }
        catch (Exception ex)
        {
            message = UserErrors.Describe(ex, "Не удалось выполнить действие с продажей. Попробуйте ещё раз.");
            success = false;
            try
            {
                products = (await Catalog.GetProductsAsync()).Where(value => value.Status != ProductStatus.Archived).ToList();
            }
            catch
            {
                // Best-effort refresh: the original operation error is already shown and must not be replaced.
            }
        }
        finally
        {
            saving = false;
        }
    }

    private string FlowClass(SaleStatus status) =>
        sale.Status == status ? "active"
            : Array.IndexOf(Flow, status) < Array.IndexOf(Flow, sale.Status ?? SaleStatus.Draft) ? "done" : string.Empty;

    private static string VariantName(ProductVariant value) =>
        string.Join(" · ", new[] { value.Color, value.Size }.Where(text => !string.IsNullOrWhiteSpace(text)));

    private static string VariantLabel(SaleItem value) =>
        string.Join(" · ", new[] { value.Color, value.Size }.Where(text => !string.IsNullOrWhiteSpace(text)));

    private static string Money(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));
}
