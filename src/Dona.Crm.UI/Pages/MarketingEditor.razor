@page "/collections/new"
@page "/collections/{Id:guid}"
@page "/outfits/new"
@page "/outfits/{Id:guid}"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject IMarketingRepository Marketing
@inject ICatalogRepository Catalog
@inject NavigationManager Navigation

<PageTitle>@Title — DONA CRM</PageTitle>
<div class="marketing-editor">
    <header>
        <a class="orbit-icon-button orbit-back-button" href="@BackUrl" aria-label="Назад"><OrbitIcon Name="back" /></a>
        <div>
            <p>@(IsCollection ? "Коллекции" : "Образы")</p>
            <h1>@Title</h1>
        </div>
    </header>
    @if (isLoading)
    {
        <div class="editor-state">Загружаем…</div>
    }
    else if (error is not null)
    {
        <div class="editor-state" role="alert">@error</div>
    }
    else
    {
        <EditForm Model="FormModel" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <UnsavedChangesGuard @ref="unsavedGuard" />
            <section>
                <h2>Основное</h2>
                @if (IsCollection)
                {
                    <label>Название<InputText @bind-Value="collection.Name" /><ValidationMessage For="() => collection.Name" /></label>
                    <label>Описание<InputTextArea @bind-Value="collection.Description" /></label>
                    <div class="field-row">
                        <label>Сезон<InputText @bind-Value="collection.Season" /></label>
                        <label>Стиль<InputText @bind-Value="collection.Style" /></label>
                    </div>
                    <div class="field-row">
                        <label>Бюджет, UZS<InputNumber @bind-Value="collection.BudgetLimitUzs" /></label>
                        <label>Статус<OrbitSelect TValue="MarketingStatus?" @bind-Value="collection.Status" Options="@MarketingStatusOptions" Label="Статус коллекции" /></label>
                    </div>
                }
                else
                {
                    <label>Название<InputText @bind-Value="outfit.Name" /><ValidationMessage For="() => outfit.Name" /></label>
                    <label>Описание<InputTextArea @bind-Value="outfit.Description" /></label>
                    <div class="field-row">
                        <label>Повод<InputText @bind-Value="outfit.Occasion" /></label>
                        <label>Статус<OrbitSelect TValue="MarketingStatus?" @bind-Value="outfit.Status" Options="@MarketingStatusOptions" Label="Статус образа" /></label>
                    </div>
                }
            </section>
            <EntityImageEditor @ref="imageEditor" Images="@CurrentImages" OwnerId="@CurrentId" EntityLabel="@(IsCollection ? "коллекции" : "образа")" ImagesChanged="MarkDirty" />
            <section>
                <div class="section-title">
                    <div>
                        <h2>Состав</h2>
                        <p>@(IsCollection ? "Порядок товаров в подборке" : $"Итого {Money(outfit.TotalPriceUzs)} UZS")</p>
                    </div>
                    <button type="button" @onclick="AddProduct"><OrbitIcon Name="plus" Class="orbit-inline-icon" />Добавить</button>
                </div>
                @if (ItemCount == 0)
                {
                    <p class="empty-items">Товары ещё не добавлены.</p>
                }
                else if (IsCollection)
                {
                    @foreach (var item in collection.Products)
                    {
                        <div class="product-row" @key="item.Id">
                            <label>Товар<ProductAutocomplete Products="products" Value="item.ProductId" OnSelected="product => CollectionProductChanged(item, product)" /></label>
                            <button type="button" aria-label="Убрать товар" @onclick="() => RemoveCollectionProduct(item)">×</button>
                        </div>
                    }
                }
                else
                {
                    @foreach (var item in outfit.Products)
                    {
                        <div class="outfit-row" @key="item.Id">
                            <label>Товар<ProductAutocomplete Products="products" Value="item.ProductId" OnSelected="product => OutfitProductChanged(item, product)" /></label>
                            <label>Цена, UZS<InputNumber @bind-Value="item.SellingPriceUzs" /></label>
                            <button type="button" aria-label="Убрать товар" @onclick="() => RemoveOutfitProduct(item)">×</button>
                        </div>
                    }
                }
            </section>
            <ValidationSummary />
            @if (saveError is not null)
            {
                <p class="save-error" role="alert">@saveError</p>
            }
            @if (!IsNew)
            {
                <button type="button" class="delete-toggle" @onclick="() => confirmDelete = true">Удалить @(IsCollection ? "коллекцию" : "образ")</button>
            }
            @if (confirmDelete)
            {
                <div class="delete-confirm">
                    <span>Удалить без возможности восстановления?</span>
                    <button type="button" @onclick="() => confirmDelete = false">Нет</button>
                    <button type="button" class="danger" @onclick="DeleteAsync">Удалить</button>
                </div>
            }
            <div class="actions">
                <a href="@BackUrl">Отмена</a>
                <button disabled="@saving">@(saving ? "Сохраняем…" : "Сохранить")</button>
            </div>
        </EditForm>
    }
</div>
@code {
    [Parameter]
    public Guid? Id { get; set; }

    private ProductCollection collection = new() { Status = MarketingStatus.Draft };
    private Outfit outfit = new() { Status = MarketingStatus.Draft };
    private IReadOnlyList<Product> products = [];
    private EntityImageEditor? imageEditor;
    private UnsavedChangesGuard? unsavedGuard;
    private bool isLoading = true;
    private bool saving;
    private bool confirmDelete;
    private string? error;
    private string? saveError;

    private bool IsCollection => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/collections", StringComparison.Ordinal);

    private bool IsNew => Id is null;

    private string BackUrl => IsCollection ? "/collections" : "/outfits";

    private string Title => IsNew
        ? (IsCollection ? "Новая коллекция" : "Новый образ")
        : (IsCollection ? "Редактирование коллекции" : "Редактирование образа");

    private object FormModel => IsCollection ? collection : outfit;

    private int ItemCount => IsCollection ? collection.Products.Count : outfit.Products.Count;

    private List<ProductImage> CurrentImages => IsCollection ? collection.Images : outfit.Images;

    private Guid CurrentId => IsCollection ? collection.Id : outfit.Id;

    private static readonly IReadOnlyList<OrbitSelectOption<MarketingStatus?>> MarketingStatusOptions =
        OrbitSelectOptions.Optional(Enum.GetValues<MarketingStatus>(), "Не указан", value => value.Display());

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            products = (await Catalog.GetProductsAsync()).Where(value => value.Status != ProductStatus.Archived).ToList();
            if (Id is not null)
            {
                if (IsCollection)
                {
                    collection = (await Marketing.GetCollectionsAsync()).FirstOrDefault(value => value.Id == Id) ?? throw new InvalidOperationException("Коллекция не найдена.");
                }
                else
                {
                    outfit = (await Marketing.GetOutfitsAsync()).FirstOrDefault(value => value.Id == Id) ?? throw new InvalidOperationException("Образ не найден.");
                }
            }
        }
        catch (Exception ex)
        {
            error = UserErrors.Describe(ex, "Не удалось загрузить данные. Попробуйте ещё раз.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddProduct()
    {
        if (IsCollection)
        {
            collection.Products.Add(new CollectionProduct { SortOrder = collection.Products.Count });
        }
        else
        {
            outfit.Products.Add(new OutfitProduct { SortOrder = outfit.Products.Count });
        }

        unsavedGuard?.MarkDirty();
    }

    private void CollectionProductChanged(CollectionProduct item, Product? product)
    {
        item.ProductId = product?.Id;
        item.ProductName = product?.Name ?? string.Empty;
        MarkDirty();
    }

    private void OutfitProductChanged(OutfitProduct item, Product? product)
    {
        item.ProductId = product?.Id;
        item.ProductName = product?.Name ?? string.Empty;
        if (product is not null)
        {
            item.SellingPriceUzs = product.SellingPriceUzs;
        }

        MarkDirty();
    }

    private void RemoveCollectionProduct(CollectionProduct item)
    {
        collection.Products.Remove(item);
        MarkDirty();
    }

    private void RemoveOutfitProduct(OutfitProduct item)
    {
        outfit.Products.Remove(item);
        MarkDirty();
    }

    private void MarkDirty() => unsavedGuard?.MarkDirty();

    private async Task SaveAsync()
    {
        saving = true;
        saveError = null;
        try
        {
            if (IsCollection)
            {
                for (var i = 0; i < collection.Products.Count; i++)
                {
                    collection.Products[i].SortOrder = i;
                }

                await Marketing.UpsertCollectionAsync(collection);
            }
            else
            {
                for (var i = 0; i < outfit.Products.Count; i++)
                {
                    outfit.Products[i].SortOrder = i;
                }

                await Marketing.UpsertOutfitAsync(outfit);
            }

            if (imageEditor is not null)
            {
                await imageEditor.CommitAsync();
            }

            unsavedGuard?.MarkClean();
            Navigation.NavigateTo(BackUrl);
        }
        catch (Exception ex)
        {
            saveError = UserErrors.Describe(ex, "Не удалось сохранить. Попробуйте ещё раз.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        saving = true;
        saveError = null;
        try
        {
            if (IsCollection)
            {
                await Marketing.DeleteCollectionAsync(collection.Id);
            }
            else
            {
                await Marketing.DeleteOutfitAsync(outfit.Id);
            }

            if (imageEditor is not null)
            {
                await imageEditor.DeleteAllAsync();
            }

            unsavedGuard?.MarkClean();
            Navigation.NavigateTo(BackUrl);
        }
        catch (Exception ex)
        {
            saveError = UserErrors.Describe(ex, "Не удалось удалить. Попробуйте ещё раз.");
            confirmDelete = false;
        }
        finally
        {
            saving = false;
        }
    }

    private static string Money(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("ru-RU"));
}
