@page "/collections"
@page "/outfits"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Storage
@inject IMarketingRepository Marketing
@inject NavigationManager Navigation

<PageTitle>@Title — DONA CRM</PageTitle>
<div class="dona-page dona-page--wide" aria-busy="@isLoading">
    <header class="dona-page-header">
        <div class="dona-heading">
            <a class="dona-icon-button dona-back-button" href="/marketing" aria-label="Вернуться в маркетинг"><OrbitIcon Name="back" /></a>
            <div>
                <p>Маркетинг</p>
                <h1 class="dona-title">@Title</h1>
            </div>
        </div>
        <a class="dona-icon-button dona-add-button" href="@($"/{Kind}/new")" aria-label="@AddLabel"><OrbitIcon Name="plus" /></a>
    </header>
    <p class="dona-note dona-note--intro">@(IsCollections ? "Группируйте товары по сезону, стилю или запуску." : "Собирайте готовые сочетания и сразу считайте их стоимость.")</p>
    @if(isLoading)
    {
        <div class="dona-state">Загружаем…</div>
    }
    else if(error is not null)
    {
        <div class="dona-state dona-state--error" role="alert">@error</div>
    }
    else if((IsCollections && collections.Count==0) || (!IsCollections && outfits.Count==0))
    {
        <div class="dona-state">
            <strong>Пока пусто</strong>
            <p>Нажмите кнопку добавления, чтобы создать первую запись.</p>
        </div>
    }
    else if(IsCollections)
    {
        <ul class="marketing-list">
            @foreach(var item in collections)
            {
                <li>
                    <a class="dona-list-row" href="/collections/@item.Id">
                        <span class="dona-icon-tile">
                            @if(item.PrimaryImage is not null)
                            {
                                <ProductImageView Image="@item.PrimaryImage" Alt="" />
                            }
                            else
                            {
                                <OrbitIcon Name="catalog" />
                            }
                        </span>
                        <span>
                            <strong>@item.Name</strong>
                            <small>@Meta(item)</small>
                        </span>
                        <span class="dona-list-row__value">@item.Products.Count<small>тов.</small></span>
                    </a>
                </li>
            }
        </ul>
    }
    else
    {
        <ul class="marketing-list">
            @foreach(var item in outfits)
            {
                <li>
                    <a class="dona-list-row" href="/outfits/@item.Id">
                        <span class="dona-icon-tile dona-icon-tile--rose">
                            @if(item.PrimaryImage is not null)
                            {
                                <ProductImageView Image="@item.PrimaryImage" Alt="" />
                            }
                            else
                            {
                                <OrbitIcon Name="image" />
                            }
                        </span>
                        <span>
                            <strong>@item.Name</strong>
                            <small>@(string.IsNullOrWhiteSpace(item.Occasion)?item.Status.Display():item.Occasion)</small>
                        </span>
                        <span class="dona-list-row__value">@Money(item.TotalPriceUzs)<small>UZS</small></span>
                    </a>
                </li>
            }
        </ul>
    }
</div>
@code{
    private static readonly CultureInfo Ru=CultureInfo.GetCultureInfo("ru-RU");
    private IReadOnlyList<ProductCollection> collections=[];
    private IReadOnlyList<Outfit> outfits=[];
    private bool isLoading=true;
    private string? error;
    private bool IsCollections=>new Uri(Navigation.Uri).AbsolutePath.StartsWith("/collections",StringComparison.Ordinal);
    private string Kind=>IsCollections?"collections":"outfits";
    private string Title=>IsCollections?"Коллекции":"Образы";
    private string AddLabel=>IsCollections?"Создать коллекцию":"Создать образ";
    protected override async Task OnParametersSetAsync(){
        isLoading=true;
        error=null;
        try{
            if(IsCollections)collections=await Marketing.GetCollectionsAsync();
            else outfits=await Marketing.GetOutfitsAsync();
        }catch(Exception ex){
            error=UserErrors.Describe(ex, "Не удалось загрузить список. Попробуйте ещё раз.");
        }finally{
            isLoading=false;
        }
    }
    private static string Meta(ProductCollection item)=>string.Join(" · ",new[]{item.Season,item.Style,item.Status.Display()}.Where(value=>!string.IsNullOrWhiteSpace(value)));
    private static string Money(decimal value)=>value.ToString("N0",Ru);
}
