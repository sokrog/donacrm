@page "/connections"
@using Dona.Crm.Web.Services
@inject IGoogleConnectionService Google
@inject AppPlatformProfile Platform

<PageTitle>Подключения — DONA CRM</PageTitle>
<div class="connections-page">
    <header><div class="orbit-secondary-heading"><a class="orbit-icon-button orbit-back-button" href="/more" aria-label="Вернуться в меню"><OrbitIcon Name="back" /></a><div><small>Ещё</small><h1>Подключения</h1><p>Данные работают локально и сохраняются в личном аккаунте только после входа.</p></div></div></header>

    @if (loading)
    {
        <div class="connection-state">Проверяем подключения…</div>
    }
    else
    {
        <section class="local-card">
            <span class="provider-icon local"><OrbitIcon Name="catalog" /></span>
            <div><strong>@Platform.StorageTitle</strong><small>@Platform.StorageDescription</small></div>
            <b>Подключено</b>
        </section>

        <section class="google-card">
            <div class="provider-heading">
                <span class="provider-icon google">G</span>
                <div><h2>Google</h2><p>Резервные копии и фотографии</p></div>
                <span class="status @((state.IsConnected && !requiresSignIn) ? "connected" : null)">@(requiresSignIn ? "Нужно войти" : state.IsConnected ? "Подключено" : "Не подключено")</span>
            </div>

            @if (state.IsConnected && !string.IsNullOrWhiteSpace(state.AccountName ?? state.AccountEmail))
            {
                <div class="account-row"><InitialBadge Text="@(state.AccountName ?? state.AccountEmail)" Compact="true" /><div><strong>@(state.AccountName ?? state.AccountEmail)</strong>@if (!string.IsNullOrWhiteSpace(state.AccountName) && !string.IsNullOrWhiteSpace(state.AccountEmail)){<small>@state.AccountEmail</small>}</div></div>
            }

            <p class="cloud-description">Копии базы и новые фотографии сохраняются в закрытом хранилище текущего Google-аккаунта.</p>

            @if (message is not null)
            {
                <p class="connection-message @(success ? "success" : null)" role="status">@message</p>
            }

            <div class="connection-actions">
                @if (!state.IsConnected || requiresSignIn)
                {
                    <button type="button" class="primary" disabled="@busy" @onclick="ConnectAsync">@(busy ? "Выполняем…" : requiresSignIn ? "Войти снова" : "Войти через Google")</button>
                }
                @if (state.IsConnected)
                {
                    <a class="sync-action" href="/sync">Синхронизация данных</a>
                    <button type="button" class="disconnect" disabled="@busy" @onclick="DisconnectAsync">Отключить аккаунт</button>
                }
            </div>
            @if (state.LastCheckedAt is not null) { <p class="last-check">Последняя проверка: @state.LastCheckedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p> }
        </section>
    }
</div>

@code {
    private GoogleConnectionState state = new(new GoogleConnectionSettings(string.Empty, null), false);
    private bool loading = true;
    private bool busy;
    private bool requiresSignIn;
    private bool success;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        state = await Google.GetStateAsync();
        if (state.IsConnected)
        {
            try
            {
                state = await Google.CheckAsync();
            }
            catch (Exception)
            {
                requiresSignIn = true;
                message = "Сессия Google завершена. Войдите снова, чтобы продолжить сохранять копии и фотографии в аккаунте.";
                success = false;
            }
        }
        loading = false;
    }

    private async Task ConnectAsync() => await RunAsync(async () =>
    {
        state = await Google.ConnectAsync();
        requiresSignIn = false;
        return $"Подключён аккаунт {state.AccountEmail ?? state.AccountName}.";
    });

    private async Task DisconnectAsync() => await RunAsync(async () =>
    {
        await Google.DisconnectAsync();
        state = await Google.GetStateAsync();
        requiresSignIn = false;
        return "Google-аккаунт отключён. Локальные данные не изменены.";
    });

    private async Task RunAsync(Func<Task<string>> action)
    {
        if (busy) return;
        busy = true; message = null;
        try { message = await action(); success = true; }
        catch (Exception exception) { message = exception.Message; success = false; }
        finally { busy = false; }
    }
}
