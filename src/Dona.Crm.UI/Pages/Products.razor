@page "/products"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICatalogRepository Catalog

<PageTitle>Каталог — DONA CRM</PageTitle>

<div class="catalog-page" aria-busy="@isLoading">
    <header class="catalog-header">
        <div><p>DONA CRM</p><h1>Каталог</h1></div>
        <a class="orbit-icon-button orbit-add-button" href="/products/new" aria-label="Добавить товар"><OrbitIcon Name="plus" /></a>
    </header>

    <div class="search-box">
        <label for="product-search">Поиск по названию или SKU</label>
        <input id="product-search" type="search" inputmode="search" autocomplete="off" placeholder="Например, худи или HD-0001" @bind="query" @bind:event="oninput" />
    </div>

    <nav class="catalog-tools" aria-label="Инструменты каталога"><a href="/collections"><OrbitIcon Name="catalog" /><span><strong>Коллекции</strong><small>Подборки товаров</small></span></a><a href="/outfits"><OrbitIcon Name="image" /><span><strong>Образы</strong><small>Готовые сочетания</small></span></a></nav>

    @if (errorMessage is not null)
    {
        <div class="catalog-state" role="alert"><strong>Каталог не загрузился</strong><p>@errorMessage</p><button @onclick="LoadAsync">Повторить</button></div>
    }
    else if (isLoading)
    {
        <div class="catalog-state" role="status">Загружаем товары…</div>
    }
    else
    {
        <div class="catalog-summary"><span>@FilteredProducts.Count @ProductWord(FilteredProducts.Count)</span><span>@products.Sum(item => item.Quantity) ед. на складе</span></div>
        @if (FilteredProducts.Count == 0)
        {
            <div class="catalog-state"><strong>@(products.Count == 0 ? "Каталог пуст" : "Ничего не найдено")</strong><p>@(products.Count == 0 ? "Добавьте первый товар, чтобы начать учёт." : "Попробуйте изменить запрос.")</p></div>
        }
        else
        {
            <ul class="product-list">
                @foreach (var product in FilteredProducts)
                {
                    <li>
                        <a class="product-card" href="/products/@product.Id">
                            <span class="product-visual">
                                @if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl)) { <ProductImageView Image="@product.PrimaryImage" FallbackUrl="@product.PrimaryImageUrl" Alt="" /> }
                                else { <OrbitIcon Name="catalog" /> }
                            </span>
                            <span class="product-info"><strong>@product.Name</strong><small>@product.Sku · @product.Category</small><span class="status @StatusClass(product.Status)">@product.Status.Display()</span></span>
                            <span class="product-numbers"><strong>@Money(product.SellingPriceUzs ?? 0)</strong><small>UZS</small><span>@product.Quantity ед.</span></span>
                        </a>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private List<Product> products = [];
    private string query = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;
    private IReadOnlyList<Product> FilteredProducts => ProductSearch.Filter(products, query, Math.Max(8, products.Count));

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        isLoading = true; errorMessage = null;
        try { products = (await Catalog.GetProductsAsync()).Where(item => item.Status != ProductStatus.Archived).ToList(); }
        catch (Exception exception) { errorMessage = exception.Message; }
        finally { isLoading = false; }
    }

    private static string Money(decimal value) => value.ToString("N0", RussianCulture);
    private static string ProductWord(int count) => count == 1 ? "товар" : count is >= 2 and <= 4 ? "товара" : "товаров";
    private static string StatusClass(ProductStatus? status) => status switch { ProductStatus.InStock => "ok", ProductStatus.LowStock => "warning", ProductStatus.OutOfStock => "danger", _ => string.Empty };
}
