@page "/products"
@using System.Globalization
@using Dona.Crm.Web.Domain
@using Dona.Crm.Web.Services
@using Dona.Crm.Web.Storage
@inject ICatalogRepository Catalog
@inject ICommerceRepository Commerce
@inject IBusinessSettingsRepository SettingsRepository
@inject ProductStatusService Statuses
@inject NavigationManager Navigation

<PageTitle>Каталог — DONA CRM</PageTitle>

<div class="dona-page dona-page--wide" aria-busy="@isLoading">
    <DonaPageHeader Class="dona-page-header dona-page-header--actions catalog-header">
        <div>
            <p class="dona-eyebrow">DONA CRM</p>
            <h1 class="dona-title">Каталог</h1>
        </div>
    </DonaPageHeader>
    <DonaPageActions>
        <Primary>
            <div class="catalog-primary-actions">
            <button type="button" class="dona-btn dona-btn--secondary catalog-select-toggle" aria-label="@(selectionMode ? "Завершить выбор" : "Выбрать товары")" title="@(selectionMode ? "Завершить выбор" : "Выбрать товары")" aria-pressed="@selectionMode" disabled="@(isLoading || products.Count == 0)" @onclick="ToggleSelection"><OrbitIcon Name="check" /><span>@(selectionMode ? "Готово" : "Выбрать товары")</span></button>
            <a class="dona-icon-button dona-add-button" href="/products/new" aria-label="Добавить товар"><OrbitIcon Name="plus" /></a>
            </div>
        </Primary>
        <Secondary>
            @if (selectionMode)
            {
                <button type="button" class="dona-btn dona-btn--secondary" disabled="@(selected.Count == 0)" @onclick="OpenPricing">Установить цены (@selected.Count)</button>
                <button type="button" class="dona-btn dona-btn--secondary" disabled="@(FilteredProducts.Count == 0)" @onclick="SelectVisible">Выбрать показанные</button>
                <button type="button" class="dona-btn dona-btn--secondary" disabled="@(selected.Count == 0)" @onclick="ClearSelected">Снять выбор</button>
            }

        </Secondary>
    </DonaPageActions>

    @if (Priced > 0) { <p class="dona-message dona-message--success" role="status">Обновлено цен: @Priced.</p> }
    <div class="dona-search">
        <label for="product-search">Поиск по названию или SKU</label>
        <input id="product-search" type="search" inputmode="search" autocomplete="off" placeholder="Например, худи или HD-0001" value="@Query" @oninput="OnSearchInput" />
    </div>
    <div class="dona-chips" role="group" aria-label="Быстрые фильтры каталога">
        <button type="button" class="@(filter is null ? "active" : null)" @onclick="() => Filter = null">Все</button>
        <button type="button" class="@PhotoFilterClass" @onclick="ShowWithoutPhoto">Без фото</button>
        <button type="button" class="@PriceFilterClass" @onclick="ShowWithoutPrice">Без цены</button>
        <button type="button" class="@VariantsFilterClass" @onclick="ShowWithoutVariants">Без вариантов</button>
        <button type="button" class="@LowFilterClass" @onclick="ShowLowStock">Заканчивается</button>
        <button type="button" class="reset" disabled="@(filter is null && string.IsNullOrWhiteSpace(query) && sort == "created")" @onclick="ResetFilters">Сбросить</button>
    </div>
    <label class="catalog-sort">Сортировка<OrbitSelect TValue="string" @bind-Value="Sort" Options="@SortOptions" Label="Сортировка каталога" /></label>

    <nav class="catalog-tools" aria-label="Инструменты каталога">
        <a href="/collections">
            <OrbitIcon Name="catalog" />
            <span>
                <strong>Коллекции</strong>
                <small>Подборки товаров</small>
            </span>
        </a>
        <a href="/outfits">
            <OrbitIcon Name="image" />
            <span>
                <strong>Образы</strong>
                <small>Готовые сочетания</small>
            </span>
        </a>
    </nav>

    @if (errorMessage is not null)
    {
        <div class="dona-state dona-state--error catalog-state" role="alert">
            <strong>Каталог не загрузился</strong>
            <p>@errorMessage</p>
            <button class="dona-btn dona-btn--primary" @onclick="LoadAsync">Повторить</button>
        </div>
    }
    else if (isLoading)
    {
        <div class="dona-state catalog-state" role="status">Загружаем товары…</div>
    }
    else
    {
        <div class="catalog-summary">
            <span>@FilteredProducts.Count @ProductWord(FilteredProducts.Count)</span>
            <span>@products.Sum(item => item.Quantity) ед. на складе</span>
        </div>
        @if (FilteredProducts.Count == 0)
        {
            <div class="dona-state catalog-state">
                <strong>@(products.Count == 0 ? "Каталог пуст" : "Ничего не найдено")</strong>
                <p>@(products.Count == 0 ? "Добавьте первый товар, чтобы начать учёт." : "Попробуйте изменить запрос.")</p>
            </div>
        }
        else
        {
            <ul class="product-list">
                @foreach (var product in FilteredProducts)
                {
                    <li class="dona-selection-row">
                        @if (selectionMode) { <label class="dona-selection"><input type="checkbox" checked="@selected.Contains(product.Id)" @onchange="e => SelectProduct(product.Id, e.Value is true)" aria-label="Выбрать @product.Name" /></label> }
                        <a class="dona-list-row product-card" href="/products/@product.Id">
                            <span class="dona-icon-tile dona-icon-tile--lg product-visual">
                                @if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl))
                                {
                                    <ProductImageView Image="@product.PrimaryImage" FallbackUrl="@product.PrimaryImageUrl" Alt="" />
                                }
                                else
                                {
                                    <OrbitIcon Name="catalog" />
                                }
                            </span>
                            <span class="product-info">
                                <strong>@product.Name</strong>
                                @if (Subtitle(product) is { Length: > 0 } subtitle)
                                {
                                    <small>@subtitle</small>
                                }
                                <span class="dona-badge @StatusClass(CurrentStatus(product))">@CurrentStatus(product).Display()</span>
                                @if (PurchaseAvailability.Expected(product.Id, purchases) is > 0 and var expected) { <span class="dona-badge">Ожидается @expected шт.</span> }
                                @if (Issues(product) is { Count: > 0 } issues)
                                {
                                    <small class="product-issues" title="@string.Join(", ", issues)" aria-label="@string.Join(", ", issues)">@(issues.Count == 1 ? issues[0] : $"Заполнить: {issues.Count}")</small>
                                }
                            </span>
                            <span class="product-numbers">
                                @if (product.SellingPriceUzs is > 0)
                                {
                                    <strong>@Money(product.SellingPriceUzs.Value)</strong>
                                    <small>UZS</small>
                                }
                                else
                                {
                                    <strong>—</strong>
                                    <small>нет цены</small>
                                }
                                <span>@product.Quantity ед.</span>
                                @if (product.Variants.Sum(v => v.ReservedQuantity) is > 0 and var reserved) { <small>В резерве @reserved</small> }
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    [SupplyParameterFromQuery(Name = "priced")] public int? Priced { get; set; }
    [SupplyParameterFromQuery(Name = "selected")] public string? SelectedParam { get; set; }
    private HashSet<Guid> selected = [];
    private bool selectionMode;
    private BusinessSettings settings = new();
    private List<Product> products = [];
    private IReadOnlyList<Purchase> purchases = [];
    [SupplyParameterFromQuery(Name = "q")] [Parameter] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] [Parameter] public string? FilterParam { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] [Parameter] public string? SortParam { get; set; }
    private static readonly string[] FilterKeys = ["photo", "price", "variants", "low"];
    private static readonly string[] SortKeys = ["created", "price", "stock"];
    private readonly Queue<(string Q, string? Filter, string Sort)> pendingUrls = new();
    private string query = string.Empty;
    private string? filter;
    private string sort = "created";
    private string Query { get => query; set { query = value ?? string.Empty; PushUrl(); } }
    private string? Filter { get => filter; set { filter = value; PushUrl(); } }
    private string Sort { get => sort; set { sort = value; PushUrl(); } }
    private static readonly IReadOnlyList<OrbitSelectOption<string>> SortOptions =
    [
        new("created", "Сначала новые"),
        new("price", "Цена: выше"),
        new("stock", "Остаток: меньше"),
    ];
    private bool isLoading = true;
    private string? errorMessage;
    private IReadOnlyList<Product> FilteredProducts => ApplySort(ProductSearch.Filter(products.Where(MatchesFilter), query, Math.Max(8, products.Count))).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();
    protected override void OnParametersSet()
    {
        var q = QueryParam?.Trim() ?? string.Empty;
        var f = FilterParam is not null && FilterKeys.Contains(FilterParam) ? FilterParam : null;
        var s = SortParam is not null && SortKeys.Contains(SortParam) ? SortParam : "created";
        // Skip echoes of URL updates we pushed ourselves (a stale echo must not overwrite newer input).
        if (pendingUrls.Contains((q, f, s)))
        {
            while (pendingUrls.Count > 0 && pendingUrls.Dequeue() != (q, f, s)) { }
            return;
        }
        pendingUrls.Clear();
        selected = (SelectedParam ?? "").Split(',').Where(x => Guid.TryParse(x, out _)).Select(Guid.Parse).ToHashSet();
        selectionMode = selected.Count > 0;
        query = q;
        filter = f;
        sort = s;
    }
    private void OnSearchInput(ChangeEventArgs args) => Query = args.Value?.ToString() ?? string.Empty;
    private void PushUrl()
    {
        var q = query.Trim();
        pendingUrls.Enqueue((q, filter, sort));
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = q.Length == 0 ? null : q,
            ["filter"] = filter,
            ["sort"] = sort == "created" ? null : sort,
            ["selected"] = selected.Count == 0 ? null : string.Join(",", selected.Order())
        });
        Navigation.NavigateTo(uri, replace: true);
    }
    private void ToggleSelection() { selectionMode = !selectionMode; if (!selectionMode) ClearSelected(); }
    private ProductStatus? CurrentStatus(Product product) => Statuses.Calculate(product, settings);
    private void SelectProduct(Guid id, bool value) { if (value) selected.Add(id); else selected.Remove(id); PushUrl(); }
    private void SelectVisible() { selected.UnionWith(FilteredProducts.Select(x => x.Id)); PushUrl(); }
    private void ClearSelected() { selected.Clear(); PushUrl(); }
    private void OpenPricing() => Navigation.NavigateTo($"/products/pricing?ids={Uri.EscapeDataString(string.Join(",", selected.Order()))}&q={Uri.EscapeDataString(query)}&filter={Uri.EscapeDataString(filter ?? "")}&sort={Uri.EscapeDataString(sort)}");
    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            settings = await SettingsRepository.GetAsync();
            products = (await Catalog.GetProductsAsync()).Where(item => item.Status != ProductStatus.Archived).ToList();
            purchases = await Commerce.GetPurchasesAsync();
        }
        catch (Exception exception)
        {
            errorMessage = UserErrors.Describe(exception, "Не удалось загрузить каталог. Попробуйте ещё раз.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string Money(decimal value) => value.ToString("N0", RussianCulture);
    private static string ProductWord(int count) => count == 1 ? "товар" : count is >= 2 and <= 4 ? "товара" : "товаров";
    private static string StatusClass(ProductStatus? status) => status switch
    {
        ProductStatus.InStock => "dona-badge--ok",
        ProductStatus.LowStock => "dona-badge--warning",
        ProductStatus.OutOfStock => "dona-badge--danger",
        _ => string.Empty
    };
    private bool MatchesFilter(Product product) => filter switch
    {
        "photo" => string.IsNullOrWhiteSpace(product.PrimaryImageUrl),
        "price" => product.SellingPriceUzs is null or <= 0,
        "variants" => product.Variants.Count == 0,
        "low" => CurrentStatus(product) is ProductStatus.LowStock or ProductStatus.OutOfStock,
        _ => true
    };
    private string PhotoFilterClass => filter == "photo" ? "active" : string.Empty;
    private string PriceFilterClass => filter == "price" ? "active" : string.Empty;
    private string VariantsFilterClass => filter == "variants" ? "active" : string.Empty;
    private string LowFilterClass => filter == "low" ? "active" : string.Empty;
    private void ShowWithoutPhoto() => Filter = "photo";
    private void ShowWithoutPrice() => Filter = "price";
    private void ShowWithoutVariants() => Filter = "variants";
    private void ShowLowStock() => Filter = "low";
    private void ResetFilters()
    {
        filter = null;
        query = string.Empty;
        sort = "created";
        PushUrl();
    }
    private static string Subtitle(Product product) => string.Join(" · ", new[] { product.Sku, product.Category }.Where(part => !string.IsNullOrWhiteSpace(part)).Select(part => part!.Trim()));
    private IEnumerable<Product> ApplySort(IEnumerable<Product> values) => sort switch
    {
        "price" => values.OrderByDescending(value => value.SellingPriceUzs ?? 0),
        "stock" => values.OrderBy(value => value.Quantity),
        _ => values.OrderByDescending(value => value.CreatedAt)
    };
    private static List<string> Issues(Product product) => new[]
    {
        string.IsNullOrWhiteSpace(product.PrimaryImageUrl) ? "Нет фото" : null,
        product.SellingPriceUzs is null or <= 0 ? "Нет цены" : null,
        string.IsNullOrWhiteSpace(product.Category) ? "Нет категории" : null,
        product.Variants.Count == 0 ? "Нет вариантов" : null
    }.OfType<string>().ToList();
}
