@inherits LayoutComponentBase
@inject GoogleSheetsSettingsStore StorageSettings
@inject LoadingState Loading
@inject InterfaceModeState Mode
@implements IDisposable

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/">
            <span class="brand-mark">D</span>
            <span><strong>Dona CRM</strong><small>торговля без хаоса</small></span>
        </a>
        <nav class="main-nav">
            <div class="nav-group"><div class="nav-group-title">Главное</div><NavLink href="/" Match="NavLinkMatch.All"><span>⌂</span> Обзор</NavLink>@if (!Mode.IsSimple) { <NavLink href="/analytics"><span>⌁</span> Продажи и прибыль</NavLink> }<NavLink href="/inventory-analytics"><span>▥</span> Складская аналитика</NavLink></div>
            <div class="nav-group"><div class="nav-group-title">Каталог</div><NavLink href="/products"><span>▦</span> Товары</NavLink><NavLink href="/categories"><span>◇</span> Категории</NavLink>@if (!Mode.IsSimple) { <NavLink href="/inventory"><span>↕</span> Движения</NavLink> }</div>
            @if (!Mode.IsSimple) { <div class="nav-group"><div class="nav-group-title">Закупки</div><NavLink href="/purchases"><span>↙</span> Закупки</NavLink><NavLink href="/purchase-history"><span>¥</span> Цены и курсы</NavLink><NavLink href="/suppliers"><span>♙</span> Поставщики</NavLink><NavLink href="/intermediaries"><span>⇄</span> Посредники</NavLink></div> }
            <div class="nav-group"><div class="nav-group-title">Продажи</div><NavLink href="/sales"><span>₸</span> Продажи</NavLink>@if (!Mode.IsSimple) { <NavLink href="/customers"><span>♙</span> Клиенты</NavLink> }</div>
            <div class="nav-group"><div class="nav-group-title">Маркетинг</div><NavLink href="/collections"><span>◇</span> Коллекции</NavLink><NavLink href="/outfits"><span>◎</span> Образы</NavLink><NavLink href="/content-plan"><span>▤</span> Контент-план</NavLink></div>
            <div class="nav-group"><div class="nav-group-title">Система</div><NavLink href="/settings"><span>⚙</span> Настройки</NavLink></div>
        </nav>
        <div class="nav-section-title">Поиск товаров</div>
        <nav class="store-links">
            <a href="https://www.1688.com/" target="_blank" rel="noopener noreferrer"><span>16</span>1688 <em>↗</em></a>
            <a href="https://www.taobao.com/" target="_blank" rel="noopener noreferrer"><span>淘</span>Taobao <em>↗</em></a>
            <a href="https://www.alibaba.com/" target="_blank" rel="noopener noreferrer"><span>阿</span>Alibaba <em>↗</em></a>
            <a href="https://www.pinduoduo.com/" target="_blank" rel="noopener noreferrer"><span>拼</span>Pinduoduo <em>↗</em></a>
        </nav>
        <button class="interface-mode-switch" type="button" @onclick="ToggleModeAsync"><span>@(Mode.IsSimple ? "S" : "A")</span><div><strong>@(Mode.IsSimple ? "Простой режим" : "Расширенный режим")</strong><small>Переключить интерфейс</small></div></button>
        <div class="sidebar-note">
            <span class="status-dot"></span>
            <div><strong>@(StorageSettings.UseGoogleSheets ? "Google Sheets" : "Локальный JSON")</strong><small>активное хранилище</small></div>
        </div>
    </aside>
    <main class="main-content">
        <header class="topbar">
            <div><span class="eyebrow">Dona CRM · рабочая версия</span></div>
            <div class="avatar">ДС</div>
        </header>
        <div class="page-container">@Body</div>
    </main>
</div>

@if (_showInitialLoading)
{
    <div class="loading-overlay"><div class="loading-dialog"><span class="spinner"></span><strong>@Loading.Message</strong><small>Пожалуйста, подождите</small></div></div>
}
else if (_showProgress)
{
    <div class="loading-progress" role="progressbar" aria-label="@Loading.Message"><span></span></div>
}

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка. <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">×</span>
</div>

@code {
    protected override async Task OnInitializedAsync() { Loading.Changed += LoadingChanged; Mode.Changed += ModeChanged; await Mode.EnsureLoadedAsync(); }
    protected override void OnAfterRender(bool firstRender) { if (firstRender) ScheduleInitialCompletion(); }
    private bool _showInitialLoading;
    private bool _showProgress;
    private CancellationTokenSource? _loadingDelay;
    private CancellationTokenSource? _initialCompletionDelay;
    private void LoadingChanged()
    {
        if (!Loading.IsLoading)
        {
            CancelLoadingDelay();
            _showInitialLoading = false;
            _showProgress = false;
            if (Loading.IsInitialLoad) ScheduleInitialCompletion();
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        CancelInitialCompletion();
        if (_showInitialLoading || _showProgress || _loadingDelay is not null) return;
        _loadingDelay = new CancellationTokenSource();
        _ = ShowLoadingAfterDelayAsync(Loading.IsInitialLoad, _loadingDelay.Token);
    }
    private void CancelLoadingDelay() { _loadingDelay?.Cancel(); _loadingDelay?.Dispose(); _loadingDelay = null; }
    private async Task ShowLoadingAfterDelayAsync(bool initial, CancellationToken token)
    {
        try
        {
            await Task.Delay(initial ? 300 : 120, token);
            if (!Loading.IsLoading || token.IsCancellationRequested) return;
            _showInitialLoading = initial;
            _showProgress = !initial;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }
    private void ScheduleInitialCompletion()
    {
        CancelInitialCompletion();
        _initialCompletionDelay = new CancellationTokenSource();
        _ = CompleteInitialLoadAfterQuietPeriodAsync(_initialCompletionDelay.Token);
    }
    private async Task CompleteInitialLoadAfterQuietPeriodAsync(CancellationToken token)
    {
        try { await Task.Delay(500, token); if (!Loading.IsLoading && !token.IsCancellationRequested) Loading.CompleteInitialLoad(); }
        catch (OperationCanceledException) { }
    }
    private void CancelInitialCompletion() { _initialCompletionDelay?.Cancel(); _initialCompletionDelay?.Dispose(); _initialCompletionDelay = null; }
    private void ModeChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task ToggleModeAsync() => await Mode.ToggleAsync();
    public void Dispose() { Loading.Changed -= LoadingChanged; Mode.Changed -= ModeChanged; CancelLoadingDelay(); CancelInitialCompletion(); }
}
