@if (!string.IsNullOrWhiteSpace(Source) && !_failed)
{
    <img @key="Source" class="@CssClass" src="@Source" alt="@Alt" loading="@(Lazy ? "lazy" : "eager")" decoding="async" @onload="ImageLoaded" @onerror="ImageFailed" />
    @if (!_loaded) { <span class="image-load-indicator" aria-label="Загрузка изображения"><i></i></span> }
}
else
{
    <span class="image-fallback" role="img" aria-label="Изображение недоступно" title="Изображение недоступно">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-13Zm2 11.8 3.5-4.2 2.7 3.1 1.8-2.1 4 4.5V6H6v11.3ZM9 10.5A1.5 1.5 0 1 0 9 7.5a1.5 1.5 0 0 0 0 3Z"/></svg>
    </span>
}

@code {
    [Parameter, EditorRequired] public string? Source { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Lazy { get; set; } = true;
    private string? _previousSource;
    private bool _loaded;
    private bool _failed;

    protected override void OnParametersSet()
    {
        if (string.Equals(_previousSource, Source, StringComparison.Ordinal)) return;
        _previousSource = Source; _loaded = false; _failed = false;
    }

    private void ImageLoaded() { _loaded = true; _failed = false; }
    private void ImageFailed() { _failed = true; _loaded = false; }
}
