@page "/products/new"
@page "/products/{Id:guid}"
@attribute [StreamRendering]
@inject ICatalogRepository Repository
@inject ICommerceRepository Commerce
@inject NavigationManager Navigation
@inject IBusinessSettingsRepository BusinessSettingsRepository
@inject ProductStatusService ProductStatusService
@inject ProductImageStorageService ImageStorage

<PageTitle>@(_isNew ? "Новый товар" : "Редактирование") — Dona CRM</PageTitle>

<div class="page-heading">
    <div><a class="back-link" href="/products">← Каталог</a><h1>@(_isNew ? "Новый товар" : Model.Name)</h1><p>Карточка товара и варианты на складе.</p></div>
</div>

<EditForm Model="Model" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <div class="editor-grid product-editor-grid">
        <section class="panel form-section product-details-card">
            <div class="section-title"><span>01</span><div><h2>Основное</h2><p>Данные, которые увидит покупатель</p></div></div>
            <div class="form-grid">
                <label class="span-2">Название<InputText @bind-Value="Model.Name" placeholder="Например, Oversize футболка Basic" /><ValidationMessage For="() => Model.Name" /></label>
                <label>SKU<InputText @bind-Value="Model.Sku" placeholder="TS-0001" /><ValidationMessage For="() => Model.Sku" /></label>
                <label>Категория<InputSelect @bind-Value="Model.Category"><option value="">Выберите категорию</option>@foreach (var item in Categories) { <option>@item</option> }</InputSelect></label>
                <label>Статус<InputSelect @bind-Value="Model.Status"><option value="">Выберите статус</option>@foreach (var item in Enum.GetValues<ProductStatus>()) { <option value="@item">@item.Display()</option> }</InputSelect></label>
                <label>Пол<InputSelect @bind-Value="Model.Gender"><option value="">Выберите пол</option>@foreach (var item in Genders) { <option>@item</option> }</InputSelect></label>
                <label>Сезон<InputSelect @bind-Value="Model.Season"><option value="">Выберите сезон</option>@foreach (var item in Seasons) { <option>@item</option> }</InputSelect></label>
                <label>Поставщик<InputText @bind-Value="Model.SupplierName" placeholder="Название магазина" /></label>
                <label class="span-2">Ссылка 1688<InputText @bind-Value="Model.SourceUrl" placeholder="https://detail.1688.com/..." /></label>
                <label class="span-2">Описание<InputTextArea @bind-Value="Model.Notes" rows="6" placeholder="Материал, посадка, особенности модели и рекомендации покупателю" /></label>
            </div>
        </section>

        <aside class="panel economics-card">
            <div class="section-title"><span>¥</span><div><h2>Экономика</h2><p>На одну единицу</p></div></div>
            <label>Закупка, ¥<InputNumber @bind-Value="Model.PurchasePriceCny" /></label>
            <label>Курс ¥ → сум<InputNumber @bind-Value="Model.CnyRateUzs" /></label>
            <label>Комиссия посредника, %<InputNumber @bind-Value="Model.AgentCommissionPercent" /></label>
            <label>Доставка, сум<InputNumber @bind-Value="Model.DeliveryCostUzs" /></label>
            <label>Цена продажи, сум<InputNumber @bind-Value="Model.SellingPriceUzs" /></label>
            <div class="calculation"><span>Себестоимость <strong>@Money(Model.CostUzs)</strong></span><span>Прибыль <strong class="positive">@Money(Model.ProfitUzs)</strong></span><span>Наценка <strong>@Model.MarkupPercent%</strong></span></div>
        </aside>

        <section class="panel form-section product-variants-section">
            <div class="section-title with-action"><span>03</span><div><h2>Варианты</h2><p>Размеры, цвета и фактический остаток</p></div><button type="button" class="button secondary" @onclick="AddVariant">＋ Вариант</button></div>
            @if (Model.Variants.Count == 0) { <div class="empty-state small">Вариантов пока нет — товар будет считаться доступным только под заказ.</div> }
            @foreach (var variant in Model.Variants)
            {
                <div class="variant-row" @key="variant.Id">
                    <label>Цвет<InputText @bind-Value="variant.Color" /></label>
                    <label>Размер<InputText @bind-Value="variant.Size" /></label>
                    <label>Количество<InputNumber @bind-Value="variant.Quantity" /></label>
                    <button type="button" class="icon-button danger" title="Удалить" @onclick="() => RemoveVariant(variant)">×</button>
                </div>
            }
        </section>
        <section class="panel form-section product-images-section">
            <div class="section-title with-action"><span>02</span><div><h2>Изображения</h2><p>Фото товара и миниатюра каталога</p></div>@if (!_isNew) { <label class="button secondary image-upload-button">@(_imageBusy ? "Загрузка…" : "＋ Загрузить")<InputFile OnChange="UploadImagesAsync" multiple accept="image/jpeg,image/png,image/webp,image/gif" disabled="@_imageBusy" /></label> }</div>
            @if (_isNew) { <div class="empty-state small">Сначала сохраните товар, затем откройте его карточку и добавьте фотографии.</div> }
            else
            {
                <div class="image-url-row"><InputText @bind-Value="_imageUrl" placeholder="https://example.com/photo.jpg" /><button type="button" class="button secondary" disabled="@(_imageBusy || string.IsNullOrWhiteSpace(_imageUrl))" @onclick="UploadImageFromUrlAsync">Добавить по ссылке</button></div>
                @if (Model.Images.Count == 0) { <div class="empty-state small">Изображений пока нет. Можно загрузить JPG, PNG, WebP или GIF до 25 МБ.</div> }
                else
                {
                <div class="product-image-gallery">
                    @foreach (var image in Model.Images.OrderBy(x => x.SortOrder).ThenBy(x => x.CreatedAt))
                    {
                        <div class="product-image-card @(image.IsMain ? "main" : null)" @key="image.Id">
                            <div class="product-image-preview"><img src="@image.Url" alt="@image.Caption" loading="lazy" />@if (image.IsMain) { <em>Главное</em> }</div>
                            <InputText @bind-Value="image.Caption" placeholder="Подпись" />
                            <small>@image.FileName · @Size(image.SizeBytes) · @(image.Storage == ProductImageStorage.GoogleDrive ? "Drive" : "Локально")</small>
                            <div class="image-card-actions"><button type="button" title="Раньше" @onclick="() => MoveImageAsync(image, -1)">←</button><button type="button" title="Позже" @onclick="() => MoveImageAsync(image, 1)">→</button>@if (!image.IsMain) { <button type="button" @onclick="() => SetMainImageAsync(image)">Сделать главным</button> }<button type="button" class="danger" @onclick="() => DeleteImageAsync(image)">Удалить</button></div>
                        </div>
                    }
                </div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(_imageMessage)) { <div class="notice @(_imageSuccess ? "success" : "error")">@_imageMessage</div> }
        </section>
    </div>
    @if (_confirmDelete) { <div class="delete-confirmation"><span>Удалить товар без возможности восстановления?</span><button type="button" class="button ghost" @onclick="() => _confirmDelete = false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да, удалить</button></div> }
    <div class="form-actions"><a class="button ghost" href="/products">Отмена</a>@if (!_isNew && Model.Status == ProductStatus.Archived) { <button class="button secondary" type="button" @onclick="RestoreAsync">Вернуть из архива</button> } else if (!_isNew) { <button class="button ghost" type="button" @onclick="ArchiveAsync">В архив</button> }@if (!_isNew) { <button class="button danger-button" type="button" @onclick="() => _confirmDelete = true">Удалить товар</button> }<button class="button primary" type="submit" disabled="@_saving">@(_saving ? "Сохраняем…" : "Сохранить товар")</button></div>
</EditForm>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Product Model { get; set; } = new();
    private bool _saving;
    private bool _confirmDelete;
    private bool _imageBusy; private bool _imageSuccess; private string? _imageMessage; private string? _imageUrl;
    private const long MaxImageSize = 25 * 1024 * 1024;
    private bool _isNew => Id is null;
    private IReadOnlyList<string> Categories { get; set; } = [];
    private static readonly string[] Genders = ["Женский", "Мужской", "Унисекс"];
    private static readonly string[] Seasons = ["Весна", "Лето", "Осень", "Зима", "Всесезон"];
    protected override async Task OnParametersSetAsync() { Categories = (await Commerce.GetCategoriesAsync()).Where(x => x.IsActive).OrderBy(x => x.SortOrder).Select(x => x.Name).ToList(); Model = Id is null ? new Product() : await Repository.GetProductAsync(Id.Value) ?? new Product(); NormalizeImages(); _confirmDelete = false; _imageMessage = null; }
    private void AddVariant() => Model.Variants.Add(new ProductVariant());
    private void RemoveVariant(ProductVariant variant) => Model.Variants.Remove(variant);
    private async Task SaveAsync() { _saving = true; NormalizeImages(); await Repository.UpsertProductAsync(Model); Navigation.NavigateTo("/products"); }
    private async Task ArchiveAsync() { _saving = true; Model.Status = ProductStatus.Archived; await Repository.UpsertProductAsync(Model); Navigation.NavigateTo("/products"); }
    private async Task RestoreAsync() { _saving = true; Model.Status = ProductStatus.OnOrder; Model.Status = ProductStatusService.Calculate(Model, await BusinessSettingsRepository.GetAsync()); await Repository.UpsertProductAsync(Model); Navigation.NavigateTo("/products"); }
    private async Task DeleteAsync() { _saving = true; foreach (var image in Model.Images.ToList()) await ImageStorage.DeleteAsync(image); await Repository.DeleteProductAsync(Model.Id); Navigation.NavigateTo("/products"); }
    private async Task UploadImagesAsync(InputFileChangeEventArgs args)
    {
        _imageBusy = true; _imageMessage = null;
        try { var files = args.GetMultipleFiles(12); foreach (var file in files) { await using var stream = file.OpenReadStream(MaxImageSize); var image = await ImageStorage.UploadAsync(Model.Id, stream, file.Name, file.ContentType, file.Size); image.SortOrder = Model.Images.Count; image.IsMain = Model.Images.Count == 0; Model.Images.Add(image); } NormalizeImages(); await Repository.UpsertProductAsync(Model); _imageMessage = $"Загружено изображений: {files.Count}."; _imageSuccess = true; }
        catch (Exception exception) { _imageMessage = $"Ошибка загрузки: {exception.Message}"; _imageSuccess = false; }
        finally { _imageBusy = false; }
    }
    private async Task UploadImageFromUrlAsync()
    {
        _imageBusy = true; _imageMessage = null;
        try { var image = await ImageStorage.UploadFromUrlAsync(Model.Id, _imageUrl ?? string.Empty); image.SortOrder = Model.Images.Count; image.IsMain = Model.Images.Count == 0; Model.Images.Add(image); NormalizeImages(); await Repository.UpsertProductAsync(Model); _imageUrl = null; _imageMessage = "Изображение скачано и сохранено."; _imageSuccess = true; }
        catch (Exception exception) { _imageMessage = $"Не удалось загрузить ссылку: {exception.Message}"; _imageSuccess = false; }
        finally { _imageBusy = false; }
    }
    private async Task SetMainImageAsync(ProductImage selected) { foreach (var image in Model.Images) image.IsMain = image.Id == selected.Id; NormalizeImages(); await Repository.UpsertProductAsync(Model); }
    private async Task MoveImageAsync(ProductImage selected, int direction) { var ordered = Model.Images.OrderBy(x => x.SortOrder).ThenBy(x => x.CreatedAt).ToList(); var index = ordered.FindIndex(x => x.Id == selected.Id); var target = index + direction; if (index < 0 || target < 0 || target >= ordered.Count) return; (ordered[index], ordered[target]) = (ordered[target], ordered[index]); for (var i = 0; i < ordered.Count; i++) ordered[i].SortOrder = i; Model.Images = ordered; await Repository.UpsertProductAsync(Model); }
    private async Task DeleteImageAsync(ProductImage image) { _imageBusy = true; try { await ImageStorage.DeleteAsync(image); Model.Images.RemoveAll(x => x.Id == image.Id); NormalizeImages(); await Repository.UpsertProductAsync(Model); _imageMessage = "Изображение удалено."; _imageSuccess = true; } catch (Exception exception) { _imageMessage = $"Не удалось удалить изображение: {exception.Message}"; _imageSuccess = false; } finally { _imageBusy = false; } }
    private void NormalizeImages() { var ordered = Model.Images.OrderBy(x => x.SortOrder).ThenBy(x => x.CreatedAt).ToList(); if (ordered.Count > 0 && ordered.All(x => !x.IsMain)) ordered[0].IsMain = true; var mainFound = false; for (var i = 0; i < ordered.Count; i++) { ordered[i].SortOrder = i; if (ordered[i].IsMain && !mainFound) mainFound = true; else if (ordered[i].IsMain) ordered[i].IsMain = false; } Model.Images = ordered; if (ordered.Count > 0) Model.ImageUrl = ordered.First(x => x.IsMain).Url; else if (Model.ImageUrl?.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase) == true || Model.ImageUrl?.StartsWith("/media/drive/", StringComparison.OrdinalIgnoreCase) == true) Model.ImageUrl = null; }
    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024m / 1024m:N1} МБ" : $"{bytes / 1024m:N0} КБ";
    private static string Money(decimal value) => $"{value:N0} сум";
}
