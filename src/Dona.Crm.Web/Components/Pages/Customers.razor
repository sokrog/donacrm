@page "/customers"
@attribute [StreamRendering]
@inject ISalesRepository Repository
<PageTitle>Клиенты — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Продажи</span><h1>Клиенты</h1><p>Контакты покупателей и адреса доставки.</p></div><a class="button primary" href="/customers/new">＋ Добавить</a></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@_items.Count клиентов</strong></div>@foreach(var item in _items.OrderBy(x=>x.Name)){<a class="simple-list-row" href="/customers/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name)?"?":item.Name[..1])</span><span><strong>@item.Name</strong><small>@Contact(item)</small></span><em>→</em></a>}@if(_items.Count==0){<div class="empty-state">Добавьте первого клиента.</div>}</section>
@code { private IReadOnlyList<Customer> _items=[]; protected override async Task OnInitializedAsync()=>_items=await Repository.GetCustomersAsync(); private static string Contact(Customer x)=>new[]{x.Phone,x.Instagram,x.Telegram}.FirstOrDefault(v=>!string.IsNullOrWhiteSpace(v))??"Контакты не указаны"; }
