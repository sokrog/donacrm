@page "/settings"
@attribute [StreamRendering]
@implements IDisposable
@using Microsoft.Extensions.Options
@inject IOptions<StorageOptions> StorageConfiguration
@inject GoogleSheetsSettingsStore SettingsStore
@inject GoogleSheetsCatalogRepository GoogleSheets
@inject CatalogMigrationService Migration
@inject LoadingState Loading
@inject IBusinessSettingsRepository BusinessSettingsRepository
@inject ICatalogRepository Catalog
@inject ProductStatusService ProductStatusService
@inject InterfaceModeState InterfaceMode
@inject ProductImageStorageService ImageStorage
@inject GoogleDriveOAuthStore DriveOAuth
@inject CurrencyContext Currency
@inject BackupService Backup

<PageTitle>Настройки — Dona CRM</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Система</span><h1>Настройки</h1><p>Бизнес-правила, Google Sheets и личный Google Drive.</p></div>
</div>

<EditForm Model="_business" class="panel form-section business-settings">
    <div class="section-title"><span>⚙</span><div><h2>Бизнес-правила</h2><p>Автоматические статусы и горизонты предупреждений</p></div></div>
    <div class="form-grid settings-form">
        <label class="span-2 toggle-row"><InputCheckbox @bind-Value="_business.SimpleInterfaceMode" /><span><strong>Простой интерфейс</strong><small>Оставляет базовую аналитику, каталог, продажи и маркетинг; расширенные разделы можно вернуть в любой момент</small></span></label>
        <label class="span-2 toggle-row"><InputCheckbox @bind-Value="_business.AutoUpdateStockStatus" /><span><strong>Автоматически обновлять статус товара</strong><small>Архивные товары и позиции без вариантов не изменяются</small></span></label>
        <label>Порог «Заканчивается», шт.<InputNumber @bind-Value="_business.LowStockThreshold" min="0" /></label>
        <label>При нулевом остатке<InputSelect @bind-Value="_business.ZeroStockStatus"><option value="@ProductStatus.OutOfStock">Нет в наличии</option><option value="@ProductStatus.OnOrder">Под заказ</option></InputSelect></label>
        <label class="span-2 toggle-row"><InputCheckbox @bind-Value="_business.CountReservedAsUnavailable" /><span><strong>Учитывать резерв как недоступный остаток</strong><small>Например, 5 на складе и 3 в резерве считаются как 2 доступных</small></span></label>
        <label>Поставка скоро, дней<InputNumber @bind-Value="_business.PurchaseDueSoonDays" min="0" /></label>
        <label>Горизонт контент-плана, дней<InputNumber @bind-Value="_business.ContentPlanningHorizonDays" min="1" /></label>
        <label>Период аналитики по умолчанию, дней<InputNumber @bind-Value="_business.DefaultAnalyticsPeriodDays" min="1" /></label>
        <label>Товар считается залежавшимся через, дней<InputNumber @bind-Value="_business.StaleInventoryDays" min="1" /></label>
        <label>Префикс номера продажи<InputText @bind-Value="_business.SaleNumberPrefix" placeholder="SALE" /><small>Например: SALE-20260720-001</small></label>
        <label>Главная валюта проекта<InputSelect @bind-Value="_business.MainCurrencyCode">@foreach (var currencyCode in CurrencyCodes.Supported) { <option value="@currencyCode">@currencyCode · @CurrencyCodes.Symbol(currencyCode)</option> }</InputSelect><small>В ней считаются себестоимость, продажи и аналитика. Смена кода не конвертирует уже сохранённые суммы.</small></label>
    </div>
    @if (!string.IsNullOrWhiteSpace(_businessMessage)) { <div class="notice @(_businessSuccess ? "success" : "error")">@_businessMessage</div> }
    <div class="settings-actions"><button type="button" class="button secondary" @onclick="RecalculateStatusesAsync">Пересчитать статусы сейчас</button><button type="button" class="button primary" @onclick="SaveBusinessSettingsAsync">Сохранить бизнес-правила</button></div>
</EditForm>

<EditForm Model="_business" class="panel form-section drive-connection-panel">
    <div class="section-title"><span>D</span><div><h2>Личный Google Drive</h2><p>Однократный вход с автоматическим обновлением доступа</p></div></div>
    <div class="drive-resource-links"><a href="https://console.cloud.google.com/apis/library/drive.googleapis.com" target="_blank" rel="noopener noreferrer">Включить Drive API ↗</a><a href="https://console.cloud.google.com/apis/credentials/oauthclient" target="_blank" rel="noopener noreferrer">Создать OAuth Desktop client ↗</a><a href="https://drive.google.com/drive/my-drive" target="_blank" rel="noopener noreferrer">Открыть личный Drive ↗</a></div>
    <div class="form-grid settings-form">
        <label class="span-2">OAuth JSON типа Desktop app
            <InputFile OnChange="ReadDriveOAuthFileAsync" accept="application/json,.json" />
            <small>@(_driveFileName ?? (DriveOAuth.HasClientCredentials ? "OAuth-клиент сохранён на этом компьютере" : "Создайте OAuth Client ID типа Desktop app и загрузите JSON"))</small>
        </label>
        <label class="span-2 toggle-row"><InputCheckbox @bind-Value="_business.UseGoogleDriveImages" /><span><strong>Хранить новые изображения в личном Google Drive</strong><small>Если выключено, файлы сохраняются локально в приложении</small></span></label>
        @if (_business.UseGoogleDriveImages) { <label class="span-2">ID или ссылка на папку Google Drive<InputText @bind-Value="_business.GoogleDriveFolderId" placeholder="Необязательно — без папки файлы попадут в корень Drive" /><small>Можно оставить пустым или вставить ссылку на папку личного диска</small></label> }
    </div>
    @if (!string.IsNullOrWhiteSpace(_driveMessage)) { <div class="notice @(_driveSuccess ? "success" : "error")">@_driveMessage</div> }
    <div class="settings-actions">
        <button type="button" class="button primary" disabled="@(!DriveOAuth.HasClientCredentials || _driveBusy)" @onclick="ConnectDriveAsync">@(DriveOAuth.IsConnected ? "Переподключить аккаунт" : "Подключить Google Drive")</button>
        @if (DriveOAuth.IsConnected) { <button type="button" class="button secondary" disabled="@_driveBusy" @onclick="CheckDriveAsync">Проверить Drive</button><button type="button" class="button secondary" disabled="@_driveBusy" @onclick="DisconnectDriveAsync">Отключить на этом компьютере</button> }
        <button type="button" class="button primary" disabled="@_driveBusy" @onclick="SaveDriveSettingsAsync">Сохранить настройки Drive</button>
    </div>
    <div class="check-list settings-status">
        <div class="check-row"><span class="check-icon @(DriveOAuth.HasClientCredentials ? "ok" : "missing")">@(DriveOAuth.HasClientCredentials ? "✓" : "!")</span><div><strong>OAuth-клиент</strong><small>@(DriveOAuth.HasClientCredentials ? "Настроен" : "JSON не загружен")</small></div></div>
        <div class="check-row"><span class="check-icon @(DriveOAuth.IsConnected ? "ok" : "neutral")">@(DriveOAuth.IsConnected ? "✓" : "○")</span><div><strong>Личный аккаунт</strong><small>@(DriveOAuth.IsConnected ? "Подключён; повторный вход обычно не требуется" : "Не подключён")</small></div></div>
    </div>
</EditForm>

<section class="panel form-section backup-panel">
    <div class="section-title"><span>↧</span><div><h2>Резервная копия</h2><p>Скачивание и безопасная проверка ZIP без изменения данных</p></div></div>
    <p>Ключи Google, OAuth-токены и другие секреты в архив не включаются. Изображения Google Drive остаются в вашем Drive.</p>
    <div class="backup-actions"><a class="button primary" href="/backup/download">Скачать резервную копию</a><label class="button secondary image-upload-button">@(_backupBusy ? "Проверяем…" : "Проверить архив перед восстановлением")<InputFile OnChange="InspectBackupAsync" accept="application/zip,.zip" disabled="@_backupBusy" /></label></div>
    @if (!string.IsNullOrWhiteSpace(_backupMessage)) { <div class="notice @(_backupPreview is null ? "error" : "success")">@_backupMessage</div> }
    @if (_backupPreview is not null)
    {
        <div class="backup-preview">
            <div><span>Создан</span><strong>@_backupPreview.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong><small>схема v@_backupPreview.SchemaVersion</small></div>
            <div><span>Товары</span><strong>@_backupPreview.Products</strong><small>новых @_backupPreview.NewProducts · обновлений @_backupPreview.UpdatedProducts</small></div>
            <div><span>Закупки</span><strong>@_backupPreview.Purchases</strong><small>новых @_backupPreview.NewPurchases · обновлений @_backupPreview.UpdatedPurchases</small></div>
            <div><span>Продажи</span><strong>@_backupPreview.Sales</strong><small>новых @_backupPreview.NewSales · обновлений @_backupPreview.UpdatedSales</small></div>
            <div><span>Справочники</span><strong>@(_backupPreview.Suppliers + _backupPreview.Intermediaries + _backupPreview.Categories + _backupPreview.Customers)</strong><small>поставщики, посредники, категории и клиенты</small></div>
            <div><span>Маркетинг</span><strong>@(_backupPreview.Collections + _backupPreview.Outfits + _backupPreview.ContentItems)</strong><small>коллекции, образы и публикации</small></div>
            <div><span>Изображения</span><strong>@_backupPreview.LocalImages</strong><small>@Size(_backupPreview.LocalImageBytes) локальных файлов</small></div>
        </div>
        <div class="notice warning">Архив только проверен. Данные ещё не изменялись; восстановление с подтверждением будет добавлено следующим шагом.</div>
    }
</section>

<div class="settings-grid">
    <section class="panel form-section">
        <div class="section-title"><span>G</span><div><h2>Доступ к Google Sheets</h2><p>Ключ сохраняется только на этом компьютере</p></div></div>

        <div class="form-grid settings-form">
            <label class="span-2">ID или ссылка на Google-таблицу
                <input @bind="_spreadsheetId" placeholder="https://docs.google.com/spreadsheets/d/... или ID" />
            </label>
            <label class="span-2">Загрузить JSON-ключ сервисного аккаунта
                <InputFile OnChange="ReadCredentialsFileAsync" accept="application/json,.json" />
                <small>@(_uploadedFileName ?? (SettingsStore.HasCredentials ? $"Сохранён ключ: {SettingsStore.ServiceAccountEmail}" : "Файл ещё не выбран"))</small>
            </label>
            <label class="span-2">Или вставить содержимое JSON-ключа
                <textarea @bind="_credentialsJson" rows="5" placeholder="{ &quot;type&quot;: &quot;service_account&quot;, ... }"></textarea>
                <small>После сохранения приватный ключ очищается из формы и больше не отображается.</small>
            </label>
            <label class="span-2 toggle-row"><input type="checkbox" @bind="_useGoogleSheets" /><span><strong>Использовать Google Sheets как основное хранилище</strong><small>Изменение применяется сразу после сохранения</small></span></label>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="notice @(_success ? "success" : "error")">@_message</div>
        }

        <div class="settings-actions split-actions">
            <button class="button primary" disabled="@_busy" @onclick="SaveSettingsAsync">Сохранить настройки</button>
            <span class="action-spacer"></span>
            <button class="button secondary" disabled="@(!SettingsStore.IsConfigured || _busy)" @onclick="CheckConnectionAsync">Проверить</button>
            <button class="button secondary" disabled="@(!SettingsStore.IsConfigured || _busy)" @onclick="ImportAsync">Импортировать каталог</button>
        </div>

        <div class="check-list settings-status">
            <div class="check-row"><span class="check-icon @(HasSpreadsheet ? "ok" : "missing")">@(HasSpreadsheet ? "✓" : "!")</span><div><strong>Таблица</strong><small>@(HasSpreadsheet ? SettingsStore.SpreadsheetId : "Не настроена")</small></div></div>
            <div class="check-row"><span class="check-icon @(SettingsStore.HasCredentials ? "ok" : "missing")">@(SettingsStore.HasCredentials ? "✓" : "!")</span><div><strong>Сервисный аккаунт</strong><small>@(SettingsStore.ServiceAccountEmail ?? "Ключ не сохранён")</small></div></div>
            <div class="check-row"><span class="check-icon @(SettingsStore.UseGoogleSheets ? "ok" : "neutral")">@(SettingsStore.UseGoogleSheets ? "✓" : "○")</span><div><strong>Активное хранилище</strong><small>@(SettingsStore.UseGoogleSheets ? "Google Sheets" : "Локальный JSON")</small></div></div>
        </div>
    </section>

    <aside class="panel settings-summary">
        <span class="eyebrow">Быстрый старт</span>
        <h2>Официальные сервисы Google</h2>
        <a class="external-card" href="https://console.cloud.google.com/iam-admin/serviceaccounts/create" target="_blank" rel="noopener noreferrer"><i>1</i><div><strong>Создать сервисный аккаунт ↗</strong><small>Google Cloud Console</small></div></a>
        <a class="external-card" href="https://console.cloud.google.com/apis/library/sheets.googleapis.com" target="_blank" rel="noopener noreferrer"><i>2</i><div><strong>Включить Sheets API ↗</strong><small>Библиотека Google API</small></div></a>
        <a class="external-card" href="https://sheets.new/" target="_blank" rel="noopener noreferrer"><i>3</i><div><strong>Создать Google-таблицу ↗</strong><small>Новая пустая таблица</small></div></a>
        <div class="setup-guide compact-guide">
            <strong>После создания</strong>
            <ol>
                <li>Создайте JSON-ключ у сервисного аккаунта.</li>
                <li>Откройте доступ к таблице для его <code>client_email</code> с правом редактора.</li>
                <li>Загрузите ключ и вставьте ссылку на таблицу слева.</li>
                <li>Сохраните и нажмите «Проверить».</li>
            </ol>
        </div>
        <p>Приложение автоматически создаёт нужные листы каталога, закупок, продаж, коллекций и контент-плана.</p>
    </aside>
</div>

@code {
    private const long MaxCredentialSize = 256 * 1024;
    private const long MaxBackupSize = 100 * 1024 * 1024;
    private bool _busy;
    private bool _success;
    private string? _message;
    private string _spreadsheetId = string.Empty;
    private string _credentialsJson = string.Empty;
    private bool _useGoogleSheets;
    private string? _uploadedFileName;
    private BusinessSettings _business = new();
    private string? _businessMessage;
    private bool _businessSuccess;
    private bool _driveBusy;
    private bool _driveSuccess;
    private string? _driveMessage;
    private string? _driveFileName;
    private BackupPreview? _backupPreview;
    private bool _backupBusy;
    private string? _backupMessage;
    private bool HasSpreadsheet => !string.IsNullOrWhiteSpace(SettingsStore.SpreadsheetId);
    protected override async Task OnInitializedAsync() { InterfaceMode.Changed += InterfaceModeChanged; _spreadsheetId = SettingsStore.SpreadsheetId; _useGoogleSheets = SettingsStore.UseGoogleSheets; _business = await BusinessSettingsRepository.GetAsync(); }

    private async Task SaveBusinessSettingsAsync()
    {
        try { NormalizeBusinessSettings(); await BusinessSettingsRepository.SaveAsync(_business); InterfaceMode.Set(_business.SimpleInterfaceMode); Currency.Set(_business.MainCurrencyCode); _businessMessage = "Бизнес-правила сохранены."; _businessSuccess = true; }
        catch (Exception exception) { _businessMessage = $"Не удалось сохранить: {exception.Message}"; _businessSuccess = false; }
    }

    private async Task RecalculateStatusesAsync()
    {
        try
        {
            NormalizeBusinessSettings(); await BusinessSettingsRepository.SaveAsync(_business);
            var products = await Catalog.GetProductsAsync(); var changed = 0;
            foreach (var product in products) { var status = ProductStatusService.Calculate(product, _business); if (status == product.Status) continue; product.Status = status; await Catalog.UpsertProductAsync(product); changed++; }
            _businessMessage = $"Пересчёт завершён: изменено статусов — {changed}."; _businessSuccess = true;
        }
        catch (Exception exception) { _businessMessage = $"Ошибка пересчёта: {exception.Message}"; _businessSuccess = false; }
    }

    private async Task CheckDriveAsync()
    {
        _driveBusy = true;
        try { NormalizeBusinessSettings(); await BusinessSettingsRepository.SaveAsync(_business); await ImageStorage.CheckGoogleDriveAsync(); _driveMessage = string.IsNullOrWhiteSpace(_business.GoogleDriveFolderId) ? "Личный Google Drive доступен." : "Папка личного Google Drive доступна."; _driveSuccess = true; }
        catch (Exception exception) { _driveMessage = $"Не удалось открыть папку Drive: {exception.Message}"; _driveSuccess = false; }
        finally { _driveBusy = false; }
    }

    private async Task SaveDriveSettingsAsync()
    {
        _driveBusy = true;
        try { NormalizeBusinessSettings(); if (_business.UseGoogleDriveImages && !DriveOAuth.IsConnected) throw new InvalidOperationException("Сначала подключите личный Google Drive."); await BusinessSettingsRepository.SaveAsync(_business); _driveMessage = _business.UseGoogleDriveImages ? "Настройки Drive сохранены." : "Локальное хранение изображений включено."; _driveSuccess = true; }
        catch (Exception exception) { _driveMessage = $"Не удалось сохранить настройки Drive: {exception.Message}"; _driveSuccess = false; }
        finally { _driveBusy = false; }
    }

    private void NormalizeBusinessSettings() { _business.LowStockThreshold = Math.Max(0, _business.LowStockThreshold); _business.PurchaseDueSoonDays = Math.Max(0, _business.PurchaseDueSoonDays); _business.ContentPlanningHorizonDays = Math.Max(1, _business.ContentPlanningHorizonDays); _business.DefaultAnalyticsPeriodDays = Math.Max(1, _business.DefaultAnalyticsPeriodDays); _business.StaleInventoryDays = Math.Max(1, _business.StaleInventoryDays); _business.SaleNumberPrefix = SaleNumberGenerator.NormalizePrefix(_business.SaleNumberPrefix); _business.MainCurrencyCode = CurrencyCodes.Normalize(_business.MainCurrencyCode); _business.GoogleDriveFolderId = ExtractDriveFolderId(_business.GoogleDriveFolderId); }
    private static string? ExtractDriveFolderId(string? value) { if (string.IsNullOrWhiteSpace(value)) return null; var marker = "/folders/"; var index = value.IndexOf(marker, StringComparison.OrdinalIgnoreCase); if (index < 0) return value.Trim(); return value[(index + marker.Length)..].Split('?', '/', '#')[0]; }

    private async Task ReadCredentialsFileAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            await using var stream = file.OpenReadStream(MaxCredentialSize);
            using var reader = new StreamReader(stream);
            _credentialsJson = await reader.ReadToEndAsync();
            _uploadedFileName = file.Name;
            _message = "Ключ загружен в форму. Нажмите «Сохранить настройки».";
            _success = true;
        }
        catch (Exception exception) { _message = $"Не удалось прочитать файл: {exception.Message}"; _success = false; }
    }

    private async Task InspectBackupAsync(InputFileChangeEventArgs args)
    {
        _backupBusy = true; _backupPreview = null; _backupMessage = null;
        try { await using var stream = args.File.OpenReadStream(MaxBackupSize); _backupPreview = await Backup.InspectAsync(stream); _backupMessage = $"Архив «{args.File.Name}» прошёл проверку. Предпросмотр не изменил данные."; }
        catch (Exception exception) { _backupMessage = $"Архив не прошёл проверку: {exception.Message}"; }
        finally { _backupBusy = false; }
    }

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024m / 1024m:N1} МБ" : $"{bytes / 1024m:N0} КБ";

    private async Task ReadDriveOAuthFileAsync(InputFileChangeEventArgs args)
    {
        _driveBusy = true;
        try { var file = args.File; await using var stream = file.OpenReadStream(MaxCredentialSize); using var reader = new StreamReader(stream); await DriveOAuth.SaveClientCredentialsAsync(await reader.ReadToEndAsync()); _driveFileName = file.Name; _driveMessage = "OAuth-клиент сохранён. Теперь нажмите «Подключить Google Drive»."; _driveSuccess = true; }
        catch (Exception exception) { _driveMessage = $"Не удалось сохранить OAuth-клиент: {exception.Message}"; _driveSuccess = false; }
        finally { _driveBusy = false; }
    }

    private async Task ConnectDriveAsync()
    {
        _driveBusy = true;
        try { var account = await DriveOAuth.ConnectAsync(); _driveMessage = $"Google Drive подключён: {account}. Токен сохранён локально."; _driveSuccess = true; }
        catch (Exception exception) { _driveMessage = $"Не удалось подключить Drive: {exception.Message}"; _driveSuccess = false; }
        finally { _driveBusy = false; }
    }

    private async Task DisconnectDriveAsync() { DriveOAuth.Disconnect(); _business.UseGoogleDriveImages = false; await BusinessSettingsRepository.SaveAsync(_business); _driveMessage = "Локальный токен удалён. Новые изображения будут сохраняться локально."; _driveSuccess = true; }

    private async Task SaveSettingsAsync() => await ExecuteAsync(async () =>
    {
        await SettingsStore.SaveAsync(_spreadsheetId, _credentialsJson, _useGoogleSheets);
        _spreadsheetId = SettingsStore.SpreadsheetId;
        _credentialsJson = string.Empty;
        _uploadedFileName = null;
        return "Настройки сохранены локально. Теперь можно проверить подключение.";
    });

    private async Task CheckConnectionAsync() => await ExecuteAsync(async () =>
    {
        await GoogleSheets.CheckConnectionAsync();
        return "Подключение успешно. Структура таблицы проверена.";
    });

    private async Task ImportAsync() => await ExecuteAsync(async () =>
    {
        var count = await Migration.ImportLocalToGoogleSheetsAsync();
        return $"Импорт завершён: {count} товаров перенесено в Google Sheets.";
    });

    private async Task ExecuteAsync(Func<Task<string>> action)
    {
        _busy = true; _message = null;
        try { _message = await Loading.RunAsync("Выполняем операцию с Google…", action); _success = true; }
        catch (Exception exception) { _message = $"Ошибка: {exception.Message}"; _success = false; }
        finally { _busy = false; }
    }
    private void InterfaceModeChanged() { _business.SimpleInterfaceMode = InterfaceMode.IsSimple; _ = InvokeAsync(StateHasChanged); }
    public void Dispose() => InterfaceMode.Changed -= InterfaceModeChanged;
}
