@page "/purchases/new"
@page "/purchases/{Id:guid}"
@attribute [StreamRendering]
@inject ICommerceRepository Commerce
@inject ICatalogRepository Catalog
@inject PurchaseReceivingService Receiving
@inject NavigationManager Navigation

<PageTitle>Закупка — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/purchases">← Закупки</a><h1>@(_isNew ? "Новая закупка" : _model.Number)</h1><p>Стоимость партии и движение из Китая.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <div class="editor-grid">
        <section class="panel form-section">
            <div class="section-title"><span>01</span><div><h2>Поставка</h2><p>Основные параметры</p></div></div>
            <div class="form-grid">
                <label>Номер<InputText @bind-Value="_model.Number" /></label><label>Статус<InputSelect @bind-Value="_model.Status"><option value="">Выберите статус</option>@foreach (var status in Enum.GetValues<PurchaseStatus>()) { <option value="@status">@status.Display()</option> }</InputSelect></label>
                <label class="span-2">Поставщик<InputSelect @bind-Value="_model.SupplierId" @bind-Value:after="SupplierChanged"><option value="">Не выбран</option>@foreach (var supplier in _suppliers) { <option value="@supplier.Id">@supplier.Name</option> }</InputSelect></label>
                <label>Трек-код<InputText @bind-Value="_model.TrackingCode" placeholder="Код отслеживания" /></label><label>Предполагаемая дата поставки<InputDate @bind-Value="_model.EstimatedDeliveryDate" /></label>
                <label>Курс ¥ → сум<InputNumber @bind-Value="_model.CnyRateUzs" /></label><label>Комиссия, %<InputNumber @bind-Value="_model.AgentCommissionPercent" /></label>
                <label>Международная доставка<InputNumber @bind-Value="_model.InternationalShippingUzs" /></label><label>Прочие расходы<InputNumber @bind-Value="_model.OtherCostsUzs" /></label>
            </div>
        </section>
        <aside class="panel economics-card"><div class="section-title"><span>¥</span><div><h2>Итог партии</h2><p>@_model.TotalQuantity единиц</p></div></div><div class="calculation large"><span>Товар в юанях <strong>¥ @_model.GoodsCostCny.ToString("N2")</strong></span><span>Товар в сумах <strong>@Money(_model.GoodsCostUzs)</strong></span><span>Комиссия <strong>@Money(_model.AgentCommissionUzs)</strong></span><span class="total-line">Итого <strong>@Money(_model.TotalCostUzs)</strong></span></div></aside>
        <section class="panel form-section span-all">
            <div class="section-title with-action"><span>02</span><div><h2>Позиции</h2><p>Товары в этой закупке</p></div><button type="button" class="button secondary" @onclick="AddItem">＋ Позиция</button></div>
            @if (HasMoqWarning) { <div class="notice warning">Есть позиции меньше MOQ поставщика (@SelectedSupplier!.Moq шт.). Проверьте возможность выкупа.</div> }
            @foreach (var item in _model.Items)
            {
                <div class="purchase-item-card" @key="item.Id">
                    <div class="purchase-item"><label>Товар<select value="@item.ProductId" @onchange="e => ProductChanged(item, e.Value?.ToString())"><option value="">Ручное название</option>@foreach (var product in _products) { <option value="@product.Id">@product.Name</option> }</select></label><label>Название<InputText @bind-Value="item.ProductName" /></label><label>Заказано<InputNumber @bind-Value="item.Quantity" /></label><label>Цена, ¥<InputNumber @bind-Value="item.UnitPriceCny" /></label><label>Вес ед., кг<InputNumber @bind-Value="item.UnitWeightKg" step="0.01" /></label><button type="button" class="icon-button danger" @onclick="() => _model.Items.Remove(item)">×</button></div>
                    <div class="receipt-row"><label>Цвет<InputText @bind-Value="item.Color" /></label><label>Размер<InputText @bind-Value="item.Size" /></label><label>Получено<InputNumber @bind-Value="item.ReceivedQuantity" /></label><label>Брак<InputNumber @bind-Value="item.DefectQuantity" /></label><div class="receipt-metric"><span>Недостача</span><strong class="@(item.MissingQuantity > 0 ? "negative" : null)">@item.MissingQuantity</strong></div><div class="receipt-metric"><span>Себестоимость ед.</span><strong>@Money(_model.ItemUnitLandedCostUzs(item))</strong></div><div class="receipt-metric"><span>Оприходовано</span><strong>@item.StockedQuantity / @item.AcceptedQuantity</strong></div></div>
                </div>
            }
            @if (_model.Items.Count == 0) { <div class="empty-state small">Добавьте товары, которые входят в закупку.</div> }
        </section>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="notice @(_receiptSuccess ? "success" : "error")">@_message</div> }
    <div class="form-actions"><a class="button ghost" href="/purchases">Отмена</a>@if (!_isNew) { <button type="button" class="button secondary" @onclick="ReceiveAsync">Оприходовать принятое</button> }<button class="button primary">Сохранить закупку</button></div>
</EditForm>
@code {
    [Parameter] public Guid? Id { get; set; }
    private Purchase _model = new(); private List<Supplier> _suppliers = []; private IReadOnlyList<Product> _products = []; private bool _isNew => Id is null;
    private string? _message; private bool _receiptSuccess;
    private Supplier? SelectedSupplier => _model.SupplierId is null ? null : _suppliers.FirstOrDefault(x => x.Id == _model.SupplierId);
    private bool HasMoqWarning => SelectedSupplier?.Moq is > 1 && _model.Items.Any(x => (x.Quantity ?? 0) < SelectedSupplier.Moq.Value);
    protected override async Task OnParametersSetAsync() { _suppliers = (await Commerce.GetSuppliersAsync()).ToList(); _model = Id is null ? new Purchase() : await Commerce.GetPurchaseAsync(Id.Value) ?? new Purchase(); var referenced = _model.Items.Where(x => x.ProductId is not null).Select(x => x.ProductId!.Value).ToHashSet(); _products = (await Catalog.GetProductsAsync()).Where(x => x.Status != ProductStatus.Archived || referenced.Contains(x.Id)).ToList(); _message = null; }
    private void AddItem() => _model.Items.Add(new PurchaseItem());
    private void SupplierChanged() { _model.SupplierName = _model.SupplierId is null ? null : _suppliers.FirstOrDefault(x => x.Id == _model.SupplierId)?.Name; }
    private void ProductChanged(PurchaseItem item, string? value) { if (!Guid.TryParse(value, out var id)) { item.ProductId = null; item.ProductVariantId = null; return; } var product = _products.FirstOrDefault(x => x.Id == id); if (product is null) return; item.ProductId = id; item.ProductName = product.Name; item.UnitPriceCny = product.PurchasePriceCny; var variant = product.Variants.FirstOrDefault(); if (variant is not null) { item.ProductVariantId = variant.Id; item.Color = variant.Color; item.Size = variant.Size; } }
    private async Task SaveAsync() { await Commerce.UpsertPurchaseAsync(_model); Navigation.NavigateTo("/purchases"); }
    private async Task ReceiveAsync() { try { await Commerce.UpsertPurchaseAsync(_model); var result = await Receiving.ReceiveAsync(_model); _message = $"Оприходовано {result.AddedUnits} шт. в {result.UpdatedProducts} товарах. Пропущено позиций: {result.SkippedItems}."; _receiptSuccess = true; } catch (Exception exception) { _message = $"Ошибка приёмки: {exception.Message}"; _receiptSuccess = false; } }
    private static string Money(decimal value) => $"{value:N0} сум";
}
