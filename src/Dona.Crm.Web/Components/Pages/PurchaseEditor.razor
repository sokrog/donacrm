@page "/purchases/new"
@page "/purchases/{Id:guid}"
@attribute [StreamRendering]
@inject ICommerceRepository Commerce
@inject ICatalogRepository Catalog
@inject PurchaseReceivingService Receiving
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CurrencyContext Currency

<PageTitle>Закупка — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/purchases">← Закупки</a><h1>@(_isNew ? "Новая закупка" : _model.Number)</h1><p>Стоимость партии и движение из Китая.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <div class="editor-grid">
        <section class="panel form-section">
            <div class="section-title"><span>01</span><div><h2>Поставка</h2><p>Основные параметры</p></div></div>
            <div class="form-grid">
                <label>Номер<InputText @bind-Value="_model.Number" /></label><label>Статус<InputSelect @bind-Value="_model.Status"><option value="">Выберите статус</option>@foreach (var status in Enum.GetValues<PurchaseStatus>()) { <option value="@status">@status.Display()</option> }</InputSelect></label>
                <label class="span-2">Поставщик<InputSelect @bind-Value="_model.SupplierId" @bind-Value:after="SupplierChanged"><option value="">Не выбран</option>@foreach (var supplier in _suppliers) { <option value="@supplier.Id">@supplier.Name</option> }</InputSelect></label>
                <label class="span-2">Посредник и доставка<InputSelect @bind-Value="_model.IntermediaryId" @bind-Value:after="IntermediaryChanged"><option value="">Не выбран</option>@foreach (var intermediary in _intermediaries) { <option value="@intermediary.Id">@intermediary.Name</option> }</InputSelect></label>
                <label>Трек-код<InputText @bind-Value="_model.TrackingCode" placeholder="Код отслеживания" /></label><label>Предполагаемая дата поставки<InputDate @bind-Value="_model.EstimatedDeliveryDate" /></label>
                <label>Валюта закупки<InputSelect @bind-Value="_model.CurrencyCode" @bind-Value:after="PurchaseCurrencyChanged">@foreach (var currencyCode in CurrencyCodes.Supported) { <option value="@currencyCode">@currencyCode · @CurrencyCodes.Symbol(currencyCode)</option> }</InputSelect></label><label>Курс @_model.CurrencyCode → @Currency.Code<InputNumber @bind-Value="_model.CnyRateUzs" /></label>
                <label>Комиссия, %<InputNumber @bind-Value="_model.AgentCommissionPercent" /></label><label>Международная доставка, @Currency.Symbol<InputNumber @bind-Value="_model.InternationalShippingUzs" /></label><label>Прочие расходы, @Currency.Symbol<InputNumber @bind-Value="_model.OtherCostsUzs" /></label>
            </div>
        </section>
        <aside class="panel economics-card"><div class="section-title"><span>@CurrencyCodes.Symbol(_model.CurrencyCode)</span><div><h2>Итог партии</h2><p>@_model.TotalQuantity единиц · итог в @Currency.Code</p></div></div><div class="calculation large"><span>Товар в @_model.CurrencyCode <strong>@Currency.SourceAmount(_model.GoodsCostCny, _model.CurrencyCode)</strong></span><span>Товар в @Currency.Code <strong>@Money(_model.GoodsCostUzs)</strong></span><span>Комиссия <strong>@Money(_model.AgentCommissionUzs)</strong></span><span class="total-line">Итого <strong>@Money(_model.TotalCostUzs)</strong></span></div></aside>
        <section class="panel form-section span-all">
            <div class="section-title with-action"><span>02</span><div><h2>Позиции</h2><p>Товары в этой закупке</p></div><button type="button" class="button secondary" @onclick="AddItem">＋ Позиция</button></div>
            @if (HasMoqWarning) { <div class="notice warning">Есть позиции меньше MOQ поставщика (@SelectedSupplier!.Moq шт.). Проверьте возможность выкупа.</div> }
            @foreach (var item in _model.Items)
            {
                <div class="purchase-item-card" @key="item.Id">
                    <div class="purchase-item"><label>Товар<ProductAutocomplete Products="_products" Value="item.ProductId" OnSelected="product => ProductChanged(item, product)" Placeholder="Название или SKU" /></label><label>Название<InputText @bind-Value="item.ProductName" /></label><label>Заказано<InputNumber @bind-Value="item.Quantity" /></label><label>Цена, @CurrencyCodes.Symbol(_model.CurrencyCode)<InputNumber @bind-Value="item.UnitPriceCny" /></label><label>Вес ед., кг<InputNumber @bind-Value="item.UnitWeightKg" step="0.01" /></label><button type="button" class="icon-button danger" @onclick="() => RemoveItemAsync(item)">×</button></div>
                    <div class="receipt-row"><label>Цвет<InputText @bind-Value="item.Color" /></label><label>Размер<InputText @bind-Value="item.Size" /></label><div class="receipt-metric"><span>Всего получено</span><strong>@(item.ReceivedQuantity ?? 0)</strong></div><div class="receipt-metric"><span>Всего брака</span><strong>@(item.DefectQuantity ?? 0)</strong></div><div class="receipt-metric"><span>Осталось принять</span><strong class="@(item.MissingQuantity > 0 ? "negative" : null)">@item.MissingQuantity</strong></div><div class="receipt-metric"><span>Себестоимость ед.</span><strong>@Money(_model.ItemUnitLandedCostUzs(item))</strong></div><div class="receipt-metric"><span>Оприходовано</span><strong>@item.StockedQuantity</strong></div></div>
                </div>
            }
            @if (_model.Items.Count == 0) { <div class="empty-state small">Добавьте товары, которые входят в закупку.</div> }
        </section>
        @if (!_isNew)
        {
            <section class="panel form-section span-all">
                <div class="section-title"><span>03</span><div><h2>Новая приёмка</h2><p>Укажите количество именно в этой поставке</p></div></div>
                <div class="form-grid receipt-meta"><label>Дата приёмки<InputDate @bind-Value="_receiptDate" /></label><label>Комментарий<InputText @bind-Value="_receiptNote" placeholder="Например, первая коробка" /></label></div>
                @foreach (var item in _model.Items.Where(x => x.MissingQuantity > 0))
                {
                    var receipt = ReceiptInput(item.Id);
                    <div class="new-receipt-row" @key="item.Id"><div><strong>@item.ProductName</strong><small>@item.Color · @item.Size · осталось @item.MissingQuantity шт.</small></div><label>Получено<InputNumber @bind-Value="receipt.ReceivedQuantity" /></label><label>Из них брак<InputNumber @bind-Value="receipt.DefectQuantity" /></label></div>
                }
                @if (_model.Items.Count > 0 && _model.Items.All(x => x.MissingQuantity == 0)) { <div class="empty-state small">Все позиции закупки уже приняты.</div> }
                <div class="form-actions"><button type="button" class="button secondary" disabled="@_receiving" @onclick="ReceiveAsync">@(_receiving ? "Сохраняем…" : "Оформить приёмку")</button></div>
            </section>
            <section class="panel form-section span-all">
                <div class="section-title"><span>04</span><div><h2>История приёмок</h2><p>@_model.Receipts.Count поставок</p></div></div>
                @foreach (var receipt in _model.Receipts.OrderByDescending(x => x.ReceivedAt))
                {
                    <div class="receipt-history-row"><span><strong>@receipt.ReceivedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong><small>@(receipt.Note ?? "Без комментария")</small><small>@ReceiptSummary(receipt)</small></span><span>Получено <strong>@receipt.ReceivedQuantity</strong></span><span>Брак <strong>@receipt.DefectQuantity</strong></span><span>На склад <strong>@receipt.StockedQuantity</strong></span></div>
                }
                @if (_model.Receipts.Count == 0) { <div class="empty-state small">Приёмок пока не было.</div> }
            </section>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="notice @(_receiptSuccess ? "success" : "error")">@_message</div> }
    <div class="form-actions"><a class="button ghost" href="/purchases">Отмена</a><button class="button primary">Сохранить закупку</button></div>
</EditForm>
@code {
    [Parameter] public Guid? Id { get; set; }
    private Purchase _model = new(); private List<Supplier> _suppliers = []; private List<Intermediary> _intermediaries = []; private IReadOnlyList<Product> _products = []; private bool _isNew => Id is null;
    private string? _message; private bool _receiptSuccess;
    private readonly Dictionary<Guid, ReceiptFormLine> _receiptLines = [];
    private DateTime? _receiptDate;
    private string? _receiptNote;
    private Guid _receiptId = Guid.NewGuid();
    private bool _receiving;
    private Supplier? SelectedSupplier => _model.SupplierId is null ? null : _suppliers.FirstOrDefault(x => x.Id == _model.SupplierId);
    private bool HasMoqWarning => SelectedSupplier?.Moq is > 1 && _model.Items.Any(x => (x.Quantity ?? 0) < SelectedSupplier.Moq.Value);
    protected override async Task OnParametersSetAsync() { var suppliers = Commerce.GetSuppliersAsync(); var intermediaries = Commerce.GetIntermediariesAsync(); await Task.WhenAll(suppliers, intermediaries); _suppliers = (await suppliers).ToList(); _intermediaries = (await intermediaries).ToList(); _model = Id is null ? new Purchase() : await Commerce.GetPurchaseAsync(Id.Value) ?? new Purchase(); _model.CurrencyCode = CurrencyCodes.Normalize(_model.CurrencyCode, "CNY"); if (_model.CurrencyCode == Currency.Code && _model.CnyRateUzs is null) _model.CnyRateUzs = 1; var referenced = _model.Items.Where(x => x.ProductId is not null).Select(x => x.ProductId!.Value).ToHashSet(); _products = (await Catalog.GetProductsAsync()).Where(x => x.Status != ProductStatus.Archived || referenced.Contains(x.Id)).ToList(); _receiptLines.Clear(); _receiptDate = null; _receiptNote = null; _receiptId = Guid.NewGuid(); _message = null; }
    private void AddItem() => _model.Items.Add(new PurchaseItem());
    private async Task RemoveItemAsync(PurchaseItem item) { if (await JS.InvokeAsync<bool>("confirm", $"Удалить позицию «{item.ProductName}» из закупки?")) _model.Items.Remove(item); }
    private void SupplierChanged() { _model.SupplierName = _model.SupplierId is null ? null : _suppliers.FirstOrDefault(x => x.Id == _model.SupplierId)?.Name; }
    private void IntermediaryChanged() { _model.IntermediaryName = _model.IntermediaryId is null ? null : _intermediaries.FirstOrDefault(x => x.Id == _model.IntermediaryId)?.Name; }
    private void ProductChanged(PurchaseItem item, Product? product) { if (product is null) { item.ProductId = null; item.ProductVariantId = null; return; } if (_model.Items.All(x => x.Id == item.Id || x.ProductId is null)) { _model.CurrencyCode = CurrencyCodes.Normalize(product.PurchaseCurrencyCode, "CNY"); _model.CnyRateUzs = product.CnyRateUzs; PurchaseCurrencyChanged(); } item.ProductId = product.Id; item.ProductName = product.Name; item.UnitPriceCny = product.PurchasePriceCny; var variant = product.Variants.FirstOrDefault(); if (variant is not null) { item.ProductVariantId = variant.Id; item.Color = variant.Color; item.Size = variant.Size; } }
    private void PurchaseCurrencyChanged() { _model.CurrencyCode = CurrencyCodes.Normalize(_model.CurrencyCode, "CNY"); if (_model.CurrencyCode == Currency.Code) _model.CnyRateUzs = 1; }
    private async Task SaveAsync() { PurchaseCurrencyChanged(); await Commerce.UpsertPurchaseAsync(_model); Navigation.NavigateTo("/purchases"); }
    private ReceiptFormLine ReceiptInput(Guid itemId) { if (!_receiptLines.TryGetValue(itemId, out var value)) _receiptLines[itemId] = value = new(); return value; }
    private async Task ReceiveAsync() { if (_receiving) return; _receiving = true; try { await Commerce.UpsertPurchaseAsync(_model); var input = _receiptLines.Select(x => new PurchaseReceiptInput(x.Key, x.Value.ReceivedQuantity ?? 0, x.Value.DefectQuantity ?? 0)); var result = await Receiving.ReceiveAsync(_model, input, _receiptId, _receiptDate is null ? null : new DateTimeOffset(_receiptDate.Value.Date, TimeZoneInfo.Local.GetUtcOffset(_receiptDate.Value.Date)), _receiptNote); _receiptLines.Clear(); _receiptDate = null; _receiptNote = null; _receiptId = Guid.NewGuid(); _message = $"Приёмка сохранена. На склад добавлено {result.AddedUnits} шт. в {result.UpdatedProducts} товарах. Пропущено позиций: {result.SkippedItems}."; _receiptSuccess = true; } catch (Exception exception) { _message = $"Ошибка приёмки: {exception.Message}"; _receiptSuccess = false; } finally { _receiving = false; } }
    private sealed class ReceiptFormLine { public int? ReceivedQuantity { get; set; } public int? DefectQuantity { get; set; } }
    private static string ReceiptSummary(PurchaseReceipt receipt) => string.Join("; ", receipt.Lines.Select(x => $"{x.ProductName}: {x.ReceivedQuantity} шт.{(x.DefectQuantity > 0 ? $" (брак {x.DefectQuantity})" : "")}"));
    private string Money(decimal value) => Currency.Format(value);
}
