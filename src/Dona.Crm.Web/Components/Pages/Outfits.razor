@page "/outfits"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
<PageTitle>Образы — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Подборки</span><h1>Готовые образы</h1><p>Сеты одежды с общей стоимостью.</p></div><a class="button primary" href="/outfits/new">＋ Добавить</a></div>
<div class="metric-grid compact-metrics"><div class="metric-card accent"><span>Образов</span><strong>@_items.Count</strong><small>всего сохранено</small></div><div class="metric-card"><span>Активных</span><strong>@_items.Count(x=>x.Status==MarketingStatus.Active)</strong><small>готовы к публикации</small></div><div class="metric-card"><span>Средний чек</span><strong>@Money(_items.Count==0?0:_items.Average(x=>x.TotalPriceUzs))</strong><small>по снимкам цен</small></div><div class="metric-card"><span>Товаров</span><strong>@_items.Sum(x=>x.Products.Count)</strong><small>в образах</small></div></div>
<div class="toolbar"><input class="search" placeholder="Название или повод" @bind="_query" @bind:event="oninput"/><select @bind="_status"><option value="">Все статусы</option>@foreach(var status in Enum.GetValues<MarketingStatus>()){<option value="@status">@status.Display()</option>}</select></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@Filtered.Count() образов</strong></div>@foreach(var item in Filtered.OrderBy(x=>x.Name)){<a class="simple-list-row" href="/outfits/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name)?"?":item.Name[..1])</span><span><strong>@item.Name</strong><small>@item.Products.Count позиций · @Money(item.TotalPriceUzs) · @(item.Occasion??"без повода")</small></span><em>→</em></a>}@if(!Filtered.Any()){<div class="empty-state">Образы не найдены. Измените параметры фильтра.</div>}</section>
@code { private IReadOnlyList<Outfit> _items=[];private string _query=string.Empty;private string _status=string.Empty;private IEnumerable<Outfit> Filtered=>_items.Where(x=>(string.IsNullOrWhiteSpace(_query)||x.Name.Contains(_query,StringComparison.OrdinalIgnoreCase)||(x.Occasion?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(_status)||x.Status.ToString()==_status));protected override async Task OnInitializedAsync()=>_items=await Marketing.GetOutfitsAsync();private static string Money(decimal value)=>$"{value:N0} сум"; }
