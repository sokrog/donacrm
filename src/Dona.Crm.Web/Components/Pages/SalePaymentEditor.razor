@page "/sales/{SaleId:guid}/payments/new"
@attribute [StreamRendering]
@inject ISalesRepository Sales
@inject SalesPaymentService PaymentService
@inject NavigationManager Navigation

<PageTitle>Новый платёж — Dona CRM</PageTitle>

<div class="page-heading"><div><a class="back-link" href="/sales/@SaleId">← Продажа</a><h1>Новый платёж</h1><p>@(_sale is null ? "Загрузка заказа" : $"Заказ {_sale.Number}: оплата или фактический возврат денег")</p></div></div>

@if (_sale is not null)
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-errors" />
        <section class="panel form-section payment-form">
            <div class="section-title"><span>01</span><div><h2>Операция</h2><p>Каждая оплата сохраняется отдельной строкой</p></div></div>
            <div class="form-grid">
                <label>Тип<InputSelect @bind-Value="_model.Type"><option value="">Выберите тип</option>@foreach (var type in Enum.GetValues<PaymentOperationType>()) { <option value="@type">@type.Display()</option> }</InputSelect></label>
                <label>Статус<InputSelect @bind-Value="_model.Status"><option value="">Выберите статус</option>@foreach (var status in Enum.GetValues<PaymentStatus>()) { <option value="@status">@status.Display()</option> }</InputSelect></label>
                <label>Способ<InputSelect @bind-Value="_model.Method"><option value="">Выберите способ</option>@foreach (var method in Enum.GetValues<PaymentMethod>()) { <option value="@method">@method.Display()</option> }</InputSelect></label>
                <label>Сумма, сум<InputNumber @bind-Value="_model.AmountUzs" /></label>
                <label>Осталось оплатить<div class="readonly-field">@Money(_sale.BalanceDueUzs)</div></label>
                <label>Осталось вернуть<div class="readonly-field">@Money(_sale.RefundDueUzs)</div></label>
                <label class="span-2">Номер операции или чека<InputText @bind-Value="_model.Reference" /></label>
                <label class="span-2">Комментарий<InputTextArea @bind-Value="_model.Notes" /></label>
            </div>
        </section>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="notice error">@_error</div> }
        <div class="form-actions"><a class="button ghost" href="/sales/@SaleId">Отмена</a><button class="button primary" disabled="@_saving">@(_saving ? "Сохраняем…" : "Сохранить платёж")</button></div>
    </EditForm>
}

@code {
    [Parameter] public Guid SaleId { get; set; }
    private Sale? _sale;
    private SalePayment _model = new();
    private bool _saving;
    private string? _error;
    protected override async Task OnParametersSetAsync() { _sale = await Sales.GetSaleAsync(SaleId); _model = new SalePayment(); if (_sale is null) Navigation.NavigateTo("/not-found"); }
    private async Task SaveAsync() { if (_sale is null || _saving) return; _saving = true; try { await PaymentService.AddAsync(_sale, _model); Navigation.NavigateTo($"/sales/{SaleId}"); } catch (Exception exception) { _error = exception.Message; } finally { _saving = false; } }
    private static string Money(decimal value) => $"{value:N0} сум";
}
