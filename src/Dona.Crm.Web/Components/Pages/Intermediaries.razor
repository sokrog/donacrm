@page "/intermediaries"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
@inject IntermediaryAnalyticsService Analytics
@inject CurrencyContext Currency

<PageTitle>Посредники — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Логистика</span><h1>Посредники</h1><p>Условия и фактические показатели доставки товара из Китая.</p></div><a class="button primary" href="/intermediaries/new">＋ Добавить</a></div>
<div class="toolbar"><input class="search" placeholder="Название, компания или контакт" @bind="_query" @bind:event="oninput" /><select @bind="_rating"><option value="">Любой рейтинг</option><option value="4">От 4</option><option value="4.5">От 4,5</option></select><select @bind="_import"><option value="">Любой тип импорта</option><option value="official">Официальный импорт</option><option value="cargo">Без официального импорта</option></select></div>
<section class="panel table-panel">
    <div class="simple-list-header"><strong>@Filtered.Count() посредников</strong></div>
    @foreach (var item in Filtered.OrderBy(x => x.Name))
    {
        var actual = Actual(item.Id);
        <a class="simple-list-row intermediary-list-row" href="/intermediaries/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name[..1])</span><span><strong>@item.Name</strong><small>@(item.Company ?? "Без компании") · @(item.RatePerKgUsd is null ? "тариф не указан" : $"${item.RatePerKgUsd}/кг") · факт @(actual?.AverageShippingPerKgUzs is > 0 ? $"{Currency.Format(actual.AverageShippingPerKgUzs)}/кг" : "—") · @Delay(actual)</small></span><em class="reliability @ScoreClass(actual?.ReliabilityScore)">@Score(actual?.ReliabilityScore)</em></a>
    }
    @if (!Filtered.Any()) { <div class="empty-state">Посредники не найдены. Измените параметры фильтра.</div> }
</section>

@code {
    private IReadOnlyList<Intermediary> _items = []; private IReadOnlyList<IntermediaryAnalytics> _analytics = []; private string _query = string.Empty; private string _rating = string.Empty; private string _import = string.Empty;
    private IEnumerable<Intermediary> Filtered => _items.Where(x => (string.IsNullOrWhiteSpace(_query) || x.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) || (x.Company?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false) || (x.ContactName?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false) || (x.Telegram?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false)) && (string.IsNullOrWhiteSpace(_rating) || x.Rating >= decimal.Parse(_rating, System.Globalization.CultureInfo.InvariantCulture)) && (_import switch { "official" => x.OfficialImport, "cargo" => !x.OfficialImport, _ => true }));
    protected override async Task OnInitializedAsync() { var items = Repository.GetIntermediariesAsync(); var purchases = Repository.GetPurchasesAsync(); await Task.WhenAll(items, purchases); _items = await items; _analytics = Analytics.Calculate(_items, await purchases); }
    private IntermediaryAnalytics? Actual(Guid id) => _analytics.FirstOrDefault(x => x.IntermediaryId == id);
    private static string Score(decimal? value) => value is null ? "—" : $"{value:N0}";
    private static string ScoreClass(decimal? value) => value switch { >= 85 => "excellent", >= 70 => "good", >= 50 => "warning", null => "neutral", _ => "poor" };
    private static string Delay(IntermediaryAnalytics? value) => value is null || value.DeliverySamples == 0 ? "сроки без данных" : value.AverageDelayDays <= 0 ? $"в срок {value.OnTimePercent:N0}%" : $"задержка +{value.AverageDelayDays:N1} дн.";
}
