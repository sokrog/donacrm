@page "/intermediaries"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
<PageTitle>Посредники — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Логистика</span><h1>Посредники</h1><p>Выкуп, склады и доставка товара из Китая.</p></div><a class="button primary" href="/intermediaries/new">＋ Добавить</a></div>
<div class="toolbar"><input class="search" placeholder="Название, компания или контакт" @bind="_query" @bind:event="oninput"/><select @bind="_rating"><option value="">Любой рейтинг</option><option value="4">От 4</option><option value="4.5">От 4,5</option></select><select @bind="_import"><option value="">Любой тип импорта</option><option value="official">Официальный импорт</option><option value="cargo">Без официального импорта</option></select></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@Filtered.Count() посредников</strong></div>@foreach(var item in Filtered.OrderBy(x=>x.Name)){<a class="simple-list-row" href="/intermediaries/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name)?"?":item.Name[..1])</span><span><strong>@item.Name</strong><small>@(item.Company??"Без компании") · @(item.RatePerKgUsd is null?"тариф не указан":$"${item.RatePerKgUsd}/кг") · рейтинг @(item.Rating?.ToString("0.0")??"—")</small></span><em>→</em></a>}@if(!Filtered.Any()){<div class="empty-state">Посредники не найдены. Измените параметры фильтра.</div>}</section>
@code { private IReadOnlyList<Intermediary> _items=[];private string _query=string.Empty;private string _rating=string.Empty;private string _import=string.Empty;private IEnumerable<Intermediary> Filtered=>_items.Where(x=>(string.IsNullOrWhiteSpace(_query)||x.Name.Contains(_query,StringComparison.OrdinalIgnoreCase)||(x.Company?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false)||(x.ContactName?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false)||(x.Telegram?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(_rating)||x.Rating>=decimal.Parse(_rating,System.Globalization.CultureInfo.InvariantCulture))&&(_import switch{"official"=>x.OfficialImport,"cargo"=>!x.OfficialImport,_=>true}));protected override async Task OnInitializedAsync()=>_items=await Repository.GetIntermediariesAsync(); }
