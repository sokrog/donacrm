@page "/intermediaries"
@attribute [StreamRendering]
@inject ICommerceRepository Repository

<PageTitle>Посредники — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Логистика</span><h1>Посредники</h1><p>Выкуп, склады и доставка товара из Китая.</p></div><button class="button primary" @onclick="NewIntermediary">＋ Добавить</button></div>

<div class="master-detail">
    <section class="panel table-panel">
        <div class="simple-list-header"><strong>@_items.Count посредников</strong></div>
        @foreach (var item in _items.OrderBy(x => x.Name))
        {
            <button class="simple-list-row @(item.Id == _model.Id ? "selected" : null)" @onclick="() => Edit(item)">
                <span class="product-thumb">@item.Name[..1]</span><span><strong>@item.Name</strong><small>@(item.Company ?? "Без компании") · @(item.RatePerKgUsd is null ? "тариф не указан" : $"${item.RatePerKgUsd}/кг")</small></span><em>→</em>
            </button>
        }
        @if (_items.Count == 0) { <div class="empty-state">Добавьте первого посредника.</div> }
    </section>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section sticky-card">
        <DataAnnotationsValidator />
        <div class="section-title"><span>⇄</span><div><h2>@(_isNew ? "Новый посредник" : "Редактирование")</h2><p>Контакты и условия доставки</p></div></div>
        <div class="stack-form">
            <label>Название<InputText @bind-Value="_model.Name" /><ValidationMessage For="() => _model.Name" /></label>
            <label>Компания<InputText @bind-Value="_model.Company" /></label>
            <label>Адрес склада в Китае<InputTextArea @bind-Value="_model.ChinaWarehouseAddress" /></label>
            <div class="form-grid"><label>Контактное лицо<InputText @bind-Value="_model.ContactName" /></label><label>Телефон<InputText @bind-Value="_model.Phone" /></label></div>
            <div class="form-grid"><label>Telegram<InputText @bind-Value="_model.Telegram" /></label><label>WeChat<InputText @bind-Value="_model.WeChat" /></label></div>
            <div class="form-grid"><label>Тариф, $/кг<InputNumber @bind-Value="_model.RatePerKgUsd" step="0.01" /></label><label>Комиссия, %<InputNumber @bind-Value="_model.CommissionPercent" step="0.1" /></label></div>
            <div class="form-grid"><label>Минимальный вес, кг<InputNumber @bind-Value="_model.MinimumWeightKg" step="0.1" /></label><label>Срок, дней<InputNumber @bind-Value="_model.EstimatedDays" /></label></div>
            <label class="toggle-row"><InputCheckbox @bind-Value="_model.OfficialImport" /><span><strong>Официальный импорт</strong><small>Посредник предоставляет документы</small></span></label>
            <label>Заметки<InputTextArea @bind-Value="_model.Notes" /></label>
        </div>
        @if (_confirmDelete) { <div class="delete-confirmation"><span>Удалить посредника?</span><button type="button" class="button ghost" @onclick="() => _confirmDelete = false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div> }
        <div class="settings-actions"><button type="button" class="button ghost" @onclick="NewIntermediary">Очистить</button>@if (!_isNew) { <button type="button" class="button danger-button" @onclick="() => _confirmDelete = true">Удалить</button> }<button class="button primary">Сохранить</button></div>
    </EditForm>
</div>

@code {
    private List<Intermediary> _items = [];
    private Intermediary _model = new();
    private bool _isNew = true;
    private bool _confirmDelete;
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync() => _items = (await Repository.GetIntermediariesAsync()).ToList();
    private void NewIntermediary() { _model = new Intermediary(); _isNew = true; _confirmDelete = false; }
    private void Edit(Intermediary item) { _model = item; _isNew = false; _confirmDelete = false; }
    private async Task SaveAsync() { await Repository.UpsertIntermediaryAsync(_model); await ReloadAsync(); _isNew = false; }
    private async Task DeleteAsync() { await Repository.DeleteIntermediaryAsync(_model.Id); await ReloadAsync(); NewIntermediary(); }
}
