@page "/intermediaries"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
<PageTitle>Посредники — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Логистика</span><h1>Посредники</h1><p>Выкуп, склады и доставка товара из Китая.</p></div><a class="button primary" href="/intermediaries/new">＋ Добавить</a></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@_items.Count посредников</strong></div>@foreach(var item in _items.OrderBy(x=>x.Name)){<a class="simple-list-row" href="/intermediaries/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name)?"?":item.Name[..1])</span><span><strong>@item.Name</strong><small>@(item.Company??"Без компании") · @(item.RatePerKgUsd is null?"тариф не указан":$"${item.RatePerKgUsd}/кг") · рейтинг @(item.Rating?.ToString("0.0")??"—")</small></span><em>→</em></a>}@if(_items.Count==0){<div class="empty-state">Добавьте первого посредника.</div>}</section>
@code { private IReadOnlyList<Intermediary> _items=[]; protected override async Task OnInitializedAsync()=>_items=await Repository.GetIntermediariesAsync(); }
