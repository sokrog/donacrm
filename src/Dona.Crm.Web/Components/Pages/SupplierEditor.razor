@page "/suppliers/new"
@page "/suppliers/{Id:guid}"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
@inject IPurchaseHistoryRepository PurchaseHistory
@inject SupplierAnalyticsService AnalyticsService
@inject NavigationManager Navigation
@inject CurrencyContext Currency

<PageTitle>@(_isNew ? "Новый поставщик" : _model.Name) — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/suppliers">← Поставщики</a><h1>@(_isNew ? "Новый поставщик" : _model.Name)</h1><p>Условия работы, контакты и фактическая надёжность магазина.</p></div></div>

<EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section narrow-panel">
    <DataAnnotationsValidator />
    <div class="section-title"><span>S</span><div><h2>Карточка поставщика</h2><p>@(_isNew ? "Все поля новой записи изначально пустые" : "Контакты и условия работы")</p></div></div>
    <div class="stack-form">
        <label>Название<InputText @bind-Value="_model.Name" /><ValidationMessage For="() => _model.Name" /></label>
        <div class="form-grid"><label>Площадка<InputSelect @bind-Value="_model.Platform"><option value="">Выберите площадку</option><option>1688</option><option>Taobao</option><option>Alibaba</option><option>Pinduoduo</option><option>Другая</option></InputSelect></label><label>MOQ<InputNumber @bind-Value="_model.Moq" /></label></div>
        <label>Ссылка магазина<InputText @bind-Value="_model.StoreUrl" /></label>
        <div class="form-grid"><label>Рейтинг магазина<InputNumber @bind-Value="_model.Rating" step="0.1" /></label><label>WeChat<InputText @bind-Value="_model.WeChat" /></label></div>
        <label>Контакт<InputText @bind-Value="_model.Contact" /></label><label>Заметки<InputTextArea @bind-Value="_model.Notes" /></label>
    </div>
    @if (_confirmDelete) { <div class="delete-confirmation"><span>Удалить поставщика?</span><button type="button" class="button ghost" @onclick="() => _confirmDelete = false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div> }
    <div class="form-actions"><a class="button ghost" href="/suppliers">Отмена</a>@if (!_isNew) { <button type="button" class="button danger-button" @onclick="() => _confirmDelete = true">Удалить</button> }<button class="button primary">Сохранить</button></div>
</EditForm>

@if (!_isNew && _analytics is not null)
{
    <div class="section-break"><span class="eyebrow">Фактические показатели</span><h2>Надёжность поставщика</h2></div>
    <div class="metric-grid compact-metrics">
        <div class="metric-card accent"><span>Рейтинг надёжности</span><strong>@Score(_analytics.ReliabilityScore)</strong><small>рассчитан по фактическим закупкам</small></div>
        <div class="metric-card"><span>Брак</span><strong>@Percent(_analytics.DefectRatePercent)</strong><small>@_analytics.DefectQuantity из @_analytics.ReceivedQuantity полученных единиц</small></div>
        <div class="metric-card"><span>Полнота поставок</span><strong>@Percent(_analytics.CompletenessPercent)</strong><small>@_analytics.ReceivedQuantity из @_analytics.OrderedQuantity заказанных</small></div>
        <div class="metric-card"><span>Соблюдение срока</span><strong>@Delay(_analytics)</strong><small>@_analytics.DeliverySamples поставок с плановой датой</small></div>
    </div>
    <div class="supplier-detail-grid">
        <section class="panel table-panel supplier-purchases-table">
            <div class="panel-header"><div><h2>Закупки</h2><p>Документы, использованные в расчёте.</p></div></div>
            <div class="data-table"><div class="table-header"><span>Номер</span><span>Дата</span><span>Статус</span><span>Заказано</span><span>Получено</span><span>Брак</span></div>
                @foreach (var purchase in _purchases.OrderByDescending(x => x.OrderedAt)) { <a class="table-row" href="/purchases/@purchase.Id"><span><strong>@purchase.Number</strong></span><span>@purchase.OrderedAt.ToLocalTime().ToString("dd.MM.yyyy")</span><span>@purchase.Status.Display()</span><span>@purchase.TotalQuantity</span><span>@purchase.Receipts.Sum(x => x.ReceivedQuantity)</span><span>@purchase.Receipts.Sum(x => x.DefectQuantity)</span></a> }
            </div>
            @if (_purchases.Count == 0) { <div class="empty-state small">Закупок пока нет.</div> }
        </section>
        <section class="panel supplier-price-history">
            <div class="panel-header"><div><h2>Последние цены</h2><p>Фактическая себестоимость при приёмке.</p></div></div>
            @foreach (var item in _costs.OrderByDescending(x => x.RecordedAt).Take(10)) { <div class="supplier-price-row"><span><strong>@item.ProductName</strong><small>@item.RecordedAt.ToLocalTime().ToString("dd.MM.yyyy") · @item.Sku</small></span><span><strong>@Currency.SourceAmount(item.UnitPriceCny, item.CurrencyCode)</strong><small>@Currency.Format(item.UnitLandedCostUzs)</small></span></div> }
            @if (_costs.Count == 0) { <div class="empty-state small">Цены появятся после приёмки.</div> }
        </section>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private Supplier _model = new(); private bool _confirmDelete; private SupplierAnalytics? _analytics; private List<Purchase> _purchases = []; private List<ProductCostHistoryEntry> _costs = [];
    private bool _isNew => Id is null;
    protected override async Task OnParametersSetAsync()
    {
        _analytics = null; _purchases = []; _costs = []; _confirmDelete = false;
        if (_isNew) { _model = new Supplier(); return; }
        var suppliers = Repository.GetSuppliersAsync(); var purchases = Repository.GetPurchasesAsync(); var history = PurchaseHistory.GetAsync();
        await Task.WhenAll(suppliers, purchases, history);
        _model = (await suppliers).FirstOrDefault(x => x.Id == Id) ?? new Supplier();
        _purchases = (await purchases).Where(x => x.SupplierId == _model.Id || (x.SupplierId is null && x.SupplierName?.Equals(_model.Name, StringComparison.OrdinalIgnoreCase) == true)).ToList();
        var data = await history; _costs = data.ProductCosts.Where(x => x.SupplierId == _model.Id || (x.SupplierId is null && x.SupplierName.Equals(_model.Name, StringComparison.OrdinalIgnoreCase))).ToList();
        _analytics = AnalyticsService.Calculate([_model], _purchases, data).Single();
    }
    private async Task SaveAsync() { await Repository.UpsertSupplierAsync(_model); Navigation.NavigateTo("/suppliers"); }
    private async Task DeleteAsync() { await Repository.DeleteSupplierAsync(_model.Id); Navigation.NavigateTo("/suppliers"); }
    private static string Percent(decimal value) => $"{value:N1}%";
    private static string Score(decimal? value) => value is null ? "—" : $"{value:N0}/100";
    private static string Delay(SupplierAnalytics value) => value.DeliverySamples == 0 ? "—" : value.AverageDelayDays <= 0 ? "В срок" : $"+{value.AverageDelayDays:N1} дн.";
}
