@page "/suppliers/new"
@page "/suppliers/{Id:guid}"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
@inject NavigationManager Navigation
<PageTitle>Поставщик — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/suppliers">← Поставщики</a><h1>@(_isNew ? "Новый поставщик" : _model.Name)</h1><p>Условия работы и контакты магазина.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section narrow-panel"><DataAnnotationsValidator/><div class="section-title"><span>S</span><div><h2>Карточка поставщика</h2><p>Все поля новой записи изначально пустые</p></div></div><div class="stack-form"><label>Название<InputText @bind-Value="_model.Name"/><ValidationMessage For="() => _model.Name"/></label><div class="form-grid"><label>Площадка<InputSelect @bind-Value="_model.Platform"><option value="">Выберите площадку</option><option>1688</option><option>Taobao</option><option>Alibaba</option><option>Pinduoduo</option><option>Другая</option></InputSelect></label><label>MOQ<InputNumber @bind-Value="_model.Moq"/></label></div><label>Ссылка магазина<InputText @bind-Value="_model.StoreUrl"/></label><div class="form-grid"><label>Рейтинг<InputNumber @bind-Value="_model.Rating" step="0.1"/></label><label>WeChat<InputText @bind-Value="_model.WeChat"/></label></div><label>Контакт<InputText @bind-Value="_model.Contact"/></label><label>Заметки<InputTextArea @bind-Value="_model.Notes"/></label></div>@if(_confirmDelete){<div class="delete-confirmation"><span>Удалить поставщика?</span><button type="button" class="button ghost" @onclick="()=>_confirmDelete=false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div>}<div class="form-actions"><a class="button ghost" href="/suppliers">Отмена</a>@if(!_isNew){<button type="button" class="button danger-button" @onclick="()=>_confirmDelete=true">Удалить</button>}<button class="button primary">Сохранить</button></div></EditForm>
@code { [Parameter]public Guid? Id{get;set;} private Supplier _model=new(); private bool _confirmDelete; private bool _isNew=>Id is null; protected override async Task OnParametersSetAsync()=>_model=Id is null?new Supplier():(await Repository.GetSuppliersAsync()).FirstOrDefault(x=>x.Id==Id)??new Supplier(); private async Task SaveAsync(){await Repository.UpsertSupplierAsync(_model);Navigation.NavigateTo("/suppliers");} private async Task DeleteAsync(){await Repository.DeleteSupplierAsync(_model.Id);Navigation.NavigateTo("/suppliers");} }
