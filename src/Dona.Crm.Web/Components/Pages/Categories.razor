@page "/categories"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
<PageTitle>Категории — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Справочник</span><h1>Категории</h1><p>Категории доступны при заполнении каталога.</p></div><a class="button primary" href="/categories/new">＋ Добавить</a></div>
<section class="panel table-panel narrow-panel"><div class="simple-list-header"><strong>@_items.Count категорий</strong></div>@foreach(var item in _items.OrderBy(x=>x.SortOrder)){<a class="simple-list-row" href="/categories/@item.Id"><span class="product-thumb">◇</span><span><strong>@item.Name</strong><small>Порядок @(item.SortOrder?.ToString()??"—") · @(item.IsActive?"активна":"скрыта")</small></span><em>→</em></a>}</section>
@code { private IReadOnlyList<Category> _items=[]; protected override async Task OnInitializedAsync()=>_items=await Repository.GetCategoriesAsync(); }
