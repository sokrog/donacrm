@page "/"
@attribute [StreamRendering]
@inject ICatalogRepository Repository

<PageTitle>Обзор — Dona CRM</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Сегодня</span><h1>Обзор магазина</h1><p>Главные цифры каталога в одном месте.</p></div>
    <a class="button primary" href="/products/new">＋ Добавить товар</a>
</div>

@if (_products is null)
{
    <div class="loading">Загружаем данные…</div>
}
else
{
    <section class="metric-grid">
        <article class="metric-card accent"><span>Всего товаров</span><strong>@_products.Count</strong><small>@_products.Sum(x => x.Quantity) единиц на складе</small></article>
        <article class="metric-card"><span>В наличии</span><strong>@_products.Count(x => x.Status == ProductStatus.InStock)</strong><small>готовы к продаже сегодня</small></article>
        <article class="metric-card"><span>Под заказ</span><strong>@_products.Count(x => x.Status == ProductStatus.OnOrder)</strong><small>без заморозки бюджета</small></article>
        <article class="metric-card"><span>Потенциальная прибыль</span><strong>@Money(_products.Sum(x => x.ProfitUzs * Math.Max(1, x.Quantity)))</strong><small>по текущим ценам</small></article>
    </section>

    <section class="panel">
        <div class="panel-header"><div><h2>Последние товары</h2><p>Недавно добавленные позиции</p></div><a href="/products">Весь каталог →</a></div>
        <div class="product-list compact">
            @foreach (var product in _products.OrderByDescending(x => x.CreatedAt).Take(5))
            {
                <div class="product-row">
                    <div class="product-thumb">@product.Name[..1]</div>
                    <div class="product-name"><strong>@product.Name</strong><small>@product.Sku · @product.Category</small></div>
                    <span class="badge @((product.Status?.ToString() ?? "none").ToLowerInvariant())">@product.Status.Display()</span>
                    <div class="number"><strong>@Money(product.SellingPriceUzs)</strong><small>прибыль @Money(product.ProfitUzs)</small></div>
                </div>
            }
        </div>
    </section>
}

@code {
    private IReadOnlyList<Product>? _products;
    protected override async Task OnInitializedAsync() => _products = await Repository.GetProductsAsync();
    private static string Money(decimal? value) => $"{value ?? 0:N0} сум";
}
