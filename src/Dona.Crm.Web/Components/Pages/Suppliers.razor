@page "/suppliers"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
<PageTitle>Поставщики — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Закупки</span><h1>Поставщики</h1><p>Магазины 1688, контакты и условия работы.</p></div><a class="button primary" href="/suppliers/new">＋ Добавить</a></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@_items.Count поставщиков</strong></div>@foreach (var item in _items.OrderBy(x => x.Name)){<a class="simple-list-row" href="/suppliers/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name[..1])</span><span><strong>@item.Name</strong><small>@item.Platform · MOQ @(item.Moq?.ToString() ?? "—") · рейтинг @(item.Rating?.ToString("0.0") ?? "—")</small></span><em>→</em></a>}@if (_items.Count == 0){<div class="empty-state">Добавьте первого поставщика.</div>}</section>
@code { private IReadOnlyList<Supplier> _items=[]; protected override async Task OnInitializedAsync()=>_items=await Repository.GetSuppliersAsync(); }
