@page "/suppliers"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
@inject IPurchaseHistoryRepository PurchaseHistory
@inject SupplierAnalyticsService Analytics
<PageTitle>Поставщики — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Закупки</span><h1>Поставщики</h1><p>Магазины 1688, контакты и условия работы.</p></div><a class="button primary" href="/suppliers/new">＋ Добавить</a></div>
<div class="toolbar"><input class="search" placeholder="Название, контакт или WeChat" @bind="_query" @bind:event="oninput"/><select @bind="_platform"><option value="">Все площадки</option>@foreach(var platform in Platforms){<option value="@platform">@platform</option>}</select><select @bind="_rating"><option value="">Любой рейтинг</option><option value="4">От 4</option><option value="4.5">От 4,5</option></select></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@Filtered.Count() поставщиков</strong></div>@foreach (var item in Filtered.OrderBy(x => x.Name)){var actual=Actual(item.Id);<a class="simple-list-row supplier-list-row" href="/suppliers/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name[..1])</span><span><strong>@item.Name</strong><small>@item.Platform · MOQ @(item.Moq?.ToString() ?? "—") · брак @(actual is null ? "—" : $"{actual.DefectRatePercent:N1}%") · получено @(actual is null ? "—" : $"{actual.CompletenessPercent:N1}%")</small></span><em class="reliability @ScoreClass(actual?.ReliabilityScore)">@Score(actual?.ReliabilityScore)</em></a>}@if (!Filtered.Any()){<div class="empty-state">Поставщики не найдены. Измените параметры фильтра.</div>}</section>
@code { private IReadOnlyList<Supplier> _items=[];private IReadOnlyList<SupplierAnalytics> _analytics=[];private string _query=string.Empty;private string _platform=string.Empty;private string _rating=string.Empty;private IEnumerable<string> Platforms=>_items.Select(x=>x.Platform).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Order();private IEnumerable<Supplier> Filtered=>_items.Where(x=>(string.IsNullOrWhiteSpace(_query)||x.Name.Contains(_query,StringComparison.OrdinalIgnoreCase)||(x.Contact?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false)||(x.WeChat?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(_platform)||x.Platform.Equals(_platform,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(_rating)||x.Rating>=decimal.Parse(_rating,System.Globalization.CultureInfo.InvariantCulture)));protected override async Task OnInitializedAsync(){var suppliers=Repository.GetSuppliersAsync();var purchases=Repository.GetPurchasesAsync();var history=PurchaseHistory.GetAsync();await Task.WhenAll(suppliers,purchases,history);_items=await suppliers;_analytics=Analytics.Calculate(_items,await purchases,await history);}private SupplierAnalytics? Actual(Guid id)=>_analytics.FirstOrDefault(x=>x.SupplierId==id);private static string Score(decimal? value)=>value is null?"—":$"{value:N0}";private static string ScoreClass(decimal? value)=>value switch{>=85=>"excellent",>=70=>"good",>=50=>"warning",null=>"neutral",_=>"poor"}; }
