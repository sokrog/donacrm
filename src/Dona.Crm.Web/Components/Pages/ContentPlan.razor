@page "/content-plan"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
@inject IBusinessSettingsRepository BusinessSettingsRepository
<PageTitle>Контент-план — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Instagram</span><h1>Контент-план</h1><p>Идеи, подготовка и расписание публикаций.</p></div><a class="button primary" href="/content-plan/new">＋ Добавить</a></div>
@if(OverdueCount>0){<div class="notice error">Просрочено публикаций: @OverdueCount.</div>}else if(UpcomingCount>0){<div class="notice warning">На ближайшие @_settings.ContentPlanningHorizonDays дн. запланировано публикаций: @UpcomingCount.</div>}
<div class="metric-grid compact-metrics"><div class="metric-card accent"><span>Запланировано</span><strong>@_posts.Count(x=>x.Status==ContentStatus.Planned)</strong><small>ожидают публикации</small></div><div class="metric-card"><span>Идей</span><strong>@_posts.Count(x=>x.Status is ContentStatus.Idea or null)</strong><small>в очереди</small></div><div class="metric-card"><span>Готово</span><strong>@_posts.Count(x=>x.Status==ContentStatus.Ready)</strong><small>можно публиковать</small></div><div class="metric-card"><span>Опубликовано</span><strong>@_posts.Count(x=>x.Status==ContentStatus.Published)</strong><small>за всё время</small></div></div>
<div class="toolbar"><input class="search" placeholder="Тема, коллекция или образ" @bind="_query" @bind:event="oninput"/><select @bind="_status"><option value="">Все статусы</option>@foreach(var status in Enum.GetValues<ContentStatus>()){<option value="@status">@status.Display()</option>}</select><select @bind="_type"><option value="">Все форматы</option>@foreach(var type in Enum.GetValues<ContentType>()){<option value="@type">@type.Display()</option>}</select></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@Filtered.Count публикаций</strong></div>@foreach(var post in Filtered.OrderBy(x=>x.ScheduledAt??DateTime.MaxValue).ThenByDescending(x=>x.CreatedAt)){<a class="content-list-row" href="/content-plan/@post.Id"><span class="content-date"><strong>@(post.ScheduledAt?.ToString("dd")??"—")</strong><small>@(post.ScheduledAt?.ToString("MMM")??"без даты")</small></span><span><strong>@post.Title</strong><small>@(post.Type?.Display()??"Формат не указан") · @post.Status.Display()</small></span><em>→</em></a>}@if(Filtered.Count==0){<div class="empty-state">Публикации не найдены. Измените параметры фильтра.</div>}</section>
@code { private List<ContentPost> _posts=[];private BusinessSettings _settings=new();private string _query=string.Empty;private string _status=string.Empty;private string _type=string.Empty;private IEnumerable<ContentPost> Pending=>_posts.Where(x=>x.Status is not ContentStatus.Published and not ContentStatus.Cancelled);private int OverdueCount=>Pending.Count(x=>x.ScheduledAt?.Date<DateTime.Today);private int UpcomingCount=>Pending.Count(x=>x.ScheduledAt?.Date>=DateTime.Today&&x.ScheduledAt?.Date<=DateTime.Today.AddDays(_settings.ContentPlanningHorizonDays));private List<ContentPost> Filtered=>_posts.Where(x=>(string.IsNullOrWhiteSpace(_query)||x.Title.Contains(_query,StringComparison.OrdinalIgnoreCase)||(x.CollectionName?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false)||(x.OutfitName?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(_status)||x.Status.ToString()==_status)&&(string.IsNullOrWhiteSpace(_type)||x.Type.ToString()==_type)).ToList();protected override async Task OnInitializedAsync(){var posts=Marketing.GetContentPostsAsync();var settings=BusinessSettingsRepository.GetAsync();await Task.WhenAll(posts,settings);_posts=(await posts).ToList();_settings=await settings;} }
