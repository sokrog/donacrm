@page "/content-plan"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
<PageTitle>Контент-план — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Instagram</span><h1>Контент-план</h1><p>Идеи, подготовка и расписание публикаций.</p></div><a class="button primary" href="/content-plan/new">＋ Добавить</a></div>
<div class="metric-grid compact-metrics"><div class="metric-card accent"><span>Запланировано</span><strong>@_posts.Count(x=>x.Status==ContentStatus.Planned)</strong><small>ожидают публикации</small></div><div class="metric-card"><span>Идей</span><strong>@_posts.Count(x=>x.Status is ContentStatus.Idea or null)</strong><small>в очереди</small></div><div class="metric-card"><span>Готово</span><strong>@_posts.Count(x=>x.Status==ContentStatus.Ready)</strong><small>можно публиковать</small></div><div class="metric-card"><span>Опубликовано</span><strong>@_posts.Count(x=>x.Status==ContentStatus.Published)</strong><small>за всё время</small></div></div>
<section class="panel table-panel"><div class="simple-list-header content-filter"><strong>@Filtered.Count публикаций</strong><select @bind="_filter"><option value="">Все статусы</option>@foreach(var status in Enum.GetValues<ContentStatus>()){<option value="@status">@status.Display()</option>}</select></div>@foreach(var post in Filtered.OrderBy(x=>x.ScheduledAt??DateTime.MaxValue).ThenByDescending(x=>x.CreatedAt)){<a class="content-list-row" href="/content-plan/@post.Id"><span class="content-date"><strong>@(post.ScheduledAt?.ToString("dd")??"—")</strong><small>@(post.ScheduledAt?.ToString("MMM")??"без даты")</small></span><span><strong>@post.Title</strong><small>@(post.Type?.Display()??"Формат не указан") · @post.Status.Display()</small></span><em>→</em></a>}@if(Filtered.Count==0){<div class="empty-state">Нет публикаций с выбранным статусом.</div>}</section>
@code { private List<ContentPost> _posts=[];private ContentStatus? _filter;private List<ContentPost> Filtered=>_filter is null?_posts:_posts.Where(x=>x.Status==_filter).ToList();protected override async Task OnInitializedAsync()=>_posts=(await Marketing.GetContentPostsAsync()).ToList(); }
