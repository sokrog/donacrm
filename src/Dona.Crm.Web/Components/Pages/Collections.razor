@page "/collections"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
<PageTitle>Коллекции — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Витрина</span><h1>Коллекции</h1><p>Сезонные подборки и тематические каталоги.</p></div><a class="button primary" href="/collections/new">＋ Добавить</a></div>
<div class="toolbar"><input class="search" placeholder="Название, сезон или стиль" @bind="_query" @bind:event="oninput"/><select @bind="_status"><option value="">Все статусы</option>@foreach(var status in Enum.GetValues<MarketingStatus>()){<option value="@status">@status.Display()</option>}</select></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@Filtered.Count() коллекций</strong></div>@foreach(var item in Filtered.OrderBy(x=>x.Name)){<a class="simple-list-row" href="/collections/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name)?"?":item.Name[..1])</span><span><strong>@item.Name</strong><small>@item.Products.Count товаров · @(item.Season??"сезон не указан") · @item.Status.Display()</small></span><em>→</em></a>}@if(!Filtered.Any()){<div class="empty-state">Коллекции не найдены. Измените параметры фильтра.</div>}</section>
@code { private IReadOnlyList<ProductCollection> _items=[];private string _query=string.Empty;private string _status=string.Empty;private IEnumerable<ProductCollection> Filtered=>_items.Where(x=>(string.IsNullOrWhiteSpace(_query)||x.Name.Contains(_query,StringComparison.OrdinalIgnoreCase)||(x.Season?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false)||(x.Style?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(_status)||x.Status.ToString()==_status));protected override async Task OnInitializedAsync()=>_items=await Marketing.GetCollectionsAsync(); }
