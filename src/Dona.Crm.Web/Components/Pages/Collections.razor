@page "/collections"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
<PageTitle>Коллекции — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Витрина</span><h1>Коллекции</h1><p>Сезонные подборки и тематические каталоги.</p></div><a class="button primary" href="/collections/new">＋ Добавить</a></div>
<section class="panel table-panel"><div class="simple-list-header"><strong>@_items.Count коллекций</strong></div>@foreach(var item in _items.OrderBy(x=>x.Name)){<a class="simple-list-row" href="/collections/@item.Id"><span class="product-thumb">@(string.IsNullOrWhiteSpace(item.Name)?"?":item.Name[..1])</span><span><strong>@item.Name</strong><small>@item.Products.Count товаров · @(item.Season??"сезон не указан") · @item.Status.Display()</small></span><em>→</em></a>}@if(_items.Count==0){<div class="empty-state">Создайте первую подборку товаров.</div>}</section>
@code { private IReadOnlyList<ProductCollection> _items=[]; protected override async Task OnInitializedAsync()=>_items=await Marketing.GetCollectionsAsync(); }
