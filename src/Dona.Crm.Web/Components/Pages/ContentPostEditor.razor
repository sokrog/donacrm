@page "/content-plan/new"
@page "/content-plan/{Id:guid}"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
@inject NavigationManager Navigation
<PageTitle>Публикация — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/content-plan">← Контент-план</a><h1>@(_isNew?"Новая публикация":_model.Title)</h1><p>Материал и дата выхода.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section narrow-panel"><DataAnnotationsValidator/><div class="stack-form"><label>Тема<InputText @bind-Value="_model.Title"/><ValidationMessage For="() => _model.Title"/></label><div class="form-grid"><label>Формат<InputSelect @bind-Value="_model.Type"><option value="">Не выбран</option>@foreach(var type in Enum.GetValues<ContentType>()){<option value="@type">@type.Display()</option>}</InputSelect></label><label>Статус<InputSelect @bind-Value="_model.Status"><option value="">Не указан</option>@foreach(var status in Enum.GetValues<ContentStatus>()){<option value="@status">@status.Display()</option>}</InputSelect></label></div><label>Дата публикации<InputDate @bind-Value="_model.ScheduledAt"/></label><label>Коллекция<InputSelect @bind-Value="_model.CollectionId" @bind-Value:after="CollectionChanged"><option value="">Не выбрана</option>@foreach(var item in _collections){<option value="@item.Id">@item.Name</option>}</InputSelect></label><label>Готовый образ<InputSelect @bind-Value="_model.OutfitId" @bind-Value:after="OutfitChanged"><option value="">Не выбран</option>@foreach(var item in _outfits){<option value="@item.Id">@item.Name</option>}</InputSelect></label><label>Текст публикации<InputTextArea @bind-Value="_model.Caption" class="caption-area"/></label><label>Ссылка на публикацию<InputText @bind-Value="_model.PublicationUrl"/></label><label>Заметки<InputTextArea @bind-Value="_model.Notes"/></label></div>@if(_confirmDelete){<div class="delete-confirmation"><span>Удалить публикацию?</span><button type="button" class="button ghost" @onclick="()=>_confirmDelete=false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div>}<div class="form-actions"><a class="button ghost" href="/content-plan">Отмена</a>@if(!_isNew){<button type="button" class="button danger-button" @onclick="()=>_confirmDelete=true">Удалить</button>}<button class="button primary">Сохранить</button></div></EditForm>
@code { [Parameter]public Guid? Id{get;set;}private ContentPost _model=new();private IReadOnlyList<ProductCollection> _collections=[];private IReadOnlyList<Outfit> _outfits=[];private bool _confirmDelete;private bool _isNew=>Id is null;protected override async Task OnParametersSetAsync(){var data=await Marketing.GetDataAsync();_collections=data.Collections;_outfits=data.Outfits;_model=Id is null?new ContentPost():data.ContentPosts.FirstOrDefault(x=>x.Id==Id)??new ContentPost();}private void CollectionChanged()=>_model.CollectionName=_model.CollectionId is null?null:_collections.FirstOrDefault(x=>x.Id==_model.CollectionId)?.Name;private void OutfitChanged()=>_model.OutfitName=_model.OutfitId is null?null:_outfits.FirstOrDefault(x=>x.Id==_model.OutfitId)?.Name;private async Task SaveAsync(){await Marketing.UpsertContentPostAsync(_model);Navigation.NavigateTo("/content-plan");}private async Task DeleteAsync(){await Marketing.DeleteContentPostAsync(_model.Id);Navigation.NavigateTo("/content-plan");} }
