@page "/purchase-history"
@attribute [StreamRendering]
@inject IPurchaseHistoryRepository Repository

<PageTitle>Цены и курсы — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Закупки</span><h1>Цены и курсы</h1><p>Фактическая стоимость товара в каждой приёмке и сравнение поставщиков.</p></div></div>

<div class="metric-grid compact-metrics">
    <div class="metric-card accent"><span>Принято товара</span><strong>@Filtered.Sum(x => x.Quantity) шт.</strong><small>@Filtered.Count() записей в истории</small></div>
    <div class="metric-card"><span>Последний курс CNY</span><strong>@Money(LatestRate)</strong><small>сум за 1 ¥</small></div>
    <div class="metric-card"><span>Средний курс</span><strong>@Money(AverageRate)</strong><small>по отфильтрованным приёмкам</small></div>
    <div class="metric-card"><span>Средняя себестоимость</span><strong>@Money(WeightedCost)</strong><small>сум за принятую единицу</small></div>
</div>

<div class="toolbar">
    <input class="search" placeholder="Товар, SKU или номер закупки" @bind="_query" @bind:event="oninput" />
    <select @bind="_supplier"><option value="">Все поставщики</option>@foreach (var supplier in Suppliers) { <option value="@supplier">@supplier</option> }</select>
    <label class="filter-date">С<input type="date" @bind="_from" /></label><label class="filter-date">По<input type="date" @bind="_to" /></label>
</div>

<div class="purchase-history-grid">
    <section class="panel table-panel cost-history-table">
        <div class="panel-header"><div><h2>История себестоимости</h2><p>Снимок создаётся при фактической приёмке.</p></div></div>
        <div class="data-table">
            <div class="table-header"><span>Дата</span><span>Товар</span><span>Поставщик</span><span>Закупка</span><span>Кол-во</span><span>Цена ¥</span><span>Курс</span><span>Себестоимость</span></div>
            @foreach (var item in Filtered.OrderByDescending(x => x.RecordedAt))
            {
                <div class="table-row"><span>@item.RecordedAt.ToLocalTime().ToString("dd.MM.yyyy")</span><span><a href="/products/@item.ProductId"><strong>@item.ProductName</strong><small>@item.Sku @Variant(item)</small></a></span><span>@Empty(item.SupplierName)</span><span><a href="/purchases/@item.PurchaseId">@item.PurchaseNumber</a></span><span>@item.Quantity</span><span>@item.UnitPriceCny.ToString("N2")</span><span>@Money(item.CnyRateUzs)</span><span><strong>@Money(item.UnitLandedCostUzs)</strong></span></div>
            }
        </div>
        @if (!Filtered.Any()) { <div class="empty-state">История не найдена. Она появится после приёмки закупки.</div> }
    </section>
    <section class="panel supplier-comparison">
        <div class="panel-header"><div><h2>Сравнение поставщиков</h2><p>По фактически принятым единицам.</p></div></div>
        <div class="supplier-summary-header"><span>Поставщик</span><span>Поставок</span><span>Единиц</span><span>Ср. себестоимость</span></div>
        @foreach (var supplier in SupplierComparison) { <div class="supplier-summary-row"><strong>@supplier.Name</strong><span>@supplier.Receipts</span><span>@supplier.Quantity</span><span>@Money(supplier.AverageCost)</span></div> }
        @if (SupplierComparison.Count == 0) { <div class="empty-state small">Пока недостаточно данных для сравнения.</div> }
    </section>
</div>

@code {
    private PurchaseHistoryData _data = new();
    private string _query = string.Empty; private string _supplier = string.Empty; private DateTime? _from; private DateTime? _to;
    private IEnumerable<ProductCostHistoryEntry> Filtered => _data.ProductCosts.Where(x => (string.IsNullOrWhiteSpace(_query) || x.ProductName.Contains(_query, StringComparison.OrdinalIgnoreCase) || x.Sku.Contains(_query, StringComparison.OrdinalIgnoreCase) || x.PurchaseNumber.Contains(_query, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(_supplier) || x.SupplierName == _supplier) && (_from is null || x.RecordedAt.ToLocalTime().Date >= _from.Value.Date) && (_to is null || x.RecordedAt.ToLocalTime().Date <= _to.Value.Date));
    private List<string> Suppliers => _data.ProductCosts.Select(x => x.SupplierName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToList();
    private decimal LatestRate => _data.ExchangeRates.OrderByDescending(x => x.RecordedAt).FirstOrDefault()?.RateUzs ?? 0;
    private decimal AverageRate { get { var values = Filtered.Where(x => x.CnyRateUzs > 0).ToList(); return values.Count == 0 ? 0 : Math.Round(values.Average(x => x.CnyRateUzs), 2); } }
    private decimal WeightedCost { get { var values = Filtered.ToList(); var quantity = values.Sum(x => x.Quantity); return quantity == 0 ? 0 : Math.Round(values.Sum(x => x.UnitLandedCostUzs * x.Quantity) / quantity); } }
    private List<SupplierSummary> SupplierComparison => Filtered.GroupBy(x => string.IsNullOrWhiteSpace(x.SupplierName) ? "Без поставщика" : x.SupplierName).Select(x => new SupplierSummary(x.Key, x.Select(v => v.ReceiptId).Distinct().Count(), x.Sum(v => v.Quantity), x.Sum(v => v.Quantity) == 0 ? 0 : Math.Round(x.Sum(v => v.UnitLandedCostUzs * v.Quantity) / x.Sum(v => v.Quantity)))).OrderBy(x => x.AverageCost).ToList();
    protected override async Task OnInitializedAsync() => _data = await Repository.GetAsync();
    private static string Money(decimal value) => value.ToString("N0");
    private static string Empty(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string Variant(ProductCostHistoryEntry item) => string.Join(" · ", new[] { item.Color, item.Size }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private sealed record SupplierSummary(string Name, int Receipts, int Quantity, decimal AverageCost);
}
