@page "/collections/new"
@page "/collections/{Id:guid}"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
@inject ICatalogRepository Catalog
@inject NavigationManager Navigation
<PageTitle>Коллекция — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/collections">← Коллекции</a><h1>@(_isNew?"Новая коллекция":_model.Name)</h1><p>Тема и состав подборки.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section narrow-panel"><DataAnnotationsValidator/><div class="stack-form"><label>Название<InputText @bind-Value="_model.Name"/><ValidationMessage For="() => _model.Name"/></label><label>Описание<InputTextArea @bind-Value="_model.Description"/></label><div class="form-grid"><label>Сезон<InputText @bind-Value="_model.Season"/></label><label>Стиль<InputText @bind-Value="_model.Style"/></label></div><div class="form-grid"><label>Лимит бюджета, сум<InputNumber @bind-Value="_model.BudgetLimitUzs"/></label><label>Статус<InputSelect @bind-Value="_model.Status"><option value="">Не указан</option>@foreach(var status in Enum.GetValues<MarketingStatus>()){<option value="@status">@status.Display()</option>}</InputSelect></label></div><div class="section-title compact-title"><span>＋</span><div><h2>Товары</h2><p>Порядок используется в каталоге</p></div><button type="button" class="button secondary" @onclick="AddProduct">Добавить</button></div>@foreach(var item in _model.Products){<div class="marketing-product-row" @key="item.Id"><label>Товар<select value="@item.ProductId" @onchange="e=>ProductChanged(item,e.Value?.ToString())"><option value="">Выберите товар</option>@foreach(var product in _products){<option value="@product.Id">@product.Name</option>}</select></label><button type="button" class="icon-button danger" @onclick="()=>_model.Products.Remove(item)">×</button></div>}@if(_model.Products.Count==0){<div class="empty-state small">Товары ещё не добавлены.</div>}</div>@if(_confirmDelete){<div class="delete-confirmation"><span>Удалить коллекцию?</span><button type="button" class="button ghost" @onclick="()=>_confirmDelete=false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div>}<div class="form-actions"><a class="button ghost" href="/collections">Отмена</a>@if(!_isNew){<button type="button" class="button danger-button" @onclick="()=>_confirmDelete=true">Удалить</button>}<button class="button primary">Сохранить</button></div></EditForm>
@code { [Parameter]public Guid? Id{get;set;} private ProductCollection _model=new();private IReadOnlyList<Product> _products=[];private bool _confirmDelete;private bool _isNew=>Id is null;protected override async Task OnParametersSetAsync(){var productsTask=Catalog.GetProductsAsync();var collectionsTask=Marketing.GetCollectionsAsync();await Task.WhenAll(productsTask,collectionsTask);_model=Id is null?new ProductCollection():(await collectionsTask).FirstOrDefault(x=>x.Id==Id)??new ProductCollection();var referenced=_model.Products.Where(x=>x.ProductId is not null).Select(x=>x.ProductId!.Value).ToHashSet();_products=(await productsTask).Where(x=>x.Status!=ProductStatus.Archived||referenced.Contains(x.Id)).ToList();}private void AddProduct()=>_model.Products.Add(new CollectionProduct{SortOrder=_model.Products.Count});private void ProductChanged(CollectionProduct item,string? value){item.ProductId=Guid.TryParse(value,out var id)?id:null;item.ProductName=_products.FirstOrDefault(x=>x.Id==item.ProductId)?.Name??string.Empty;}private async Task SaveAsync(){for(var i=0;i<_model.Products.Count;i++)_model.Products[i].SortOrder=i;await Marketing.UpsertCollectionAsync(_model);Navigation.NavigateTo("/collections");}private async Task DeleteAsync(){await Marketing.DeleteCollectionAsync(_model.Id);Navigation.NavigateTo("/collections");} }
