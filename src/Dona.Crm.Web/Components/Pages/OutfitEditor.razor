@page "/outfits/new"
@page "/outfits/{Id:guid}"
@attribute [StreamRendering]
@inject IMarketingRepository Marketing
@inject ICatalogRepository Catalog
@inject NavigationManager Navigation
<PageTitle>Образ — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/outfits">← Образы</a><h1>@(_isNew?"Новый образ":_model.Name)</h1><p>Состав и общая стоимость.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section narrow-panel"><DataAnnotationsValidator/><div class="stack-form"><label>Название<InputText @bind-Value="_model.Name"/><ValidationMessage For="() => _model.Name"/></label><label>Описание<InputTextArea @bind-Value="_model.Description"/></label><div class="form-grid"><label>Повод<InputText @bind-Value="_model.Occasion"/></label><label>Статус<InputSelect @bind-Value="_model.Status"><option value="">Не указан</option>@foreach(var status in Enum.GetValues<MarketingStatus>()){<option value="@status">@status.Display()</option>}</InputSelect></label></div><div class="outfit-total"><span>Стоимость образа</span><strong>@Money(_model.TotalPriceUzs)</strong></div><div class="section-title compact-title"><span>＋</span><div><h2>Состав образа</h2><p>Цена фиксируется при выборе</p></div><button type="button" class="button secondary" @onclick="AddProduct">Добавить</button></div>@foreach(var item in _model.Products){<div class="outfit-product-row" @key="item.Id"><label>Товар<select value="@item.ProductId" @onchange="e=>ProductChanged(item,e.Value?.ToString())"><option value="">Выберите товар</option>@foreach(var product in _products){<option value="@product.Id">@product.Name</option>}</select></label><label>Цена<InputNumber @bind-Value="item.SellingPriceUzs"/></label><button type="button" class="icon-button danger" @onclick="()=>_model.Products.Remove(item)">×</button></div>}</div>@if(_confirmDelete){<div class="delete-confirmation"><span>Удалить образ?</span><button type="button" class="button ghost" @onclick="()=>_confirmDelete=false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div>}<div class="form-actions"><a class="button ghost" href="/outfits">Отмена</a>@if(!_isNew){<button type="button" class="button danger-button" @onclick="()=>_confirmDelete=true">Удалить</button>}<button class="button primary">Сохранить</button></div></EditForm>
@code { [Parameter]public Guid? Id{get;set;}private Outfit _model=new();private IReadOnlyList<Product> _products=[];private bool _confirmDelete;private bool _isNew=>Id is null;protected override async Task OnParametersSetAsync(){var productsTask=Catalog.GetProductsAsync();var outfitsTask=Marketing.GetOutfitsAsync();await Task.WhenAll(productsTask,outfitsTask);_products=await productsTask;_model=Id is null?new Outfit():(await outfitsTask).FirstOrDefault(x=>x.Id==Id)??new Outfit();}private void AddProduct()=>_model.Products.Add(new OutfitProduct{SortOrder=_model.Products.Count});private void ProductChanged(OutfitProduct item,string? value){item.ProductId=Guid.TryParse(value,out var id)?id:null;var p=_products.FirstOrDefault(x=>x.Id==item.ProductId);item.ProductName=p?.Name??string.Empty;item.SellingPriceUzs=p?.SellingPriceUzs;}private async Task SaveAsync(){for(var i=0;i<_model.Products.Count;i++)_model.Products[i].SortOrder=i;await Marketing.UpsertOutfitAsync(_model);Navigation.NavigateTo("/outfits");}private async Task DeleteAsync(){await Marketing.DeleteOutfitAsync(_model.Id);Navigation.NavigateTo("/outfits");}private static string Money(decimal value)=>$"{value:N0} сум"; }
