@page "/intermediaries/new"
@page "/intermediaries/{Id:guid}"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
@inject NavigationManager Navigation
<PageTitle>Посредник — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/intermediaries">← Посредники</a><h1>@(_isNew?"Новый посредник":_model.Name)</h1><p>Контакты и условия доставки.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section narrow-panel"><DataAnnotationsValidator/><div class="section-title"><span>⇄</span><div><h2>Карточка посредника</h2><p>Склад, тариф и контакты</p></div></div><div class="stack-form"><label>Название<InputText @bind-Value="_model.Name"/><ValidationMessage For="() => _model.Name"/></label><label>Компания<InputText @bind-Value="_model.Company"/></label><label>Адрес склада в Китае<InputTextArea @bind-Value="_model.ChinaWarehouseAddress"/></label><div class="form-grid"><label>Контактное лицо<InputText @bind-Value="_model.ContactName"/></label><label>Телефон<InputText @bind-Value="_model.Phone"/></label></div><div class="form-grid"><label>Telegram<InputText @bind-Value="_model.Telegram"/></label><label>WeChat<InputText @bind-Value="_model.WeChat"/></label></div><div class="form-grid"><label>Тариф, $/кг<InputNumber @bind-Value="_model.RatePerKgUsd" step="0.01"/></label><label>Комиссия, %<InputNumber @bind-Value="_model.CommissionPercent" step="0.1"/></label></div><div class="form-grid"><label>Минимальный вес, кг<InputNumber @bind-Value="_model.MinimumWeightKg" step="0.1"/></label><label>Срок, дней<InputNumber @bind-Value="_model.EstimatedDays"/></label></div><label>Рейтинг 0–5<InputNumber @bind-Value="_model.Rating" min="0" max="5" step="0.1"/></label><label class="toggle-row"><InputCheckbox @bind-Value="_model.OfficialImport"/><span><strong>Официальный импорт</strong><small>Предоставляет документы</small></span></label><label>Заметки<InputTextArea @bind-Value="_model.Notes"/></label></div>@if(_confirmDelete){<div class="delete-confirmation"><span>Удалить посредника?</span><button type="button" class="button ghost" @onclick="()=>_confirmDelete=false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div>}<div class="form-actions"><a class="button ghost" href="/intermediaries">Отмена</a>@if(!_isNew){<button type="button" class="button danger-button" @onclick="()=>_confirmDelete=true">Удалить</button>}<button class="button primary">Сохранить</button></div></EditForm>
@code { [Parameter]public Guid? Id{get;set;} private Intermediary _model=new(); private bool _confirmDelete; private bool _isNew=>Id is null; protected override async Task OnParametersSetAsync()=>_model=Id is null?new Intermediary():(await Repository.GetIntermediariesAsync()).FirstOrDefault(x=>x.Id==Id)??new Intermediary(); private async Task SaveAsync(){await Repository.UpsertIntermediaryAsync(_model);Navigation.NavigateTo("/intermediaries");} private async Task DeleteAsync(){await Repository.DeleteIntermediaryAsync(_model.Id);Navigation.NavigateTo("/intermediaries");} }
