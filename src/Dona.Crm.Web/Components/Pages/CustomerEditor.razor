@page "/customers/new"
@page "/customers/{Id:guid}"
@attribute [StreamRendering]
@inject ISalesRepository Repository
@inject NavigationManager Navigation
<PageTitle>Клиент — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/customers">← Клиенты</a><h1>@(_isNew?"Новый клиент":_model.Name)</h1><p>Контакты и доставка.</p></div></div>
<EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel form-section narrow-panel"><DataAnnotationsValidator/><div class="section-title"><span>♙</span><div><h2>Карточка клиента</h2><p>Контакты и адрес</p></div></div><div class="stack-form"><label>Имя<InputText @bind-Value="_model.Name"/><ValidationMessage For="() => _model.Name"/></label><label>Телефон<InputText @bind-Value="_model.Phone"/></label><div class="form-grid"><label>Instagram<InputText @bind-Value="_model.Instagram"/></label><label>Telegram<InputText @bind-Value="_model.Telegram"/></label></div><label>Адрес<InputTextArea @bind-Value="_model.Address"/></label><label>Заметки<InputTextArea @bind-Value="_model.Notes"/></label></div>@if(_confirmDelete){<div class="delete-confirmation"><span>Удалить клиента?</span><button type="button" class="button ghost" @onclick="()=>_confirmDelete=false">Нет</button><button type="button" class="button danger-button" @onclick="DeleteAsync">Да</button></div>}<div class="form-actions"><a class="button ghost" href="/customers">Отмена</a>@if(!_isNew){<button type="button" class="button danger-button" @onclick="()=>_confirmDelete=true">Удалить</button>}<button class="button primary">Сохранить</button></div></EditForm>
@code { [Parameter]public Guid? Id{get;set;} private Customer _model=new(); private bool _confirmDelete; private bool _isNew=>Id is null; protected override async Task OnParametersSetAsync()=>_model=Id is null?new Customer():(await Repository.GetCustomersAsync()).FirstOrDefault(x=>x.Id==Id)??new Customer(); private async Task SaveAsync(){await Repository.UpsertCustomerAsync(_model);Navigation.NavigateTo("/customers");} private async Task DeleteAsync(){await Repository.DeleteCustomerAsync(_model.Id);Navigation.NavigateTo("/customers");} }
