@page "/products"
@attribute [StreamRendering]
@inject ICatalogRepository Repository

<PageTitle>Товары — Dona CRM</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Каталог</span><h1>Товары</h1><p>Наличие, экономика и источники закупки.</p></div>
    <a class="button primary" href="/products/new">＋ Добавить товар</a>
</div>

<div class="toolbar">
    <input class="search" placeholder="Поиск по названию или SKU" @bind="_query" @bind:event="oninput" />
    <select @bind="_status"><option value="">Все статусы</option>@foreach (var status in Enum.GetValues<ProductStatus>()) { <option value="@status">@status.Display()</option> }</select>
    <select @bind="_category"><option value="">Все категории</option>@foreach (var category in Categories) { <option value="@category">@category</option> }</select>
    <select @bind="_stock"><option value="">Любой остаток</option><option value="available">Есть в наличии</option><option value="empty">Нет в наличии</option></select>
    <label class="toolbar-toggle"><input type="checkbox" @bind="_showArchived" /> Показывать архив</label>
</div>

<section class="panel table-panel">
    <div class="data-table">
        <div class="table-header"><span>Товар</span><span>Статус</span><span>Остаток</span><span>Себестоимость</span><span>Цена</span><span>Наценка</span></div>
        @foreach (var product in FilteredProducts)
        {
            <a class="table-row" href="/products/@product.Id">
                <span class="product-cell">@if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl)) { <img class="product-list-image" src="@product.PrimaryImageUrl" alt="" loading="lazy" /> } else { <i>@(string.IsNullOrWhiteSpace(product.Name) ? "?" : product.Name[..1])</i> }<span><strong>@product.Name</strong><small>@product.Sku · @product.Category</small></span></span>
                <span><em class="badge @((product.Status?.ToString() ?? "none").ToLowerInvariant())">@product.Status.Display()</em></span>
                <span>@product.Quantity шт.</span><span>@Money(product.CostUzs)</span><span><strong>@Money(product.SellingPriceUzs)</strong></span>
                <span class="@(product.ProfitUzs >= 0 ? "positive" : "negative")">@product.MarkupPercent%</span>
            </a>
        }
    </div>
    @if (!FilteredProducts.Any()) { <div class="empty-state">Ничего не найдено. Измените фильтры или добавьте товар.</div> }
</section>

@code {
    private IReadOnlyList<Product> _products = [];
    private string _query = string.Empty;
    private string _status = string.Empty;
    private string _category = string.Empty;
    private string _stock = string.Empty;
    private bool _showArchived;
    private IEnumerable<string> Categories => _products.Select(x => x.Category).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Order();
    private IEnumerable<Product> FilteredProducts => _products.Where(x =>
        (string.IsNullOrWhiteSpace(_query) || x.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) || x.Sku.Contains(_query, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_status) || x.Status.ToString() == _status) &&
        (string.IsNullOrWhiteSpace(_category) || x.Category.Equals(_category, StringComparison.OrdinalIgnoreCase)) &&
        (_stock != "available" || x.Quantity > 0) && (_stock != "empty" || x.Quantity == 0) &&
        (_showArchived || _status == ProductStatus.Archived.ToString() || x.Status != ProductStatus.Archived));
    protected override async Task OnInitializedAsync() => _products = await Repository.GetProductsAsync();
    private static string Money(decimal? value) => $"{value ?? 0:N0} сум";
}
