@page "/sales/new"
@page "/sales/{Id:guid}"
@attribute [StreamRendering]
@inject ISalesRepository Sales
@inject ICatalogRepository Catalog
@inject SalesInventoryService Inventory
@inject IBusinessSettingsRepository BusinessSettingsRepository
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Продажа — Dona CRM</PageTitle>
<div class="page-heading"><div><a class="back-link" href="/sales">← Продажи</a><h1>@(_isNew ? "Новая продажа" : _model.Number)</h1><p>Заказ клиента и движение товара на складе.</p></div></div>
@if (!_isNew && _model.Status is not SaleStatus.Cancelled and not SaleStatus.Returned)
{
    <div class="sale-workflow">@foreach (var status in WorkflowStatuses) { <span class="@(WorkflowClass(status))">@status.Display()</span> }</div>
}

<EditForm Model="_model" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    @if (IsClosed) { <div class="notice warning">Заказ закрыт. Товары и сумма доступны только для просмотра.</div> }
    else if (_model.Status == SaleStatus.Shipped) { <div class="notice warning">Заказ уже отправлен. Изменение состава заблокировано; доступно только завершение продажи.</div> }
    <fieldset class="editor-fieldset" disabled="@IsReadOnly">
    <div class="editor-grid">
        <section class="panel form-section">
            <div class="section-title"><span>01</span><div><h2>Заказ</h2><p>Клиент, оплата и доставка</p></div></div>
            <div class="form-grid">
                <label>Номер<InputText @bind-Value="_model.Number" /><ValidationMessage For="() => _model.Number" /></label>
                <label>Статус<div class="readonly-field">@_model.Status.Display()</div></label>
                <label class="span-2">Клиент<InputSelect @bind-Value="_model.CustomerId" @bind-Value:after="CustomerChanged"><option value="">Без клиента</option>@foreach (var customer in _customers) { <option value="@customer.Id">@customer.Name</option> }</InputSelect></label>
                <label>Способ оплаты<InputSelect @bind-Value="_model.PaymentMethod"><option value="">Не выбран</option>@foreach (var method in Enum.GetValues<PaymentMethod>()) { <option value="@method">@method.Display()</option> }</InputSelect></label>
                <label>Доставка<InputSelect @bind-Value="_model.DeliveryMethod"><option value="">Не выбрана</option>@foreach (var method in Enum.GetValues<DeliveryMethod>()) { <option value="@method">@method.Display()</option> }</InputSelect></label>
                <label>Скидка, %<InputNumber @bind-Value="_model.DiscountPercent" @bind-Value:after="DiscountPercentChanged" /></label>
                <label>Скидка, сум<InputNumber @bind-Value="_model.DiscountUzs" @bind-Value:after="DiscountAmountChanged" /></label>
                <label>Стоимость доставки, сум<InputNumber @bind-Value="_model.DeliveryChargeUzs" /></label>
                <label class="span-2">Заметки<InputTextArea @bind-Value="_model.Notes" /></label>
            </div>
        </section>
        <aside class="panel economics-card">
            <div class="section-title"><span>₸</span><div><h2>Итог заказа</h2><p>@_model.TotalQuantity товаров</p></div></div>
            <div class="calculation large"><span>Товары <strong>@Money(_model.SubtotalUzs)</strong></span><span>Скидка <strong>− @Money(_model.DiscountUzs ?? 0)</strong></span><span>Доставка <strong>@Money(_model.DeliveryChargeUzs ?? 0)</strong></span><span class="total-line">К оплате <strong>@Money(_model.TotalUzs)</strong></span>@if (_model.RefundedUzs > 0) { <span>По возвратам <strong class="negative">− @Money(_model.RefundedUzs)</strong></span><span>Чистая выручка <strong>@Money(_model.NetTotalUzs)</strong></span> }@if (_model.Payments.Count > 0) { <span>Фактически оплачено <strong>@Money(_model.PaidUzs)</strong></span><span>Осталось оплатить <strong>@Money(_model.BalanceDueUzs)</strong></span>@if (_model.RefundDueUzs > 0) { <span>Нужно вернуть денег <strong class="negative">@Money(_model.RefundDueUzs)</strong></span> } }@if (!_isNew) { <span>Себестоимость <strong>@Money(_model.CostUzs)</strong></span><span>Прибыль <strong class="@(_model.ProfitUzs >= 0 ? "positive" : "negative")">@Money(_model.ProfitUzs)</strong></span> }</div>
        </aside>
        <section class="panel form-section span-all">
            <div class="section-title with-action"><span>02</span><div><h2>Товары</h2><p>Варианты и количество</p></div><button type="button" class="button secondary" @onclick="AddItem">＋ Позиция</button></div>
            @foreach (var item in _model.Items)
            {
                <div class="sale-item" @key="item.Id">
                    <label>Товар<ProductAutocomplete Products="_products" Value="item.ProductId" OnSelected="product => ProductChanged(item, product)" /></label>
                    <label>Вариант<select value="@item.ProductVariantId" @onchange="e => VariantChanged(item, e.Value?.ToString())"><option value="">Выберите вариант</option>@foreach (var variant in Variants(item)) { <option value="@variant.Id">@VariantName(variant)</option> }</select></label>
                    <label>Количество<InputNumber @bind-Value="item.Quantity" @bind-Value:after="OrderLinesChanged" /></label>
                    <label>Цена, сум<InputNumber @bind-Value="item.UnitPriceUzs" @bind-Value:after="OrderLinesChanged" /></label>
                    <div class="stock-availability"><span>Доступно</span><strong>@Available(item) шт.</strong></div>
                    <button type="button" class="icon-button danger" @onclick="() => RemoveItemAsync(item)">×</button>
                </div>
            }
            @if (_model.Items.Count == 0) { <div class="empty-state small">Добавьте товары в заказ.</div> }
        </section>
    </div>
    </fieldset>

    @if (!_isNew && _model.Returns.Count > 0)
    {
        <section class="panel form-section sale-return-history">
            <div class="section-title"><span>03</span><div><h2>История возвратов</h2><p>@_model.Returns.Count документов · @Money(_model.RefundedUzs)</p></div></div>
            @foreach (var document in _model.Returns.OrderByDescending(x => x.CreatedAt))
            {
                <div class="sale-return-history-row"><span><strong>@document.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @document.Reason</strong><small>@ReturnSummary(document)</small></span><span>Принято <strong>@document.AcceptedQuantity</strong></span><span>На склад <strong>@document.RestockedQuantity</strong></span><span>Брак <strong>@document.DefectQuantity</strong></span><span>Деньги <strong>@Money(document.RefundAmountUzs ?? 0)</strong></span></div>
            }
        </section>
    }
    @if (!_isNew && _model.Payments.Count > 0)
    {
        <section class="panel form-section sale-return-history">
            <div class="section-title"><span>04</span><div><h2>История платежей</h2><p>Оплачено @Money(_model.PaidUzs) · долг @Money(_model.BalanceDueUzs)</p></div></div>
            @foreach (var payment in _model.Payments.OrderByDescending(x => x.CreatedAt))
            {
                <div class="payment-history-row"><span><strong>@payment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @payment.Type?.Display()</strong><small>@(payment.Reference ?? payment.Notes ?? "Без комментария")</small></span><span>@payment.Method?.Display()</span><span><em class="badge">@payment.Status?.Display()</em></span><span class="@(payment.Type == PaymentOperationType.Refund ? "negative" : "positive")">@Money(payment.AmountUzs ?? 0)</span></div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="notice @(_success ? "success" : "error")">@_message</div> }
    <div class="form-actions">
        <a class="button ghost" href="/sales">Отмена</a>
        @if (!_isNew && _model.Status is SaleStatus.Draft or SaleStatus.Reserved or SaleStatus.Paid) { <button type="button" class="button ghost" @onclick="CancelAsync">Отменить заказ</button> }
        @if (!_isNew && _model.Status is SaleStatus.Draft or null) { <button type="button" class="button secondary" @onclick="ReserveAsync">Зарезервировать</button> }
        @if (!_isNew && (_model.Status is SaleStatus.Reserved or SaleStatus.Paid or SaleStatus.Shipped or SaleStatus.Completed or SaleStatus.Returned) && (_model.BalanceDueUzs > 0 || _model.RefundDueUzs > 0)) { <a class="button secondary" href="/sales/@_model.Id/payments/new">Добавить платёж</a> }
        @if (!_isNew && _model.Status is SaleStatus.Reserved or SaleStatus.Paid) { <button type="button" class="button secondary" @onclick="MarkShippedAsync">Отметить отправленным</button> }
        @if (!_isNew && _model.Status is SaleStatus.Reserved or SaleStatus.Paid or SaleStatus.Shipped) { <button type="button" class="button secondary" @onclick="CompleteAsync">Завершить продажу</button> }
        @if (!_isNew && _model.Status is SaleStatus.Completed && HasReturnableItems) { <a class="button danger-button" href="/sales/@_model.Id/returns/new">Оформить возврат</a> }
        @if (!IsReadOnly) { <button class="button primary">Сохранить</button> }
    </div>
</EditForm>

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "productId")] public Guid? ProductId { get; set; }
    private Sale _model = new();
    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<Product> _products = [];
    private bool _isNew => Id is null;
    private bool IsClosed => _model.Status is SaleStatus.Completed or SaleStatus.Cancelled or SaleStatus.Returned;
    private bool IsReadOnly => IsClosed || _model.Status == SaleStatus.Shipped;
    private bool HasReturnableItems => _model.Items.Any(x => x.SoldQuantity > x.ReturnedQuantity);
    private static readonly SaleStatus[] WorkflowStatuses = [SaleStatus.Draft, SaleStatus.Reserved, SaleStatus.Paid, SaleStatus.Shipped, SaleStatus.Completed];
    private string? _message;
    private bool _success;
    private DiscountInput _discountInput;

    protected override async Task OnParametersSetAsync()
    {
        _customers = await Sales.GetCustomersAsync();
        if (Id is null) { var existing = await Sales.GetSalesAsync(); var settings = await BusinessSettingsRepository.GetAsync(); _model = new Sale { Number = SaleNumberGenerator.Generate(existing, settings.SaleNumberPrefix, DateTimeOffset.Now) }; }
        else _model = await Sales.GetSaleAsync(Id.Value) ?? new Sale();
        InitializeDiscount();
        var allProducts = await Catalog.GetProductsAsync();
        var referencedIds = _model.Items.Where(x => x.ProductId is not null).Select(x => x.ProductId!.Value).ToHashSet();
        _products = allProducts.Where(x => x.Status != ProductStatus.Archived || referencedIds.Contains(x.Id)).ToList();
        if (_isNew && ProductId is not null && _model.Items.Count == 0)
        {
            var product = _products.FirstOrDefault(x => x.Id == ProductId);
            if (product is not null) { var item = new SaleItem { Quantity = 1 }; ProductChanged(item, product); var available = product.Variants.Where(x => x.AvailableQuantity > 0).ToList(); if (available.Count == 1) VariantChanged(item, available[0].Id.ToString()); _model.Items.Add(item); }
        }
        _message = null;
    }

    private void AddItem() => _model.Items.Add(new SaleItem());
    private async Task RemoveItemAsync(SaleItem item) { if (await JS.InvokeAsync<bool>("confirm", $"Удалить позицию «{item.ProductName}» из продажи?")) { _model.Items.Remove(item); OrderLinesChanged(); } }
    private void CustomerChanged() => _model.CustomerName = _model.CustomerId is null ? null : _customers.FirstOrDefault(x => x.Id == _model.CustomerId)?.Name;
    private IEnumerable<ProductVariant> Variants(SaleItem item) => item.ProductId is null ? [] : _products.FirstOrDefault(x => x.Id == item.ProductId)?.Variants ?? [];
    private void ProductChanged(SaleItem item, Product? product)
    {
        item.ProductId = product?.Id;
        item.ProductName = product?.Name ?? string.Empty;
        item.UnitPriceUzs = product?.SellingPriceUzs;
        item.UnitCostUzs = product?.CostUzs;
        item.ProductVariantId = null; item.Color = string.Empty; item.Size = string.Empty;
        OrderLinesChanged();
    }
    private void VariantChanged(SaleItem item, string? value)
    {
        item.ProductVariantId = Guid.TryParse(value, out var id) ? id : null;
        var variant = Variants(item).FirstOrDefault(x => x.Id == item.ProductVariantId);
        item.Color = variant?.Color ?? string.Empty; item.Size = variant?.Size ?? string.Empty;
    }
    private int Available(SaleItem item) => (Variants(item).FirstOrDefault(x => x.Id == item.ProductVariantId)?.AvailableQuantity ?? 0) + item.ReservedQuantity;
    private void InitializeDiscount()
    {
        _discountInput = _model.DiscountPercent is not null ? DiscountInput.Percent : DiscountInput.Amount;
        if (_discountInput == DiscountInput.Percent) DiscountPercentChanged(); else DiscountAmountChanged();
    }
    private void DiscountPercentChanged()
    {
        _discountInput = DiscountInput.Percent;
        _model.DiscountPercent = SaleDiscountCalculator.NormalizePercent(_model.DiscountPercent);
        _model.DiscountUzs = SaleDiscountCalculator.AmountFromPercent(_model.SubtotalUzs, _model.DiscountPercent);
    }
    private void DiscountAmountChanged()
    {
        _discountInput = DiscountInput.Amount;
        _model.DiscountUzs = SaleDiscountCalculator.NormalizeAmount(_model.SubtotalUzs, _model.DiscountUzs);
        _model.DiscountPercent = SaleDiscountCalculator.PercentFromAmount(_model.SubtotalUzs, _model.DiscountUzs);
    }
    private void OrderLinesChanged() { if (_discountInput == DiscountInput.Percent) DiscountPercentChanged(); else DiscountAmountChanged(); }
    private static string VariantName(ProductVariant variant) => $"{(string.IsNullOrWhiteSpace(variant.Color) ? "Без цвета" : variant.Color)} · {(string.IsNullOrWhiteSpace(variant.Size) ? "Без размера" : variant.Size)}";
    private string WorkflowClass(SaleStatus status) => _model.Status == status ? "active" : _model.Status is not null && _model.Status <= SaleStatus.Completed && status < _model.Status ? "done" : string.Empty;
    private async Task SaveAsync()
    {
        try
        {
            if ((await Sales.GetSalesAsync()).Any(x => x.Id != _model.Id && x.Number.Equals(_model.Number, StringComparison.OrdinalIgnoreCase))) throw new InvalidOperationException("Продажа с таким номером уже существует.");
            _model.Status ??= SaleStatus.Draft;
            if (_model.Status is SaleStatus.Reserved or SaleStatus.Paid or SaleStatus.Shipped) await Inventory.ReserveAsync(_model); else await Sales.UpsertSaleAsync(_model);
            if (_isNew) Navigation.NavigateTo($"/sales/{_model.Id}"); else { _products = await Catalog.GetProductsAsync(); Show("Заказ сохранён, резерв синхронизирован.", true); }
        }
        catch (Exception exception) { Show(exception.Message, false); }
    }
    private async Task ReserveAsync() => await RunInventoryAsync(() => Inventory.ReserveAsync(_model), "Товар зарезервирован.");
    private async Task CancelAsync() => await RunInventoryAsync(() => Inventory.CancelAsync(_model), "Заказ отменён, резерв снят.");
    private async Task MarkShippedAsync() => await RunInventoryAsync(() => Inventory.MarkShippedAsync(_model), "Заказ отмечен отправленным.");
    private async Task CompleteAsync() => await RunInventoryAsync(() => Inventory.CompleteAsync(_model), "Продажа завершена, остатки списаны.");
    private async Task RunInventoryAsync(Func<Task> action, string success) { try { await action(); _products = await Catalog.GetProductsAsync(); Show(success, true); } catch (Exception exception) { Show(exception.Message, false); } }
    private void Show(string message, bool success) { _message = message; _success = success; }
    private static string ReturnSummary(SaleReturn document) => string.Join("; ", document.Items.Select(x => $"{x.ProductName}: {x.Quantity} · {x.Disposition?.Display()}"));
    private static string Money(decimal value) => $"{value:N0} сум";
    private enum DiscountInput { Amount, Percent }
}
