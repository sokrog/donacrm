@page "/inventory"
@attribute [StreamRendering]
@inject IStockMovementRepository Repository

<PageTitle>Движения склада — Dona CRM</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Каталог и склад</span><h1>Движения склада</h1><p>История приходов, резервов, продаж, отмен и возвратов.</p></div>
</div>

<div class="metric-grid compact-metrics">
    <div class="metric-card accent"><span>Приход</span><strong>+@_items.Where(x => x.QuantityDelta > 0 && x.Type == StockMovementType.PurchaseReceipt).Sum(x => x.QuantityDelta)</strong><small>принято из закупок</small></div>
    <div class="metric-card"><span>Продано</span><strong>@Math.Abs(_items.Where(x => x.Type == StockMovementType.Sale).Sum(x => x.QuantityDelta))</strong><small>списано при завершении</small></div>
    <div class="metric-card"><span>Возвращено</span><strong>+@_items.Where(x => x.Type == StockMovementType.Return).Sum(x => x.QuantityDelta)</strong><small>возвращено на склад</small></div>
    <div class="metric-card"><span>Текущий резерв</span><strong>@_items.Sum(x => x.ReservedDelta)</strong><small>по записанным операциям</small></div>
</div>

<div class="toolbar">
    <input class="search" placeholder="Товар, SKU или документ" @bind="_query" @bind:event="oninput" />
    <select @bind="_type"><option value="">Все операции</option>@foreach (var type in Enum.GetValues<StockMovementType>()) { <option value="@type">@type.Display()</option> }</select>
    <select @bind="_source"><option value="">Все источники</option><option value="Purchase">Закупки</option><option value="Sale">Продажи</option></select>
    <label class="filter-date">С<input type="date" @bind="_from" /></label>
    <label class="filter-date">По<input type="date" @bind="_to" /></label>
</div>

<section class="panel table-panel inventory-table">
    <div class="data-table">
        <div class="table-header"><span>Дата и операция</span><span>Товар</span><span>Вариант</span><span>Остаток</span><span>Резерв</span><span>Документ</span></div>
        @foreach (var item in Filtered.OrderByDescending(x => x.CreatedAt))
        {
            <div class="table-row">
                <span><strong>@item.Type.Display()</strong><small>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></span>
                <span><a href="/products/@item.ProductId"><strong>@item.ProductName</strong><small>@item.Sku</small></a></span>
                <span>@Variant(item)</span>
                <span class="@DeltaClass(item.QuantityDelta)">@Delta(item.QuantityDelta)</span>
                <span class="@DeltaClass(item.ReservedDelta)">@Delta(item.ReservedDelta)</span>
                <span><a href="@SourceUrl(item)"><strong>@(string.IsNullOrWhiteSpace(item.SourceNumber) ? "—" : item.SourceNumber)</strong><small>@SourceName(item)</small></a></span>
            </div>
        }
    </div>
    @if (!Filtered.Any()) { <div class="empty-state">Движения не найдены. Они появятся после приёмки закупки или операции с продажей.</div> }
</section>

@code {
    private IReadOnlyList<StockMovement> _items = [];
    private string _query = string.Empty;
    private string _type = string.Empty;
    private string _source = string.Empty;
    private DateTime? _from;
    private DateTime? _to;
    private IEnumerable<StockMovement> Filtered => _items.Where(x =>
        (string.IsNullOrWhiteSpace(_query) || x.ProductName.Contains(_query, StringComparison.OrdinalIgnoreCase) || x.Sku.Contains(_query, StringComparison.OrdinalIgnoreCase) || x.SourceNumber.Contains(_query, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_type) || x.Type.ToString() == _type) &&
        (string.IsNullOrWhiteSpace(_source) || x.SourceType == _source) &&
        (_from is null || x.CreatedAt.ToLocalTime().Date >= _from.Value.Date) &&
        (_to is null || x.CreatedAt.ToLocalTime().Date <= _to.Value.Date));
    protected override async Task OnInitializedAsync() => _items = await Repository.GetAsync();
    private static string Variant(StockMovement x) => string.Join(" · ", new[] { x.Color, x.Size }.Where(v => !string.IsNullOrWhiteSpace(v))) is { Length: > 0 } value ? value : "—";
    private static string Delta(int value) => value == 0 ? "—" : value > 0 ? $"+{value}" : value.ToString();
    private static string DeltaClass(int value) => value > 0 ? "positive" : value < 0 ? "negative" : string.Empty;
    private static string SourceUrl(StockMovement x) => x.SourceType == "Purchase" ? $"/purchases/{x.SourceId}" : x.SourceType == "Sale" ? $"/sales/{x.SourceId}" : "/inventory";
    private static string SourceName(StockMovement x) => x.SourceType == "Purchase" ? "Закупка" : x.SourceType == "Sale" ? "Продажа" : x.SourceType;
}
