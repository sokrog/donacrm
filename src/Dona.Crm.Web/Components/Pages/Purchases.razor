@page "/purchases"
@attribute [StreamRendering]
@inject ICommerceRepository Repository
@inject IBusinessSettingsRepository BusinessSettingsRepository

<PageTitle>Закупки — Dona CRM</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Поставка</span><h1>Закупки</h1><p>От выкупа до поступления на склад.</p></div><a class="button primary" href="/purchases/new">＋ Новая закупка</a></div>
@if (OverdueCount > 0) { <div class="notice error">Просрочено поставок: @OverdueCount. Проверьте трек-коды и свяжитесь с посредником.</div> }
else if (DueSoonCount > 0) { <div class="notice warning">В ближайшие @_settings.PurchaseDueSoonDays дн. ожидается поставок: @DueSoonCount.</div> }
<div class="toolbar">
    <input class="search" placeholder="Номер, поставщик или трек-код" @bind="_query" @bind:event="oninput" />
    <select @bind="_status"><option value="">Все статусы</option>@foreach (var status in Enum.GetValues<PurchaseStatus>()) { <option value="@status">@status.Display()</option> }</select>
    <select @bind="_delivery"><option value="">Любая дата поставки</option><option value="overdue">Просрочено</option><option value="soon">Скоро</option><option value="none">Без даты</option></select>
</div>
<section class="panel table-panel">
    <div class="data-table purchase-table">
        <div class="table-header"><span>Номер</span><span>Поставщик</span><span>Статус</span><span>Позиций</span><span>Сумма</span></div>
        @foreach (var purchase in Filtered.OrderByDescending(x => x.OrderedAt))
        {
            <a class="table-row" href="/purchases/@purchase.Id"><span><strong>@purchase.Number</strong><small>@purchase.OrderedAt.ToLocalTime().ToString("dd.MM.yyyy")</small></span><span><strong>@(purchase.SupplierName ?? "—")</strong><small>@(string.IsNullOrWhiteSpace(purchase.TrackingCode) ? "без трек-кода" : purchase.TrackingCode) · @(purchase.EstimatedDeliveryDate is null ? "дата не указана" : $"до {purchase.EstimatedDeliveryDate:dd.MM.yyyy}")</small></span><span><em class="badge">@purchase.Status.Display()</em></span><span>@purchase.TotalQuantity шт.</span><span><strong>@Money(purchase.TotalCostUzs)</strong></span></a>
        }
    </div>
    @if (!Filtered.Any()) { <div class="empty-state">Закупки не найдены. Измените параметры фильтра.</div> }
</section>
@code { private List<Purchase> _purchases = []; private BusinessSettings _settings=new(); private string _query=string.Empty;private string _status=string.Empty;private string _delivery=string.Empty;private IEnumerable<Purchase> Active=>_purchases.Where(x=>x.Status is not PurchaseStatus.Received and not PurchaseStatus.Cancelled);private IEnumerable<Purchase> Filtered=>_purchases.Where(x=>(string.IsNullOrWhiteSpace(_query)||x.Number.Contains(_query,StringComparison.OrdinalIgnoreCase)||(x.SupplierName?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false)||(x.TrackingCode?.Contains(_query,StringComparison.OrdinalIgnoreCase)??false))&&(string.IsNullOrWhiteSpace(_status)||x.Status.ToString()==_status)&&(_delivery switch{"overdue"=>x.EstimatedDeliveryDate?.Date<DateTime.Today,"soon"=>x.EstimatedDeliveryDate?.Date>=DateTime.Today&&x.EstimatedDeliveryDate?.Date<=DateTime.Today.AddDays(_settings.PurchaseDueSoonDays),"none"=>x.EstimatedDeliveryDate is null,_=>true}));private int OverdueCount=>Active.Count(x=>x.EstimatedDeliveryDate?.Date<DateTime.Today);private int DueSoonCount=>Active.Count(x=>x.EstimatedDeliveryDate?.Date>=DateTime.Today&&x.EstimatedDeliveryDate?.Date<=DateTime.Today.AddDays(_settings.PurchaseDueSoonDays));protected override async Task OnInitializedAsync(){var purchases=Repository.GetPurchasesAsync();var settings=BusinessSettingsRepository.GetAsync();await Task.WhenAll(purchases,settings);_purchases=(await purchases).ToList();_settings=await settings;}private static string Money(decimal value) => $"{value:N0} сум"; }
