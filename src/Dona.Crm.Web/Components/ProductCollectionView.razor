@inject ProductViewPreferences View
@inject CurrencyContext Currency

<div class="product-view-toolbar">
    <div class="view-mode-buttons"><button type="button" class="@(View.Mode == ProductViewMode.List ? "active" : null)" @onclick="() => ChangeModeAsync(ProductViewMode.List)" title="Список">☷ <span>Список</span></button><button type="button" class="@(View.Mode == ProductViewMode.Grid ? "active" : null)" @onclick="() => ChangeModeAsync(ProductViewMode.Grid)" title="Плитка">▦ <span>Плитка</span></button></div>
    @if (View.Mode == ProductViewMode.Grid)
    {
        <label>Колонок <select value="@View.Columns" @onchange="ChangeColumnsAsync"><option value="2">2</option><option value="3">3</option><option value="4">4</option></select></label>
    }
</div>

@if (Items.Count == 0)
{
    <div class="empty-state">@EmptyText</div>
}
else if (View.Mode == ProductViewMode.Grid)
{
    <div class="product-card-grid" style="--product-grid-columns:@View.Columns">
        @foreach (var product in Items)
        {
            <a class="product-tile" href="/products/@product.Id">
                <div class="product-tile-image">@if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl)) { <CachedImage Source="product.PrimaryImageUrl" Alt="product.Name" /> } else { <span>@Initial(product)</span> }<em class="badge @((product.Status?.ToString() ?? "none").ToLowerInvariant())">@product.Status.Display()</em></div>
                <div class="product-tile-body"><small>@product.Sku · @product.Category</small><strong>@product.Name</strong><div><span>@product.Quantity шт.</span><b>@Money(product.SellingPriceUzs)</b></div><small>Себестоимость @Money(product.CostUzs) · наценка @product.MarkupPercent%</small></div>
            </a>
        }
    </div>
}
else if (Compact)
{
    <div class="product-list compact">
        @foreach (var product in Items)
        {
            <a class="product-row" href="/products/@product.Id"><div class="product-thumb">@if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl)) { <CachedImage Source="product.PrimaryImageUrl" Alt="product.Name" /> } else { @Initial(product) }</div><div class="product-name"><strong>@product.Name</strong><small>@product.Sku · @product.Category</small></div><span class="badge @((product.Status?.ToString() ?? "none").ToLowerInvariant())">@product.Status.Display()</span><div class="number"><strong>@Money(product.SellingPriceUzs)</strong><small>прибыль @Money(product.ProfitUzs)</small></div></a>
        }
    </div>
}
else
{
    <div class="data-table"><div class="table-header"><span>Товар</span><span>Статус</span><span>Остаток</span><span>Себестоимость</span><span>Цена</span><span>Наценка</span></div>@foreach (var product in Items) { <a class="table-row" href="/products/@product.Id"><span class="product-cell">@if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl)) { <span class="product-list-image-wrap"><CachedImage Source="product.PrimaryImageUrl" Alt="product.Name" CssClass="product-list-image" /></span> } else { <i>@Initial(product)</i> }<span><strong>@product.Name</strong><small>@product.Sku · @product.Category</small></span></span><span><em class="badge @((product.Status?.ToString() ?? "none").ToLowerInvariant())">@product.Status.Display()</em></span><span>@product.Quantity шт.</span><span>@Money(product.CostUzs)</span><span><strong>@Money(product.SellingPriceUzs)</strong></span><span class="@(product.ProfitUzs >= 0 ? "positive" : "negative")">@product.MarkupPercent%</span></a> }</div>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<Product> Products { get; set; } = [];
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Товары не найдены.";
    private IReadOnlyList<Product> Items => Products.ToList();
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; await View.LoadAsync(); StateHasChanged(); }
    private async Task ChangeModeAsync(ProductViewMode mode) { await View.SetModeAsync(mode); }
    private async Task ChangeColumnsAsync(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var columns)) await View.SetColumnsAsync(columns); }
    private static string Initial(Product product) => string.IsNullOrWhiteSpace(product.Name) ? "?" : product.Name[..1];
    private string Money(decimal? value) => Currency.Format(value);
}
